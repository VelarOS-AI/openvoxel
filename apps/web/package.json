{
  "name": "@openvoxel/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "imports": {
    "#openvoxel/web/carousel-input": "./src/native/carousel-input.mjs",
    "#openvoxel/web/world-exit-guard": "./src/native/world-exit-guard.mjs"
  },
  "velar": {
    "entry": "src/main.vel",
    "targets": [
      "web"
    ],
    "requires": {
      "capabilities": [
        "web"
      ]
    }
  },
  "scripts": {
    "generate": "node ../../tools/run-validation.mjs -- node tools/generate-assets.mjs",
    "generate:check": "node ../../tools/run-validation.mjs -- node tools/check-assets.mjs",
    "precheck": "npm run generate",
    "check": "node ../../tools/run-validation.mjs -- velar check",
    "format": "velar format",
    "format:check": "node ../../tools/run-validation.mjs -- velar format --check",
    "test": "node ../../tools/run-validation.mjs --shell \"velar test && node --test --test-concurrency=1 tests/*.test.mjs\"",
    "predev": "npm run generate",
    "dev": "velar dev --port 7173",
    "prebuild": "npm run generate",
    "build": "node ../../tools/run-validation.mjs -- velar build",
    "preview": "velar preview --port 7174"
  },
  "dependencies": {
    "@openvoxel/client": "0.2.0",
    "@openvoxel/game": "0.2.0",
    "@openvoxel/protocol": "0.2.0",
    "@openvoxel/world": "0.2.0",
    "@velarscript/web": "0.34.0"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@velarscript/cli": "0.34.0",
    "sharp": "0.35.4",
    "yaml": "2.9.0"
  }
}
