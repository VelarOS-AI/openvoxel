import {ClientChunkState, ClientWorldSession, WorldBackend, WorldBackendConformanceResult, openClientWorld, verifyWorldBackend} from "@openvoxel/client"
import {localBackend, onlineBackend} from "@openvoxel/client"
import {CreateWorldRequest} from "@openvoxel/protocol"
import {WorldManifest, chunkKey, locateBlock} from "@openvoxel/world"
import {Head} from "velar/web"
import {configuration} from "./config.vel"
import {actionsLook, canvasLook, cardLook, controlLook, diagnosticsLook, errorLook, fieldLook, formLook, heroLook, labelLook, metricLook, mutedLook, pageLook, primaryControlLook, renderHeaderLook, shellLook, titleLook, valueLook, viewportLook} from "./look.vel"
import {WorldRenderer, WorldRendererStats, initialRenderChunkPositions, openWorldRenderer} from "./world-renderer.vel"

const online = onlineBackend(configuration.openApiUrl)
const local = localBackend()

export component App:
    state worldId = "browser-world"
    state worldName = "Browser World"
    state seed = "browser-world-seed"
    state backendMode = "online"
    state status = "Ready to create or open a world"
    state failure = ""
    state world: WorldManifest? = null
    state session: ClientWorldSession? = null
    state chunk: readonly ClientChunkState? = null
    state runtimeId: number? = null
    state revision = 0
    state generation = 0
    state contentStates = 0
    state renderChunks = 0
    state renderMeshes = 0
    state renderQuads = 0
    state renderChecksum = 0
    state renderPending = 0
    state conformance: readonly WorldBackendConformanceResult? = null
    let renderCanvas: CanvasElement? = null
    let renderer: WorldRenderer? = null

    def backend() -> WorldBackend: return backendMode == "local" ? local : online

    def backendLabel() -> string: return backendMode == "local" ? "LocalBackend" : "OnlineBackend"

    def cleanWorldId() -> string:
        const clean = worldId.trim()
        assert not clean.isBlank() else "World id cannot be blank"
        return clean

    async def closeSession():
        const previousRenderer = renderer
        const previous = session
        renderer = null
        session = null
        world = null
        chunk = null
        runtimeId = null
        revision = 0
        generation = 0
        contentStates = 0
        renderChunks = 0
        renderMeshes = 0
        renderQuads = 0
        renderChecksum = 0
        renderPending = 0
        if previousRenderer != null: await previousRenderer.close()
        if previous != null: await previous.close()

    def refreshDiagnostics(active: readonly ClientWorldSession, activeChunk: readonly ClientChunkState):
        runtimeId = active.state.block(active.bootstrap.spawn)
        revision = activeChunk.revision()
        generation = active.state.generation()
        contentStates = active.content.states.size

    def receiveRenderStats(stats: readonly WorldRendererStats):
        renderChunks = stats.chunks
        renderMeshes = stats.meshes
        renderQuads = stats.quads
        renderChecksum = stats.checksum
        renderPending = stats.pending

    def receiveRenderFailure(message: string):
        failure = message
        status = "World rendering failed"

    async def attach(manifest: readonly WorldManifest):
        await closeSession()
        let opened: ClientWorldSession? = null
        let openedRenderer: WorldRenderer? = null
        try:
            opened = await openClientWorld(backend(), manifest.id)
            const located = locateBlock(manifest.spawn, manifest.chunkEdge)
            const positions = initialRenderChunkPositions(manifest, opened.content.minimumWorldY, opened.content.maximumWorldY)
            const chunks = await opened.loadChunks(positions)
            const spawnChunk = chunks.find(candidate => chunkKey(candidate.position) == chunkKey(located.chunk))
            assert spawnChunk != null else "Backend did not return the spawn Chunk"
            const canvas = renderCanvas
            assert canvas != null else "World renderer canvas is not mounted"
            openedRenderer = await openWorldRenderer(canvas, opened, manifest, receiveRenderStats, receiveRenderFailure)
            world = WorldManifest.parse(manifest)
            session = opened
            chunk = spawnChunk
            renderer = openedRenderer
            refreshDiagnostics(opened, spawnChunk)
            status = f"World connected and {chunks.size} Chunks scheduled for rendering"
        catch error:
            if openedRenderer != null: await openedRenderer.close()
            if opened != null: await opened.close()
            throw error

    action createAndOpen():
        failure = ""
        try:
            const command: CreateWorldRequest = {
                id: cleanWorldId(),
                name: worldName.trim(),
                seed: seed.trim(),
            }
            const created = await backend().createWorld(command)
            await attach(created)
        catch error:
            failure = error.message
            status = "World creation failed"

    action openExisting():
        failure = ""
        try:
            const found = await backend().findWorld(cleanWorldId())
            await attach(found)
        catch error:
            failure = error.message
            status = "World open failed"

    action editSpawn():
        failure = ""
        try:
            const active = session
            const activeWorld = world
            const activeChunk = chunk
            assert active != null and activeWorld != null and activeChunk != null else "Open a world before editing"
            const current = active.state.block(activeWorld.spawn)
            assert current != null else "Spawn block is not loaded"
            const replacement = active.content.states.find(state => state.runtimeId != current)
            assert replacement != null else "World content needs at least two block states"
            await active.applyBlocks([{
                position: activeWorld.spawn,
                blockStateRuntimeId: replacement.runtimeId,
            }])
            refreshDiagnostics(active, activeChunk)
            status = "Spawn block edit committed"
        catch error:
            failure = error.message
            status = "Block edit failed"

    action reconnect():
        failure = ""
        try:
            const active = session
            const activeChunk = chunk
            assert active != null and activeChunk != null else "Open a world before reconnecting"
            await active.reconnect()
            refreshDiagnostics(active, activeChunk)
            status = "Realtime connection reopened and tracked Chunks resynchronized"
        catch error:
            failure = error.message
            status = "Reconnect failed"

    async def selectBackend(mode: string):
        if backendMode == mode: return
        await closeSession()
        backendMode = mode
        conformance = null
        failure = ""
        status = f"{backendLabel()} selected"

    action useOnline(): await selectBackend("online")

    action useLocal(): await selectBackend("local")

    action verifyBackend():
        failure = ""
        conformance = null
        try:
            const base = cleanWorldId()
            const idSuffix = f"-{backendMode}-conformance"
            const seedSuffix = f"-{backendMode}-conformance"
            const report = await verifyWorldBackend(backend(), {
                id: f"{base.slice(0, 64 - idSuffix.size)}{idSuffix}",
                name: f"{backendLabel()} Conformance",
                seed: f"{seed.trim().slice(0, 128 - seedSuffix.size)}{seedSuffix}",
            })
            conformance = report
            status = f"{backendLabel()} passed the shared backend conformance"
        catch error:
            failure = error.message
            status = f"{backendLabel()} conformance failed"

    async def shutdown():
        await closeSession()
        await online.close()
        await local.close()

    @cleanup: async shutdown()

    def busy() -> bool:
        return createAndOpen.pending or openExisting.pending or editSpawn.pending or reconnect.pending or useOnline.pending or useLocal.pending or verifyBackend.pending

    def diagnostics() -> WebNode:
        const activeWorld = world
        const activeChunk = chunk
        if activeWorld == null or activeChunk == null:
            return <p look={mutedLook} data-world-empty>No world is connected.</p>
        return <div look={diagnosticsLook} data-world-ready="true">
            <div look={metricLook}>
                <span look={mutedLook}>World</span>
                <strong look={valueLook} data-world-id>{activeWorld.id}</strong>
            </div>
            <div look={metricLook}>
                <span look={mutedLook}>Spawn Chunk</span>
                <strong look={valueLook} data-chunk-key>{chunkKey(activeChunk.position)}</strong>
            </div>
            <div look={metricLook}>
                <span look={mutedLook}>Block runtime id</span>
                <strong look={valueLook} data-runtime-id>{str(runtimeId ?? -1)}</strong>
            </div>
            <div look={metricLook}>
                <span look={mutedLook}>Chunk revision</span>
                <strong look={valueLook} data-revision>{str(revision)}</strong>
            </div>
            <div look={metricLook}>
                <span look={mutedLook}>Connection generation</span>
                <strong look={valueLook} data-generation>{str(generation)}</strong>
            </div>
            <div look={metricLook}>
                <span look={mutedLook}>Content states</span>
                <strong look={valueLook} data-content-states>{str(contentStates)}</strong>
            </div>
        </div>

    return <div look={shellLook} data-app>
        <Head
            title="OpenVoxel Diagnostics"
            description="Real browser acceptance surface for OpenVoxel world sessions"
            robots="noindex,nofollow"
        />
        <main look={pageLook}>
            <header look={heroLook}>
                <p look={mutedLook} data-backend-mode>{backendLabel()} · {backendMode == "local" ? "Worker + IndexedDB" : "HTTP + WebSocket + MessagePack"}</p>
                <h1 look={titleLook}>OpenVoxel Diagnostics</h1>
                <p look={mutedLook}>
                    Create a world, synchronize its spawn Chunk, edit one block, and verify reconnect convergence.
                </p>
            </header>

            <form look={cardLook} on:submit.prevent={createAndOpen} aria-busy={busy()} data-world-form>
                <div look={actionsLook} aria-label="Backend mode">
                    <button
                        type="button"
                        look={backendMode == "online" ? primaryControlLook : controlLook}
                        on:click={useOnline}
                        disabled={busy()}
                        aria-pressed={backendMode == "online"}
                        data-use-online
                    >
                        Online
                    </button>
                    <button
                        type="button"
                        look={backendMode == "local" ? primaryControlLook : controlLook}
                        on:click={useLocal}
                        disabled={busy()}
                        aria-pressed={backendMode == "local"}
                        data-use-local
                    >
                        Local
                    </button>
                </div>
                <div look={formLook}>
                    <label look={labelLook}>
                        World id
                        <input
                            look={fieldLook}
                            name="worldId"
                            bind:value={worldId}
                            disabled={busy()}
                            data-world-id-input
                        />
                    </label>
                    <label look={labelLook}>
                        Name
                        <input
                            look={fieldLook}
                            name="worldName"
                            bind:value={worldName}
                            disabled={busy()}
                            data-world-name-input
                        />
                    </label>
                    <label look={labelLook}>
                        Seed
                        <input look={fieldLook} name="seed" bind:value={seed} disabled={busy()} data-seed-input />
                    </label>
                </div>
                <div look={actionsLook}>
                    <button type="submit" look={primaryControlLook} disabled={busy()} data-create-world>
                        Create and open
                    </button>
                    <button type="button" look={controlLook} on:click={openExisting} disabled={busy()} data-open-world>
                        Open existing
                    </button>
                    <button
                        type="button"
                        look={controlLook}
                        on:click={editSpawn}
                        disabled={busy() or session == null}
                        data-edit-spawn
                    >
                        Edit spawn block
                    </button>
                    <button
                        type="button"
                        look={controlLook}
                        on:click={reconnect}
                        disabled={busy() or session == null}
                        data-reconnect
                    >
                        Reconnect
                    </button>
                    <button
                        type="button"
                        look={controlLook}
                        on:click={verifyBackend}
                        disabled={busy()}
                        data-verify-backend
                    >
                        Verify backend contract
                    </button>
                </div>
                {failure == "" ? <></> : <p look={errorLook} role="alert" data-error>{failure}</p>}
                <p look={mutedLook} aria-live="polite" data-status>{status}</p>
            </form>

            {conformance == null ? <></> : <section look={cardLook} aria-label="Backend conformance" data-conformance-pass="true">
                <strong>{backendLabel()} conformance passed</strong>
                <div look={diagnosticsLook}>
                    <div look={metricLook}>
                        <span look={mutedLook}>World</span>
                        <strong look={valueLook} data-conformance-world>{conformance.worldId}</strong>
                    </div>
                    <div look={metricLook}>
                        <span look={mutedLook}>Revision</span>
                        <strong look={valueLook} data-conformance-revision>{str(conformance.revision)}</strong>
                    </div>
                    <div look={metricLook}>
                        <span look={mutedLook}>Generation</span>
                        <strong look={valueLook} data-conformance-generation>{str(conformance.generation)}</strong>
                    </div>
                </div>
            </section>}

            <section look={cardLook} aria-label="Voxel world view" data-render-ready={renderChunks > 0 ? "true" : "false"}>
                <div look={renderHeaderLook}>
                    <strong>World view</strong>
                    <span look={mutedLook}>
                        {renderPending > 0 ? f"Meshing {renderPending} Chunks" : "Drag to orbit · wheel to zoom"}
                    </span>
                </div>
                <div look={viewportLook}>
                    <canvas ref={renderCanvas} look={canvasLook} data-voxel-canvas></canvas>
                </div>
                <div look={diagnosticsLook}>
                    <div look={metricLook}>
                        <span look={mutedLook}>Rendered Chunks</span>
                        <strong look={valueLook} data-render-chunks>{str(renderChunks)}</strong>
                    </div>
                    <div look={metricLook}>
                        <span look={mutedLook}>GPU Meshes</span>
                        <strong look={valueLook} data-render-meshes>{str(renderMeshes)}</strong>
                    </div>
                    <div look={metricLook}>
                        <span look={mutedLook}>Visible quads</span>
                        <strong look={valueLook} data-render-quads>{str(renderQuads)}</strong>
                    </div>
                    <div look={metricLook}>
                        <span look={mutedLook}>Mesh checksum</span>
                        <strong look={valueLook} data-render-checksum>{str(renderChecksum)}</strong>
                    </div>
                    <div look={metricLook}>
                        <span look={mutedLook}>Pending</span>
                        <strong look={valueLook} data-render-pending>{str(renderPending)}</strong>
                    </div>
                </div>
            </section>

            <section look={cardLook} aria-label="World session diagnostics">
                <strong>Session state</strong>
                {diagnostics()}
            </section>
        </main>
    </div>
