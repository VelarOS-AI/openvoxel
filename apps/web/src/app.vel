import {localBackend} from "@openvoxel/client"
import {CreateWorldRequest} from "@openvoxel/protocol"
import {Head, Link, navigate} from "velar/web"
import {Icon, IconName} from "./icon.vel"
import {actionGroupLook, actionRowLook, activeDotLook, advancedButtonLook, advancedFieldsLook, appShellLook, backgroundBottomShadeLook, backgroundImageLook, backgroundShadeLook, brandIconLook, brandLook, brandNameLook, carouselArrowLook, createIntroLook, createLayoutLook, displayTitleLook, dotLook, dotsLook, emptyActionsLook, emptyContentLook, errorLook, fieldLook, formActionsLook, formPanelLook, homeContentLook, labelLook, metadataItemLook, metadataLook, navButtonLook, navLabelLook, navLook, nextArrowLook, openPanelLook, panelTitleLook, presetGridLook, presetImageLook, presetLabelLook, presetLook, previousArrowLook, primaryButtonLook, secondaryButtonLook, segmentLook, segmentButtonLook, selectedPresetLook, selectedSegmentButtonLook, settingsPanelLook, settingsRowLook, settingsValueLook, subtitleLook, topBarLook, worldInfoLook} from "./look.vel"
import {SavedWorld, loadSavedWorlds, presetName, rememberWorld, touchWorld, worldCover, worldIdFromName} from "./world-library.vel"

extern js`
    let lastWheelAt = 0

    export function wheelDirection(event) {
        const now = performance.now()
        const delta = Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX
        if (!Number.isFinite(delta) || Math.abs(delta) < 4 || now - lastWheelAt < 320) return 0
        lastWheelAt = now
        return delta > 0 ? 1 : -1
    }
`:
    export def wheelDirection(event: Event) -> number

component Brand(back: bool = false):
    def home(): navigate("/")

    return <div look={brandLook}>
        {back ? <button type="button" look={navButtonLook} on:click={home} aria-label="Back to worlds" data-back-home>
            <Icon name={IconName.chevronLeft} />
        </button> : <></>}
        <Link to="/" look={brandLook}>
            <Icon name={IconName.cube} look={brandIconLook} />
            <span look={brandNameLook}>OpenVoxel</span>
        </Link>
    </div>

component Navigation(showCreate: bool = true):
    def create(): navigate("/worlds/new")

    return <nav look={navLook} aria-label="Application">
        {showCreate ? <button type="button" look={navButtonLook} on:click={create} data-new-world>
            <Icon name={IconName.squarePlus} />
            <span look={navLabelLook}>New world</span>
        </button> : <></>}
        <button type="button" look={navButtonLook} title="Settings">
            <Icon name={IconName.gear} />
            <span look={navLabelLook}>Settings</span>
        </button>
        <button type="button" look={navButtonLook} title="Help">
            <Icon name={IconName.circleQuestion} />
            <span look={navLabelLook}>Help</span>
        </button>
    </nav>

export component App:
    state worlds = loadSavedWorlds()
    state selectedIndex = worlds.size > 0 ? worlds.size - 1 : 0
    state settingsOpen = false

    computed activeWorld = worlds.get(selectedIndex)

    def selectWorld(index: number):
        if index < 0 or index >= worlds.size: return
        selectedIndex = index
        settingsOpen = false

    def moveSelection(direction: number):
        if worlds.size <= 1: return
        selectedIndex = (selectedIndex + direction + worlds.size) % worlds.size
        settingsOpen = false

    def previousWorld(): moveSelection(-1)

    def nextWorld(): moveSelection(1)

    def switchByWheel(event: Event):
        const direction = wheelDirection(event)
        if direction != 0: moveSelection(direction)

    def toggleWorldSettings(): settingsOpen = not settingsOpen

    def play():
        const selected = activeWorld
        if selected == null: return
        touchWorld(selected)
        navigate(f"/world/{selected.id}")

    def createFirstWorld(): navigate("/worlds/new")

    def openExistingWorld(): navigate("/worlds/open")

    def carouselDots() -> List<WebNode>:
        const nodes: List<WebNode> = []
        for world, index in worlds:
            nodes.append(<button
                type="button"
                look={index == selectedIndex ? activeDotLook : dotLook}
                on:pointerenter={() => selectWorld(index)}
                on:click={() => selectWorld(index)}
                aria-label={f"Show {world.name}"}
                aria-current={index == selectedIndex ? "true" : "false"}
                data-carousel-dot={world.id}
            ></button>)
        return nodes

    def worldHome() -> WebNode:
        const selected = activeWorld
        assert selected != null else "A selected world is required"
        return <>
            <button type="button" look={previousArrowLook} on:click={previousWorld} disabled={worlds.size <= 1} aria-label="Previous world" data-carousel-previous>
                <Icon name={IconName.chevronLeft} />
            </button>
            <button type="button" look={nextArrowLook} on:click={nextWorld} disabled={worlds.size <= 1} aria-label="Next world" data-carousel-next>
                <Icon name={IconName.chevronRight} />
            </button>
            <section look={homeContentLook} aria-label="Selected world" data-world-carousel>
                <div look={worldInfoLook}>
                    <h1 look={displayTitleLook} data-selected-world-name>{selected.name}</h1>
                    <div look={metadataLook}>
                        <span look={metadataItemLook}>
                            <Icon name={IconName.earthAmericas} />
                            {selected.mode}
                        </span>
                        <span look={metadataItemLook}>
                            <Icon name={IconName.clock} />
                            {selected.lastPlayed}
                        </span>
                    </div>
                </div>
                <div look={actionRowLook}>
                    <div look={actionGroupLook}>
                        <button type="button" look={primaryButtonLook} on:click={play} data-play-world>
                            <Icon name={IconName.play} />
                            Play
                        </button>
                        <button type="button" look={secondaryButtonLook} on:click={toggleWorldSettings} aria-expanded={settingsOpen} data-world-settings>
                            <Icon name={IconName.gear} />
                            World settings
                        </button>
                    </div>
                    <div look={dotsLook} aria-label="Choose world" data-carousel-dots>
                        {carouselDots()}
                    </div>
                </div>
            </section>
            {settingsOpen ? <aside look={settingsPanelLook} aria-label="World settings" data-world-settings-panel>
                <div look={settingsRowLook}>
                    <strong>{selected.name}</strong>
                    <span look={settingsValueLook}>{selected.id}</span>
                </div>
                <div look={settingsRowLook}>
                    <span>Seed</span>
                    <span look={settingsValueLook}>{selected.seed}</span>
                </div>
                <div look={settingsRowLook}>
                    <span>World preset</span>
                    <span look={settingsValueLook}>{presetName(selected.preset)}</span>
                </div>
                <button type="button" look={secondaryButtonLook} on:click={toggleWorldSettings}>Close</button>
            </aside> : <></>}
        </>

    def emptyHome() -> WebNode:
        return <section look={emptyContentLook} data-empty-worlds>
            <div look={worldInfoLook}>
                <h1 look={displayTitleLook}>Create your first world</h1>
                <p look={subtitleLook}>Shape a place that is entirely yours.</p>
            </div>
            <div look={emptyActionsLook}>
                <button type="button" look={primaryButtonLook} on:click={createFirstWorld} data-create-first-world>
                    <Icon name={IconName.plus} />
                    Create world
                </button>
                <button type="button" look={secondaryButtonLook} on:click={openExistingWorld} data-open-existing-world>
                    <Icon name={IconName.folderOpen} />
                    Open existing world
                </button>
            </div>
        </section>

    return <div look={appShellLook} on:wheel.prevent={switchByWheel} data-app data-screen="world-home">
        <Head
            title="OpenVoxel"
            description="Create, manage, and enter your OpenVoxel worlds"
            themeColor="#06101f"
            language="en"
        />
        <img
            look={backgroundImageLook}
            src={activeWorld == null ? "/worlds/meadow.webp" : worldCover(activeWorld.preset)}
            alt=""
            aria-hidden={true}
            data-world-background
        />
        <div look={backgroundShadeLook}></div>
        <div look={backgroundBottomShadeLook}></div>
        <header look={topBarLook}>
            <Brand />
            <Navigation showCreate={activeWorld != null} />
        </header>
        {activeWorld == null ? emptyHome() : worldHome()}
    </div>

export component CreateWorldPage:
    const backend = localBackend()
    state name = "New World"
    state seed = ""
    state mode = "Survival"
    state preset = "meadow"
    state advancedOpen = false
    state worldId = ""
    state failure = ""

    def selectPreset(value: string): preset = value

    def selectSurvival(): mode = "Survival"

    def selectCreative(): mode = "Creative"

    def toggleAdvanced(): advancedOpen = not advancedOpen

    def cancel(): navigate("/")

    action createWorld():
        failure = ""
        try:
            const cleanName = name.trim()
            assert not cleanName.isBlank() else "World name cannot be blank"
            const requestedId = worldId.trim()
            const id = requestedId.isBlank() ? worldIdFromName(cleanName) : requestedId
            const cleanSeed = seed.trim().isBlank() ? id : seed.trim()
            const command: CreateWorldRequest = {id, name: cleanName, seed: cleanSeed}
            const created = await backend.createWorld(command)
            rememberWorld(SavedWorld.from(created, {
                mode,
                preset,
                lastPlayed: "Created just now",
            }))
            navigate(f"/world/{created.id}")
        catch error: failure = error.message

    @cleanup: detach backend.close()

    def presetButton(value: string, icon: IconName) -> WebNode:
        return <button
            type="button"
            look={preset == value ? selectedPresetLook : presetLook}
            on:click={() => selectPreset(value)}
            aria-pressed={preset == value}
            data-preset={value}
        >
            <img look={presetImageLook} src={worldCover(value)} alt="" aria-hidden={true} />
            <span look={presetLabelLook}>
                <Icon name={icon} />
                {presetName(value)}
            </span>
        </button>

    return <div look={appShellLook} data-app data-screen="create-world">
        <Head
            title="Create a world · OpenVoxel"
            description="Create a new OpenVoxel world"
            themeColor="#06101f"
            language="en"
        />
        <img look={backgroundImageLook} src={worldCover(preset)} alt="" aria-hidden={true} data-preset-background />
        <div look={backgroundShadeLook}></div>
        <div look={backgroundBottomShadeLook}></div>
        <header look={topBarLook}>
            <Brand back={true} />
        </header>
        <main look={createLayoutLook}>
            <section look={createIntroLook}>
                <div look={worldInfoLook}>
                    <h1 look={displayTitleLook}>Create a new world</h1>
                    <p look={subtitleLook}>Shape your adventure. Choose a landscape and start building your world.</p>
                </div>
                <div look={presetGridLook} aria-label="World preset">
                    {presetButton("meadow", IconName.leaf)}
                    {presetButton("coast", IconName.water)}
                    {presetButton("highlands", IconName.mountainSun)}
                </div>
            </section>
            <form look={formPanelLook} on:submit.prevent={createWorld} aria-busy={createWorld.pending} data-create-world-form>
                <label look={labelLook}>
                    World name
                    <input
                        look={fieldLook}
                        name="name"
                        bind:value={name}
                        maxlength="80"
                        disabled={createWorld.pending}
                        data-world-name-input
                    />
                </label>
                <div look={segmentLook} aria-label="Game mode">
                    <button type="button" look={mode == "Survival" ? selectedSegmentButtonLook : segmentButtonLook} on:click={selectSurvival} aria-pressed={mode == "Survival"} data-mode="survival">
                        <Icon name={IconName.shieldHalved} />
                        Survival
                    </button>
                    <button type="button" look={mode == "Creative" ? selectedSegmentButtonLook : segmentButtonLook} on:click={selectCreative} aria-pressed={mode == "Creative"} data-mode="creative">
                        <Icon name={IconName.wandMagicSparkles} />
                        Creative
                    </button>
                </div>
                <label look={labelLook}>
                    Seed (optional)
                    <input
                        look={fieldLook}
                        name="seed"
                        bind:value={seed}
                        maxlength="128"
                        placeholder="Leave blank for a random seed"
                        disabled={createWorld.pending}
                        data-seed-input
                    />
                </label>
                <button type="button" look={advancedButtonLook} on:click={toggleAdvanced} aria-expanded={advancedOpen} data-advanced-settings>
                    <span><Icon name={IconName.sliders} /> Advanced settings</span>
                    <Icon name={advancedOpen ? IconName.chevronUp : IconName.chevronDown} />
                </button>
                {advancedOpen ? <div look={advancedFieldsLook} data-advanced-fields>
                    <label look={labelLook}>
                        World identifier
                        <input
                            look={fieldLook}
                            name="worldId"
                            bind:value={worldId}
                            maxlength="64"
                            placeholder="Generated from name"
                            disabled={createWorld.pending}
                            data-world-id-input
                        />
                    </label>
                    <label look={labelLook}>
                        Generator
                        <input look={fieldLook} value="OpenVoxel Overworld" disabled={true} />
                    </label>
                </div> : <></>}
                {failure.isBlank() ? <></> : <p look={errorLook} role="alert" data-error>{failure}</p>}
                <div look={formActionsLook}>
                    <button type="submit" look={primaryButtonLook} disabled={createWorld.pending} data-create-world>
                        {createWorld.pending ? "Creating…" : "Create world"}
                        <Icon name={IconName.arrowRight} />
                    </button>
                    <button type="button" look={secondaryButtonLook} on:click={cancel} disabled={createWorld.pending}>
                        Cancel
                    </button>
                </div>
            </form>
        </main>
    </div>

export component OpenWorldPage:
    const backend = localBackend()
    state worldId = ""
    state failure = ""

    def cancel(): navigate("/")

    action openWorld():
        failure = ""
        try:
            const id = worldId.trim()
            assert not id.isBlank() else "World identifier cannot be blank"
            const found = await backend.findWorld(id)
            const saved = SavedWorld.from(found, {
                mode: "Existing world",
                preset: "meadow",
                lastPlayed: "Opened just now",
            })
            rememberWorld(saved)
            navigate(f"/world/{found.id}")
        catch error: failure = error.message

    @cleanup: detach backend.close()

    return <div look={appShellLook} data-app data-screen="open-world">
        <Head
            title="Open a world · OpenVoxel"
            description="Open an existing OpenVoxel world"
            themeColor="#06101f"
            language="en"
        />
        <img look={backgroundImageLook} src="/worlds/meadow.webp" alt="" aria-hidden={true} />
        <div look={backgroundShadeLook}></div>
        <div look={backgroundBottomShadeLook}></div>
        <header look={topBarLook}>
            <Brand back={true} />
        </header>
        <form look={openPanelLook} on:submit.prevent={openWorld} aria-busy={openWorld.pending} data-open-world-form>
            <h1 look={panelTitleLook}>Open existing world</h1>
            <p look={subtitleLook}>Enter the identifier of a world stored on this device.</p>
            <label look={labelLook}>
                World identifier
                <input
                    look={fieldLook}
                    name="worldId"
                    bind:value={worldId}
                    maxlength="64"
                    disabled={openWorld.pending}
                    autofocus={true}
                    data-open-world-id
                />
            </label>
            {failure.isBlank() ? <></> : <p look={errorLook} role="alert" data-error>{failure}</p>}
            <div look={formActionsLook}>
                <button type="submit" look={primaryButtonLook} disabled={openWorld.pending} data-open-world>
                    {openWorld.pending ? "Opening…" : "Open world"}
                    <Icon name={IconName.arrowRight} />
                </button>
                <button type="button" look={secondaryButtonLook} on:click={cancel} disabled={openWorld.pending}>
                    Cancel
                </button>
            </div>
        </form>
    </div>
