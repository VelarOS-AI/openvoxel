import {ClientWorldChange, ClientWorldChangeKind, ClientWorldSession} from "@openvoxel/client"
import {MeshingWorkerRequest, MeshingWorkerResponse, VoxelRenderSurface, builtinClientResourcePack, createClientRenderCatalog, meshingWorkerOperations, openVoxelRenderSurface, snapshotChunkNeighborhood} from "@openvoxel/renderer"
import {ChunkPosition, WorldManifest, chunkCoordinate, chunkKey, locateBlock} from "@openvoxel/world"
import {Cancellation, Task, task} from "velar/task"
import {workerPool} from "velar/worker"

export type WorldRendererStats:
    readonly chunks: number
    readonly meshes: number
    readonly quads: number
    readonly checksum: number
    readonly pending: number

export type WorldRenderer:
    close: () -> Promise<null>

const initialHorizontalChunkRadius = 1
const verticalRenderChunkRadius = 2
const streamBatchSize = 12
const maximumConcurrentMeshBuilds = 24

export const horizontalRenderChunkRadius = 3

export def initialRenderChunkPositions(
    manifest: readonly WorldManifest,
    minimumWorldY: number,
    maximumWorldY: number,
) -> List<readonly ChunkPosition>:
    const center = locateBlock(manifest.spawn, manifest.chunkEdge).chunk
    const minimumChunkY = chunkCoordinate(minimumWorldY, manifest.chunkEdge)
    const maximumChunkY = chunkCoordinate(maximumWorldY, manifest.chunkEdge)
    const positions: List<readonly ChunkPosition> = []
    for dy in range(-1, 2):
        const y = center.y + dy
        if y < minimumChunkY or y > maximumChunkY: continue
        for dz in range(-initialHorizontalChunkRadius, initialHorizontalChunkRadius + 1):
            for dx in range(-initialHorizontalChunkRadius, initialHorizontalChunkRadius + 1):
                positions.append({x: center.x + dx, y, z: center.z + dz})
    return positions

def streamedChunkPositions(
    centerX: number,
    centerY: number,
    centerZ: number,
    minimumChunkY: number,
    maximumChunkY: number,
) -> List<readonly ChunkPosition>:
    const positions: List<readonly ChunkPosition> = []
    for ring in range(horizontalRenderChunkRadius + 1):
        for dz in range(-ring, ring + 1):
            for dx in range(-ring, ring + 1):
                if Math.max(dx.abs(), dz.abs()) != ring: continue
                for dy in range(-verticalRenderChunkRadius, verticalRenderChunkRadius + 1):
                    const y = centerY + dy
                    if y >= minimumChunkY and y <= maximumChunkY:
                        positions.append({x: centerX + dx, y, z: centerZ + dz})
    return positions

export async def openWorldRenderer(
    canvas: CanvasElement,
    session: readonly ClientWorldSession,
    manifest: readonly WorldManifest,
    changed: (stats: readonly WorldRendererStats) -> null,
    failed: (message: string) -> null,
) -> WorldRenderer:
    const catalog = createClientRenderCatalog(session.content, builtinClientResourcePack)
    const spawnChunk = locateBlock(manifest.spawn, manifest.chunkEdge).chunk
    const minimumChunkY = chunkCoordinate(session.content.minimumWorldY, manifest.chunkEdge)
    const maximumChunkY = chunkCoordinate(session.content.maximumWorldY, manifest.chunkEdge)
    let surface: VoxelRenderSurface? = null
    const meshing = workerPool("openvoxel-meshing", MeshingWorkerRequest, MeshingWorkerResponse, 2, 32)
    let subscription = session.subscribeChanges(_event => null)
    const tickets: Map<string, number> = Map()
    const meshTasks: Map<string, Task<null>> = Map()
    const activeMeshKeys: Set<string> = Set()
    const queuedMeshPositions: Map<string, readonly ChunkPosition> = Map()
    const queuedMeshTickets: Map<string, number> = Map()
    let streaming: Task<null>? = null
    let streamVersion = 0
    let activeMeshBuilds = 0
    let loading = 0
    let closed = false

    def activeSurface() -> VoxelRenderSurface:
        const current = surface
        assert current != null else "World render surface is not ready"
        return current

    def publishStats():
        if surface == null: return
        const stats = activeSurface().stats()
        changed(WorldRendererStats.from(stats, {pending: activeMeshBuilds + queuedMeshPositions.size + loading}))

    let continueMeshing: () -> null = () => null

    async def build(position: readonly ChunkPosition, ticket: number, cancellation: Cancellation):
        try:
            await cancellation.checkpoint()
            const center = session.state.chunk(position)
            assert center != null else "Cannot mesh an untracked client Chunk"
            const paddedBlocks = snapshotChunkNeighborhood(position, center.edge, block => session.state.block(block))
            const response = await meshing.call({
                operation: meshingWorkerOperations.mesh,
                position,
                edge: manifest.chunkEdge,
                paddedBlocks,
                ticket,
            }, cancellation, 15s)
            const mesh = response.mesh
            if closed or tickets.get(chunkKey(position)) != ticket: return
            assert mesh != null else "Meshing Worker returned no Chunk mesh"
            activeSurface().setChunkMesh(mesh)
        catch error:
            if not closed and tickets.get(chunkKey(position)) == ticket: failed(error.message)
        finally:
            const key = chunkKey(position)
            meshTasks.remove(key)
            activeMeshKeys.remove(key)
            activeMeshBuilds -= 1
            if not closed:
                continueMeshing()
                publishStats()

    async def cancelEvicted(owner: Task<null>, key: string, ticket: number):
        await owner.cancel("Chunk left the render window")
        if tickets.get(key) == ticket: tickets.remove(key)

    def drainMeshQueue():
        while not closed and activeMeshBuilds < maximumConcurrentMeshBuilds:
            let selectedKey: string? = null
            for key in queuedMeshPositions.keys():
                if key not in activeMeshKeys:
                    selectedKey = key
                    break
            if selectedKey == null: return
            const key = selectedKey
            const position = queuedMeshPositions.get(key)!
            const ticket = queuedMeshTickets.get(key)!
            queuedMeshPositions.remove(key)
            queuedMeshTickets.remove(key)
            activeMeshKeys.add(key)
            activeMeshBuilds += 1
            async def runBuild(cancellation: Cancellation): await build(position, ticket, cancellation)
            const owner: Task<null> = task(runBuild)
            meshTasks.set(key, owner)

    continueMeshing = drainMeshQueue

    def schedule(position: readonly ChunkPosition):
        if closed or session.state.chunk(position) == null: return
        const key = chunkKey(position)
        const ticket = (tickets.get(key) ?? 0) + 1
        tickets.set(key, ticket)
        queuedMeshPositions.set(key, position)
        queuedMeshTickets.set(key, ticket)
        drainMeshQueue()

    def addTracked(targets: Map<string, readonly ChunkPosition>, position: readonly ChunkPosition):
        if session.state.chunk(position) != null: targets.set(chunkKey(position), position)

    def addNeighbors(targets: Map<string, readonly ChunkPosition>, position: readonly ChunkPosition):
        addTracked(targets, {x: position.x + 1, y: position.y, z: position.z})
        addTracked(targets, {x: position.x - 1, y: position.y, z: position.z})
        addTracked(targets, {x: position.x, y: position.y + 1, z: position.z})
        addTracked(targets, {x: position.x, y: position.y - 1, z: position.z})
        addTracked(targets, {x: position.x, y: position.y, z: position.z + 1})
        addTracked(targets, {x: position.x, y: position.y, z: position.z - 1})

    def invalidate(event: readonly ClientWorldChange):
        if event.kind == ClientWorldChangeKind.terrainUnloaded:
            for position in event.positions:
                const key = chunkKey(position)
                const ticket = (tickets.get(key) ?? 0) + 1
                tickets.set(key, ticket)
                queuedMeshPositions.remove(key)
                queuedMeshTickets.remove(key)
                const previous = meshTasks.get(key)
                if previous == null: tickets.remove(key)
                else: detach cancelEvicted(previous, key, ticket)
                activeSurface().removeChunk(position.x, position.y, position.z)
            publishStats()
            return
        // 地形下载后还会紧接着同步热数据。只在同步完成后建网格，避免先用冷快照
        // 建一次、再被相同 Chunk 的增量结果立刻推翻。
        if event.kind == ClientWorldChangeKind.terrainLoaded: return
        const targets: Map<string, readonly ChunkPosition> = Map()
        if event.kind == ClientWorldChangeKind.blocksChanged and event.changes.size > 0:
            for change in event.changes:
                addTracked(targets, change.chunk)
                const local = change.local
                if local.x == 0: addTracked(targets, {x: change.chunk.x - 1, y: change.chunk.y, z: change.chunk.z})
                if local.x == manifest.chunkEdge - 1:
                    addTracked(targets, {x: change.chunk.x + 1, y: change.chunk.y, z: change.chunk.z})
                if local.y == 0: addTracked(targets, {x: change.chunk.x, y: change.chunk.y - 1, z: change.chunk.z})
                if local.y == manifest.chunkEdge - 1:
                    addTracked(targets, {x: change.chunk.x, y: change.chunk.y + 1, z: change.chunk.z})
                if local.z == 0: addTracked(targets, {x: change.chunk.x, y: change.chunk.y, z: change.chunk.z - 1})
                if local.z == manifest.chunkEdge - 1:
                    addTracked(targets, {x: change.chunk.x, y: change.chunk.y, z: change.chunk.z + 1})
        else:
            for position in event.positions:
                addTracked(targets, position)
                addNeighbors(targets, position)
        for position in targets.values(): schedule(position)
        publishStats()

    async def streamWindow(centerX: number, centerY: number, centerZ: number, version: number, cancellation: Cancellation):
        const desired = streamedChunkPositions(centerX, centerY, centerZ, minimumChunkY, maximumChunkY)
        const desiredKeys: Set<string> = Set()
        const missing: List<readonly ChunkPosition> = []
        for position in desired:
            const key = chunkKey(position)
            desiredKeys.add(key)
            if session.state.chunk(position) == null: missing.append(position)
        loading = missing.size
        publishStats()
        try:
            let start = 0
            while start < missing.size:
                await cancellation.checkpoint()
                if closed or streamVersion != version: return
                let end = start + streamBatchSize
                if end > missing.size: end = missing.size
                await session.loadChunks(missing.slice(start, end), cancellation)
                start = end
                if streamVersion == version:
                    loading = missing.size - start
                    publishStats()
            await cancellation.checkpoint()
            if closed or streamVersion != version: return
            const obsolete: List<readonly ChunkPosition> = []
            for position in session.state.trackedPositions():
                if chunkKey(position) not in desiredKeys: obsolete.append(position)
            if obsolete.size > 0: session.unloadChunks(obsolete)
        finally:
            if streamVersion == version:
                loading = 0
                if not closed: publishStats()

    async def replaceStream(
        previous: Task<null>?,
        centerX: number,
        centerY: number,
        centerZ: number,
        version: number,
        cancellation: Cancellation,
    ):
        try:
            if previous != null: await previous.cancel("Camera entered another Chunk")
            await cancellation.checkpoint()
            await streamWindow(centerX, centerY, centerZ, version, cancellation)
        catch error:
            if not closed and streamVersion == version: failed(error.message)
        finally:
            if streamVersion == version: streaming = null

    def requestWindow(centerX: number, centerY: number, centerZ: number):
        if closed: return
        streamVersion += 1
        const version = streamVersion
        const previous = streaming
        async def run(cancellation: Cancellation):
            await replaceStream(previous, centerX, centerY, centerZ, version, cancellation)
        streaming = task(run)

    def viewChanged(centerX: number, centerY: number, centerZ: number): requestWindow(centerX, centerY, centerZ)

    try:
        surface = await openVoxelRenderSurface(
            canvas,
            catalog,
            manifest.chunkEdge,
            manifest.spawn.x,
            manifest.spawn.y,
            manifest.spawn.z,
            horizontalRenderChunkRadius,
            viewChanged,
        )
        await meshing.broadcast({operation: meshingWorkerOperations.initialize, states: catalog.states}, null, 10s)
        subscription.close()
        subscription = session.subscribeChanges(invalidate)
        for position in session.state.trackedPositions(): schedule(position)
        publishStats()
        requestWindow(spawnChunk.x, spawnChunk.y, spawnChunk.z)
    catch error:
        subscription.close()
        await meshing.close()
        if surface != null: activeSurface().release()
        throw error

    async def close():
        if closed: return
        closed = true
        subscription.close()
        const activeStream = streaming
        streaming = null
        if activeStream != null: await activeStream.cancel("World renderer closed")
        const activeTasks = meshTasks.values()
        for owner in activeTasks: await owner.cancel("World renderer closed")
        meshTasks.clear()
        activeMeshKeys.clear()
        queuedMeshPositions.clear()
        queuedMeshTickets.clear()
        await meshing.close()
        if surface != null: activeSurface().release()
        surface = null

    return {close}
