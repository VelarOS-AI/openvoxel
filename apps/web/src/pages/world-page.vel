import {WorldGameMode, WorldManifest} from "@openvoxel/world"
import {Head, RouteContext, navigate} from "velar/web"
import {Icon, IconName} from "../icon.vel"
import {asyncPageLifetime} from "../lifecycle/async-page-lifetime.vel"
import {WorldRendererStats} from "../rendering/world-renderer.vel"
import {subtitleLook} from "../styles/common.vel"
import {navButtonLook} from "../styles/shell.vel"
import {gameCanvasLook, loadingLook, worldChromeLook, worldStageLook} from "../styles/world-stage.vel"
import {localWorldExperience} from "../worlds/world-entry.vel"

export component WorldPage(route: RouteContext):
    const lifetime = asyncPageLifetime()
    const generation = lifetime.begin()
    state world: readonly WorldManifest? = null
    state loading = true
    state failure = ""
    state stats: readonly WorldRendererStats? = null
    let canvas: CanvasElement? = null
    computed renderStatus = (not failure.isBlank()
        ? "Rendering stopped"
        : stats == null ? "Preparing world"
        : stats.ready ? "World ready" : f"Building {stats.startupPending} nearby Chunks")

    def mountedCanvas() -> CanvasElement:
        const current = canvas
        assert current != null else "World canvas is not mounted"
        return current

    def receiveStats(value: readonly WorldRendererStats):
        if lifetime.owns(generation) and failure.isBlank(): stats = value

    def receiveFailure(message: string):
        if lifetime.owns(generation): failure = message

    const experience = localWorldExperience(route.params.get("id") ?? "", mountedCanvas, receiveStats, receiveFailure)

    async def enter():
        try:
            const manifest = await experience.enter()
            if not lifetime.owns(generation): return
            world = manifest
            loading = false
        catch error:
            if not lifetime.owns(generation): return
            failure = error.message
            loading = false

    def leave(): navigate("/")

    @mounted: await enter()

    @cleanup:
        lifetime.dispose()
        detach experience.close()

    return <main
        look={worldStageLook}
        data-app
        data-screen="world"
        data-world-ready={str(not loading and failure.isBlank() and (stats?.ready ?? false))}
        data-render-pending={str(stats?.pending ?? 0)}
        data-rendered-chunks={str(stats?.chunks ?? 0)}
        data-rendered-meshes={str(stats?.meshes ?? 0)}
        data-rendered-quads={str(stats?.quads ?? 0)}
        data-resident-chunks={str(stats?.residentChunks ?? 0)}
        data-terrain-pending-chunks={str(stats?.terrainPendingChunks ?? 0)}
        data-mesh-queued-chunks={str(stats?.meshQueuedChunks ?? 0)}
        data-mesh-active-chunks={str(stats?.meshActiveChunks ?? 0)}
        data-upload-queued-chunks={str(stats?.uploadQueuedChunks ?? 0)}
        data-translucent-sort-queued-meshes={str(stats?.translucentSortQueuedMeshes ?? 0)}
        data-view-chunk-x={str(stats?.viewChunkX ?? 0)}
        data-view-chunk-y={str(stats?.viewChunkY ?? 0)}
        data-view-chunk-z={str(stats?.viewChunkZ ?? 0)}
    >
        <Head
            title={world == null ? "OpenVoxel" : f"{world.name} · OpenVoxel"}
            description="OpenVoxel world"
            themeColor="#06101f"
            language="en"
        />
        <canvas
            ref={canvas}
            look={gameCanvasLook}
            aria-label={world?.mode == WorldGameMode.creative
                ? "First-person creative world view. Click to capture the pointer and fly."
                : "First-person survival world view. Click to capture the pointer and explore."}
            data-voxel-canvas
            data-navigation-mode="first-person"
            data-movement-mode={world?.mode == WorldGameMode.creative ? "creative-flight" : "survival-walk"}
        ></canvas>
        <div look={worldChromeLook}>
            <button type="button" look={navButtonLook} on:click={leave} aria-label="Back to worlds" data-leave-world>
                <Icon name={IconName.chevronLeft} />
            </button>
            <div>
                <strong>{world?.name ?? "Opening world"}</strong>
                <p look={subtitleLook} aria-live="polite" data-render-status>{renderStatus}</p>
                <p look={subtitleLook} data-first-person-controls>
                    {world?.mode == WorldGameMode.creative
                        ? "Click to look · WASD move · Space rise · Ctrl/C descend · Shift accelerate · Esc release"
                        : "Click to look · WASD move · Space jump · Shift sprint · Esc release"}
                </p>
            </div>
        </div>
        {loading ? <div look={loadingLook} aria-busy="true" data-world-loading>Opening world…</div> : <></>}
        {failure.isBlank() ? <></> : <div look={loadingLook} role="alert" data-error>
            <div>
                <p>{failure}</p>
                <button type="button" look={navButtonLook} on:click={leave}>Back to worlds</button>
            </div>
        </div>}
    </main>
