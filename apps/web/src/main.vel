import {WorldLoadingOverlay} from "./components/world-loading-overlay.vel"
import {releaseGameLandscape} from "./navigation/device-display.vel"
import {loadSavedWorlds} from "./worlds/world-library.vel"
import {worldCover} from "./worlds/world-presentation.vel"
import {WorldPreset} from "./worlds/saved-world.vel"
import {appShellLook} from "./styles/shell.vel"
import {navigate} from "./navigation/app-navigation.vel"
import {Router, lazy, route} from "velar/web"
import {WorldHomePage} from "./pages/world-home-page.vel"
import {installWorldExitProtection} from "./lifecycle/world-exit-guard.vel"

component RouteLoadingPage:
    const worlds = loadSavedWorlds()
    const selected = worlds.get(worlds.size - 1)
    def cancel():
        releaseGameLandscape()
        navigate("/")
    return <main look={appShellLook} data-app aria-busy="true" data-route-module-loading>
        <WorldLoadingOverlay
            active={true}
            cover={worldCover(selected?.preset ?? WorldPreset.meadow)}
            title={selected?.name ?? "OpenVoxel"}
            detail="正在准备…"
            cancel={cancel}
        />
    </main>

const CreateWorldPage = lazy(() => import("./pages/create-world-page.vel"), "CreateWorldPage", RouteLoadingPage)
const OpenWorldPage = lazy(() => import("./pages/open-world-page.vel"), "OpenWorldPage", RouteLoadingPage)
const WorldPage = lazy(() => import("./pages/world-page.vel"), "WorldPage", RouteLoadingPage)

const routes = [
    route("/", WorldHomePage),
    route("/worlds/new", CreateWorldPage),
    route("/worlds/open", OpenWorldPage),
    route("/world/:id", WorldPage),
]

@main:
    installWorldExitProtection()
    mount(<Router routes={routes} fallback={WorldHomePage} />, "#app")
