import {WorldGameMode} from "@openvoxel/world/game-mode"

export enum WorldPreset:
    meadow = "meadow"
    coast = "coast"
    highlands = "highlands"
    quietShore = "quiet-shore"

export readonly type SavedWorld:
    id: string
    name: string
    seed: string
    mode: WorldGameMode
    preset: WorldPreset
    lastPlayed: string
    contentPacks: readonly List<string>?

export type SavedWorlds = List<SavedWorld>

export def worldIdFromName(name: string) -> string:
    const slug = Text.slug(name).slice(0, 44)
    const prefix = slug.isBlank() ? "world" : slug
    return f"{prefix}-{Math.randomInt(1_000_000)}"
