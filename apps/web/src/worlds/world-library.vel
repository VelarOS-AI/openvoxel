import {storage} from "velar/storage"
import {SavedWorld, SavedWorlds} from "./saved-world.vel"

const savedWorldsKey = "openvoxel.worlds.v1"

export def loadSavedWorlds() -> SavedWorlds: return storage.get(savedWorldsKey, SavedWorlds, [])

export def rememberWorld(world: SavedWorld):
    const worlds = loadSavedWorlds().filter(candidate => candidate.id != world.id)
    worlds.append(world)
    storage.set(savedWorldsKey, worlds)

export def touchWorld(world: SavedWorld): rememberWorld(SavedWorld.from(world, {lastPlayed: "刚刚玩过"}))

export def forgetWorld(id: string): storage.set(savedWorldsKey, loadSavedWorlds().filter(world => world.id != id))
