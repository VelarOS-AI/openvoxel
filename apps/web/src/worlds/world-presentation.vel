import {WorldGameMode} from "@openvoxel/world/game-mode"
import {WorldPreset} from "./saved-world.vel"

export def worldGameModeName(mode: WorldGameMode) -> string:
    match mode:
        case WorldGameMode.survival: return "生存"
        case WorldGameMode.creative: return "创造"

export def worldCover(preset: WorldPreset) -> string:
    match preset:
        case WorldPreset.meadow: return "/worlds/meadow.webp"
        case WorldPreset.coast: return "/worlds/coast.webp"
        case WorldPreset.highlands: return "/worlds/highlands.webp"
        case WorldPreset.quietShore: return "/worlds/quiet-shore.webp"

export def presetName(preset: WorldPreset) -> string:
    match preset:
        case WorldPreset.meadow: return "草甸"
        case WorldPreset.coast: return "海岸"
        case WorldPreset.highlands: return "高地"
        case WorldPreset.quietShore: return "静谧海岸"

export def lastPlayedLabel(value: string) -> string:
    match value:
        case "Created just now": return "刚刚创建"
        case "Played just now": return "刚刚玩过"
        case "Opened just now": return "刚刚打开"
        case _: return value
