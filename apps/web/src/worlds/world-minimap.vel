import {minimapCanvasLook, minimapLook} from "../styles/world-minimap.vel"

/// UI 只拥有圆形地图的挂载位置，画面与方向由游戏图形表面绘制。
export component WorldMinimapPanel(attach: (canvas: CanvasElement?) -> null):
    let canvas: CanvasElement? = null

    @mounted:
        attach(canvas)

    @cleanup:
        attach(null)

    return <aside look={minimapLook} aria-label="小地图" data-minimap>
        <canvas ref={canvas} look={minimapCanvasLook} aria-label="实时俯视地图：上北、右东、下南、左西，箭头表示位置与朝向。" data-map-canvas></canvas>
    </aside>
