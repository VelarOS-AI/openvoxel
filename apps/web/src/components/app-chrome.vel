import {GameSettings, GameSettingsSubscription, gameSettings, subscribeGameSettings} from "@openvoxel/game/settings"
import {showDialog, closeDialog} from "velar/browser"
import {GameSettingsPanel} from "./game-settings-panel.vel"
import {settingsDialogLook} from "../styles/game-settings.vel"
import {Icon, IconName} from "../icon.vel"
import {captureLink, navigate} from "../navigation/app-navigation.vel"
import {brandIconLook, brandLook, brandNameLook, navButtonLook, navLabelLook, navLook} from "../styles/shell.vel"

export component Brand(back: bool = false):
    def home(): navigate("/")

    def followHome(event: Event):
        if captureLink(event): home()

    return <div look={brandLook}>
        {back ? <button type="button" look={navButtonLook} on:click={home} aria-label="返回世界列表" data-back-home>
            <Icon name={IconName.chevronLeft} />
        </button> : <></>}
        <a href="/" look={brandLook} on:click={followHome}>
            <Icon name={IconName.cube} look={brandIconLook} />
            <span look={brandNameLook}>OpenVoxel</span>
        </a>
    </div>

export component Navigation(showCreate: bool = true):
    state preferences: GameSettings = gameSettings()
    let subscription: GameSettingsSubscription? = null
    let dialog: DialogElement? = null
    def receivePreferences(value: GameSettings): preferences = value
    def openSettings():
        const current = dialog
        if current != null: showDialog(current)
    def closeSettings():
        const current = dialog
        if current != null: closeDialog(current)
    @mounted:
        subscription = subscribeGameSettings(receivePreferences)
    @cleanup:
        subscription?.close()
    def create(): navigate("/worlds/new")

    return <><nav host look={navLook} aria-label="主菜单">
        {showCreate ? <button type="button" look={navButtonLook} on:click={create} data-new-world>
            <Icon name={IconName.squarePlus} />
            <span look={navLabelLook}>新建世界</span>
        </button> : <></>}
        <button type="button" look={navButtonLook} title="设置" on:click={openSettings} data-open-menu-settings>
            <Icon name={IconName.gear} />
            <span look={navLabelLook}>设置</span>
        </button>
        <button type="button" look={navButtonLook} title="帮助">
            <Icon name={IconName.circleQuestion} />
            <span look={navLabelLook}>帮助</span>
        </button>
    </nav>
    <dialog ref={dialog} look={settingsDialogLook} aria-labelledby="game-settings-title" on:cancel.prevent={closeSettings} data-settings-dialog>
        <GameSettingsPanel settings={preferences} close={closeSettings} />
    </dialog></>
