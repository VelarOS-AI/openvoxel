import {Icon, IconName} from "../icon.vel"
import {captureLink, navigate} from "../navigation/app-navigation.vel"
import {brandIconLook, brandLook, brandNameLook, navButtonLook, navLabelLook, navLook} from "../styles/shell.vel"

export component Brand(back: bool = false):
    def home(): navigate("/")

    def followHome(event: Event):
        if captureLink(event): home()

    return <div look={brandLook}>
        {back ? <button type="button" look={navButtonLook} on:click={home} aria-label="Back to worlds" data-back-home>
            <Icon name={IconName.chevronLeft} />
        </button> : <></>}
        <a href="/" look={brandLook} on:click={followHome}>
            <Icon name={IconName.cube} look={brandIconLook} />
            <span look={brandNameLook}>OpenVoxel</span>
        </a>
    </div>

export component Navigation(showCreate: bool = true):
    def create(): navigate("/worlds/new")

    return <nav look={navLook} aria-label="Application">
        {showCreate ? <button type="button" look={navButtonLook} on:click={create} data-new-world>
            <Icon name={IconName.squarePlus} />
            <span look={navLabelLook}>New world</span>
        </button> : <></>}
        <button type="button" look={navButtonLook} title="Settings">
            <Icon name={IconName.gear} />
            <span look={navLabelLook}>Settings</span>
        </button>
        <button type="button" look={navButtonLook} title="Help">
            <Icon name={IconName.circleQuestion} />
            <span look={navLabelLook}>Help</span>
        </button>
    </nav>
