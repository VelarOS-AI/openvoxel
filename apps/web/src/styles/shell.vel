import {Look, alpha, border, dropShadow, linearGradient, rgba, spacing, transition} from "velar/look"
import {brightBlue, ink, white} from "./theme.vel"

export const appShellLook: Look = look:
    position = "fixed"
    inset = 0px
    minWidth = 320px
    minHeight = 560px
    overflow = "hidden"
    color = white
    backgroundColor = ink
    fontFamily = "Inter, ui-sans-serif, system-ui, sans-serif"
    colorScheme = "dark"

export const backgroundImageLook: Look = look:
    position = "absolute"
    inset = 0px
    width = 100%
    height = 100%
    objectFit = "cover"
    objectPosition = "center"
    scale = 1.01
    transition = transition("opacity", 240ms, "ease-out")

export const backgroundShadeLook: Look = look:
    position = "absolute"
    inset = 0px
    zIndex = 1
    pointerEvents = "none"
    backgroundColor = alpha(ink, 0.14)
    backgroundImage = linearGradient(90deg, alpha(ink, 0.78), alpha(ink, 0.02))

export const backgroundBottomShadeLook: Look = look:
    position = "absolute"
    inset = 0px
    zIndex = 2
    pointerEvents = "none"
    backgroundImage = linearGradient(180deg, alpha(ink, 0.02), alpha(ink, 0.7))

export const topBarLook: Look = look:
    position = "relative"
    zIndex = 7
    display = "flex"
    alignItems = "center"
    justifyContent = "space-between"
    gap = 24px
    padding = spacing(30px, 42px)

    if viewport.width <= 720px:
        padding = spacing(22px, 20px)

export const brandLook: Look = look:
    display = "inline-flex"
    alignItems = "center"
    gap = 13px
    color = white
    textDecoration = "none"

export const brandIconLook: Look = look:
    width = 40px
    textAlign = "center"
    fontSize = 2rem
    filter = dropShadow(0px, 3px, 10px, rgba(0, 0, 0, 0.3))

export const brandNameLook: Look = look:
    fontFamily = "Rajdhani, Inter, sans-serif"
    fontSize = 1.48rem
    fontWeight = 700
    letterSpacing = 0.02em

export const navLook: Look = look:
    display = "flex"
    alignItems = "center"
    gap = 10px

export const navButtonLook: Look = look:
    display = "inline-flex"
    alignItems = "center"
    gap = 10px
    minHeight = 42px
    padding = spacing(9px, 13px)
    color = white
    backgroundColor = "transparent"
    border = border(1px, alpha(white, 0))
    borderRadius = 12px
    fontFamily = "Inter, sans-serif"
    fontSize = 0.95rem
    fontWeight = 500
    textDecoration = "none"
    cursor = "pointer"
    transition = transition("background-color", 160ms, "ease-out")

    if @hover:
        backgroundColor = alpha(white, 0.1)
        borderColor = alpha(white, 0.12)
    if @focus:
        outline = border(2px, alpha(brightBlue, 0.86))
        outlineOffset = 2px

    if viewport.width <= 640px:
        padding = spacing(9px, 10px)

export const navLabelLook: Look = look:
    display = "inline"

    if viewport.width <= 560px:
        display = "none"
