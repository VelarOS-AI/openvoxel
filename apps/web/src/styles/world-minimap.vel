import {Look} from "velar/look"

export const minimapLook: Look = look:
    position = "absolute"
    right = 22px
    top = 22px
    zIndex = 2
    width = 208px
    height = 208px
    borderRadius = 50%
    pointerEvents = "none"

    if viewport.width <= 600px:
        width = 136px
        height = 136px
        right = 12px
        top = 12px

export const minimapCanvasLook: Look = look:
    display = "block"
    width = 100%
    height = 100%
