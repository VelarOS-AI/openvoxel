import {glassPanelLook} from "./common.vel"
import {Look, alpha, blur, border, shadow} from "velar/look"
import {ink, panel, white} from "./theme.vel"

export const openPanelLook: Look = look:
    ...glassPanelLook
    position = "absolute"
    zIndex = 5
    inset = 0px
    margin = "auto"
    height = "fit-content"
    maxHeight = 88vh
    overflowY = "auto"
    boxSizing = "border-box"
    width = 420px
    maxWidth = 88vw
    display = "grid"
    gap = 18px
    padding = 30px

export const panelTitleLook: Look = look:
    margin = 0
    fontFamily = "Rajdhani, Inter, sans-serif"
    fontSize = 2.2rem
    fontWeight = 700
    lineHeight = 1
