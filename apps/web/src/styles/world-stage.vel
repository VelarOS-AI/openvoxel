import {glassPanelLook} from "./common.vel"
import {Look, alpha, blur, border, rgb, shadow, spacing} from "velar/look"
import {ink, panel, white} from "./theme.vel"

const hudAccent = rgb(242, 193, 116)

export const worldStageLook: Look = look:
    position = "fixed"
    inset = 0px
    overflow = "hidden"
    color = white
    backgroundColor = ink
    fontFamily = "Inter, sans-serif"

export const gameCanvasLook: Look = look:
    display = "block"
    width = 100%
    height = 100%
    cursor = "grab"
    touchAction = "none"

    if @active:
        cursor = "grabbing"

export const worldChromeLook: Look = look:
    position = "absolute"
    zIndex = 4
    top = 16px
    right = 16px

    if viewport.width <= 640px:
        top = 8px
        right = 8px

export const worldBackButtonLook: Look = look:
    display = "grid"
    placeItems = "center"
    width = 42px
    height = 42px
    color = white
    backgroundColor = alpha(ink, 0)
    border = border(0px, alpha(white, 0))
    borderRadius = 50%
    cursor = "pointer"

    if @hover:
        backgroundColor = alpha(ink, 0.2)
    if @focusVisible:
        outline = border(2px, hudAccent)
        outlineOffset = 2px

export const creativeAimLook: Look = look:
    position = "absolute"
    inset = 0px
    zIndex = 2
    display = "grid"
    placeItems = "center"
    pointerEvents = "none"

export const creativeAimIdleLook: Look = look:
    color = alpha(white, 0.84)
    fontFamily = "Rajdhani, Inter, sans-serif"
    fontSize = 1.65rem
    fontWeight = 600
    textShadow = shadow(0px, 1px, 3px, ink)

export const creativeAimActiveLook: Look = look:
    color = hudAccent
    fontFamily = "Rajdhani, Inter, sans-serif"
    fontSize = 1.65rem
    fontWeight = 700
    textShadow = shadow(0px, 1px, 5px, ink)

export const creativeHudLook: Look = look:
    position = "absolute"
    left = 0px
    right = 0px
    bottom = 12px
    zIndex = 4
    display = "grid"
    justifyItems = "center"
    pointerEvents = "none"

export const creativeToolbarLook: Look = look:
    display = "flex"
    gap = 0px
    padding = 0px
    backgroundColor = alpha(ink, 0.8)
    border = border(1px, alpha(white, 0.24))
    borderRadius = 0px
    pointerEvents = "auto"

export const creativeSlotLook: Look = look:
    display = "block"
    width = 58px
    height = 58px
    padding = 3px
    position = "relative"
    boxSizing = "border-box"
    overflow = "hidden"
    border = border(1px, alpha(white, 0.12))
    borderRadius = 0px
    backgroundColor = alpha(white, 0.04)
    cursor = "pointer"
    if @hover:
        backgroundColor = alpha(white, 0.12)
    if @focusVisible:
        outline = border(2px, white)
    if viewport.width <= 560px:
        width = 38px
        height = 38px
    if viewport.width <= 360px:
        width = 34px
        height = 34px

export const creativeSelectedSlotLook: Look = look:
    ...creativeSlotLook
    borderColor = rgb(255, 255, 255)
    backgroundColor = alpha(white, 0.08)
    outline = border(2px, rgb(255, 255, 255))
    outlineOffset = -2px

export const creativeEditErrorLook: Look = look:
    margin = 0px
    paddingBottom = 8px
    color = rgb(255, 204, 204)
    textShadow = shadow(0px, 1px, 4px, ink)
    fontSize = 0.82rem

export const loadingLook: Look = look:
    position = "absolute"
    inset = 0px
    zIndex = 3
    display = "grid"
    placeItems = "center"
    color = alpha(white, 0.84)
    backgroundColor = alpha(ink, 0.7)
    fontSize = 1rem

export const worldExitDialogLook: Look = look:
    ...glassPanelLook
    width = 90%
    maxWidth = 460px
    padding = 0px
    fontFamily = "Inter, sans-serif"

    @backdrop:
        backgroundColor = alpha(ink, 0.76)
        backdropFilter = blur(8px)

export const worldExitBodyLook: Look = look:
    display = "grid"
    gap = 16px
    padding = spacing(26px, 28px, 24px, 28px)

export const worldExitTitleLook: Look = look:
    margin = 0px
    fontFamily = "Rajdhani, Inter, sans-serif"
    fontSize = 1.8rem
    lineHeight = 1.1

export const worldExitDescriptionLook: Look = look:
    margin = 0px
    color = alpha(white, 0.72)
    lineHeight = 1.55

export const worldExitActionsLook: Look = look:
    display = "flex"
    alignItems = "center"
    justifyContent = "flex-end"
    flexWrap = "wrap"
    gap = 10px
    paddingTop = 4px

    if viewport.width <= 520px:
        display = "grid"

export const screenReaderLook: Look = look:
    position = "absolute"
    width = 1px
    height = 1px
    padding = 0px
    margin = -1px
    overflow = "hidden"
    clipPath = "inset(50%)"
    whiteSpace = "nowrap"

export const frameRateLook: Look = look:
    position = "absolute"
    top = 22px
    right = 70px
    zIndex = 3
    color = white
    fontFamily = "monospace"
    fontSize = 0.8rem
    lineHeight = 30px
    textShadow = shadow(0px, 1px, 3px, ink)
    pointerEvents = "none"
    if viewport.width <= 640px:
        top = 14px
        right = 58px

export const frameTimeLook: Look = look:
    if viewport.width <= 640px:
        display = "none"
