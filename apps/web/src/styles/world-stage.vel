import {Look, alpha, blur, border, shadow, spacing} from "velar/look"
import {ink, panel, white} from "./theme.vel"

export const worldStageLook: Look = look:
    position = "fixed"
    inset = 0px
    overflow = "hidden"
    color = white
    backgroundColor = ink
    fontFamily = "Inter, sans-serif"

export const gameCanvasLook: Look = look:
    display = "block"
    width = 100%
    height = 100%
    cursor = "grab"
    touchAction = "none"

    if @active:
        cursor = "grabbing"

export const worldChromeLook: Look = look:
    position = "absolute"
    zIndex = 4
    top = 26px
    left = 28px
    display = "flex"
    alignItems = "center"
    gap = 12px

export const loadingLook: Look = look:
    position = "absolute"
    inset = 0px
    zIndex = 3
    display = "grid"
    placeItems = "center"
    color = alpha(white, 0.84)
    backgroundColor = alpha(ink, 0.7)
    fontSize = 1rem

export const worldExitDialogLook: Look = look:
    width = 90%
    maxWidth = 460px
    padding = 0px
    color = white
    backgroundColor = alpha(panel, 0.98)
    border = border(1px, alpha(white, 0.18))
    borderRadius = 18px
    boxShadow = shadow(0px, 24px, 72px, alpha(ink, 0.76))
    fontFamily = "Inter, sans-serif"

    @backdrop:
        backgroundColor = alpha(ink, 0.76)
        backdropFilter = blur(8px)

export const worldExitBodyLook: Look = look:
    display = "grid"
    gap = 16px
    padding = spacing(26px, 28px, 24px, 28px)

export const worldExitTitleLook: Look = look:
    margin = 0px
    fontFamily = "Rajdhani, Inter, sans-serif"
    fontSize = 1.8rem
    lineHeight = 1.1

export const worldExitDescriptionLook: Look = look:
    margin = 0px
    color = alpha(white, 0.7)
    lineHeight = 1.55

export const worldExitActionsLook: Look = look:
    display = "flex"
    alignItems = "center"
    justifyContent = "flex-end"
    flexWrap = "wrap"
    gap = 10px
    paddingTop = 4px

    if viewport.width <= 520px:
        display = "grid"

export const screenReaderLook: Look = look:
    position = "absolute"
    width = 1px
    height = 1px
    padding = 0px
    margin = -1px
    overflow = "hidden"
    clipPath = "inset(50%)"
    whiteSpace = "nowrap"
