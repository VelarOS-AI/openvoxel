import {Look, alpha} from "velar/look"
import {ink, white} from "./theme.vel"

export const worldStageLook: Look = look:
    position = "fixed"
    inset = 0px
    overflow = "hidden"
    color = white
    backgroundColor = ink
    fontFamily = "Inter, sans-serif"

export const gameCanvasLook: Look = look:
    display = "block"
    width = 100%
    height = 100%
    cursor = "grab"
    touchAction = "none"

    if @active:
        cursor = "grabbing"

export const worldChromeLook: Look = look:
    position = "absolute"
    zIndex = 4
    top = 26px
    left = 28px
    display = "flex"
    alignItems = "center"
    gap = 12px

export const loadingLook: Look = look:
    position = "absolute"
    inset = 0px
    zIndex = 3
    display = "grid"
    placeItems = "center"
    color = alpha(white, 0.84)
    backgroundColor = alpha(ink, 0.7)
    fontSize = 1rem

export const screenReaderLook: Look = look:
    position = "absolute"
    width = 1px
    height = 1px
    padding = 0px
    margin = -1px
    overflow = "hidden"
    clipPath = "inset(50%)"
    whiteSpace = "nowrap"
