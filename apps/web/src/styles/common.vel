import {Look, alpha, blur, border, brightness, linearGradient, shadow, spacing, transition} from "velar/look"
import {accent, accentStrong, danger, ink, panel, white} from "./theme.vel"

export const worldInfoLook: Look = look:
    display = "grid"
    gap = 10px

export const displayTitleLook: Look = look:
    margin = 0
    maxWidth = 760px
    fontFamily = "Rajdhani, Inter, sans-serif"
    fontSize = 4.4rem
    fontWeight = 700
    lineHeight = 0.95
    letterSpacing = 0.01em
    textShadow = shadow(0px, 6px, 24px, alpha(ink, 0.64))

    if viewport.width <= 720px:
        fontSize = 3.2rem

export const subtitleLook: Look = look:
    margin = 0
    maxWidth = 560px
    color = alpha(white, 0.72)
    fontSize = 1rem
    lineHeight = 1.6
    textShadow = shadow(0px, 3px, 14px, alpha(ink, 0.6))

export const primaryButtonLook: Look = look:
    display = "inline-flex"
    alignItems = "center"
    justifyContent = "center"
    gap = 11px
    minWidth = 190px
    minHeight = 52px
    padding = spacing(12px, 24px)
    color = white
    backgroundImage = linearGradient(135deg, accentStrong, accent)
    border = border(1px, alpha(white, 0.28))
    borderRadius = 13px
    boxShadow = shadow(0px, 5px, 14px, alpha(ink, 0.18))
    fontFamily = "Inter, sans-serif"
    fontSize = 1rem
    fontWeight = 600
    textDecoration = "none"
    cursor = "pointer"
    transition = transition("filter", 160ms, "ease-out")

    if @hover:
        filter = brightness(1.09)
    if @focusVisible:
        outline = border(2px, white)
        outlineOffset = 3px
    if @disabled:
        opacity = 0.58
        cursor = "wait"

export const secondaryButtonLook: Look = look:
    display = "inline-flex"
    alignItems = "center"
    justifyContent = "center"
    gap = 10px
    minHeight = 46px
    padding = spacing(10px, 14px)
    color = "inherit"
    backgroundColor = "transparent"
    border = border(1px, alpha(white, 0))
    borderRadius = 11px
    fontFamily = "Inter, sans-serif"
    fontSize = 0.95rem
    fontWeight = 500
    textDecoration = "none"
    cursor = "pointer"

    if @hover:
        color = "inherit"
        backgroundColor = alpha(accent, 0.12)
    if @focusVisible:
        outline = border(2px, accentStrong)
        outlineOffset = 2px

export const labelLook: Look = look:
    display = "grid"
    gap = 8px
    color = white
    fontSize = 0.84rem
    fontWeight = 500

export const fieldLook: Look = look:
    width = 100%
    minWidth = 0
    boxSizing = "border-box"
    padding = spacing(12px, 14px)
    color = white
    backgroundColor = alpha(ink, 0.22)
    border = border(1px, alpha(white, 0.18))
    borderRadius = 11px
    fontFamily = "Inter, sans-serif"
    fontSize = 0.98rem

    if @focusVisible:
        borderColor = accentStrong
        outline = border(2px, alpha(accentStrong, 0.28))
        outlineOffset = 1px

export const formActionsLook: Look = look:
    display = "flex"
    alignItems = "center"
    gap = 14px
    paddingTop = 4px

export const errorLook: Look = look:
    margin = 0
    padding = spacing(11px, 13px)
    color = danger
    backgroundColor = alpha(danger, 0.12)
    border = border(1px, alpha(danger, 0.4))
    borderRadius = 10px
    fontSize = 0.88rem

export const panelSubtitleLook: Look = look:
    ...subtitleLook
    color = alpha(white, 0.72)
    textShadow = "none"

export const glassPanelLook: Look = look:
    color = white
    backgroundColor = panel
    border = border(1px, alpha(white, 0.16))
    borderRadius = 18px
    backdropFilter = blur(18px)
    boxShadow = shadow(0px, 18px, 56px, alpha(ink, 0.3))
