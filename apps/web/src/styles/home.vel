import {Look, alpha, blur, border, rgb, shadow, spacing, transition} from "velar/look"
import {secondaryButtonLook, glassPanelLook} from "./common.vel"
import {accentStrong, ink, muted, panel, white} from "./theme.vel"

const carouselArrowLook: Look = look:
    position = "absolute"
    top = 0px
    bottom = 0px
    margin = "auto"
    zIndex = 6
    display = "grid"
    placeItems = "center"
    width = 62px
    height = 82px
    color = white
    backgroundColor = "transparent"
    border = "none"
    borderRadius = 18px
    fontSize = 1.65rem
    cursor = "pointer"
    transition = transition("opacity", 160ms, "ease-out")

    if @hover:
        opacity = 0.7
    if @focusVisible:
        outline = border(2px, accentStrong)
        outlineOffset = 3px
    if @disabled:
        opacity = 0.34
        cursor = "default"

    if viewport.width <= 640px:
        width = 48px
        height = 64px
        borderRadius = 14px

export const previousArrowLook: Look = look:
    ...carouselArrowLook
    left = 36px

    if viewport.width <= 640px:
        left = 16px

export const nextArrowLook: Look = look:
    ...carouselArrowLook
    right = 36px

    if viewport.width <= 640px:
        right = 16px

export const homeContentLook: Look = look:
    position = "absolute"
    zIndex = 5
    left = 5.4vw
    right = 5.4vw
    bottom = 5.6vh
    display = "grid"
    gap = 18px

    if viewport.width <= 720px:
        left = 24px
        right = 24px
        bottom = 28px
        gap = 14px

export const metadataLook: Look = look:
    display = "flex"
    flexWrap = "wrap"
    gap = 18px
    color = muted

export const metadataItemLook: Look = look:
    display = "inline-flex"
    alignItems = "center"
    gap = 8px
    fontSize = 0.92rem

export const actionRowLook: Look = look:
    display = "flex"
    alignItems = "center"
    justifyContent = "space-between"
    gap = 16px
    flexWrap = "wrap"
    width = 100%
    paddingTop = 18px
    borderTop = border(1px, alpha(white, 0.18))

export const actionGroupLook: Look = look:
    display = "flex"
    alignItems = "center"
    gap = 14px
    flexWrap = "wrap"

export const emptyActionsLook: Look = look:
    ...actionGroupLook

    if viewport.width <= 520px:
        alignItems = "stretch"
        flexDirection = "column"
        maxWidth = 230px

export const emptyContentLook: Look = look:
    position = "absolute"
    zIndex = 5
    left = 5.4vw
    bottom = 10vh
    display = "grid"
    gap = 18px
    maxWidth = 650px

    if viewport.width <= 720px:
        left = 24px
        right = 24px
        bottom = 42px

export const settingsPanelLook: Look = look:
    ...glassPanelLook
    position = "absolute"
    zIndex = 8
    right = 5.4vw
    bottom = 12vh
    display = "grid"
    gap = 14px
    width = 320px
    maxWidth = 90vw
    boxSizing = "border-box"
    padding = 22px

export const settingsRowLook: Look = look:
    display = "grid"
    gap = 4px
    paddingBottom = 10px
    borderBottom = border(1px, alpha(white, 0.12))

export const settingsValueLook: Look = look:
    color = alpha(white, 0.68)
    fontSize = 0.86rem
    overflowWrap = "anywhere"

export const deleteButtonLook: Look = look:
    ...secondaryButtonLook
    color = rgb(255, 187, 175)

export const deleteDialogLook: Look = look:
    ...glassPanelLook
    position = "fixed"
    inset = 0px
    margin = "auto"
    width = 440px
    maxWidth = 90vw
    boxSizing = "border-box"
    padding = 28px
    fontFamily = "Inter, sans-serif"
    @backdrop:
        backgroundColor = alpha(ink, 0.48)

export const deleteTitleLook: Look = look:
    margin = spacing(0px, 0px, 14px, 0px)
    fontSize = 1.25rem
    overflowWrap = "anywhere"

export const deleteDescriptionLook: Look = look:
    margin = spacing(0px, 0px, 24px, 0px)
    color = alpha(white, 0.72)
    lineHeight = 1.6

export const deleteActionsLook: Look = look:
    display = "flex"
    justifyContent = "flex-end"
    gap = 10px

export const deleteCancelLook: Look = look:
    ...secondaryButtonLook
    color = white
    border = border(1px, alpha(white, 0.18))
    if @hover:
        backgroundColor = alpha(white, 0.12)
        color = white

export const deleteConfirmLook: Look = look:
    ...deleteCancelLook
    backgroundColor = rgb(168, 54, 47)
    borderColor = "transparent"
    color = white
    if @hover:
        backgroundColor = rgb(146, 42, 36)
        color = white
    if @disabled:
        opacity = 0.6
        cursor = "wait"
