import {Color, Look, alpha, border, color, minmax, repeat, rgb, spacing, tracks} from "velar/look"

const ink: Color = rgb(226, 232, 240)
const paper: Color = rgb(8, 15, 28)
const panel: Color = rgb(15, 26, 45)
const accent: Color = rgb(72, 209, 152)
const danger: Color = rgb(251, 113, 133)

export const shellLook: Look = look:
    minHeight = 100vh
    padding = spacing(32px, 18px, 64px, 18px)
    color = ink
    background = paper
    fontFamily = "Inter, ui-sans-serif, system-ui, sans-serif"

export const pageLook: Look = look:
    display = "grid"
    gap = 20px
    width = 100%
    maxWidth = 980px
    marginInline = "auto"

export const heroLook: Look = look:
    display = "grid"
    gap = 6px

export const titleLook: Look = look:
    margin = 0
    fontSize = 2rem

export const mutedLook: Look = look:
    margin = 0
    color = alpha(ink, 0.68)

export const cardLook: Look = look:
    display = "grid"
    gap = 16px
    padding = 20px
    background = panel
    border = border(1px, alpha(ink, 0.14))
    borderRadius = 14px

export const formLook: Look = look:
    display = "grid"
    gridTemplateColumns = repeat(3, minmax(0px, 1fr))
    gap = 12px

    if viewport.width <= 720px:
        gridTemplateColumns = tracks(1fr)

export const labelLook: Look = look:
    display = "grid"
    gap = 6px
    color = alpha(ink, 0.74)
    fontSize = 0.82rem

export const fieldLook: Look = look:
    minWidth = 0
    padding = spacing(10px, 12px)
    color = ink
    background = alpha(paper, 0.48)
    border = border(1px, alpha(ink, 0.2))
    borderRadius = 9px

    if @focus:
        borderColor = accent

export const actionsLook: Look = look:
    display = "flex"
    flexWrap = "wrap"
    gap = 10px

export const controlLook: Look = look:
    padding = spacing(9px, 13px)
    color = ink
    background = "transparent"
    border = border(1px, alpha(ink, 0.25))
    borderRadius = 9px
    cursor = "pointer"

    if @hover:
        borderColor = accent
    if @disabled:
        opacity = 0.45
        cursor = "not-allowed"

export const primaryControlLook: Look = look:
    ...controlLook
    color = paper
    background = accent
    borderColor = accent
    fontWeight = 700

export const diagnosticsLook: Look = look:
    display = "grid"
    gridTemplateColumns = repeat(3, minmax(0px, 1fr))
    gap = 10px

    if viewport.width <= 640px:
        gridTemplateColumns = tracks(1fr)

export const metricLook: Look = look:
    display = "grid"
    gap = 4px
    padding = 14px
    background = alpha(paper, 0.38)
    borderRadius = 10px

export const valueLook: Look = look:
    fontFamily = "ui-monospace, SFMono-Regular, Menlo, monospace"
    fontSize = 0.92rem
    overflowWrap = "anywhere"

export const errorLook: Look = look:
    margin = 0
    padding = 12px
    color = danger
    background = alpha(danger, 0.1)
    border = border(1px, alpha(danger, 0.5))
    borderRadius = 9px
