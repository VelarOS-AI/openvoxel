import {HttpMethod} from "@openvoxel/backend"
import {Bytes} from "velar/binary"
import {http} from "velar/http"
import {encode, parse} from "velar/msgpack"
import {expect} from "velar/test"
import {connect} from "velar/websocket"
import {createOpenVoxelServer} from "./server.vel"
import {backendOptions, loadOpenVoxelConfiguration} from "./config.vel"
import {WorldManifest, stoneBlock} from "@openvoxel/domain"
import {ApiResponse, BlockCatalogResponse, BlockChangedEvent, ChunkBatchResponse, ChunkResponse, GenerationSampleResponse} from "@openvoxel/protocol"
import {WorldRuntime, memoryWorldStore} from "@openvoxel/world-runtime"

type HealthResponse:
    status: string
    service: string
    protocolVersion: number

type RouteFailureData:
    method: string
    path: string

type WorldFailureData:
    worldId: string

test "Fastify modules and MessagePack realtime complete the backend vertical slice":
    const runtime = WorldRuntime(memoryWorldStore())
    const configuration = await loadOpenVoxelConfiguration("config/server.yml")
    const server = await createOpenVoxelServer(runtime, backendOptions(configuration, logger=false))

    const healthResponse = await server.inject(HttpMethod.get, "/api/health", null)
    expect(healthResponse.status).toBe(200)
    const healthEnvelope = ApiResponse.parse(healthResponse.json)
    expect(healthEnvelope.code).toBe("OK")
    const health = HealthResponse.parse(healthEnvelope.data)
    expect(health.status).toBe("ready")
    expect(health.protocolVersion).toBe(1)

    const worldResponse = await server.inject(HttpMethod.post, "/api/worlds", {
        id: "transport",
        name: "Transport",
        seed: "transport-seed",
    })
    expect(worldResponse.status).toBe(201)
    const worldEnvelope = ApiResponse.parse(worldResponse.json)
    expect(worldEnvelope.code).toBe("CREATED")
    const world = WorldManifest.parse(worldEnvelope.data)
    expect(world.chunkEdge).toBe(16)
    expect(world.generator).toBe("openvoxel:survival-v1")

    const duplicateResponse = await server.inject(HttpMethod.post, "/api/worlds", {
        id: "transport",
        name: "Transport",
        seed: "transport-seed",
    })
    expect(duplicateResponse.status).toBe(409)
    const duplicate = ApiResponse.parse(duplicateResponse.json)
    expect(duplicate.code).toBe("WorldAlreadyExistsError")
    expect(WorldFailureData.parse(duplicate.data).worldId).toBe(world.id)

    const catalogResponse = await server.inject(HttpMethod.get, "/api/blocks", null)
    const catalog = BlockCatalogResponse.parse(ApiResponse.parse(catalogResponse.json).data)
    expect(catalog.schemaVersion).toBe(1)
    expect(catalog.catalogVersion).toBe("openvoxel:base-v1")
    expect(catalog.contentHash.size).toBe(64)
    expect(catalog.blocks.size).toBe(38)
    expect(catalog.seaLevel).toBe(64)

    const sampleResponse = await server.inject(HttpMethod.post, "/api/generation/sample", {
        worldId: world.id,
        position: {x: 0, z: 0},
    })
    const sample = GenerationSampleResponse.parse(ApiResponse.parse(sampleResponse.json).data)
    expect(sample.position).toEqual({x: 0, z: 0})
    expect(sample.surfaceY).toBe(66)
    expect(sample.biome).toBe("plains")

    const beforeResponse = await server.inject(HttpMethod.post, "/api/chunks/query", {
        worldId: world.id,
        position: {x: 0, y: 1, z: 0},
    })
    const before = ChunkResponse.parse(ApiResponse.parse(beforeResponse.json).data)
    expect(before.blocks.size).toBe(4096)

    const batchResponse = await server.inject(HttpMethod.post, "/api/chunks/batch", {
        worldId: world.id,
        positions: [{x: 0, y: 3, z: 0}, {x: 0, y: 4, z: 0}],
    })
    const batch = ChunkBatchResponse.parse(ApiResponse.parse(batchResponse.json).data)
    expect(batch.chunks.size).toBe(2)
    expect(batch.chunks[0].position.y).toBe(3)
    expect(batch.chunks[1].position.y).toBe(4)

    const missing = await server.inject(HttpMethod.get, "/api/missing", null)
    expect(missing.status).toBe(404)
    const missingEnvelope = ApiResponse.parse(missing.json)
    expect(missingEnvelope.code).toBe("RouteNotFound")
    expect(RouteFailureData.parse(missingEnvelope.data).path).toBe("/api/missing")

    const address = await server.listen("127.0.0.1", 0)
    const liveHealthEnvelope = await http.get(f"http://127.0.0.1:{address.port}/api/health").parse(ApiResponse)
    const liveHealth = HealthResponse.parse(liveHealthEnvelope.data)
    expect(liveHealth.status).toBe("ready")

    using client = await connect(f"ws://127.0.0.1:{address.port}/api/events")
    using observer = await connect(f"ws://127.0.0.1:{address.port}/api/events")
    await client.send(encode({
        operation: "set-block",
        worldId: world.id,
        position: {x: 0, y: 30, z: 0},
        blockId: stoneBlock,
    }))
    const message = await client.next()
    if not (message is Bytes):
        throw Error("Expected a binary block change event")
    const event = parse(message, BlockChangedEvent)
    expect(event.event).toBe("block.changed")
    expect(event.position).toEqual({x: 0, y: 30, z: 0})
    expect(event.blockId).toBe(stoneBlock)
    expect(event.revision).toBe(1)

    const observedMessage = await observer.next()
    if not (observedMessage is Bytes):
        throw Error("Expected the second client to receive the block change")
    const observed = parse(observedMessage, BlockChangedEvent)
    expect(observed.worldId).toBe(world.id)
    expect(observed.revision).toBe(event.revision)

    const afterResponse = await server.inject(HttpMethod.post, "/api/chunks/query", {
        worldId: world.id,
        position: {x: 0, y: 1, z: 0},
    })
    const after = ChunkResponse.parse(ApiResponse.parse(afterResponse.json).data)
    expect(after.revision).toBe(1)
    expect(after.blocks[3584]).toBe(stoneBlock)
    await client.close()
    await observer.close()
    await server.close()
    await runtime.close()
