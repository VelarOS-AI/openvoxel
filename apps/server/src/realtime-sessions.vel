import {Cancellation, Task, task} from "velar/task"
import {WebSocketConnection} from "velar/websocket"

export type RealtimeHandler = (connection: WebSocketConnection) -> Promise<null>

export type RealtimeSessions:
    start: (connection: WebSocketConnection, handler: RealtimeHandler) -> bool
    drain: () -> Promise<null>

/// Owns every detached realtime handler as a structured Task. New work is
/// rejected once draining starts, and shutdown joins the exact admitted set
/// without polling process state.
export def realtimeSessions(maximum: number) -> RealtimeSessions:
    assert maximum.isInteger() and maximum >= 1 else "Realtime session capacity must be a positive integer"
    const owners: Map<number, Task<null>> = Map()
    let nextId = 1
    let draining = false

    async def run(_cancellation: Cancellation, id: number, connection: WebSocketConnection, handler: RealtimeHandler):
        try:
            await handler(connection)
        finally:
            owners.remove(id)

    def start(connection: WebSocketConnection, handler: RealtimeHandler) -> bool:
        if draining or owners.size >= maximum:
            return false
        const id = nextId
        nextId += 1
        if nextId > 9007199254740991:
            nextId = 1
        assert not owners.has(id) else "Realtime session identifier space is exhausted"
        async def work(cancellation: Cancellation):
            await run(cancellation, id, connection, handler)

        const owner = task(work)
        owners.set(id, owner)
        return true

    async def drain():
        draining = true
        const pending: List<Promise<null>> = []
        for owner in owners.values():
            pending.append(owner.result())
        await Promise.all(pending)

    return {start, drain}
