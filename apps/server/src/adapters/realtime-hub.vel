import {Bytes} from "velar/binary"
import {encode} from "@velarscript-labs/msgpack"
import {WebSocketConnection} from "velar/websocket"
import {BlockChangedEvent} from "@openvoxel/protocol"
import {BlockChange} from "@openvoxel/world-runtime"

export type RealtimeHub:
    join: (connection: WebSocketConnection) -> null
    leave: (connection: WebSocketConnection) -> null
    publishChange: (change: BlockChange) -> Promise<null>

export def realtimeHub(warning: (message: string, context: unknown) -> null) -> RealtimeHub:
    const connections: Set<WebSocketConnection> = Set()

    def join(connection: WebSocketConnection): connections.add(connection)

    def leave(connection: WebSocketConnection): connections.remove(connection)

    async def publishChange(change: BlockChange):
        const event: BlockChangedEvent = {
            event: "block.changed",
            worldId: change.worldId,
            position: change.position,
            previousBlockId: change.previousBlockId,
            blockId: change.blockId,
            revision: change.revision,
        }
        const message: Bytes = encode(event)
        const failed: List<WebSocketConnection> = []
        for connection in connections.copy():
            try: await connection.send(message)
            catch error:
                failed.append(connection)
                warning("realtime.subscriber.failed", {code: error.code, message: error.message})
        for connection in failed: connections.remove(connection)

    return {join, leave, publishChange}
