import {DatabaseCommand, DatabaseExecutor, DatabaseQuery, all, command, execute, one, query, requireOne, sqlConcat, trustedSql} from "@velarscript-labs/database"
import {SqlPredicate, deleteCommand, insertCommand, insertStatement, selectQuery, sqlAnd, sqlAscending, sqlColumn, sqlColumnEqual, sqlEqual, sqlLeftJoin, sqlNamedField, sqlSet, sqlTable, sqlTupleIn, updateCommand} from "@velarscript-labs/sql"
import {SqliteConnection, SqliteJournalMode, SqliteTransaction, openSqlite, sqliteLiteral} from "@velarscript-labs/sqlite"
import {WorldBlockRegistrySnapshot, requireBlockStateRuntimeId} from "@openvoxel/blocks"
import {ChunkPosition, LocalPosition, WorldManifest, chunkKey, validateWorldManifest} from "@openvoxel/domain"
import {BlockOverride, BlockOverrideCommit, ChunkDelta, WorldStore} from "@openvoxel/world-runtime"

type WorldRow:
    id: string
    name: string
    seed: string
    formatVersion: number
    chunkEdge: number
    generator: string
    blockRegistryJson: string

type DatabaseVersionRow:
    user_version: number

type ChunkDeltaRow:
    chunkX: number
    chunkY: number
    chunkZ: number
    revision: number
    localX: number?
    localY: number?
    localZ: number?
    blockStateRuntimeId: number?

type ChunkStateRow:
    revision: number

type OverrideRow:
    blockStateRuntimeId: number

export type SqliteWorldStoreOptions:
    path: string
    busyTimeoutMilliseconds: number
    queueCapacity: number
    maxRows: number
    maxResultBytes: number

export const sqliteSchemaVersion = 3
const worldsTable = sqlTable("worlds")
const chunkStatesTable = sqlTable("chunk_states")
const blockOverridesTable = sqlTable("block_overrides")

// These remain OpenVoxel operations: Labs owns safe composition and binding,
// while this adapter owns schema names, migrations, row shapes, and cardinality.
const readSchemaVersion = query(trustedSql("PRAGMA user_version"), DatabaseVersionRow, maximumRows=1)

def insertWorldOperation(world: WorldManifest) -> DatabaseCommand:
    return insertCommand(
        worldsTable,
        ["id", "name", "seed", "format_version", "chunk_edge", "generator", "block_registry_json"],
        [[world.id, world.name, world.seed, world.formatVersion, world.chunkEdge, world.generator, Json.stableStringify(world.blockRegistry)]],
        minimumAffected = 1,
        maximumAffected = 1,
    )

def findWorldOperation(worldId: string) -> DatabaseQuery<WorldRow>:
    return selectQuery(
        worldsTable,
        [
            sqlNamedField("id"),
            sqlNamedField("name"),
            sqlNamedField("seed"),
            sqlNamedField("format_version", alias="formatVersion"),
            sqlNamedField("chunk_edge", alias="chunkEdge"),
            sqlNamedField("generator"),
            sqlNamedField("block_registry_json", alias="blockRegistryJson"),
        ],
        WorldRow,
        where = sqlColumnEqual("id", worldId),
        limit = 1,
        maximumRows = 1,
    )

def updateWorldBlockRegistryOperation(worldId: string, blockRegistry: readonly WorldBlockRegistrySnapshot) -> DatabaseCommand:
    return updateCommand(
        worldsTable,
        [sqlSet("block_registry_json", Json.stableStringify(blockRegistry))],
        sqlColumnEqual("id", worldId),
        minimumAffected = 1,
        maximumAffected = 1,
    )

def chunkPredicate(worldId: string, chunk: ChunkPosition) -> SqlPredicate:
    return sqlAnd([
        sqlColumnEqual("world_id", worldId),
        sqlColumnEqual("chunk_x", chunk.x),
        sqlColumnEqual("chunk_y", chunk.y),
        sqlColumnEqual("chunk_z", chunk.z),
    ])

def overridePredicate(worldId: string, chunk: ChunkPosition, local: LocalPosition) -> SqlPredicate:
    return sqlAnd([
        chunkPredicate(worldId, chunk),
        sqlColumnEqual("local_x", local.x),
        sqlColumnEqual("local_y", local.y),
        sqlColumnEqual("local_z", local.z),
    ])

def findChunkStateOperation(worldId: string, chunk: ChunkPosition) -> DatabaseQuery<ChunkStateRow>:
    return selectQuery(
        chunkStatesTable,
        [sqlNamedField("revision")],
        ChunkStateRow,
        where = chunkPredicate(worldId, chunk),
        limit = 1,
        maximumRows = 1,
    )

def findBlockOverrideOperation(worldId: string, chunk: ChunkPosition, local: LocalPosition) -> DatabaseQuery<OverrideRow>:
    return selectQuery(
        blockOverridesTable,
        [sqlNamedField("block_state_runtime_id", alias="blockStateRuntimeId")],
        OverrideRow,
        where = overridePredicate(worldId, chunk, local),
        limit = 1,
        maximumRows = 1,
    )

def saveChunkStateOperation(worldId: string, chunk: ChunkPosition, revision: number) -> DatabaseCommand:
    return command(sqlConcat([
        insertStatement(
            chunkStatesTable,
            ["world_id", "chunk_x", "chunk_y", "chunk_z", "revision"],
            [[worldId, chunk.x, chunk.y, chunk.z, revision]],
        ),
        trustedSql(" ON CONFLICT(world_id, chunk_x, chunk_y, chunk_z) DO UPDATE SET revision = excluded.revision"),
    ]), minimumAffected = 1, maximumAffected = 1)

def removeBlockOverrideOperation(worldId: string, chunk: ChunkPosition, local: LocalPosition) -> DatabaseCommand:
    return deleteCommand(
        blockOverridesTable,
        overridePredicate(worldId, chunk, local),
        maximumAffected = 1,
    )

def saveBlockOverrideOperation(worldId: string, chunk: ChunkPosition, local: LocalPosition, blockStateRuntimeId: number) -> DatabaseCommand:
    return command(sqlConcat([
        insertStatement(
            blockOverridesTable,
            ["world_id", "chunk_x", "chunk_y", "chunk_z", "local_x", "local_y", "local_z", "block_state_runtime_id"],
            [[worldId, chunk.x, chunk.y, chunk.z, local.x, local.y, local.z, blockStateRuntimeId]],
        ),
        trustedSql(" ON CONFLICT(world_id, chunk_x, chunk_y, chunk_z, local_x, local_y, local_z) DO UPDATE SET block_state_runtime_id = excluded.block_state_runtime_id"),
    ]), minimumAffected = 1, maximumAffected = 1)

def validateOptions(options: SqliteWorldStoreOptions) -> SqliteWorldStoreOptions:
    assert not options.path.isBlank() else "SQLite path cannot be blank"
    assert options.busyTimeoutMilliseconds.isInteger() and options.busyTimeoutMilliseconds >= 1 and options.busyTimeoutMilliseconds <= 60000 else "SQLite busy timeout must be an integer from 1 through 60000"
    assert options.queueCapacity.isInteger() and options.queueCapacity >= 1 and options.queueCapacity <= 1024 else "SQLite queue capacity must be an integer from 1 through 1024"
    assert options.maxRows.isInteger() and options.maxRows >= 1 and options.maxRows <= 1000000 else "SQLite row limit must be an integer from 1 through 1000000"
    assert options.maxResultBytes.isInteger() and options.maxResultBytes >= 1 and options.maxResultBytes <= 128 * 1024 * 1024 else "SQLite result byte limit must be an integer from 1 through 134217728"
    return options

async def openDatabase(options: SqliteWorldStoreOptions) -> SqliteConnection:
    return await openSqlite(options.path, {
        busyTimeoutMilliseconds: options.busyTimeoutMilliseconds,
        queueCapacity: options.queueCapacity,
        maxRows: options.maxRows,
        maxResultBytes: options.maxResultBytes,
        journalMode: SqliteJournalMode.wal,
    })

async def migrate(executor: DatabaseExecutor):
    const versionRow = await requireOne(executor, readSchemaVersion, message="SQLite did not return its schema version")
    assert versionRow.user_version == 0 or versionRow.user_version == sqliteSchemaVersion else f"SQLite schema version {versionRow.user_version} does not match required version {sqliteSchemaVersion}"
    await execute(executor, command(
        trustedSql("CREATE TABLE IF NOT EXISTS worlds (id TEXT PRIMARY KEY, name TEXT NOT NULL, seed TEXT NOT NULL, format_version INTEGER NOT NULL, chunk_edge INTEGER NOT NULL, generator TEXT NOT NULL, block_registry_json TEXT NOT NULL)"),
    ))
    await execute(executor, command(sqlConcat([
        trustedSql("PRAGMA user_version = "),
        sqliteLiteral(sqliteSchemaVersion),
    ])))

async def initialize(database: SqliteConnection):
    const executor = database.executor()
    await migrate(executor)
    await execute(executor, command(
        trustedSql("CREATE TABLE IF NOT EXISTS chunk_states (world_id TEXT NOT NULL, chunk_x INTEGER NOT NULL, chunk_y INTEGER NOT NULL, chunk_z INTEGER NOT NULL, revision INTEGER NOT NULL CHECK (revision >= 0), PRIMARY KEY (world_id, chunk_x, chunk_y, chunk_z), FOREIGN KEY (world_id) REFERENCES worlds(id) ON DELETE CASCADE)"),
    ))
    await execute(executor, command(
        trustedSql("CREATE TABLE IF NOT EXISTS block_overrides (world_id TEXT NOT NULL, chunk_x INTEGER NOT NULL, chunk_y INTEGER NOT NULL, chunk_z INTEGER NOT NULL, local_x INTEGER NOT NULL, local_y INTEGER NOT NULL, local_z INTEGER NOT NULL, block_state_runtime_id INTEGER NOT NULL, PRIMARY KEY (world_id, chunk_x, chunk_y, chunk_z, local_x, local_y, local_z), FOREIGN KEY (world_id, chunk_x, chunk_y, chunk_z) REFERENCES chunk_states(world_id, chunk_x, chunk_y, chunk_z) ON DELETE CASCADE)"),
    ))

def sameOverride(left: number?, right: number?) -> bool:
    if left == null: return right == null
    if right == null: return false
    return left == right

export async def sqliteWorldStore(configuration: SqliteWorldStoreOptions) -> WorldStore:
    const options = validateOptions(configuration)
    const database = await openDatabase(options)
    try: await initialize(database)
    catch error:
        await database.close()
        throw error
    const databaseExecutor = database.executor()

    async def saveManifest(manifest: WorldManifest):
        const world = validateWorldManifest(manifest)
        await execute(databaseExecutor, insertWorldOperation(world))

    async def findManifest(worldId: string) -> WorldManifest?:
        const row = await one(databaseExecutor, findWorldOperation(worldId))
        if row == null: return null
        const blockRegistry = WorldBlockRegistrySnapshot.parse(Json.parse(row.blockRegistryJson))
        return validateWorldManifest(WorldManifest.from(row, {blockRegistry}))

    async def updateBlockRegistry(worldId: string, blockRegistry: readonly WorldBlockRegistrySnapshot):
        await execute(databaseExecutor, updateWorldBlockRegistryOperation(worldId, blockRegistry))

    async def findChunks(worldId: string, positions: List<ChunkPosition>) -> List<ChunkDelta>:
        if positions.size == 0: return []

        const coordinateRows: List<List<unknown>> = []
        for position in positions:
            const coordinate: List<unknown> = [position.x, position.y, position.z]
            coordinateRows.append(coordinate)
        const stateTable = sqlTable("chunk_states", alias="state")
        const overrideTable = sqlTable("block_overrides", alias="override")
        const findChunkDeltas = selectQuery(
            stateTable,
            [
                sqlNamedField("chunk_x", alias="chunkX", qualifier="state"),
                sqlNamedField("chunk_y", alias="chunkY", qualifier="state"),
                sqlNamedField("chunk_z", alias="chunkZ", qualifier="state"),
                sqlNamedField("revision", qualifier="state"),
                sqlNamedField("local_x", alias="localX", qualifier="override"),
                sqlNamedField("local_y", alias="localY", qualifier="override"),
                sqlNamedField("local_z", alias="localZ", qualifier="override"),
                sqlNamedField("block_state_runtime_id", alias="blockStateRuntimeId", qualifier="override"),
            ],
            ChunkDeltaRow,
            joins = [sqlLeftJoin(overrideTable, sqlAnd([
                sqlEqual(sqlColumn("world_id", qualifier="override"), sqlColumn("world_id", qualifier="state")),
                sqlEqual(sqlColumn("chunk_x", qualifier="override"), sqlColumn("chunk_x", qualifier="state")),
                sqlEqual(sqlColumn("chunk_y", qualifier="override"), sqlColumn("chunk_y", qualifier="state")),
                sqlEqual(sqlColumn("chunk_z", qualifier="override"), sqlColumn("chunk_z", qualifier="state")),
            ]))],
            where = sqlAnd([
                sqlColumnEqual("world_id", worldId, qualifier="state"),
                sqlTupleIn([
                    sqlColumn("chunk_x", qualifier="state"),
                    sqlColumn("chunk_y", qualifier="state"),
                    sqlColumn("chunk_z", qualifier="state"),
                ], coordinateRows),
            ]),
            orderBy = [
                sqlAscending(sqlColumn("chunk_x", qualifier="state")),
                sqlAscending(sqlColumn("chunk_y", qualifier="state")),
                sqlAscending(sqlColumn("chunk_z", qualifier="state")),
                sqlAscending(sqlColumn("local_y", qualifier="override")),
                sqlAscending(sqlColumn("local_z", qualifier="override")),
                sqlAscending(sqlColumn("local_x", qualifier="override")),
            ],
            maximumRows = 1000000,
        )
        const rows = await all(databaseExecutor, findChunkDeltas)

        const deltas: List<ChunkDelta> = []
        const indices: Map<string, number> = Map()
        for row in rows:
            const position: ChunkPosition = {x: row.chunkX, y: row.chunkY, z: row.chunkZ}
            const key = chunkKey(position)
            const existingIndex = indices.get(key)
            let deltaIndex = 0
            if existingIndex == null:
                const overrides: List<BlockOverride> = []
                deltas.append({position, revision: row.revision, overrides})
                deltaIndex = deltas.size - 1
                indices.set(key, deltaIndex)
            else: deltaIndex = existingIndex
            if row.localX != null and row.localY != null and row.localZ != null and row.blockStateRuntimeId != null:
                requireBlockStateRuntimeId(row.blockStateRuntimeId)
                deltas[deltaIndex].overrides.append({
                    position: {x: row.localX, y: row.localY, z: row.localZ},
                    blockStateRuntimeId: row.blockStateRuntimeId,
                })
        return deltas

    async def commitBlock(worldId: string, chunk: ChunkPosition, local: LocalPosition, blockStateRuntimeId: number?) -> BlockOverrideCommit:
        if blockStateRuntimeId != null: requireBlockStateRuntimeId(blockStateRuntimeId)

        async def transactionOperation(transaction: SqliteTransaction) -> BlockOverrideCommit:
            const executor = transaction.executor()
            const state = await one(executor, findChunkStateOperation(worldId, chunk))
            const storedOverride = await one(executor, findBlockOverrideOperation(worldId, chunk, local))
            const previousOverrideBlockStateRuntimeId = storedOverride == null ? null : storedOverride.blockStateRuntimeId
            const revision = state == null ? 0 : state.revision
            if sameOverride(previousOverrideBlockStateRuntimeId, blockStateRuntimeId):
                return {previousOverrideBlockStateRuntimeId, revision, changed: false}

            const nextRevision = revision + 1
            await execute(executor, saveChunkStateOperation(worldId, chunk, nextRevision))
            if blockStateRuntimeId == null: await execute(executor, removeBlockOverrideOperation(worldId, chunk, local))
            else: await execute(executor, saveBlockOverrideOperation(worldId, chunk, local, blockStateRuntimeId))
            return {previousOverrideBlockStateRuntimeId, revision: nextRevision, changed: true}

        return await database.transaction(transactionOperation)

    async def close(): await database.close()

    return {
        manifests: {save: saveManifest, find: findManifest, updateBlockRegistry},
        deltas: {findChunks, commitBlock},
        close,
    }
