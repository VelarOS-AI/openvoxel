import {SqliteConnection, SqliteJournalMode, openSqlite} from "@velarscript-labs/sqlite"
import {WorldStore} from "@openvoxel/world-runtime"
import {SqliteWorldStoreOptions, validateSqliteWorldStoreOptions} from "./sqlite-world-store/options.vel"
import {initializeWorldSchema} from "./sqlite-world-store/schema.vel"
import {sqliteWorldManifests} from "./sqlite-world-store/manifests.vel"
import {sqliteWorldDeltas} from "./sqlite-world-store/deltas.vel"

export {SqliteWorldStoreOptions, validateSqliteWorldStoreOptions} from "./sqlite-world-store/options.vel"
export {sqliteSchemaVersion} from "./sqlite-world-store/schema.vel"

async def openDatabase(options: SqliteWorldStoreOptions) -> SqliteConnection:
    return await openSqlite(options.path, {
        busyTimeoutMilliseconds: options.busyTimeoutMilliseconds,
        queueCapacity: options.queueCapacity,
        maxRows: options.maxRows,
        maxResultBytes: options.maxResultBytes,
        journalMode: SqliteJournalMode.wal,
    })

/// 连接归此适配器门面所有；各持久化职责只借用连接或执行器。
export async def sqliteWorldStore(configuration: SqliteWorldStoreOptions) -> WorldStore:
    const validatedConfiguration = validateSqliteWorldStoreOptions(configuration)
    const database = await openDatabase(validatedConfiguration)
    try: await initializeWorldSchema(database)
    catch error:
        await database.close()
        throw error

    async def close(): await database.close()

    return {
        manifests: sqliteWorldManifests(database.executor()),
        deltas: sqliteWorldDeltas(database),
        close,
    }
