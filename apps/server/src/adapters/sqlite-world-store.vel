import {DatabaseCommand, DatabaseExecutor, DatabaseQuery, all, command, execute, one, query, requireOne, sqlConcat, trustedSql, trustedSqlTemplate} from "@velarscript-labs/database"
import {insertCommand, selectQuery, sqlAnd, sqlAscending, sqlColumn, sqlColumnEqual, sqlEqual, sqlLeftJoin, sqlNamedField, sqlTable, sqlTupleIn} from "@velarscript-labs/sql"
import {SqliteConnection, SqliteJournalMode, SqliteTransaction, openSqlite, sqliteLiteral} from "@velarscript-labs/sqlite"
import {WorldBlockRegistrySnapshot, requireBlockStateRuntimeId} from "@openvoxel/blocks"
import {ChunkPosition, WorldContentIdentity, WorldManifest, chunkKey, validateWorldManifest} from "@openvoxel/world"
import {BlockOverride, ChunkDelta, ChunkDeltaCommit, WorldStore} from "@openvoxel/world-runtime"

type WorldRow:
    id: string
    name: string
    seed: string
    formatVersion: number
    chunkEdge: number
    generator: string
    generatorHash: string
    spawnX: number
    spawnY: number
    spawnZ: number
    contentJson: string
    blockRegistryJson: string

type DatabaseVersionRow:
    user_version: number

type ChunkDeltaRow:
    chunkX: number
    chunkY: number
    chunkZ: number
    revision: number
    localX: number?
    localY: number?
    localZ: number?
    blockStateRuntimeId: number?

type ChunkStateRow:
    chunkX: number
    chunkY: number
    chunkZ: number
    revision: number

/// SQL 行聚合阶段需要逐项 append；完成后再一次性投影成对外只读 ChunkDelta。
type MutableStoredChunkDelta:
    position: ChunkPosition
    revision: number
    overrides: List<BlockOverride>

export type SqliteWorldStoreOptions:
    path: string
    busyTimeoutMilliseconds: number
    queueCapacity: number
    maxRows: number
    maxResultBytes: number

export const sqliteSchemaVersion = 5
const worldsTable = sqlTable("worlds")
const chunkStatesTable = sqlTable("chunk_states")
const blockOverridesTable = sqlTable("block_overrides")

// These remain OpenVoxel operations: Labs owns safe composition and binding,
// while this adapter owns schema names, migrations, row shapes, and cardinality.
const readSchemaVersion = query(trustedSql("PRAGMA user_version"), DatabaseVersionRow, maximumRows=1)

def insertWorldOperation(world: WorldManifest) -> DatabaseCommand:
    return insertCommand(
        worldsTable,
        ["id", "name", "seed", "format_version", "chunk_edge", "generator", "generator_hash", "spawn_x", "spawn_y", "spawn_z", "content_json", "block_registry_json"],
        [[world.id, world.name, world.seed, world.formatVersion, world.chunkEdge, world.generator, world.generatorHash, world.spawn.x, world.spawn.y, world.spawn.z, Json.stableStringify(world.content), Json.stableStringify(world.blockRegistry)]],
        minimumAffected = 1,
        maximumAffected = 1,
    )

def findWorldOperation(worldId: string) -> DatabaseQuery<WorldRow>:
    return selectQuery(
        worldsTable,
        [
            sqlNamedField("id"),
            sqlNamedField("name"),
            sqlNamedField("seed"),
            sqlNamedField("format_version", alias="formatVersion"),
            sqlNamedField("chunk_edge", alias="chunkEdge"),
            sqlNamedField("generator"),
            sqlNamedField("generator_hash", alias="generatorHash"),
            sqlNamedField("spawn_x", alias="spawnX"),
            sqlNamedField("spawn_y", alias="spawnY"),
            sqlNamedField("spawn_z", alias="spawnZ"),
            sqlNamedField("content_json", alias="contentJson"),
            sqlNamedField("block_registry_json", alias="blockRegistryJson"),
        ],
        WorldRow,
        where = sqlColumnEqual("id", worldId),
        limit = 1,
        maximumRows = 1,
    )

def findChunkStatesOperation(worldId: string, coordinates: List<List<unknown>>) -> DatabaseQuery<ChunkStateRow>:
    return query(
        trustedSqlTemplate([
            `SELECT chunk_x AS "chunkX", chunk_y AS "chunkY", chunk_z AS "chunkZ", revision FROM chunk_states WHERE world_id = `,
            " AND (chunk_x, chunk_y, chunk_z) IN (SELECT CAST(json_extract(value, '$[0]') AS INTEGER), CAST(json_extract(value, '$[1]') AS INTEGER), CAST(json_extract(value, '$[2]') AS INTEGER) FROM json_each(",
            "))",
        ], [worldId, Json.stableStringify(coordinates)]),
        ChunkStateRow,
        maximumRows = coordinates.size,
    )

def saveChunkStatesOperation(rows: List<List<unknown>>) -> DatabaseCommand:
    return command(trustedSqlTemplate([
        "INSERT INTO chunk_states (world_id, chunk_x, chunk_y, chunk_z, revision) SELECT CAST(json_extract(value, '$[0]') AS TEXT), CAST(json_extract(value, '$[1]') AS INTEGER), CAST(json_extract(value, '$[2]') AS INTEGER), CAST(json_extract(value, '$[3]') AS INTEGER), CAST(json_extract(value, '$[4]') AS INTEGER) FROM json_each(",
        ") WHERE 1 = 1 ON CONFLICT(world_id, chunk_x, chunk_y, chunk_z) DO UPDATE SET revision = excluded.revision",
    ], [Json.stableStringify(rows)]), minimumAffected = rows.size, maximumAffected = rows.size)

def removeBlockOverridesOperation(worldId: string, coordinates: List<List<unknown>>) -> DatabaseCommand:
    return command(trustedSqlTemplate([
        "DELETE FROM block_overrides WHERE world_id = ",
        " AND (chunk_x, chunk_y, chunk_z, local_x, local_y, local_z) IN (SELECT CAST(json_extract(value, '$[0]') AS INTEGER), CAST(json_extract(value, '$[1]') AS INTEGER), CAST(json_extract(value, '$[2]') AS INTEGER), CAST(json_extract(value, '$[3]') AS INTEGER), CAST(json_extract(value, '$[4]') AS INTEGER), CAST(json_extract(value, '$[5]') AS INTEGER) FROM json_each(",
        "))",
    ], [worldId, Json.stableStringify(coordinates)]), maximumAffected = coordinates.size)

def saveBlockOverridesOperation(rows: List<List<unknown>>) -> DatabaseCommand:
    return command(trustedSqlTemplate([
        "INSERT INTO block_overrides (world_id, chunk_x, chunk_y, chunk_z, local_x, local_y, local_z, block_state_runtime_id) SELECT CAST(json_extract(value, '$[0]') AS TEXT), CAST(json_extract(value, '$[1]') AS INTEGER), CAST(json_extract(value, '$[2]') AS INTEGER), CAST(json_extract(value, '$[3]') AS INTEGER), CAST(json_extract(value, '$[4]') AS INTEGER), CAST(json_extract(value, '$[5]') AS INTEGER), CAST(json_extract(value, '$[6]') AS INTEGER), CAST(json_extract(value, '$[7]') AS INTEGER) FROM json_each(",
        ") WHERE 1 = 1 ON CONFLICT(world_id, chunk_x, chunk_y, chunk_z, local_x, local_y, local_z) DO UPDATE SET block_state_runtime_id = excluded.block_state_runtime_id",
    ], [Json.stableStringify(rows)]), minimumAffected = rows.size, maximumAffected = rows.size)

async def openDatabase(options: SqliteWorldStoreOptions) -> SqliteConnection:
    return await openSqlite(options.path, {
        busyTimeoutMilliseconds: options.busyTimeoutMilliseconds,
        queueCapacity: options.queueCapacity,
        maxRows: options.maxRows,
        maxResultBytes: options.maxResultBytes,
        journalMode: SqliteJournalMode.wal,
    })

async def initialize(database: SqliteConnection):
    /// 三张表和 user_version 必须处于同一个事务。进程在初始化中途退出时，
    /// SQLite 会回滚到真正的空库，不会留下“版本已写入但表不完整”的半成品。
    async def initializeTransaction(transaction: SqliteTransaction):
        const executor = transaction.executor()
        const versionRow = await requireOne(executor, readSchemaVersion, message="SQLite did not return its schema version")
        if versionRow.user_version == sqliteSchemaVersion: return null
        assert versionRow.user_version == 0 else f"SQLite schema version {versionRow.user_version} does not match required version {sqliteSchemaVersion}"
        // 新格式直接建表；user_version 为 0 但已有同名表时会明确失败，不猜测、
        // 覆盖或迁移旧结构。
        await execute(executor, command(
            trustedSql("CREATE TABLE worlds (id TEXT PRIMARY KEY, name TEXT NOT NULL, seed TEXT NOT NULL, format_version INTEGER NOT NULL, chunk_edge INTEGER NOT NULL, generator TEXT NOT NULL, generator_hash TEXT NOT NULL, spawn_x INTEGER NOT NULL, spawn_y INTEGER NOT NULL, spawn_z INTEGER NOT NULL, content_json TEXT NOT NULL, block_registry_json TEXT NOT NULL)"),
        ))
        await execute(executor, command(
            trustedSql("CREATE TABLE chunk_states (world_id TEXT NOT NULL, chunk_x INTEGER NOT NULL, chunk_y INTEGER NOT NULL, chunk_z INTEGER NOT NULL, revision INTEGER NOT NULL CHECK (revision >= 0), PRIMARY KEY (world_id, chunk_x, chunk_y, chunk_z), FOREIGN KEY (world_id) REFERENCES worlds(id) ON DELETE CASCADE)"),
        ))
        await execute(executor, command(
            trustedSql("CREATE TABLE block_overrides (world_id TEXT NOT NULL, chunk_x INTEGER NOT NULL, chunk_y INTEGER NOT NULL, chunk_z INTEGER NOT NULL, local_x INTEGER NOT NULL, local_y INTEGER NOT NULL, local_z INTEGER NOT NULL, block_state_runtime_id INTEGER NOT NULL, PRIMARY KEY (world_id, chunk_x, chunk_y, chunk_z, local_x, local_y, local_z), FOREIGN KEY (world_id, chunk_x, chunk_y, chunk_z) REFERENCES chunk_states(world_id, chunk_x, chunk_y, chunk_z) ON DELETE CASCADE)"),
        ))
        await execute(executor, command(sqlConcat([
            trustedSql("PRAGMA user_version = "),
            sqliteLiteral(sqliteSchemaVersion),
        ])))
        return null

    await database.transaction(initializeTransaction)

export async def sqliteWorldStore(configuration: SqliteWorldStoreOptions) -> WorldStore:
    const database = await openDatabase(configuration)
    try: await initialize(database)
    catch error:
        await database.close()
        throw error
    const databaseExecutor = database.executor()

    async def saveManifest(manifest: WorldManifest):
        const world = validateWorldManifest(manifest)
        await execute(databaseExecutor, insertWorldOperation(world))

    async def findManifest(worldId: string) -> WorldManifest?:
        const row = await one(databaseExecutor, findWorldOperation(worldId))
        if row == null: return null
        const blockRegistry = WorldBlockRegistrySnapshot.parse(Json.parse(row.blockRegistryJson))
        const content = WorldContentIdentity.parse(Json.parse(row.contentJson))
        return validateWorldManifest(WorldManifest.from(row, {
            spawn: {x: row.spawnX, y: row.spawnY, z: row.spawnZ},
            content,
            blockRegistry,
        }))

    async def findChunks(worldId: string, positions: readonly List<readonly ChunkPosition>) -> List<ChunkDelta>:
        if positions.size == 0: return []

        const coordinateRows: List<List<unknown>> = []
        for position in positions:
            const coordinate: List<unknown> = [position.x, position.y, position.z]
            coordinateRows.append(coordinate)
        const stateTable = sqlTable("chunk_states", alias="state")
        const overrideTable = sqlTable("block_overrides", alias="override")
        const findChunkDeltas = selectQuery(
            stateTable,
            [
                sqlNamedField("chunk_x", alias="chunkX", qualifier="state"),
                sqlNamedField("chunk_y", alias="chunkY", qualifier="state"),
                sqlNamedField("chunk_z", alias="chunkZ", qualifier="state"),
                sqlNamedField("revision", qualifier="state"),
                sqlNamedField("local_x", alias="localX", qualifier="override"),
                sqlNamedField("local_y", alias="localY", qualifier="override"),
                sqlNamedField("local_z", alias="localZ", qualifier="override"),
                sqlNamedField("block_state_runtime_id", alias="blockStateRuntimeId", qualifier="override"),
            ],
            ChunkDeltaRow,
            joins = [sqlLeftJoin(overrideTable, sqlAnd([
                sqlEqual(sqlColumn("world_id", qualifier="override"), sqlColumn("world_id", qualifier="state")),
                sqlEqual(sqlColumn("chunk_x", qualifier="override"), sqlColumn("chunk_x", qualifier="state")),
                sqlEqual(sqlColumn("chunk_y", qualifier="override"), sqlColumn("chunk_y", qualifier="state")),
                sqlEqual(sqlColumn("chunk_z", qualifier="override"), sqlColumn("chunk_z", qualifier="state")),
            ]))],
            where = sqlAnd([
                sqlColumnEqual("world_id", worldId, qualifier="state"),
                sqlTupleIn([
                    sqlColumn("chunk_x", qualifier="state"),
                    sqlColumn("chunk_y", qualifier="state"),
                    sqlColumn("chunk_z", qualifier="state"),
                ], coordinateRows),
            ]),
            orderBy = [
                sqlAscending(sqlColumn("chunk_x", qualifier="state")),
                sqlAscending(sqlColumn("chunk_y", qualifier="state")),
                sqlAscending(sqlColumn("chunk_z", qualifier="state")),
                sqlAscending(sqlColumn("local_y", qualifier="override")),
                sqlAscending(sqlColumn("local_z", qualifier="override")),
                sqlAscending(sqlColumn("local_x", qualifier="override")),
            ],
            maximumRows = 1000000,
        )
        const rows = await all(databaseExecutor, findChunkDeltas)

        const deltas: List<MutableStoredChunkDelta> = []
        const indices: Map<string, number> = Map()
        for row in rows:
            const position: ChunkPosition = {x: row.chunkX, y: row.chunkY, z: row.chunkZ}
            const key = chunkKey(position)
            const existingIndex = indices.get(key)
            let deltaIndex = 0
            if existingIndex == null:
                const overrides: List<BlockOverride> = []
                deltas.append({position, revision: row.revision, overrides})
                deltaIndex = deltas.size - 1
                indices.set(key, deltaIndex)
            else: deltaIndex = existingIndex
            if row.localX != null and row.localY != null and row.localZ != null and row.blockStateRuntimeId != null:
                requireBlockStateRuntimeId(row.blockStateRuntimeId)
                deltas[deltaIndex].overrides.append({
                    position: {x: row.localX, y: row.localY, z: row.localZ},
                    blockStateRuntimeId: row.blockStateRuntimeId,
                })
        const output: List<ChunkDelta> = []
        for delta in deltas: output.append(ChunkDelta.from(delta))
        return output

    async def commitChunks(worldId: string, commits: readonly List<readonly ChunkDeltaCommit>):
        if commits.size == 0: return
        const chunkCoordinates: List<List<unknown>> = []
        const chunkStateRows: List<List<unknown>> = []
        const removedOverrideCoordinates: List<List<unknown>> = []
        const savedOverrideRows: List<List<unknown>> = []
        const seenChunks: Set<string> = Set()
        for commit in commits:
            assert commit.expectedRevision.isInteger() and commit.expectedRevision >= 0 else "Expected Chunk revision must be a non-negative integer"
            assert commit.revision == commit.expectedRevision + 1 else "Chunk revision must advance exactly once"
            const key = chunkKey(commit.position)
            assert key not in seenChunks else f"SQLite Chunk batch contains duplicate position {key}"
            seenChunks.add(key)
            chunkCoordinates.append([commit.position.x, commit.position.y, commit.position.z])
            chunkStateRows.append([worldId, commit.position.x, commit.position.y, commit.position.z, commit.revision])
            const seenLocals: Set<string> = Set()
            for write in commit.writes:
                const localKey = f"{write.position.x}:{write.position.y}:{write.position.z}"
                assert localKey not in seenLocals else f"SQLite Chunk commit contains duplicate local position {localKey}"
                seenLocals.add(localKey)
                if write.blockStateRuntimeId == null:
                    removedOverrideCoordinates.append([
                        commit.position.x,
                        commit.position.y,
                        commit.position.z,
                        write.position.x,
                        write.position.y,
                        write.position.z,
                    ])
                else:
                    requireBlockStateRuntimeId(write.blockStateRuntimeId)
                    savedOverrideRows.append([
                        worldId,
                        commit.position.x,
                        commit.position.y,
                        commit.position.z,
                        write.position.x,
                        write.position.y,
                        write.position.z,
                        write.blockStateRuntimeId,
                    ])

        async def transactionOperation(transaction: SqliteTransaction):
            const executor = transaction.executor()
            // 坐标和值作为一个 JSON 参数交给 SQLite 的 json_each 展开。这样每组
            // 操作都保持固定 SQL 形状，不受 999 个绑定参数限制，也不需要逐项执行。
            const revisions: Map<string, number> = Map()
            const storedStates = await all(executor, findChunkStatesOperation(worldId, chunkCoordinates))
            for state in storedStates:
                const key = f"{state.chunkX}:{state.chunkY}:{state.chunkZ}"
                assert revisions.get(key) == null else f"SQLite returned duplicate Chunk state {key}"
                revisions.set(key, state.revision)
            for commit in commits:
                const key = chunkKey(commit.position)
                const currentRevision = revisions.get(key) ?? 0
                assert currentRevision == commit.expectedRevision else f"Chunk revision conflict at {key}: expected {commit.expectedRevision}, stored {currentRevision}"
            // 先建立或推进 Chunk 状态，再写覆盖，满足 block_overrides 外键。
            await execute(executor, saveChunkStatesOperation(chunkStateRows))
            if removedOverrideCoordinates.size > 0:
                await execute(executor, removeBlockOverridesOperation(worldId, removedOverrideCoordinates))
            if savedOverrideRows.size > 0: await execute(executor, saveBlockOverridesOperation(savedOverrideRows))
            return null

        await database.transaction(transactionOperation)

    async def close(): await database.close()

    return {
        manifests: {save: saveManifest, find: findManifest},
        deltas: {findChunks, commitChunks},
        close,
    }
