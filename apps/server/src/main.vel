import {get} from "velar/env"
import {WebSocketServer} from "velar/websocket"
import {blockCatalogHash, blockCatalogVersion, blockStateMapHash} from "@openvoxel/blocks"
import {appName, startOpenVoxelServer} from "./app.vel"
import {sqliteWorldStore} from "./adapters/sqlite-world-store.vel"
import {loadOpenVoxelConfiguration, resolveServerPath, serverOptions, withEnvironmentOverrides, withResolvedRuntimePaths} from "./config.vel"
import {worldRuntime} from "@openvoxel/world-runtime"
import {openVoxelApplication} from "./application.vel"

const configuredPath = get("OPENVOXEL_CONFIG")
const configurationPath = resolveServerPath(configuredPath ?? "application.yml")
const configuration = withResolvedRuntimePaths(withEnvironmentOverrides(await loadOpenVoxelConfiguration(configuredPath)))
const store = await sqliteWorldStore(configuration.database)
const application = openVoxelApplication(worldRuntime(store), serverOptions(configuration))

export async def start() -> WebSocketServer:
    const server = await startOpenVoxelServer(application)
    application.info("server.configuration", {
        databasePath: configuration.database.path,
        configurationPath,
        blockCatalogVersion,
        blockStateMapHash: blockStateMapHash.slice(0, 12),
        blockCatalogHash: blockCatalogHash.slice(0, 12),
    })
    print(f"{appName} is running at http://{configuration.server.host}:{server.port}")
    return server
