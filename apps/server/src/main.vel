import {run} from "velar/websocket"
import {startOpenVoxelServer} from "./server.vel"
import {sqliteWorldStore, validateSqliteWorldStoreOptions} from "./adapters/sqlite-world-store.vel"
import {loadContentCatalog} from "./adapters/content-catalog.vel"
import {loadOpenVoxelConfiguration, openVoxelConfigurationPath, serverOptions, withEnvironmentOverrides, withResolvedRuntimePaths} from "./config.vel"
import {WorldRuntime, validateWorldRuntimeOptions, worldRuntime} from "@openvoxel/world-runtime"
import {openVoxelApplication, validateOpenVoxelServerOptions} from "./application.vel"

const appName = "OpenVoxel"

@main:
    const configurationPath = openVoxelConfigurationPath()
    const configuration = withResolvedRuntimePaths(withEnvironmentOverrides(await loadOpenVoxelConfiguration()))
    // 在创建任何资源前组合各消费方拥有的纯校验器。构造函数仍复用同一校验器，
    // 因而其他入口也不能绕过边界，但配置模块不再复制数据库、网络或缓存规则。
    const validatedServerOptions = validateOpenVoxelServerOptions(serverOptions(configuration))
    const validatedDatabaseOptions = validateSqliteWorldStoreOptions(configuration.database)
    const validatedRuntimeOptions = validateWorldRuntimeOptions(configuration.worldRuntime)
    const content = await loadContentCatalog(configuration.content)
    const store = await sqliteWorldStore(validatedDatabaseOptions)
    let runtime: WorldRuntime? = null
    try: runtime = worldRuntime(store, content, validatedRuntimeOptions)
    catch error:
        // SQLite 已经打开但还没有移交给 WorldRuntime；构造失败时由本层回收，
        // 同时保留原始构造错误，不让次要的清理异常把根因覆盖掉。
        try: await store.close()
        catch _cleanupError: pass
        throw error
    const application = openVoxelApplication(runtime, validatedServerOptions)
    const server = await startOpenVoxelServer(application)
    application.info("server.configuration", {
        databasePath: configuration.database.path,
        configurationPath,
        defaultContentHash: content.defaultContent().identity.contentHash.slice(0, 12),
        installedContentPacks: configuration.content.packArtifacts.size,
        activeWorldCapacity: configuration.worldRuntime.activeWorldCapacity,
        activeChunkCapacity: configuration.worldRuntime.activeChunkCapacity,
        activeOverrideCapacity: configuration.worldRuntime.activeOverrideCapacity,
    })
    print(f"{appName} is running at http://{configuration.server.host}:{server.port}")
    await run(server)
