import {exists, removeFile} from "velar/fs"
import {open} from "velar/sqlite"
import {expect} from "velar/test"
import {dirtBlock, stoneBlock} from "@openvoxel/domain"
import {BlockChange, WorldRuntime} from "@openvoxel/world-runtime"
import {SqliteWorldStoreOptions, sqliteWorldStore} from "./adapters/sqlite-world-store.vel"

type CountRow:
    count: number

type BlockRow:
    blockId: number

def testDatabase(path: string) -> SqliteWorldStoreOptions:
    return {
        path,
        busyTimeoutMilliseconds: 2000,
        queueCapacity: 64,
        maxRows: 262144,
        maxResultBytes: 64 * 1024 * 1024,
    }

async def removeDatabase(path: string):
    const files = [path, f"{path}-wal", f"{path}-shm"]
    for file in files:
        if await exists(file):
            await removeFile(file)

async def tableCount(path: string, table: string) -> number:
    using database = await open(path)
    const row = await database.one(f"SELECT COUNT(*) AS count FROM {table}", [], CountRow)
    assert row != null else f"Expected count for {table}"
    return row.count

async def legacyChunkTableCount(path: string) -> number:
    using database = await open(path)
    const row = await database.one(
        "SELECT COUNT(*) AS count FROM sqlite_master WHERE type = 'table' AND name = 'chunks'",
        [],
        CountRow,
    )
    assert row != null else "Expected SQLite schema count"
    return row.count

async def singleStoredBlockId(path: string) -> number:
    using database = await open(path)
    const row = await database.one("SELECT block_id AS blockId FROM block_overrides", [], BlockRow)
    assert row != null else "Expected one stored block override"
    return row.blockId

test "SQLite adapter does not persist generated chunks":
    const databasePath = "openvoxel-generated-chunks-test.sqlite"
    await removeDatabase(databasePath)
    try:
        const store = await sqliteWorldStore(testDatabase(databasePath))
        const runtime = WorldRuntime(store)
        try:
            await runtime.createWorld({id: "generated-only", name: "Generated Only", seed: "openvoxel"})
            const chunks = await runtime.chunks("generated-only", [
                {x: 0, y: 0, z: 0},
                {x: -1, y: 1, z: 2},
                {x: 8, y: 3, z: -5},
            ])
            expect(chunks.size).toBe(3)
        finally:
            await runtime.close()

        expect(await tableCount(databasePath, "chunk_states")).toBe(0)
        expect(await tableCount(databasePath, "block_overrides")).toBe(0)
        expect(await legacyChunkTableCount(databasePath)).toBe(0)
    finally:
        await removeDatabase(databasePath)

test "SQLite adapter restores sparse overrides and removes a reverted override":
    const databasePath = "openvoxel-block-overrides-test.sqlite"
    await removeDatabase(databasePath)
    try:
        const firstStore = await sqliteWorldStore(testDatabase(databasePath))
        const firstRuntime = WorldRuntime(firstStore)
        let baseBlockId = 0
        let replacementBlockId = 0
        try:
            await firstRuntime.createWorld({id: "persistent", name: "Persistent", seed: "sqlite-seed"})
            const before = await firstRuntime.chunk("persistent", {x: -1, y: 1, z: 2})
            baseBlockId = before.get({x: 15, y: 14, z: 0})
            replacementBlockId = baseBlockId == stoneBlock ? dirtBlock : stoneBlock
            const change = await firstRuntime.setBlock("persistent", {x: -1, y: 30, z: 32}, replacementBlockId)
            expect(change.previousBlockId).toBe(baseBlockId)
            expect(change.revision).toBe(1)
            const repeated = await firstRuntime.setBlock("persistent", {x: -1, y: 30, z: 32}, replacementBlockId)
            expect(repeated.revision).toBe(1)
        finally:
            await firstRuntime.close()

        expect(await tableCount(databasePath, "chunk_states")).toBe(1)
        expect(await tableCount(databasePath, "block_overrides")).toBe(1)
        expect(await singleStoredBlockId(databasePath)).toBe(replacementBlockId)

        const reopenedStore = await sqliteWorldStore(testDatabase(databasePath))
        const reopenedRuntime = WorldRuntime(reopenedStore)
        try:
            const manifest = await reopenedRuntime.requireWorld("persistent")
            const restored = await reopenedRuntime.chunk("persistent", {x: -1, y: 1, z: 2})
            expect(manifest.seed).toBe("sqlite-seed")
            expect(restored.revision).toBe(1)
            expect(restored.get({x: 15, y: 14, z: 0})).toBe(replacementBlockId)

            const reverted = await reopenedRuntime.setBlock("persistent", {x: -1, y: 30, z: 32}, baseBlockId)
            expect(reverted.previousBlockId).toBe(replacementBlockId)
            expect(reverted.revision).toBe(2)
        finally:
            await reopenedRuntime.close()

        expect(await tableCount(databasePath, "chunk_states")).toBe(1)
        expect(await tableCount(databasePath, "block_overrides")).toBe(0)
        expect(await legacyChunkTableCount(databasePath)).toBe(0)
    finally:
        await removeDatabase(databasePath)

test "SQLite adapter serializes concurrent block transactions":
    const databasePath = "openvoxel-concurrent-overrides-test.sqlite"
    await removeDatabase(databasePath)
    try:
        const store = await sqliteWorldStore(testDatabase(databasePath))
        const runtime = WorldRuntime(store)
        try:
            await runtime.createWorld({id: "concurrent", name: "Concurrent", seed: "openvoxel"})
            const before = await runtime.chunk("concurrent", {x: 0, y: 1, z: 0})
            const tasks: List<Promise<BlockChange>> = []
            const replacements: List<number> = []
            for x in range(16):
                const baseBlockId = before.get({x, y: 14, z: 0})
                const replacementBlockId = baseBlockId == stoneBlock ? dirtBlock : stoneBlock
                replacements.append(replacementBlockId)
                tasks.append(runtime.setBlock("concurrent", {x, y: 30, z: 0}, replacementBlockId))

            const changes = await Promise.all(tasks)
            expect(changes.size).toBe(16)
            const after = await runtime.chunk("concurrent", {x: 0, y: 1, z: 0})
            expect(after.revision).toBe(16)
            for x in range(16):
                expect(after.get({x, y: 14, z: 0})).toBe(replacements[x])
        finally:
            await runtime.close()

        expect(await tableCount(databasePath, "chunk_states")).toBe(1)
        expect(await tableCount(databasePath, "block_overrides")).toBe(16)
    finally:
        await removeDatabase(databasePath)
