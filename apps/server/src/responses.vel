import {ServeResponse, json, text} from "velar/serve"

def envelope(code: string, data: unknown, message: string) -> unknown: return {code, data, message}

export def apiResponse(status: number, code: string, data: unknown, message: string, headers: Map<string, string> = Map()) -> ServeResponse:
    return json(envelope(code, data, message), status=status, headers=headers)

export def ok(data: unknown, headers: Map<string, string> = Map()) -> ServeResponse:
    return apiResponse(200, "OK", data, "success", headers)

export def created(data: unknown, headers: Map<string, string> = Map()) -> ServeResponse:
    return apiResponse(201, "CREATED", data, "created", headers)

export def failure(status: number, code: string, data: unknown, message: string, headers: Map<string, string> = Map()) -> ServeResponse:
    return apiResponse(status, code, data, message, headers)

export def notModified(headers: Map<string, string>) -> ServeResponse: return text("", status=304, headers=headers)
