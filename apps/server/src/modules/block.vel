import {Request, input} from "velar/serve"
import {SetBlockRequest, blockCatalogResponse, protocolVersion} from "@openvoxel/protocol"
import {notModified, ok} from "../responses.vel"
import {openVoxelServicesProvider} from "../services.vel"

const catalogPayload = blockCatalogResponse()
const catalogEtag = f`"{catalogPayload.contentHash}"`

def catalogHeaders() -> Map<string, string>:
    return Map([
        ["etag", catalogEtag],
        ["cache-control", "public, max-age=0, must-revalidate"],
        ["access-control-expose-headers", "etag, x-openvoxel-protocol-version"],
        ["x-openvoxel-protocol-version", str(protocolVersion)],
    ])

def matchesEtag(value: string?, expected: string) -> bool:
    if value == null:
        return false
    for candidate in value.split(","):
        const normalized = candidate.trim()
        if normalized == "*" or normalized == expected or normalized == f"W/{expected}":
            return true
    return false

export server blockRoutes:
    /// Returns the authoritative block catalog with validator headers.
    @get(p"/api/blocks", ifNoneMatch=input.header("if-none-match", default=null)):
        const headers = catalogHeaders()
        if matchesEtag(ifNoneMatch, catalogEtag):
            return notModified(headers)
        return ok(catalogPayload, headers)

    /// Persists one block override and broadcasts the resulting revision.
    @post(p"/api/blocks", request: Request, services=input.dependency(openVoxelServicesProvider)):
        const command = await request.parse(SetBlockRequest)
        const change = await services.runtime.setBlock(command.worldId, command.position, command.blockId)
        await services.realtime.publishChange(change)
        services.info("block.changed", {worldId: change.worldId, revision: change.revision})
        return ok(change)
