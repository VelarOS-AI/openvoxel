import {input, respond, text} from "velar/serve"
import {protocolVersion} from "@openvoxel/protocol"
import {openVoxelApplicationProvider} from "../application.vel"
import {applicationResult} from "../error-handler.vel"
import {worldContentResponse} from "../presentation/world-content.vel"

def catalogHeaders(etag: string) -> Map<string, string>:
    return Map([
        ["etag", etag],
        ["cache-control", "public, max-age=0, must-revalidate"],
        ["access-control-expose-headers", "etag, x-openvoxel-protocol-version"],
        ["x-openvoxel-protocol-version", str(protocolVersion)],
    ])

def matchesEtag(value: string?, expected: string) -> bool:
    if value == null: return false
    for candidate in value.split(","):
        const normalized = candidate.trim()
        if normalized == "*" or normalized == expected or normalized == f"W/{expected}": return true
    return false

export server blockRoutes:
    /// 返回指定世界的 Content Pack、方块 runtimeId 和生成器事实。ETag 同时包含
    /// 内容构建身份与状态映射身份，客户端不能把一个世界的目录复用于另一个世界。
    @get worldContent(p"/api/worlds/{worldId:string}/content", ifNoneMatch = input.header("if-none-match", default=null), application = input.dependency(openVoxelApplicationProvider)):
        const snapshot = await applicationResult(application.runtime.worldContent(worldId))
        const etag = f`"{snapshot.content.contentHash}-{snapshot.stateMapHash}"`
        const headers = catalogHeaders(etag)
        if matchesEtag(ifNoneMatch, etag): return text("", status=304, headers=headers)
        return respond(worldContentResponse(snapshot), headers=headers)
