import {input} from "velar/serve"
import {clientContractResponse, protocolVersion} from "@openvoxel/protocol"
import {ok} from "../responses.vel"
import {openVoxelApplicationProvider} from "../application.vel"

export server systemRoutes:
    /// Reports service readiness and the active protocol version.
    @get(p"/api/health"):
        return ok(
            {status: "ready", service: "openvoxel", protocolVersion},
            Map([["x-openvoxel-protocol-version", str(protocolVersion)]]),
        )

    /// Publishes the client transport and world-data contract.
    @get(p"/api/client-contract", application=input.dependency(openVoxelApplicationProvider)):
        return ok(
            clientContractResponse({
                requestBodyBytes: application.options.bodyLimit,
                realtimeMessageBytes: application.options.maxMessageBytes,
            }),
            Map([
                ["cache-control", "no-store"],
                ["x-openvoxel-protocol-version", str(protocolVersion)],
            ]),
        )
