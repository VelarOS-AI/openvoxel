import {input} from "velar/serve"
import {TerrainChunkBatchRequest} from "@openvoxel/protocol"
import {openVoxelApplicationProvider} from "../application.vel"
import {applicationResult} from "../error-handler.vel"
import {generationSampleResponse, terrainChunkBatchResponse} from "../presentation/chunk.vel"

export server chunkRoutes:
    /// 固定地形按批次读取。响应只由种子、生成器和方块注册表决定，可被客户端长期
    /// 缓存；玩家修改不混入这里，而是通过同一世界的实时通道同步。
    @post terrainChunks(p"/api/worlds/{worldId:string}/terrain/chunks", query: TerrainChunkBatchRequest, application = input.dependency(openVoxelApplicationProvider)):
        const chunks = await applicationResult(application.runtime.terrainChunks(worldId, query.positions))
        return terrainChunkBatchResponse(worldId, chunks)

    /// 地形采样是调试生成器的固定只读资源，不包含玩家覆盖。
    @get generationSample(p"/api/worlds/{worldId:string}/terrain/samples/{blockX:number}/{blockZ:number}", application = input.dependency(openVoxelApplicationProvider)):
        const sample = await applicationResult(application.runtime.terrainSample(worldId, {x: blockX, z: blockZ}))
        return generationSampleResponse(worldId, sample)
