import {Request, input} from "velar/serve"
import {CreateWorld} from "@openvoxel/domain"
import {WorldQuery, protocolVersion, worldBootstrapResponse} from "@openvoxel/protocol"
import {WorldNotFoundError} from "@openvoxel/world-runtime"
import {created, ok} from "../responses.vel"
import {openVoxelServicesProvider} from "../services.vel"

export server worldRoutes:
    /// Creates one deterministic world manifest.
    @post(p"/api/worlds", request: Request, services=input.dependency(openVoxelServicesProvider)):
        const command = await request.parse(CreateWorld)
        const manifest = await services.runtime.createWorld(command)
        services.info("world.created", {worldId: manifest.id, seed: manifest.seed})
        return created(manifest)

    /// Finds a world manifest by identifier.
    @post(p"/api/worlds/find", request: Request, services=input.dependency(openVoxelServicesProvider)):
        const query = await request.parse(WorldQuery)
        const manifest = await services.runtime.findWorld(query.worldId)
        if manifest == null:
            throw WorldNotFoundError(query.worldId)
        return ok(manifest)

    /// Returns the world bootstrap contract consumed before chunk loading.
    @get(p"/api/worlds/{worldId:string}/bootstrap", services=input.dependency(openVoxelServicesProvider)):
        const manifest = await services.runtime.requireWorld(worldId)
        return ok(
            worldBootstrapResponse(manifest),
            Map([
                ["cache-control", "no-store"],
                ["x-openvoxel-protocol-version", str(protocolVersion)],
            ]),
        )
