import {BackendApp, SocketConnection} from "@openvoxel/backend"
import {Bytes} from "velar/binary"
import {encode, parse} from "@velarscript/msgpack"
import {SocketBlockCommand} from "@openvoxel/protocol"
import {WorldRuntime} from "@openvoxel/world-runtime"
import {RealtimeHub} from "../adapters/realtime-hub.vel"

class RealtimeController:
    constructor(private const app: BackendApp, private const runtime: WorldRuntime, private const realtime: RealtimeHub):
        pass

    async def sendError(connection: SocketConnection, error: Error):
        await connection.send(encode({event: "error", code: error.code, message: error.message}))

    async def handleMessage(connection: SocketConnection, message: Bytes):
        try:
            const command = parse(message, SocketBlockCommand)
            assert command.operation == "set-block" else "Unsupported realtime operation"
            const change = await self.runtime.setBlock(command.worldId, command.position, command.blockId)
            await self.realtime.publishChange(change)
            self.app.info("realtime.block.changed", {worldId: change.worldId, revision: change.revision})
        catch error:
            self.app.warn("realtime.command.failed", {code: error.code, message: error.message})
            await self.sendError(connection, error)

    async def connect(connection: SocketConnection):
        self.realtime.join(connection)
        try:
            let message = await connection.next()
            while message != null:
                if message is Bytes:
                    await self.handleMessage(connection, message)
                else:
                    await connection.send(encode({event: "error", code: "TextMessageUnsupported", message: "Realtime commands must use MessagePack"}))
                message = await connection.next()
        finally:
            self.realtime.leave(connection)
            await connection.close(1000, "Connection finished")

export def registerRealtimeModule(app: BackendApp, runtime: WorldRuntime, realtime: RealtimeHub):
    const controller = RealtimeController(app, runtime, realtime)

    async def connect(connection: SocketConnection):
        await controller.connect(connection)

    app.websocket("/api/events", connect)
