import {WorldRuntime} from "@openvoxel/world-runtime"
import {Cancellation, Task, task} from "velar/task"
import {all, each, field, integer, nonBlank, refine, validator} from "velar/validation"
import {provide} from "velar/serve"
import {WorldLiveState, worldLiveState} from "./world-live-state.vel"
import {encodeWorldBlockChanges} from "./presentation/realtime.vel"

export type OpenVoxelServerOptions:
    host: string
    port: number
    logger: bool
    bodyLimit: number
    corsAllowedOrigins: List<string>
    maxMessageBytes: number
    maxQueuedMessages: number
    maxQueuedBytes: number
    maxPendingSendBytes: number
    maxConnections: number
    maxConcurrentRequests: number
    realtimeDrainMilliseconds: number

const OpenVoxelServerOptionsValidator = validator(OpenVoxelServerOptions, all([
    field("host", (options: OpenVoxelServerOptions) => options.host, nonBlank(maximum=255)),
    field("port", (options: OpenVoxelServerOptions) => options.port, integer(minimum=0, maximum=65535)),
    field("bodyLimit", (options: OpenVoxelServerOptions) => options.bodyLimit, integer(minimum=1, maximum=16777216)),
    field("corsAllowedOrigins", (options: OpenVoxelServerOptions) => options.corsAllowedOrigins, all([
        refine((origins: List<string>) => origins.size <= 64, "cannot contain more than 64 origins"),
        each(refine((origin: string) => origin == "*" or origin.startsWith("http://") or origin.startsWith("https://"), "must be * or an HTTP(S) origin")),
    ])),
    field("maxMessageBytes", (options: OpenVoxelServerOptions) => options.maxMessageBytes, integer(minimum=1, maximum=67108864)),
    field("maxQueuedMessages", (options: OpenVoxelServerOptions) => options.maxQueuedMessages, integer(minimum=1, maximum=10000)),
    field("maxQueuedBytes", (options: OpenVoxelServerOptions) => options.maxQueuedBytes, integer(minimum=1, maximum=67108864)),
    field("maxPendingSendBytes", (options: OpenVoxelServerOptions) => options.maxPendingSendBytes, integer(minimum=1, maximum=67108864)),
    field("maxConnections", (options: OpenVoxelServerOptions) => options.maxConnections, integer(minimum=1, maximum=4096)),
    field("maxConcurrentRequests", (options: OpenVoxelServerOptions) => options.maxConcurrentRequests, integer(minimum=1, maximum=4096)),
    field("realtimeDrainMilliseconds", (options: OpenVoxelServerOptions) => options.realtimeDrainMilliseconds, integer(minimum=0, maximum=2147483647)),
]))

export def validateOpenVoxelServerOptions(options: OpenVoxelServerOptions) -> OpenVoxelServerOptions:
    return OpenVoxelServerOptionsValidator.validate(options)

type AccessLogEntry:
    method: string
    path: string
    status: number
    durationMs: number

export type OpenVoxelApplication:
    runtime: WorldRuntime
    options: OpenVoxelServerOptions
    live: WorldLiveState
    info: (message: string, context: unknown) -> null
    warn: (message: string, context: unknown) -> null
    access: (entry: AccessLogEntry) -> null
    close: () -> Promise<null>

export def openVoxelApplication(runtime: WorldRuntime, options: OpenVoxelServerOptions) -> OpenVoxelApplication:
    const validatedOptions = validateOpenVoxelServerOptions(options)
    let closing: Task<null>? = null

    def log(level: string, message: string, context: unknown):
        if not validatedOptions.logger: return
        try: print(Json.stringify({level, message, context}))
        catch _error:
            // 日志是旁路观察能力。序列化器或输出设备失败时不能改变请求结果，
            // 更不能让已经监听成功的服务器因为一条启动日志而泄漏。
            return

    def info(message: string, context: unknown): log("info", message, context)

    def warn(message: string, context: unknown): log("warn", message, context)

    def access(entry: AccessLogEntry): info("http.request", entry)

    const live = worldLiveState(validatedOptions.maxConnections, warn)
    const blockChanges = runtime.subscribeBlockChanges(batch => live.publish(batch.worldId, batch.sequence, encodeWorldBlockChanges(batch)))

    async def closeApplication(_cancellation: Cancellation):
        // 三个资源按依赖倒序释放。finally 保证某一步失败也不会跳过更底层的
        // 世界运行时和数据库；close 的 Task 仍会把第一次失败交给停机调用方。
        try: blockChanges.close()
        finally:
            try: await live.close()
            finally: await runtime.close()

    async def close():
        const existing = closing
        if existing != null:
            await existing.result()
            return
        const owner = task(closeApplication)
        closing = owner
        await owner.result()

    return {runtime, options: validatedOptions, live, info, warn, access, close}

async def resolveOpenVoxelApplication(_values: Record<unknown>) -> OpenVoxelApplication:
    // 线上启动必须通过 supply 把已经构造好的应用实例绑定进 ServeApp；这个
    // resolver 只负责在漏配时给出明确错误，不再从进程全局变量读取隐式状态。
    throw Error("OpenVoxel application Provider was not supplied")

async def releaseOpenVoxelApplication(application: OpenVoxelApplication): await application.close()

export const openVoxelApplicationProvider = provide(
    inputs={},
    resolve=resolveOpenVoxelApplication,
    scope="app",
    release=releaseOpenVoxelApplication,
    eager=true,
)
