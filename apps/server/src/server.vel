import {Request, ServeApp, bodyLimit, lifecycle, middleware, use} from "velar/serve"
import {WebSocketServer, listen} from "velar/websocket"
import {realtimeEventsPath} from "@openvoxel/protocol"
import {failure} from "./responses.vel"
import {handleApplicationError} from "./error-handler.vel"
import {acceptRealtimeConnections} from "./modules/realtime.vel"
import {blockRoutes} from "./modules/block.vel"
import {chunkRoutes} from "./modules/chunk.vel"
import {systemRoutes} from "./modules/system.vel"
import {worldRoutes} from "./modules/world.vel"
import {OpenVoxelApplication, mountOpenVoxelApplication, unmountOpenVoxelApplication} from "./application.vel"

server openVoxelRoutes:
    ...systemRoutes
    ...worldRoutes
    ...chunkRoutes
    ...blockRoutes

    @notFound(request: Request):
        return failure(404, "RouteNotFound", {method: request.method, path: request.path}, "Route not found")

export def createOpenVoxelApp(application: OpenVoxelApplication) -> ServeApp:
    let app = bodyLimit(openVoxelRoutes, application.options.bodyLimit)
    app = use(app, middleware.errors(handleApplicationError))
    app = use(app, middleware.cors(
        origins = application.options.corsAllowedOrigins,
        headers = ["content-type", "if-none-match"],
    ))
    app = use(app, middleware.requestId())
    app = use(app, middleware.securityHeaders())
    app = use(app, middleware.concurrency(256))
    if application.options.logger:
        app = use(app, middleware.accessLog(application.access))

    return app

def ownedOpenVoxelApp(application: OpenVoxelApplication) -> ServeApp:
    const app = createOpenVoxelApp(application)

    async def startup():
        mountOpenVoxelApplication(application)

    async def shutdown():
        unmountOpenVoxelApplication()

    return lifecycle(app, startup=startup, shutdown=shutdown)

export async def startOpenVoxelServer(application: OpenVoxelApplication) -> WebSocketServer:
    try:
        const server = await listen({
            host: application.options.host,
            port: application.options.port,
            http: ownedOpenVoxelApp(application),
            path: realtimeEventsPath,
            origins: application.options.corsAllowedOrigins,
            maxBodyBytes: application.options.bodyLimit,
            maxMessageBytes: application.options.maxMessageBytes,
            maxQueuedMessages: application.options.maxQueuedMessages,
            maxQueuedBytes: application.options.maxQueuedBytes,
            maxPendingSendBytes: application.options.maxPendingSendBytes,
            maxConnections: application.options.maxConnections,
        })
        async acceptRealtimeConnections(server, application)
        application.info("server.started", {host: application.options.host, port: server.port})
        return server
    catch error:
        await application.close()
        throw error
