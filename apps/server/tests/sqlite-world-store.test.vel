import {exists, removeFile} from "velar/fs"
import {sqlConcat, trustedSql, trustedSqlTemplate} from "@velarscript-labs/database"
import {openSqlite, sqliteIdentifier, sqliteLiteral} from "@velarscript-labs/sqlite"
import {expect} from "velar/test"
import {defaultBlockStateRuntimeId} from "@openvoxel/blocks"
import {builtinIdentities} from "@openvoxel/identities"
import {ChunkPosition, WorldGameMode, chunkBlock, worldEcologyEpochMilliseconds} from "@openvoxel/world"
import {BlockEdit, worldRuntime} from "@openvoxel/world-runtime"
import {SqliteWorldStoreOptions, sqliteSchemaVersion, sqliteWorldStore, validateSqliteWorldStoreOptions} from "../src/adapters/sqlite-world-store.vel"

const dirtBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.dirt)
const stoneBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.stone)
const cottonBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.cotton)

type CountRow:
    count: number

type BlockRow:
    blockStateRuntimeId: number
    growthOriginEpoch: number?

type SchemaVersionRow:
    user_version: number

def testDatabase(path: string) -> SqliteWorldStoreOptions:
    return {
        path,
        busyTimeoutMilliseconds: 2000,
        queueCapacity: 64,
        maxRows: 262144,
        maxResultBytes: 64 * 1024 * 1024,
    }

test "SQLite adapter owns its connection limits":
    expect(sqliteSchemaVersion).toBe(9)
    const invalid = SqliteWorldStoreOptions.from(testDatabase("unused.sqlite"), {queueCapacity: 0})
    expect(() => validateSqliteWorldStoreOptions(invalid)).toThrow()

async def removeDatabase(path: string):
    const files = [path, f"{path}-wal", f"{path}-shm"]
    for file in files:
        if await exists(file): await removeFile(file)

async def tableCount(path: string, table: string) -> number:
    using database = await openSqlite(path)
    const row = await database.one(sqlConcat([
        trustedSql("SELECT COUNT(*) AS count FROM "),
        sqliteIdentifier(table),
    ]), CountRow)
    assert row != null else f"Expected count for {table}"
    return row.count

async def fullChunkTableCount(path: string) -> number:
    using database = await openSqlite(path)
    const row = await database.one(
        trustedSql("SELECT COUNT(*) AS count FROM sqlite_master WHERE type = 'table' AND name = 'chunks'"),
        CountRow,
    )
    assert row != null else "Expected SQLite schema count"
    return row.count

async def singleStoredBlockStateRuntimeId(path: string) -> number:
    using database = await openSqlite(path)
    const row = await database.one(trustedSql("SELECT block_state_runtime_id AS blockStateRuntimeId, growth_origin_epoch AS growthOriginEpoch FROM block_overrides"), BlockRow)
    assert row != null else "Expected one stored block override"
    return row.blockStateRuntimeId

async def singleStoredCrop(path: string) -> BlockRow:
    using database = await openSqlite(path)
    const row = await database.one(trustedSql("SELECT block_state_runtime_id AS blockStateRuntimeId, growth_origin_epoch AS growthOriginEpoch FROM block_overrides WHERE growth_origin_epoch IS NOT NULL"), BlockRow)
    assert row != null else "Expected one stored crop override"
    return row

async def schemaVersion(path: string) -> number:
    using database = await openSqlite(path)
    const row = await database.one(trustedSql("PRAGMA user_version"), SchemaVersionRow)
    assert row != null else "Expected SQLite schema version"
    return row.user_version

test "SQLite adapter does not persist generated chunks":
    const databasePath = "openvoxel-generated-chunks-test.sqlite"
    await removeDatabase(databasePath)
    try:
        const store = await sqliteWorldStore(testDatabase(databasePath))
        const runtime = worldRuntime(store)
        try:
            await runtime.createWorld({id: "generated-only", name: "Generated Only", seed: "openvoxel"})
            const chunks = await runtime.chunks("generated-only", [
                {x: 0, y: 0, z: 0},
                {x: -1, y: 1, z: 2},
                {x: 8, y: 3, z: -5},
            ])
            expect(chunks.size).toBe(3)
        finally: await runtime.close()

        expect(await tableCount(databasePath, "chunk_states")).toBe(0)
        expect(await tableCount(databasePath, "block_overrides")).toBe(0)
        expect(await fullChunkTableCount(databasePath)).toBe(0)
    finally: await removeDatabase(databasePath)

test "SQLite adapter stores attack-shaped world text only as bound data":
    const databasePath = "openvoxel-sql-injection-test.sqlite"
    await removeDatabase(databasePath)
    try:
        const store = await sqliteWorldStore(testDatabase(databasePath))
        const runtime = worldRuntime(store)
        const attack = "Ada'); DROP TABLE worlds; --"
        try:
            await runtime.createWorld({id: "injection-safe", name: attack, seed: attack})
            const manifest = await runtime.requireWorld("injection-safe")
            expect(manifest.name).toBe(attack)
            expect(manifest.seed).toBe(attack)
        finally: await runtime.close()

        expect(await tableCount(databasePath, "worlds")).toBe(1)
        const reopened = await sqliteWorldStore(testDatabase(databasePath))
        await reopened.close()
    finally: await removeDatabase(databasePath)

test "SQLite adapter restores sparse overrides and removes a reverted override":
    const databasePath = "openvoxel-block-overrides-test.sqlite"
    await removeDatabase(databasePath)
    try:
        const firstStore = await sqliteWorldStore(testDatabase(databasePath))
        const firstRuntime = worldRuntime(firstStore)
        let baseBlockStateRuntimeId = 0
        let replacementBlockStateRuntimeId = 0
        let createdWorldTimeOriginMilliseconds = 0
        try:
            const created = await firstRuntime.createWorld({id: "persistent", name: "Persistent", seed: "sqlite-seed", mode: WorldGameMode.creative})
            createdWorldTimeOriginMilliseconds = created.worldTimeOriginMilliseconds
            const before = await firstRuntime.chunk("persistent", {x: -1, y: 1, z: 2})
            baseBlockStateRuntimeId = chunkBlock(before, {x: 15, y: 14, z: 0})
            replacementBlockStateRuntimeId = baseBlockStateRuntimeId == stoneBlock ? dirtBlock : stoneBlock
            const change = (await firstRuntime.editBlocks("persistent", [{
                position: {x: -1, y: 30, z: 32},
                blockStateRuntimeId: replacementBlockStateRuntimeId,
            }])).changes[0]
            expect(change.previousBlockStateRuntimeId).toBe(baseBlockStateRuntimeId)
            expect(change.revision).toBe(1)
            const repeated = (await firstRuntime.editBlocks("persistent", [{
                position: {x: -1, y: 30, z: 32},
                blockStateRuntimeId: replacementBlockStateRuntimeId,
            }])).changes[0]
            expect(repeated.revision).toBe(1)
        finally: await firstRuntime.close()

        expect(await tableCount(databasePath, "chunk_states")).toBe(1)
        expect(await tableCount(databasePath, "block_overrides")).toBe(1)
        expect(await singleStoredBlockStateRuntimeId(databasePath)).toBe(replacementBlockStateRuntimeId)

        const reopenedStore = await sqliteWorldStore(testDatabase(databasePath))
        const reopenedRuntime = worldRuntime(reopenedStore)
        try:
            const manifest = await reopenedRuntime.requireWorld("persistent")
            const restored = await reopenedRuntime.chunk("persistent", {x: -1, y: 1, z: 2})
            expect(manifest.seed).toBe("sqlite-seed")
            expect(manifest.mode).toBe(WorldGameMode.creative)
            expect(manifest.worldTimeOriginMilliseconds).toBe(createdWorldTimeOriginMilliseconds)
            expect(restored.revision).toBe(1)
            expect(chunkBlock(restored, {x: 15, y: 14, z: 0})).toBe(replacementBlockStateRuntimeId)

            const reverted = (await reopenedRuntime.editBlocks("persistent", [{
                position: {x: -1, y: 30, z: 32},
                blockStateRuntimeId: baseBlockStateRuntimeId,
            }])).changes[0]
            expect(reverted.previousBlockStateRuntimeId).toBe(replacementBlockStateRuntimeId)
            expect(reverted.revision).toBe(2)
        finally: await reopenedRuntime.close()

        expect(await tableCount(databasePath, "chunk_states")).toBe(1)
        expect(await tableCount(databasePath, "block_overrides")).toBe(0)
        expect(await fullChunkTableCount(databasePath)).toBe(0)
    finally: await removeDatabase(databasePath)

test "SQLite adapter roundtrips player crop growth anchors across runtime reloads":
    const databasePath = "openvoxel-crop-growth-anchor-test.sqlite"
    await removeDatabase(databasePath)
    let clockMilliseconds = 1_000_000

    def environmentClock() -> number: return clockMilliseconds

    const chunkPosition: ChunkPosition = {x: 0, y: 12, z: 0}
    const local = {x: 0, y: 0, z: 0}
    try:
        const first = worldRuntime(await sqliteWorldStore(testDatabase(databasePath)), environmentClock=environmentClock)
        try:
            await first.createWorld({id: "sqlite-crop", name: "SQLite Crop", seed: "sqlite-growth"})
            await first.editBlocks("sqlite-crop", [{position: {x: 0, y: 191, z: 0}, blockStateRuntimeId: dirtBlock}])
            const planted = (await first.editBlocks("sqlite-crop", [{position: {x: 0, y: 192, z: 0}, blockStateRuntimeId: cottonBlock}])).changes[0]
            expect(planted.changed).toBe(true)
            expect(planted.revision).toBe(1)
        finally: await first.close()
        expect(await singleStoredCrop(databasePath)).toEqual(BlockRow.from({blockStateRuntimeId: cottonBlock, growthOriginEpoch: 10}))

        clockMilliseconds += worldEcologyEpochMilliseconds * 8
        const reopened = worldRuntime(await sqliteWorldStore(testDatabase(databasePath)), environmentClock=environmentClock)
        try:
            const cottonAge2 = (await reopened.worldContent("sqlite-crop")).catalog.states.find(state => state.blockKey == builtinIdentities.blocks.cotton and state.properties.some(property => property.name == "age" and property.value == 2))
            assert cottonAge2 != null else "Expected mature cotton state"
            expect(chunkBlock(await reopened.chunk("sqlite-crop", chunkPosition), local)).toBe(cottonAge2.runtimeId)
            const replayed = (await reopened.editBlocks("sqlite-crop", [{position: {x: 0, y: 200, z: 0}, blockStateRuntimeId: cottonAge2.runtimeId}])).changes[0]
            expect(replayed.changed).toBe(false)
            expect(replayed.revision).toBe(1)
        finally: await reopened.close()
        expect(await singleStoredCrop(databasePath)).toEqual(BlockRow.from({blockStateRuntimeId: cottonBlock, growthOriginEpoch: 10}))
    finally: await removeDatabase(databasePath)

test "SQLite adapter commits a multi-block batch with one Chunk revision":
    const databasePath = "openvoxel-concurrent-overrides-test.sqlite"
    await removeDatabase(databasePath)
    try:
        const store = await sqliteWorldStore(testDatabase(databasePath))
        const runtime = worldRuntime(store)
        try:
            await runtime.createWorld({id: "concurrent", name: "Concurrent", seed: "openvoxel"})
            const before = await runtime.chunk("concurrent", {x: 0, y: 1, z: 0})
            const edits: List<BlockEdit> = []
            const replacements: List<number> = []
            for x in range(16):
                const baseBlockStateRuntimeId = chunkBlock(before, {x, y: 14, z: 0})
                const replacementBlockStateRuntimeId = baseBlockStateRuntimeId == stoneBlock ? dirtBlock : stoneBlock
                replacements.append(replacementBlockStateRuntimeId)
                edits.append({position: {x, y: 30, z: 0}, blockStateRuntimeId: replacementBlockStateRuntimeId})

            const batch = await runtime.editBlocks("concurrent", edits)
            expect(batch.changes.size).toBe(16)
            expect(batch.changes.every(change => change.revision == 1)).toBe(true)
            const after = await runtime.chunk("concurrent", {x: 0, y: 1, z: 0})
            expect(after.revision).toBe(1)
            for x in range(16): expect(chunkBlock(after, {x, y: 14, z: 0})).toBe(replacements[x])
        finally: await runtime.close()

        expect(await tableCount(databasePath, "chunk_states")).toBe(1)
        expect(await tableCount(databasePath, "block_overrides")).toBe(16)
    finally: await removeDatabase(databasePath)

test "SQLite adapter commits the maximum block batch without per-row statements":
    const databasePath = "openvoxel-maximum-overrides-test.sqlite"
    await removeDatabase(databasePath)
    try:
        const runtime = worldRuntime(await sqliteWorldStore(testDatabase(databasePath)))
        try:
            await runtime.createWorld({id: "maximum", name: "Maximum", seed: "maximum-batch"})
            const before = await runtime.chunk("maximum", {x: 0, y: 1, z: 0})
            const edits: List<BlockEdit> = []
            for localY in range(4):
                for localZ in range(16):
                    for localX in range(16):
                        const base = chunkBlock(before, {x: localX, y: localY, z: localZ})
                        edits.append({
                            position: {x: localX, y: 16 + localY, z: localZ},
                            blockStateRuntimeId: base == stoneBlock ? dirtBlock : stoneBlock,
                        })
            const batch = await runtime.editBlocks("maximum", edits)
            expect(batch.changes.size).toBe(1024)
            expect(batch.changes.every(change => change.revision == 1)).toBe(true)
        finally: await runtime.close()

        expect(await tableCount(databasePath, "chunk_states")).toBe(1)
        expect(await tableCount(databasePath, "block_overrides")).toBe(1024)
    finally: await removeDatabase(databasePath)

test "SQLite adapter persists the complete world block registry":
    const databasePath = "openvoxel-world-registry-test.sqlite"
    await removeDatabase(databasePath)
    try:
        const first = worldRuntime(await sqliteWorldStore(testDatabase(databasePath)))
        let createdContentHash = ""
        try:
            const created = await first.createWorld({id: "registry", name: "Registry", seed: "openvoxel"})
            createdContentHash = created.content.contentHash
        finally: await first.close()

        const reopened = worldRuntime(await sqliteWorldStore(testDatabase(databasePath)))
        try:
            const manifest = await reopened.requireWorld("registry")
            expect(manifest.generatorHash.size).toBe(64)
            expect(manifest.spawn.y > 0).toBe(true)
            expect(manifest.content.contentHash).toBe(createdContentHash)
            expect(manifest.content.packs.size).toBe(0)
            expect(manifest.blockRegistry.states.size).toBe(377)
            expect(manifest.blockRegistry.states[0]).toEqual({runtimeId: 0, stateKey: builtinIdentities.blocks.air})
        finally: await reopened.close()
        expect(await schemaVersion(databasePath)).toBe(sqliteSchemaVersion)
    finally: await removeDatabase(databasePath)

test "SQLite adapter rejects a persisted runtime id outside the world registry":
    const databasePath = "openvoxel-unknown-block-test.sqlite"
    await removeDatabase(databasePath)
    try:
        const firstStore = await sqliteWorldStore(testDatabase(databasePath))
        const firstRuntime = worldRuntime(firstStore)
        try:
            await firstRuntime.createWorld({id: "unknown", name: "Unknown", seed: "openvoxel"})
            await firstRuntime.editBlocks("unknown", [{
                position: {x: 0, y: 30, z: 0},
                blockStateRuntimeId: dirtBlock,
            }])
        finally: await firstRuntime.close()

        using database = await openSqlite(databasePath)
        await database.execute(trustedSqlTemplate([
            "UPDATE block_overrides SET block_state_runtime_id = ",
            "",
        ], [0xffffffff]))

        let rejected = false
        try:
            const reopened = worldRuntime(await sqliteWorldStore(testDatabase(databasePath)))
            try: await reopened.chunk("unknown", {x: 0, y: 1, z: 0})
            finally: await reopened.close()
        catch error: rejected = error.message.has("World block registry does not contain runtime id 4294967295")
        expect(rejected).toBe(true)
    finally: await removeDatabase(databasePath)

test "SQLite adapter rejects databases created by a newer server schema":
    const databasePath = "openvoxel-newer-schema-test.sqlite"
    await removeDatabase(databasePath)
    try:
        using database = await openSqlite(databasePath)
        await database.execute(sqlConcat([
            trustedSql("PRAGMA user_version = "),
            sqliteLiteral(999),
        ]))

        let rejected = false
        try:
            const incompatible = await sqliteWorldStore(testDatabase(databasePath))
            await incompatible.close()
        catch error: rejected = error.message.has("does not match required version")
        expect(rejected).toBe(true)
    finally: await removeDatabase(databasePath)

test "SQLite adapter rejects an incompatible climate schema without modifying stored overrides":
    const databasePath = "openvoxel-previous-schema-test.sqlite"
    await removeDatabase(databasePath)
    try:
        using previous = await openSqlite(databasePath)
        await previous.execute(trustedSql("CREATE TABLE chunk_states (world_id TEXT NOT NULL, chunk_x INTEGER NOT NULL, chunk_y INTEGER NOT NULL, chunk_z INTEGER NOT NULL, revision INTEGER NOT NULL, PRIMARY KEY (world_id, chunk_x, chunk_y, chunk_z))"))
        await previous.execute(trustedSql("INSERT INTO chunk_states VALUES ('legacy', 0, 0, 0, 5)"))
        await previous.execute(trustedSql("CREATE TABLE block_overrides (world_id TEXT NOT NULL, chunk_x INTEGER NOT NULL, chunk_y INTEGER NOT NULL, chunk_z INTEGER NOT NULL, local_x INTEGER NOT NULL, local_y INTEGER NOT NULL, local_z INTEGER NOT NULL, block_state_runtime_id INTEGER NOT NULL, PRIMARY KEY (world_id, chunk_x, chunk_y, chunk_z, local_x, local_y, local_z))"))
        await previous.execute(trustedSqlTemplate([
            "INSERT INTO block_overrides (world_id, chunk_x, chunk_y, chunk_z, local_x, local_y, local_z, block_state_runtime_id) VALUES ('legacy', 0, 0, 0, 1, 2, 3, ",
            ")",
        ], [stoneBlock]))
        await previous.execute(sqlConcat([
            trustedSql("PRAGMA user_version = "),
            sqliteLiteral(sqliteSchemaVersion - 1),
        ]))
        await previous.close()

        let rejected = false
        try:
            const incompatible = await sqliteWorldStore(testDatabase(databasePath))
            await incompatible.close()
        catch error: rejected = error.message.has("does not match required version")
        expect(rejected).toBe(true)
        expect(await schemaVersion(databasePath)).toBe(sqliteSchemaVersion - 1)
        expect(await tableCount(databasePath, "block_overrides")).toBe(1)
    finally: await removeDatabase(databasePath)
