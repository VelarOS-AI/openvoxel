import {Bytes} from "velar/binary"
import {TestResponse, client} from "velar/server-test"
import {Provider} from "velar/serve"
import {http} from "velar/http"
import {WebSocketConnection, connect} from "velar/websocket"
import {encode, parse} from "@velarscript-labs/msgpack"
import {expect} from "velar/test"
import {loadOpenVoxelConfiguration, serverOptions} from "../src/config.vel"
import {createOpenVoxelApp, startOpenVoxelServer} from "../src/server.vel"
import {OpenVoxelApplication, OpenVoxelServerOptions, openVoxelApplication, openVoxelApplicationProvider} from "../src/application.vel"
import {defaultBlockStateRuntimeId} from "@openvoxel/blocks"
import {builtinIdentities} from "@openvoxel/identities"
import {defaultGenerator} from "@openvoxel/world-generation"
import {ChunkPosition, WorldManifest, chunkBlock} from "@openvoxel/world"
import {BlockEditsAppliedEvent, ChunksSyncedEvent, ClientContractResponse, GenerationSampleResponse, SocketErrorEvent, TerrainChunkBatchResponse, WorldBlocksChangedEvent, WorldBootstrapResponse, WorldContentResponse, WorldReadyEvent, clientContractVersion, protocolVersion} from "@openvoxel/protocol"
import {memoryWorldStore, worldRuntime} from "@openvoxel/world-runtime"

// velar/websocket 的客户端目前不允许设置握手 Origin。这个宿主契约只用于验证
// 服务端拒绝不受信任的浏览器来源，不参与 OpenVoxel 的生产连接实现。
extern js`
    import WebSocket from "ws"

    export function rejectedWebSocketStatus(url, origin) {
        return new Promise((resolveStatus, rejectStatus) => {
            const socket = new WebSocket(url, {origin})
            let settled = false
            const finish = action => {
                if (settled) return
                settled = true
                clearTimeout(timer)
                action()
            }
            const timer = setTimeout(() => finish(() => rejectStatus(new Error("WebSocket rejection did not settle"))), 5000)
            socket.once("unexpected-response", (_request, response) => finish(() => {
                response.resume()
                resolveStatus(response.statusCode ?? 0)
            }))
            socket.once("open", () => finish(() => {
                socket.close()
                rejectStatus(new Error("WebSocket Origin was unexpectedly accepted"))
            }))
            socket.once("error", error => finish(() => rejectStatus(error)))
        })
    }
`:
    export def rejectedWebSocketStatus(url: string, origin: string) -> Promise<number>

const stoneBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.stone)
const dirtBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.dirt)

type HealthResponse:
    status: string
    service: string
    protocolVersion: number

type ProblemResponse:
    type: string
    title: string
    status: number
    code: string
    detail: string?
    instance: string?

type OpenApiResponse:
    openapi: string
    paths: Record<OpenApiPathItem>

type OpenApiOperation:
    operationId: string

type OpenApiPathItem:
    get: OpenApiOperation?
    post: OpenApiOperation?

async def problem(response: TestResponse) -> ProblemResponse: return ProblemResponse.parse(await response.json())

async def nextBinary(connection: WebSocketConnection) -> Bytes:
    const message = await connection.next()
    if not (message is Bytes): throw Error("Expected a binary realtime message")
    return message

def providerOverride(application: OpenVoxelApplication) -> Map<Provider, unknown>:
    const overrides: Map<Provider, unknown> = Map()
    const value: unknown = application
    overrides.set(Provider.parse(openVoxelApplicationProvider), value)
    return overrides

async def testApplication(port: number = 0) -> OpenVoxelApplication:
    const configuration = await loadOpenVoxelConfiguration()
    const configured = serverOptions(configuration, logger=false)
    const options = OpenVoxelServerOptions.from(configured, {
        host: "127.0.0.1",
        port,
        logger: false,
    })
    return openVoxelApplication(worldRuntime(memoryWorldStore()), options)

test "native HTTP exposes fixed terrain as REST resources and OpenAPI as route truth":
    const application = await testApplication()
    const api = await client(createOpenVoxelApp(application), providerOverride(application))
    try:
        const healthResponse = await api.get("/api/health")
        expect(healthResponse.status).toBe(200)
        const health = HealthResponse.parse(await healthResponse.json())
        expect(health.status).toBe("ready")
        expect(health.protocolVersion).toBe(protocolVersion)

        const contractResponse = await api.get("/api")
        const contract = ClientContractResponse.parse(await contractResponse.json())
        expect(contract.contractVersion).toBe(clientContractVersion)
        expect(contract.http).toEqual({encoding: "json", descriptionFormat: "openapi-3.1"})
        expect(contract.realtime.commands).toEqual(["chunks.sync", "blocks.apply"])
        expect(contract.chunks.indexOrder).toBe("x + edge * (z + edge * y)")
        expect(contract.limits.requestBodyBytes).toBe(65536)

        const openApiResponse = await api.get("/api/openapi.json")
        const openApi = OpenApiResponse.parse(await openApiResponse.json())
        expect(openApi.openapi).toBe("3.1.0")
        expect(openApi.paths.has("/api/worlds/{worldId}/terrain/chunks")).toBe(true)
        expect(openApi.paths.has("/api/worlds/{worldId}/terrain/samples/{blockX}/{blockZ}")).toBe(true)
        expect(openApi.paths["/api"]!.get!.operationId).toBe("clientContract")
        expect(openApi.paths["/api/worlds/{worldId}/bootstrap"]!.get!.operationId).toBe("worldBootstrap")
        expect(openApi.paths["/api/worlds/{worldId}/content"]!.get!.operationId).toBe("worldContent")
        expect(openApi.paths["/api/worlds/{worldId}/terrain/chunks"]!.post!.operationId).toBe("terrainChunks")
        expect(openApi.paths["/api/worlds/{worldId}/realtime"]!.get!.operationId).toBe("worldRealtime")
        expect(openApi.paths.keys().some(path => path.has("/blocks/{blockX}"))).toBe(false)

        const worldResponse = await api.post("/api/worlds", {json: {
            id: "transport",
            name: "Transport",
            seed: "transport-seed",
        }})
        expect(worldResponse.status).toBe(201)
        const world = WorldManifest.parse(await worldResponse.json())
        expect(world.chunkEdge).toBe(16)
        expect(world.generator).toBe(defaultGenerator)
        expect(world.blockRegistry.states.size).toBe(183)
        expect(worldResponse.headers.get("location")).toBe("/api/worlds/transport")

        const worldResourceResponse = await api.get("/api/worlds/transport")
        expect(WorldManifest.parse(await worldResourceResponse.json())).toEqual(world)

        const duplicateResponse = await api.post("/api/worlds", {json: {
            id: "transport",
            name: "Transport",
            seed: "transport-seed",
        }})
        expect(duplicateResponse.status).toBe(409)
        expect((await problem(duplicateResponse)).code).toBe("world.already_exists")

        const unknownGeneratorResponse = await api.post("/api/worlds", {json: {
            id: "unknown-generator",
            name: "Unknown Generator",
            seed: "transport-seed",
            generator: "openvoxel:missing",
        }})
        expect(unknownGeneratorResponse.status).toBe(422)
        expect((await problem(unknownGeneratorResponse)).code).toBe("request.invalid")

        const catalogResponse = await api.get(f"/api/worlds/{world.id}/content")
        const catalog = WorldContentResponse.parse(await catalogResponse.json())
        expect(catalog.schemaVersion).toBe(3)
        expect(catalog.content.contentHash).toBe(world.content.contentHash)
        expect(catalog.blocks.size).toBe(38)
        expect(catalog.componentProfiles.size).toBe(38)
        expect(catalog.states.size).toBe(183)
        const catalogEtag = catalogResponse.headers.get("etag")
        expect(catalogEtag).toBe(f`"{catalog.content.contentHash}-{catalog.stateMapHash}"`)
        const cachedCatalogResponse = await api.get(f"/api/worlds/{world.id}/content", {headers: Map([["if-none-match", catalogEtag ?? ""]])})
        expect(cachedCatalogResponse.status).toBe(304)

        const bootstrapResponse = await api.get(f"/api/worlds/{world.id}/bootstrap")
        const bootstrap = WorldBootstrapResponse.parse(await bootstrapResponse.json())
        expect(bootstrap.protocolVersion).toBe(protocolVersion)
        expect(bootstrap.clientContractVersion).toBe(clientContractVersion)
        expect(bootstrap.blockRegistry).toEqual(world.blockRegistry)
        expect(bootstrap.content.contentHash).toBe(catalog.content.contentHash)
        expect(bootstrap.contentStateMapHash).toBe(catalog.stateMapHash)
        expect(bootstrap.maximumChunkBatchSize).toBe(64)

        const invalidBatchResponse = await api.post(f"/api/worlds/{world.id}/terrain/chunks", {json: {}})
        expect(invalidBatchResponse.status).toBe(422)
        expect((await problem(invalidBatchResponse)).code).toBe("request.invalid.request")

        const fractionalBatchResponse = await api.post(f"/api/worlds/{world.id}/terrain/chunks", {json: {
            positions: [{x: 0.5, y: 1, z: 0}],
        }})
        expect(fractionalBatchResponse.status).toBe(422)
        expect((await problem(fractionalBatchResponse)).code).toBe("request.invalid")

        const terrainResponse = await api.post(f"/api/worlds/{world.id}/terrain/chunks", {json: {
            positions: [{x: 0, y: 1, z: 0}, {x: -1, y: 1, z: 2}],
        }})
        const terrain = TerrainChunkBatchResponse.parse(await terrainResponse.json())
        expect(terrain.worldId).toBe(world.id)
        expect(terrain.chunks.size).toBe(2)
        expect(terrain.chunks[0].indices.size).toBe(4096)
        expect(terrain.chunks[1].position).toEqual({x: -1, y: 1, z: 2})

        const sampleResponse = await api.get(f"/api/worlds/{world.id}/terrain/samples/0/0")
        const sample = GenerationSampleResponse.parse(await sampleResponse.json())
        expect(sample.position).toEqual({x: 0, z: 0})
        expect(sample.surfaceY).toBe(61)
        expect(sample.biome).toBe(builtinIdentities.biomes.ocean)

        const missing = await api.get("/api/missing")
        expect(missing.status).toBe(404)
        expect((await problem(missing)).code).toBe("route.not_found")

        const preflight = await api.request("OPTIONS", f"/api/worlds/{world.id}/content", {headers: Map([
            ["origin", "http://127.0.0.1:5173"],
            ["access-control-request-method", "GET"],
            ["access-control-request-headers", "if-none-match"],
        ])})
        expect(preflight.status).toBe(204)
        expect(preflight.headers.get("access-control-allow-origin")).toBe("http://127.0.0.1:5173")

        const deniedPreflight = await api.request("OPTIONS", f"/api/worlds/{world.id}/content", {headers: Map([
            ["origin", "https://untrusted.example"],
            ["access-control-request-method", "GET"],
        ])})
        expect(deniedPreflight.status).toBe(403)
    finally:
        await api.close()
        await application.close()

test "native HTTP compresses large cold terrain batches":
    const application = await testApplication()
    const world = await application.runtime.createWorld({id: "compressed", name: "Compressed", seed: "transport-compression"})
    const server = await startOpenVoxelServer(application)
    try:
        const positions: List<ChunkPosition> = []
        for x in range(16): positions.append({x, y: 1, z: 0})
        const url = f"http://127.0.0.1:{server.port}/api/worlds/{world.id}/terrain/chunks"
        const compressed = await http.post(url, {
            headers: Map([
                ["content-type", "application/json"],
                ["accept-encoding", "gzip"],
            ]),
            body: {positions},
            maxBytes: 16 * 1024 * 1024,
        }).response()
        const compressedBytes = await compressed.bytes()
        expect(compressed.headers.get("content-encoding")).toBe("gzip")

        const identity = await http.post(url, {
            headers: Map([
                ["content-type", "application/json"],
                ["accept-encoding", "identity"],
            ]),
            body: {positions},
            maxBytes: 16 * 1024 * 1024,
        }).response()
        const identityBytes = await identity.bytes()
        expect(identity.headers.get("content-encoding")).toBe(null)
        expect(compressedBytes.size < identityBytes.size).toBe(true)
    finally: await server.stop()

test "failed native listen releases its supplied application and preserves the listen error":
    const owner = await testApplication()
    const running = await startOpenVoxelServer(owner)
    try:
        const rejected = await testApplication(running.port)
        await rejected.runtime.createWorld({id: "listen-failure", name: "Listen Failure", seed: "listen-failure"})
        let listenMessage = ""
        try: await startOpenVoxelServer(rejected)
        catch error: listenMessage = error.message
        expect(not listenMessage.isBlank()).toBe(true)

        let runtimeMessage = ""
        try: await rejected.runtime.requireWorld("listen-failure")
        catch error: runtimeMessage = error.message
        expect(runtimeMessage.has("closed")).toBe(true)
    finally: await running.stop()

test "world-scoped WebSocket synchronizes hot deltas and applies atomic batches":
    const application = await testApplication()
    const world = await application.runtime.createWorld({id: "realtime", name: "Realtime", seed: "realtime-seed"})
    const otherWorld = await application.runtime.createWorld({id: "other", name: "Other", seed: "other-seed"})
    const generated = await application.runtime.terrainChunks(world.id, [{x: 0, y: 1, z: 0}])
    const firstBase = chunkBlock(generated[0], {x: 0, y: 14, z: 0})
    const secondBase = chunkBlock(generated[0], {x: 1, y: 14, z: 0})
    const firstReplacement = firstBase == stoneBlock ? dirtBlock : stoneBlock
    const secondReplacement = secondBase == stoneBlock ? dirtBlock : stoneBlock
    const server = await startOpenVoxelServer(application)
    try:
        const deniedStatus = await rejectedWebSocketStatus(
            f"ws://127.0.0.1:{server.port}/api/worlds/{world.id}/realtime",
            "https://untrusted.example",
        )
        expect(deniedStatus).toBe(403)

        using missing = await connect(f"ws://127.0.0.1:{server.port}/api/worlds/missing/realtime")
        expect(parse(await nextBinary(missing), SocketErrorEvent).code).toBe("world.not_found")
        const missingClose = await missing.closeInfo()
        expect(missingClose.code).toBe(1008)
        expect(missingClose.reason).toBe("World is unavailable")

        using sender = await connect(f"ws://127.0.0.1:{server.port}/api/worlds/{world.id}/realtime")
        using observer = await connect(f"ws://127.0.0.1:{server.port}/api/worlds/{world.id}/realtime")
        using isolated = await connect(f"ws://127.0.0.1:{server.port}/api/worlds/{otherWorld.id}/realtime")
        const senderReady = parse(await nextBinary(sender), WorldReadyEvent)
        const observerReady = parse(await nextBinary(observer), WorldReadyEvent)
        const isolatedReady = parse(await nextBinary(isolated), WorldReadyEvent)
        expect(senderReady.worldId).toBe(world.id)
        expect(observerReady.worldId).toBe(world.id)
        expect(isolatedReady.worldId).toBe(otherWorld.id)
        expect(senderReady.sequence).toBe(0)
        expect(observerReady.sequence).toBe(0)
        expect(isolatedReady.sequence).toBe(0)

        await sender.send(encode({operation: "delete-world", requestId: "unsupported"}))
        const unsupported = parse(await nextBinary(sender), SocketErrorEvent)
        expect(unsupported.requestId).toBe("unsupported")
        expect(unsupported.code).toBe("realtime.unsupported_operation")

        await sender.send(encode({operation: "blocks.apply", requestId: "malformed"}))
        expect(parse(await nextBinary(sender), SocketErrorEvent).code).toBe("request.invalid")

        await sender.send("blocks.apply")
        expect(parse(await nextBinary(sender), SocketErrorEvent).code).toBe("realtime.text_unsupported")

        await sender.send(encode({
            operation: "blocks.apply",
            requestId: "invalid-state",
            edits: [{position: {x: 0, y: 30, z: 0}, blockStateRuntimeId: 65535}],
        }))
        expect(parse(await nextBinary(sender), SocketErrorEvent).code).toBe("block.unknown_state")

        await sender.send(encode({
            operation: "chunks.sync",
            requestId: "initial-sync",
            positions: [{x: 0, y: 1, z: 0}],
        }))
        const initialSync = parse(await nextBinary(sender), ChunksSyncedEvent)
        expect(initialSync.worldId).toBe(world.id)
        expect(initialSync.chunks[0].revision).toBe(0)
        expect(initialSync.chunks[0].overrides.size).toBe(0)

        const coldBeforeResponse = await client(createOpenVoxelApp(application), providerOverride(application))
        let coldBefore: TerrainChunkBatchResponse? = null
        try:
            const response = await coldBeforeResponse.post(f"/api/worlds/{world.id}/terrain/chunks", {json: {
                positions: [{x: 0, y: 1, z: 0}],
            }})
            coldBefore = TerrainChunkBatchResponse.parse(await response.json())
        finally: await coldBeforeResponse.close()

        await sender.send(encode({
            operation: "blocks.apply",
            requestId: "edit-batch",
            edits: [
                {position: {x: 0, y: 30, z: 0}, blockStateRuntimeId: firstReplacement},
                {position: {x: 1, y: 30, z: 0}, blockStateRuntimeId: secondReplacement},
            ],
        }))
        const senderChanged = parse(await nextBinary(sender), WorldBlocksChangedEvent)
        const applied = parse(await nextBinary(sender), BlockEditsAppliedEvent)
        const observed = parse(await nextBinary(observer), WorldBlocksChangedEvent)
        expect(applied.requestId).toBe("edit-batch")
        expect(applied.worldId).toBe(world.id)
        expect(applied.sequence).toBe(1)
        expect(applied.changes.size).toBe(2)
        expect(applied.changes.every(change => change.revision == 1)).toBe(true)
        expect(senderChanged).toEqual(observed)
        expect(observed.sequence).toBe(applied.sequence)
        expect(observed.changes).toEqual(applied.changes)

        // 新连接的 ready 必须携带订阅瞬间的世界游标。客户端会先以该游标建立
        // 新连接代际，再同步自己跟踪的 Chunk，因此不会把重连前的序号误判为缺口。
        using reconnected = await connect(f"ws://127.0.0.1:{server.port}/api/worlds/{world.id}/realtime")
        const reconnectedReady = parse(await nextBinary(reconnected), WorldReadyEvent)
        expect(reconnectedReady.worldId).toBe(world.id)
        expect(reconnectedReady.sequence).toBe(1)

        // 另一个世界没有收到上面的广播；它的下一条消息只能是自己的同步响应。
        await isolated.send(encode({
            operation: "chunks.sync",
            requestId: "isolated-sync",
            positions: [{x: 0, y: 1, z: 0}],
        }))
        const isolatedSync = parse(await nextBinary(isolated), ChunksSyncedEvent)
        expect(isolatedSync.requestId).toBe("isolated-sync")
        expect(isolatedSync.worldId).toBe(otherWorld.id)

        await sender.send(encode({
            operation: "chunks.sync",
            requestId: "updated-sync",
            positions: [{x: 0, y: 1, z: 0}],
        }))
        const updatedSync = parse(await nextBinary(sender), ChunksSyncedEvent)
        expect(updatedSync.chunks[0].revision).toBe(1)
        expect(updatedSync.chunks[0].overrides.size).toBe(2)

        const resolved = await application.runtime.chunk(world.id, {x: 0, y: 1, z: 0})
        expect(resolved.revision).toBe(1)
        expect(chunkBlock(resolved, {x: 0, y: 14, z: 0})).toBe(firstReplacement)
        expect(chunkBlock(resolved, {x: 1, y: 14, z: 0})).toBe(secondReplacement)

        const coldAfterClient = await client(createOpenVoxelApp(application), providerOverride(application))
        try:
            const response = await coldAfterClient.post(f"/api/worlds/{world.id}/terrain/chunks", {json: {
                positions: [{x: 0, y: 1, z: 0}],
            }})
            const coldAfter = TerrainChunkBatchResponse.parse(await response.json())
            assert coldBefore != null else "Expected the fixed terrain baseline"
            expect(coldAfter).toEqual(coldBefore)
        finally: await coldAfterClient.close()
    finally: await server.stop()
