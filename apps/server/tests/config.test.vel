import {expect} from "velar/test"
import {resolve} from "velar/path"
import {applicationConfigurationPath} from "velar/server"
import {OpenVoxelConfiguration, ServerConfiguration, ServerLimitsConfiguration, loadOpenVoxelConfiguration, openVoxelConfigurationPath, resolveServerPath, serverApplicationRoot, serverOptions, withResolvedRuntimePaths} from "../src/config.vel"
import {validateOpenVoxelServerOptions} from "../src/application.vel"

test "server YAML configuration owns network and database settings":
    const configuration = await loadOpenVoxelConfiguration()
    expect(configuration.server.host).toBe("127.0.0.1")
    expect(configuration.server.port).toBe(3000)
    expect(configuration.server.cors.allowedOrigins).toContain("http://127.0.0.1:7173")
    expect(configuration.server.cors.allowedOrigins).toContain("http://localhost:7173")
    expect(configuration.database.path).toBe("openvoxel.sqlite")
    expect(configuration.database.maxRows).toBe(262144)
    expect(configuration.content.packArtifacts.size).toBe(0)
    expect(configuration.worldRuntime.activeWorldCapacity).toBe(64)
    expect(configuration.worldRuntime.activeChunkCapacity).toBe(2048)
    expect(configuration.worldRuntime.activeOverrideCapacity).toBe(262144)
    expect(applicationConfigurationPath).toBe("application.yml")
    expect(openVoxelConfigurationPath()).toBe(resolve(["application.yml"]))
    expect(resolveServerPath("application.yml")).toBe(resolve([serverApplicationRoot(), "application.yml"]))
    const runtimeConfiguration = withResolvedRuntimePaths(configuration)
    expect(runtimeConfiguration.database.path).toBe(resolve([serverApplicationRoot(), "openvoxel.sqlite"]))
    const options = serverOptions(configuration)
    expect(options.bodyLimit).toBe(65536)
    expect(options.corsAllowedOrigins.size).toBe(2)
    expect(options.maxConnections).toBe(128)
    expect(options.maxConcurrentRequests).toBe(256)
    expect(options.realtimeDrainMilliseconds).toBe(5000)

test "the server option owner rejects invalid limits before resources are opened":
    const configuration = await loadOpenVoxelConfiguration()
    const invalidLimits = ServerLimitsConfiguration.from(configuration.server.limits, {concurrentRequests: 0})
    const invalidServer = ServerConfiguration.from(configuration.server, {limits: invalidLimits})
    const invalid = OpenVoxelConfiguration.from(configuration, {server: invalidServer})
    expect(() => validateOpenVoxelServerOptions(serverOptions(invalid))).toThrow()
