{
  "name": "@openvoxel/identities",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "data",
    "generated",
    "src"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./identity-data": "./generated/identities.json"
  },
  "velar": {
    "entry": "src/index.vel",
    "targets": ["core", "node", "web", "desktop"],
    "requires": {"capabilities": []},
    "resources": {
      "./identity-data": {
        "path": "generated/identities.json",
        "type": "json"
      }
    }
  },
  "scripts": {
    "generate": "velar run tools/generate.vel",
    "generate:check": "velar run tools/check-generated.vel",
    "check": "velar check",
    "format": "velar format",
    "format:check": "velar format --check",
    "test": "velar test",
    "build": "velar build"
  },
  "dependencies": {
    "@velarscript-labs/yaml": "0.1.4"
  },
  "devDependencies": {
    "@velarscript/cli": "0.16.0",
    "@velarscript/node": "0.16.0"
  }
}
