import {exists, makeDirectory, readText, writeText} from "velar/fs"
import {parseYaml} from "@velarscript-labs/yaml"
import {sha256Text} from "velar/hash"
import {IdentityCatalogArtifact} from "../src/catalog.vel"
import {BuiltinIdentities, BuiltinIdentityDocument} from "../src/identities.vel"
import {collectIdentityLeafPaths} from "../src/identity-resolution.vel"

export async def generatedIdentityCatalogText() -> string:
    const sourceDocument = BuiltinIdentityDocument.parse(parseYaml(await readText("data/identities.yml", 256 * 1024)))
    assert sourceDocument.formatVersion == 3 else "Unsupported identity source format version"
    BuiltinIdentities.parse(sourceDocument.identities)
    collectIdentityLeafPaths(sourceDocument.identities)
    const artifact: IdentityCatalogArtifact = {
        artifactVersion: 1,
        contentHash: sha256Text(Json.stableStringify(sourceDocument.identities)),
        identities: sourceDocument.identities,
    }
    return f"{Json.stableStringify(artifact, 2)}\n"

@main:
    const generatedDirectory = "generated"
    if not await exists(generatedDirectory): await makeDirectory(generatedDirectory)
    const path = "generated/identities.json"
    const output = await generatedIdentityCatalogText()
    if not await exists(path) or await readText(path, 512 * 1024) != output: await writeText(path, output)
