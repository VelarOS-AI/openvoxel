import {expect} from "velar/test"
import {BuiltinIdentityDocument, IdentityResolution, resolveIdentityReferences} from "../src/index.vel"

test "identity documents preserve and resolve data-only paths without a VelarScript field declaration":
    const identityDocument = BuiltinIdentityDocument.parse({
        formatVersion: 3,
        identities: {
            futureResources: {
                experimentalModel: "example:model/block/experimental",
            },
        },
    })
    const resolved = IdentityResolution.parse(resolveIdentityReferences(
        {model: "futureResources.experimentalModel"},
        identityDocument.identities,
    ))
    assert resolved.value is Record<unknown> else "Resolved identity example must remain a record"
    expect(resolved.value["model"]).toBe("example:model/block/experimental")
    expect(resolved.usedPaths).toEqual(["futureResources.experimentalModel"])
