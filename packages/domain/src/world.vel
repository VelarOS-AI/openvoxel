import {requireChunkEdge} from "./coordinates.vel"
import {blockCatalogVersion, blockIdMapHash} from "@openvoxel/blocks"

export const worldFormatVersion = 1
export const initialChunkEdge = 16
export const defaultGenerator = "openvoxel:survival-v1"
export const maximumChunkBatchSize = 64

export type CreateWorld:
    id: string
    name: string
    seed: string

export type WorldManifest extends CreateWorld:
    formatVersion: number
    chunkEdge: number
    generator: string
    blockCatalogVersion: string
    blockIdMapHash: string

export class WorldBlockCatalogMismatchError extends Error:
    constructor(
        const worldId: string,
        const actualCatalogVersion: string,
        const actualIdMapHash: string,
        const expectedCatalogVersion: string = blockCatalogVersion,
        const expectedIdMapHash: string = blockIdMapHash,
    ):
        super(f"World '{worldId}' uses block catalog {actualCatalogVersion}/{actualIdMapHash}; this server requires {expectedCatalogVersion}/{expectedIdMapHash}")

def requireBoundedText(value: string, label: string, maximum: number):
    assert not value.isBlank() else f"{label} cannot be blank"
    assert value.size <= maximum else f"{label} is too long"

export def validateWorldManifest(manifest: WorldManifest) -> WorldManifest:
    requireBoundedText(manifest.id, "World id", 64)
    requireBoundedText(manifest.name, "World name", 80)
    requireBoundedText(manifest.seed, "World seed", 128)
    assert manifest.formatVersion == worldFormatVersion else "Unsupported world format version"
    requireChunkEdge(manifest.chunkEdge)
    assert manifest.chunkEdge == initialChunkEdge else "World format v1 requires a chunk edge of 16"
    assert manifest.generator == defaultGenerator else "Unsupported world generator"
    if manifest.blockCatalogVersion != blockCatalogVersion or manifest.blockIdMapHash != blockIdMapHash:
        throw WorldBlockCatalogMismatchError(manifest.id, manifest.blockCatalogVersion, manifest.blockIdMapHash)
    return manifest

export def createWorldManifest(command: CreateWorld) -> WorldManifest:
    return validateWorldManifest({
        id: command.id.trim(),
        name: command.name.trim(),
        seed: command.seed.trim(),
        formatVersion: worldFormatVersion,
        chunkEdge: initialChunkEdge,
        generator: defaultGenerator,
        blockCatalogVersion,
        blockIdMapHash,
    })
