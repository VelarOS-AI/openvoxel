import {expect} from "velar/test"
import {checkWorldCoordinates} from "./testing/property-check.vel"
import {BlockOcclusion, airBlock, blockCatalog, blockDefinition, coalOreBlock, copperOreBlock, diamondOreBlock, germaniumOreBlock, ironOreBlock, magmaBlock, saltpeterOreBlock, sandBlock, spruceLeavesBlock, stoneBlock, sulphurOreBlock, waterBlock} from "@openvoxel/blocks"
import {Chunk, blockIndex, chunkChecksum} from "./chunk.vel"
import {Coordinate2, Coordinate3, chunkCoordinate, localCoordinate, locateBlock} from "./coordinates.vel"
import {generateChunk} from "./generator.vel"
import {maximumWorldY, minimumWorldY, sampleTerrain, seaLevel} from "./generation/terrain.vel"
import {createWorldManifest} from "./world.vel"

def coordinateRoundTrip(position: Coordinate3) -> bool:
    const located = locateBlock(position, 16)
    return located.chunk.x * 16 + located.local.x == position.x and located.chunk.y * 16 + located.local.y == position.y and located.chunk.z * 16 + located.local.z == position.z

def countBlock(chunk: Chunk, blockId: number) -> number:
    let count = 0
    for index in range(chunk.blocks.size):
        if chunk.blocks[index] == blockId:
            count += 1
    return count

test "negative world coordinates map to stable chunks":
    expect(chunkCoordinate(-17, 16)).toBe(-2)
    expect(localCoordinate(-17, 16)).toBe(15)
    expect(chunkCoordinate(-16, 16)).toBe(-1)
    expect(localCoordinate(-16, 16)).toBe(0)
    expect(chunkCoordinate(-1, 16)).toBe(-1)
    expect(localCoordinate(-1, 16)).toBe(15)
    expect(chunkCoordinate(0, 16)).toBe(0)
    expect(localCoordinate(0, 16)).toBe(0)
    expect(chunkCoordinate(15, 16)).toBe(0)
    expect(localCoordinate(15, 16)).toBe(15)
    expect(chunkCoordinate(16, 16)).toBe(1)
    expect(localCoordinate(16, 16)).toBe(0)

test "coordinate decomposition round trips for generated values":
    checkWorldCoordinates(coordinateRoundTrip)

test "three dimensional coordinates inherit the horizontal coordinate contract":
    const position = Coordinate3.parse({x: 4, y: 8, z: 12})
    expect(Coordinate2.is(position)).toBe(true)
    expect(position.y).toBe(8)

test "chunk storage uses x z y order without collisions":
    expect(blockIndex({x: 0, y: 0, z: 0}, 16)).toBe(0)
    expect(blockIndex({x: 15, y: 0, z: 0}, 16)).toBe(15)
    expect(blockIndex({x: 0, y: 0, z: 1}, 16)).toBe(16)
    expect(blockIndex({x: 0, y: 1, z: 0}, 16)).toBe(256)
    expect(blockIndex({x: 15, y: 15, z: 15}, 16)).toBe(4095)

test "generator is deterministic across positive and negative chunks":
    const manifest = createWorldManifest({id: "deterministic", name: "Deterministic", seed: "openvoxel"})
    const first = generateChunk(manifest, {x: -3, y: 0, z: 5})
    const second = generateChunk(manifest, {x: -3, y: 0, z: 5})
    const other = generateChunk(manifest, {x: -2, y: 0, z: 5})
    expect(chunkChecksum(first)).toBe(chunkChecksum(second))
    expect(chunkChecksum(first) == chunkChecksum(other)).toBe(false)
    expect(first.blocks.size).toBe(4096)

test "three dimensional lookup crosses chunk boundaries":
    const located = locateBlock({x: -1, y: 16, z: 32}, 16)
    expect(located.chunk).toEqual({x: -1, y: 1, z: 2})
    expect(located.local).toEqual({x: 15, y: 0, z: 0})
    expect(airBlock).toBe(0)
    expect(stoneBlock).toBe(3)

test "survival generator exposes stable climate and world limits":
    const sample = sampleTerrain("openvoxel", {x: 0, z: 0})
    expect(seaLevel).toBe(64)
    expect(minimumWorldY).toBe(0)
    expect(maximumWorldY).toBe(255)
    expect(sample.surfaceY).toBe(66)
    expect(sample.temperature).toBe(7)
    expect(sample.humidity).toBe(3)
    expect(sample.biome).toBe("plains")

test "block catalog keeps persisted identifiers stable":
    expect(blockCatalog().size).toBe(38)
    expect(blockDefinition(airBlock).key).toBe("openvoxel:air")
    expect(blockDefinition(stoneBlock).key).toBe("openvoxel:stone")
    expect(blockDefinition(spruceLeavesBlock).simulation.occlusion).toBe(BlockOcclusion.empty)

test "world generation covers oceans caves fluids and all mineral families":
    const manifest = createWorldManifest({id: "palette", name: "Palette", seed: "openvoxel"})
    const ocean = generateChunk(manifest, {x: -10, y: 3, z: -10})
    expect(countBlock(ocean, waterBlock) > 0).toBe(true)
    expect(countBlock(ocean, sandBlock) > 0).toBe(true)

    const fluid = generateChunk(manifest, {x: -1, y: 1, z: -1})
    expect(countBlock(fluid, magmaBlock) > 0).toBe(true)
    expect(countBlock(fluid, sulphurOreBlock) > 0).toBe(true)

    const shallow = generateChunk(manifest, {x: 0, y: 2, z: 0})
    expect(countBlock(shallow, airBlock) > 0).toBe(true)

    const iron = generateChunk(manifest, {x: 0, y: 0, z: 0})
    const coal = generateChunk(manifest, {x: 0, y: 1, z: 0})
    const copper = generateChunk(manifest, {x: 0, y: 3, z: 0})
    const diamond = generateChunk(manifest, {x: 0, y: 0, z: 1})
    const germanium = generateChunk(manifest, {x: 1, y: 0, z: 0})
    const saltpeter = generateChunk(manifest, {x: -5, y: 3, z: 6})
    const undergroundWater = generateChunk(manifest, {x: 1, y: 1, z: -1})
    expect(countBlock(iron, ironOreBlock) > 0).toBe(true)
    expect(countBlock(coal, coalOreBlock) > 0).toBe(true)
    expect(countBlock(copper, copperOreBlock) > 0).toBe(true)
    expect(countBlock(diamond, diamondOreBlock) > 0).toBe(true)
    expect(countBlock(germanium, germaniumOreBlock) > 0).toBe(true)
    expect(countBlock(saltpeter, saltpeterOreBlock) > 0).toBe(true)
    expect(countBlock(undergroundWater, waterBlock) > 0).toBe(true)

test "feature owners continue tree crowns across cubic chunk seams":
    const manifest = createWorldManifest({id: "seam", name: "Seam", seed: "openvoxel"})
    const left = generateChunk(manifest, {x: -9, y: 4, z: 1})
    const right = generateChunk(manifest, {x: -8, y: 4, z: 1})
    expect(left.get({x: 15, y: 5, z: 12})).toBe(spruceLeavesBlock)
    expect(right.get({x: 0, y: 5, z: 12})).toBe(spruceLeavesBlock)
    const repeated = generateChunk(manifest, {x: -9, y: 4, z: 1})
    expect(chunkChecksum(repeated)).toBe(chunkChecksum(left))

test "generator returns empty chunks outside the version one vertical range":
    const manifest = createWorldManifest({id: "bounds", name: "Bounds", seed: "openvoxel"})
    const below = generateChunk(manifest, {x: 0, y: -1, z: 0})
    const above = generateChunk(manifest, {x: 0, y: 16, z: 0})
    expect(countBlock(below, airBlock)).toBe(4096)
    expect(countBlock(above, airBlock)).toBe(4096)

test "survival generator golden chunks detect accidental algorithm drift":
    const manifest = createWorldManifest({id: "golden", name: "Golden", seed: "openvoxel"})
    expect(chunkChecksum(generateChunk(manifest, {x: 0, y: 0, z: 0}))).toBe(565829698)
    expect(chunkChecksum(generateChunk(manifest, {x: 0, y: 3, z: 0}))).toBe(2216434414)
    expect(chunkChecksum(generateChunk(manifest, {x: -10, y: 3, z: -10}))).toBe(2218300903)
