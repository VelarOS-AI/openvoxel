import {Chunk, emptyChunk} from "./chunk.vel"
import {blockId, isFluidBlock} from "@openvoxel/blocks"
import {ChunkPosition, Coordinate2} from "./coordinates.vel"
import {WorldManifest, validateWorldManifest} from "./world.vel"
import {carveCaves, cavePlanner, generateFluidPockets, generateMinerals, generateVegetation} from "./generation/features.vel"
import {ColumnCache, GenerationFields, TerrainSample, baseTerrainBlock, columnPlanner, createGenerationFields, maximumWorldY, minimumWorldY, sampleTerrainWithFields, subsurfaceBlock, surfaceBlock} from "./generation/terrain.vel"

const airBlock = blockId("openvoxel:air")

def chunkMinimumX(chunk: Chunk) -> number:
    return chunk.position.x * chunk.edge

def chunkMinimumY(chunk: Chunk) -> number:
    return chunk.position.y * chunk.edge

def chunkMinimumZ(chunk: Chunk) -> number:
    return chunk.position.z * chunk.edge

def insideY(chunk: Chunk, y: number) -> bool:
    const minimumY = chunkMinimumY(chunk)
    return y >= minimumY and y < minimumY + chunk.edge

def indexAt(chunk: Chunk, worldX: number, worldY: number, worldZ: number) -> number:
    const localX = worldX - chunkMinimumX(chunk)
    const localY = worldY - chunkMinimumY(chunk)
    const localZ = worldZ - chunkMinimumZ(chunk)
    return localX + chunk.edge * (localZ + chunk.edge * localY)

def generateBaseTerrain(chunk: Chunk, fields: GenerationFields, cache: ColumnCache):
    const minimumY = chunkMinimumY(chunk)
    for localX in range(chunk.edge):
        for localZ in range(chunk.edge):
            const sample = cache.samples[localZ + chunk.edge * localX]
            for localY in range(chunk.edge):
                const worldY = minimumY + localY
                const index = localX + chunk.edge * (localZ + chunk.edge * localY)
                chunk.blocks[index] = baseTerrainBlock(fields, sample, worldY)

def paintSurfaceColumn(chunk: Chunk, sample: TerrainSample, topY: number):
    const topBlock = surfaceBlock(sample, topY)
    const underBlock = subsurfaceBlock(sample, topY)
    let thickness = 4
    if sample.mountainFactor > 0.9:
        thickness = 2
    else if sample.humidity > 11:
        thickness = 6
    for depth in range(thickness):
        const worldY = topY - depth
        if not insideY(chunk, worldY):
            continue
        const index = indexAt(chunk, sample.position.x, worldY, sample.position.z)
        if chunk.blocks[index] != airBlock and not isFluidBlock(chunk.blocks[index]):
            chunk.blocks[index] = depth == 0 ? topBlock : underBlock

def generateSurface(chunk: Chunk, cache: ColumnCache):
    for localX in range(chunk.edge):
        for localZ in range(chunk.edge):
            const index = localZ + chunk.edge * localX
            paintSurfaceColumn(chunk, cache.samples[index], cache.surfaceHeights[index])

export type WorldGenerator:
    sample: (position: Coordinate2) -> TerrainSample
    generate: (position: ChunkPosition) -> Chunk

export def worldGenerator(manifest: WorldManifest) -> WorldGenerator:
    const world = validateWorldManifest(manifest)
    const seed = world.seed
    const edge = world.chunkEdge
    const fields = createGenerationFields(seed)
    const columns = columnPlanner(fields, edge)
    const caves = cavePlanner(fields, seed)

    def sample(position: Coordinate2) -> TerrainSample:
        return sampleTerrainWithFields(fields, position)

    def generate(position: ChunkPosition) -> Chunk:
        const chunk = emptyChunk(position, edge)
        const minimumY = position.y * edge
        const maximumY = minimumY + edge - 1
        if maximumY < minimumWorldY or minimumY > maximumWorldY:
            return chunk

        const cache = columns.columns(position.x, position.z)
        generateBaseTerrain(chunk, fields, cache)
        carveCaves(chunk, caves)
        generateFluidPockets(chunk, seed)
        generateMinerals(chunk, seed)
        generateSurface(chunk, cache)
        generateVegetation(chunk, fields, seed, cache)
        return chunk

    return {sample, generate}

export def generateChunk(manifest: WorldManifest, position: ChunkPosition) -> Chunk:
    return worldGenerator(manifest).generate(position)
