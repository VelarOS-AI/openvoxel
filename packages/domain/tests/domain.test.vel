import {expect} from "velar/test"
import {checkWorldCoordinates} from "./support/property-check.vel"
import {BlockShapeKind, blockCatalog, blockTypeDefinition, builtinIdentities, defaultBlockStateRuntimeId} from "@openvoxel/blocks"
import {Chunk, blockIndex, chunkBlock, chunkBlockAtIndex, chunkChecksum, emptyChunk, setChunkBlock} from "../src/chunk.vel"
import {Coordinate2, Coordinate3, chunkCoordinate, localCoordinate, locateBlock} from "../src/coordinates.vel"
import {generateChunk} from "../src/generator.vel"
import {maximumWorldY, minimumWorldY, sampleTerrain, seaLevel} from "../src/generation/terrain.vel"
import {createWorldManifest, validateWorldManifest} from "../src/world.vel"

const airBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.air)
const coalOreBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.coalOre)
const copperOreBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.copperOre)
const diamondOreBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.diamondOre)
const germaniumOreBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.germaniumOre)
const ironOreBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.ironOre)
const magmaBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.magma)
const saltpeterOreBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.saltpeterOre)
const sandBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.sand)
const spruceLeavesBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.spruceLeaves)
const stoneBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.stone)
const sulphurOreBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.sulphurOre)
const waterBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.water)

def coordinateRoundTrip(position: Coordinate3) -> bool:
    const located = locateBlock(position, 16)
    return located.chunk.x * 16 + located.local.x == position.x and located.chunk.y * 16 + located.local.y == position.y and located.chunk.z * 16 + located.local.z == position.z

def countBlock(chunk: Chunk, runtimeId: number) -> number:
    let count = 0
    for index in range(chunk.indices.size):
        if chunkBlockAtIndex(chunk, index) == runtimeId: count += 1
    return count

test "negative world coordinates map to stable chunks":
    expect(chunkCoordinate(-17, 16)).toBe(-2)
    expect(localCoordinate(-17, 16)).toBe(15)
    expect(chunkCoordinate(-16, 16)).toBe(-1)
    expect(localCoordinate(-16, 16)).toBe(0)
    expect(chunkCoordinate(-1, 16)).toBe(-1)
    expect(localCoordinate(-1, 16)).toBe(15)
    expect(chunkCoordinate(0, 16)).toBe(0)
    expect(localCoordinate(0, 16)).toBe(0)
    expect(chunkCoordinate(15, 16)).toBe(0)
    expect(localCoordinate(15, 16)).toBe(15)
    expect(chunkCoordinate(16, 16)).toBe(1)
    expect(localCoordinate(16, 16)).toBe(0)

test "coordinate decomposition round trips for generated values": checkWorldCoordinates(coordinateRoundTrip)

test "three dimensional coordinates inherit the horizontal coordinate contract":
    const position = Coordinate3.parse({x: 4, y: 8, z: 12})
    expect(Coordinate2.is(position)).toBe(true)
    expect(position.y).toBe(8)

test "chunk storage uses x z y order without collisions":
    expect(blockIndex({x: 0, y: 0, z: 0}, 16)).toBe(0)
    expect(blockIndex({x: 15, y: 0, z: 0}, 16)).toBe(15)
    expect(blockIndex({x: 0, y: 0, z: 1}, 16)).toBe(16)
    expect(blockIndex({x: 0, y: 1, z: 0}, 16)).toBe(256)
    expect(blockIndex({x: 15, y: 15, z: 15}, 16)).toBe(4095)

test "generator is deterministic across positive and negative chunks":
    const manifest = createWorldManifest({id: "deterministic", name: "Deterministic", seed: "openvoxel"})
    const first = generateChunk(manifest, {x: -3, y: 0, z: 5})
    const second = generateChunk(manifest, {x: -3, y: 0, z: 5})
    const other = generateChunk(manifest, {x: -2, y: 0, z: 5})
    expect(chunkChecksum(first)).toBe(chunkChecksum(second))
    expect(chunkChecksum(first) == chunkChecksum(other)).toBe(false)
    expect(first.indices.size).toBe(4096)

test "three dimensional lookup crosses chunk boundaries":
    const located = locateBlock({x: -1, y: 16, z: 32}, 16)
    expect(located.chunk).toEqual({x: -1, y: 1, z: 2})
    expect(located.local).toEqual({x: 15, y: 0, z: 0})
    expect(airBlock).toBe(0)
    expect(stoneBlock).toBe(147)

test "survival generator exposes stable climate and world limits":
    const sample = sampleTerrain("openvoxel", {x: 0, z: 0})
    expect(seaLevel).toBe(64)
    expect(minimumWorldY).toBe(0)
    expect(maximumWorldY).toBe(255)
    expect(sample.surfaceY).toBe(99)
    expect(sample.temperature).toBe(0)
    expect(sample.humidity).toBe(4)
    expect(sample.biome).toBe("tundra")

test "block catalog exposes runtime definitions by canonical type key":
    expect(blockCatalog().size).toBe(38)
    expect(blockTypeDefinition(builtinIdentities.blocks.air).defaultStateRuntimeId).toBe(airBlock)
    expect(blockTypeDefinition(builtinIdentities.blocks.stone).defaultStateRuntimeId).toBe(stoneBlock)
    expect(blockTypeDefinition(builtinIdentities.blocks.spruceLeaves).physics.occlusion.kind).toBe(BlockShapeKind.empty)

test "world manifests carry their complete runtime registry":
    const manifest = validateWorldManifest(createWorldManifest({id: "catalog", name: "Catalog", seed: "openvoxel"}))
    expect(manifest.blockRegistry.states.size).toBe(183)
    expect(manifest.blockRegistry.states[0]).toEqual({runtimeId: 0, stateKey: builtinIdentities.blocks.air})

test "chunk palettes store UInt32 runtime ids behind UInt16 local indices":
    const chunk = emptyChunk({x: 0, y: 0, z: 0}, 16)
    const modRuntimeId = 0x1000000
    setChunkBlock(chunk, {x: 1, y: 2, z: 3}, modRuntimeId)
    expect(chunk.palette).toEqual([airBlock, modRuntimeId])
    expect(chunkBlock(chunk, {x: 1, y: 2, z: 3})).toBe(modRuntimeId)
    expect(chunk.indices[561]).toBe(1)

test "world generation covers oceans caves fluids and all mineral families":
    const manifest = createWorldManifest({id: "palette", name: "Palette", seed: "openvoxel"})
    const ocean = generateChunk(manifest, {x: -12, y: 3, z: -12})
    expect(countBlock(ocean, waterBlock) > 0).toBe(true)
    expect(countBlock(ocean, sandBlock) > 0).toBe(true)

    const magma = generateChunk(manifest, {x: -12, y: 0, z: -11})
    const sulphur = generateChunk(manifest, {x: -12, y: 0, z: -10})
    expect(countBlock(magma, magmaBlock) > 0).toBe(true)
    expect(countBlock(sulphur, sulphurOreBlock) > 0).toBe(true)

    const shallow = generateChunk(manifest, {x: -12, y: 0, z: -12})
    expect(countBlock(shallow, airBlock) > 0).toBe(true)

    const iron = generateChunk(manifest, {x: -12, y: 0, z: -12})
    const coal = generateChunk(manifest, {x: -12, y: 1, z: -12})
    const copper = generateChunk(manifest, {x: -12, y: 1, z: -12})
    const diamond = generateChunk(manifest, {x: -12, y: 0, z: -11})
    const germanium = generateChunk(manifest, {x: -12, y: 1, z: -10})
    const saltpeter = generateChunk(manifest, {x: -11, y: 3, z: 4})
    const undergroundWater = generateChunk(manifest, {x: -12, y: 1, z: 6})
    expect(countBlock(iron, ironOreBlock) > 0).toBe(true)
    expect(countBlock(coal, coalOreBlock) > 0).toBe(true)
    expect(countBlock(copper, copperOreBlock) > 0).toBe(true)
    expect(countBlock(diamond, diamondOreBlock) > 0).toBe(true)
    expect(countBlock(germanium, germaniumOreBlock) > 0).toBe(true)
    expect(countBlock(saltpeter, saltpeterOreBlock) > 0).toBe(true)
    expect(countBlock(undergroundWater, waterBlock) > 0).toBe(true)

test "feature owners continue tree crowns across cubic chunk seams":
    const manifest = createWorldManifest({id: "seam", name: "Seam", seed: "openvoxel"})
    const left = generateChunk(manifest, {x: -1, y: 7, z: -4})
    const right = generateChunk(manifest, {x: 0, y: 7, z: -4})
    expect(chunkBlock(left, {x: 15, y: 0, z: 5})).toBe(spruceLeavesBlock)
    expect(chunkBlock(right, {x: 0, y: 0, z: 5})).toBe(spruceLeavesBlock)
    const repeated = generateChunk(manifest, {x: -1, y: 7, z: -4})
    expect(chunkChecksum(repeated)).toBe(chunkChecksum(left))

test "generator returns empty chunks outside the version one vertical range":
    const manifest = createWorldManifest({id: "bounds", name: "Bounds", seed: "openvoxel"})
    const below = generateChunk(manifest, {x: 0, y: -1, z: 0})
    const above = generateChunk(manifest, {x: 0, y: 16, z: 0})
    expect(countBlock(below, airBlock)).toBe(4096)
    expect(countBlock(above, airBlock)).toBe(4096)

test "survival generator golden chunks detect accidental algorithm drift":
    const manifest = createWorldManifest({id: "golden", name: "Golden", seed: "openvoxel"})
    expect(chunkChecksum(generateChunk(manifest, {x: 0, y: 0, z: 0}))).toBe(2919264330)
    expect(chunkChecksum(generateChunk(manifest, {x: 0, y: 3, z: 0}))).toBe(2665425008)
    expect(chunkChecksum(generateChunk(manifest, {x: -10, y: 3, z: -10}))).toBe(2320878832)
