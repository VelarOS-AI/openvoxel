import {Random} from "velar/random"
import {BlockRegistry} from "@openvoxel/blocks"
import {WorldGeneratorDefinition, PlantUnit} from "../definition/catalog.vel"
import {biomeAffinity, ecosystemUnits, habitatWeight, stageEnabled} from "../ecosystem/composition.vel"
import {SurvivalBlockPalette} from "./block-palette.vel"
import {CompiledFeaturePlan, FeatureWrite, compiledFeaturePlan} from "./feature-plan.vel"
import {TerrainColumnPlan, surfaceBlock, temperatureAtHeight} from "./terrain.vel"
import {EcologyPatterns} from "./ecology-patterns.vel"

export def plantRuntimeId(unit: readonly PlantUnit, registry: readonly BlockRegistry, stream: Random) -> number:
    let runtimeId = registry.defaultStateRuntimeIdForKey(unit.block)
    for property in unit.properties:
        runtimeId = registry.withProperty(runtimeId, property.name, property.values[stream.int(0, property.values.size)])
    return runtimeId

/// 包只声明适生条件和状态选择；支撑、世界坐标所有者和区块裁剪由公共规划器执行。
export def groundPlantFeatures(
    profile: readonly WorldGeneratorDefinition,
    blocks: readonly SurvivalBlockPalette,
    registry: readonly BlockRegistry,
    core: readonly TerrainColumnPlan,
    root: Random,
    patterns: readonly EcologyPatterns,
) -> List<CompiledFeaturePlan>:
    const output: List<CompiledFeaturePlan> = []
    if not stageEnabled(profile, "vegetation"): return output
    const units = ecosystemUnits(profile).plants.filter(unit => not unit.aquatic)
    if units.size == 0: return output
    const minimumX = core.minimumX
    const minimumZ = core.minimumZ
    const size = profile.vegetation.groundPlantCellSize
    for cellX in range((minimumX / size).floor(), ((minimumX + 15) / size).floor() + 1):
        for cellZ in range((minimumZ / size).floor(), ((minimumZ + 15) / size).floor() + 1):
            const stream = root.fork(f"ground:{cellX}:{cellZ}")
            const x = cellX * size + stream.int(0, size)
            const z = cellZ * size + stream.int(0, size)
            if x < minimumX or x > minimumX + 15 or z < minimumZ or z > minimumZ + 15: continue
            const sample = core.sampleAt(x, z)
            if sample.roadDistance != null or sample.surfaceY < (sample.waterLevel ?? profile.world.seaLevel): continue
            const temperature = temperatureAtHeight(profile, sample.temperature, sample.surfaceY)
            if temperature <= profile.surface.snowTemperature or sample.slope > profile.vegetation.treeMaximumSlope:
                continue
            const ground = surfaceBlock(profile, blocks, sample)
            const cover = Math.clamp(patterns.cover(x, z), 0, 1)
            const regionalCover = ecosystemUnits(profile).biomes.find(unit => unit.id == sample.biome)?.groundCover ?? 1
            const chance = Math.clamp(profile.vegetation.groundPlantChance * regionalCover * Math.clamp(sample.humidity / 12, 0.25, 1) * (0.1 + 2.2 * cover * cover), 0, 1)
            if not stream.bool(chance): continue
            const weights = units.map(unit => registry.hasTag(ground, unit.support) ? unit.weight * habitatWeight(temperature, unit.temperature) * habitatWeight(sample.humidity, unit.humidity) * biomeAffinity(profile, sample.biome, unit.affinities) : 0)
            // 同一块连续群落共享优势种；独立随机分量保留混生，边界不会重置图案。
            const choice = stream.bool(0.68) ? (patterns.species(x, z) + stream.number() * 0.65) / 13 : stream.number()
            let remaining = Math.min(0.999999, choice) * weights.sum()
            for unit, index in units:
                remaining -= weights[index]
                if remaining >= 0: continue
                const owner = f"{unit.key}:{x}:{z}"
                const runtimeId = plantRuntimeId(unit, registry, stream)
                const height = stream.int(unit.minimumHeight, unit.maximumHeight + 1)
                const top = unit.topBlock == null ? runtimeId : registry.defaultStateRuntimeIdForKey(unit.topBlock)
                const writes: List<FeatureWrite> = range(height).map(y => ({x: 0, y, z: 0, runtimeId: y == height - 1 ? top : runtimeId}))
                output.append(compiledFeaturePlan(owner, {x, y: sample.surfaceY + 1, z}, f"2_ground:{owner}", writes))
                break
    return output
