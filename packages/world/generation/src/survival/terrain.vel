import {simplex2, simplex3} from "@velarscript-labs/noise"
import {Float32Buffer, UInt16Buffer, float32Buffer, uint16Buffer} from "velar/binary"
import {Coordinate2, WorldBaseClimateSampler, createWorldBaseClimateNodeSampler, requireCoordinate2, worldTemperatureAtHeight} from "@openvoxel/world"
import {worldGeneratorClimate} from "../generator-climate.vel"
import {CurvePoint, FractalNoiseConfig, WorldGeneratorDefinition} from "../definition/catalog.vel"
import {baseWorldGeneratorCatalog} from "../runtime/builtin-catalog.vel"
import {TerrainSample} from "../terrain-sample.vel"
import {SurvivalBlockPalette} from "./block-palette.vel"
import {evictOldest} from "./lru-cache.vel"
import {surfaceBedrock} from "./surface-materials.vel"
import {BasinGround, WaterBodyPlanner, createWaterBodyPlanner} from "./water-bodies.vel"
import {RoadGround, RoadPlanner, createRoadPlanner} from "./roads.vel"
export {surfaceBlock, subsurfaceBlock} from "./surface-materials.vel"

export type Noise2 = (number, number) -> number
export type Noise3 = (number, number, number) -> number
export type DensityColumn = (worldY: number) -> number

/// 每个噪声通道拥有独立种子。共享坐标不等于共享随机流，因此增加植被或矿物
/// 通道不会改变已经生成的大陆和河流。
type GenerationNoiseFields:
    profile: readonly WorldGeneratorDefinition
    continentalness: Noise2
    erosion: Noise2
    ridge: Noise2
    hills: Noise2
    river: Noise2
    continentalWarpX: Noise2
    continentalWarpZ: Noise2
    riverWarpX: Noise2
    riverWarpZ: Noise2
    surfaceMicroDetail: Noise2
    detail: Noise3
    aquifer: Noise3
    strata: Noise2
    climateNode: WorldBaseClimateSampler
    forest: Noise2
    geology: Noise2
    deposit: Noise2
    exposure: Noise2

export type GenerationFields extends GenerationNoiseFields:
    roads: RoadPlanner
    waterBodies: WaterBodyPlanner

readonly type HorizontalCell:
    gridX: number
    gridZ: number
    amountX: number
    amountZ: number

type TerrainShape:
    targetSurfaceY: number
    continentalness: number
    erosion: number
    ridge: number
    riverStrength: number
    /// 尚未体素化的连续河面标高。河床与河面同源于平滑的二维地形骨架，
    /// 不跟随最终整数地表逐列跳动。
    riverWaterLevel: number

/// 一个水平 Chunk 列的全部地形事实。7×7×33 密度网格覆盖核心区及一个粗采样
/// 边界；18×18 最终表面则覆盖 16×16 核心区与一格坡度边界。
export type TerrainColumnPlan:
    edge: number
    minimumX: number
    minimumZ: number
    densityGrid: Float32Buffer
    surfaceHeights: UInt16Buffer
    waterLevels: Float32Buffer
    /// 核心 16×16 区域的最终地表范围，供垂直 Chunk 在进入表层、含水层和
    /// 装饰阶段前做常数时间的相交判断。
    minimumSurfaceY: number
    maximumSurfaceY: number
    minimumWaterLevel: number
    maximumWaterLevel: number
    samples: readonly List<readonly TerrainSample>
    densityAt: (worldX: number, worldY: number, worldZ: number) -> number
    densityColumnAt: (worldX: number, worldZ: number) -> DensityColumn
    sampleAt: (worldX: number, worldZ: number) -> readonly TerrainSample
    surfaceYAt: (worldX: number, worldZ: number) -> number
    waterLevelAt: (worldX: number, worldZ: number) -> number

export type ColumnPlanner:
    cachedColumnCount: () -> number
    columnBuildCount: () -> number
    columns: (chunkX: number, chunkZ: number) -> TerrainColumnPlan

const builtinProfile = baseWorldGeneratorCatalog.generators[0]
export const minimumWorldY = builtinProfile.world.minimumY
export const maximumWorldY = builtinProfile.world.maximumY
export const seaLevel = builtinProfile.world.seaLevel

def saturate(value: number) -> number: return Math.clamp(value, 0, 1)

def lerp(start: number, end: number, amount: number) -> number: return start + (end - start) * amount

def smooth(value: number) -> number:
    const amount = saturate(value)
    return amount * amount * (3 - 2 * amount)

def squish(value: number, zero: number, one: number) -> number: return saturate((value - zero) / (one - zero))

def signedFractal(field: Noise2, x: number, z: number, config: readonly FractalNoiseConfig) -> number:
    let amplitude = 1
    let total = 0
    let weight = 0
    let frequency = 1 / config.period
    for octave in range(config.octaves):
        total += field(x * frequency, z * frequency) * amplitude
        weight += amplitude
        amplitude *= config.persistence
        frequency *= config.lacunarity
    return Math.clamp(total / weight, -1, 1)

def curve(points: readonly List<readonly CurvePoint>, input: number) -> number:
    if input <= points[0].input: return points[0].output
    for index in range(1, points.size):
        const right = points[index]
        if input > right.input: continue
        const left = points[index - 1]
        const amount = smooth((input - left.input) / (right.input - left.input))
        return lerp(left.output, right.output, amount)
    return points[points.size - 1].output

/// Domain warp 只改变水平采样坐标。Y 从不参与扭曲，所以悬挑与洞穴不会把
/// 大陆轮廓折叠成难以解释的三维噪声团。
def terrainShape(fields: GenerationNoiseFields, position: readonly Coordinate2) -> TerrainShape:
    const terrain = fields.profile.terrain
    const warpScale = 1 / terrain.warp.continentalPeriod
    const warpedX = position.x + terrain.warp.continentalAmplitude * fields.continentalWarpX(position.x * warpScale, position.z * warpScale)
    const warpedZ = position.z + terrain.warp.continentalAmplitude * fields.continentalWarpZ(position.x * warpScale, position.z * warpScale)
    const continentalness = signedFractal(fields.continentalness, warpedX, warpedZ, terrain.continentalness)
    const erosion = saturate(signedFractal(fields.erosion, warpedX, warpedZ, terrain.erosion) * 0.5 + 0.5)
    // 地貌带先分配平原、丘陵和山地的空间，再叠加起伏；零等值线不是山脉。
    // 非零采样原点避免所有种子在 (0, 0) 同时命中噪声的固定零点。
    const ridge = saturate(0.5 + 1.25 * signedFractal(fields.ridge, warpedX + terrain.ridge.period * 13.37, warpedZ - terrain.ridge.period * 9.41, terrain.ridge))
    const hills = signedFractal(fields.hills, warpedX, warpedZ, terrain.hills)

    const riverWarpScale = 1 / terrain.warp.riverPeriod
    const riverX = position.x + terrain.warp.riverAmplitude * fields.riverWarpX(position.x * riverWarpScale, position.z * riverWarpScale)
    const riverZ = position.z + terrain.warp.riverAmplitude * fields.riverWarpZ(position.x * riverWarpScale, position.z * riverWarpScale)
    const riverLine = signedFractal(fields.river, riverX, riverZ, terrain.river)
    const riverStrength = smooth(squish(terrain.riverHalfWidth - riverLine.abs(), 0, terrain.riverHalfWidth)) * squish(continentalness, -0.38, -0.12)

    const baseHeight = curve(terrain.continentalHeight, continentalness)
    const inland = smooth(squish(continentalness, -0.08, 0.5))
    const ridgeMask = smooth(squish(ridge, 0.6, 0.9))
    const erosionMask = lerp(1, 0.28, erosion)
    const mountainHeight = terrain.mountainAmplitude * inland * ridgeMask * erosionMask * (0.66 + 0.34 * saturate(hills * 0.5 + 0.5))
    // 海岸内侧也有独立丘陵；渐隐带保留海滩，山脊带则交给大尺度山体。
    const foothills = smooth(squish(continentalness, -0.22, 0.12))
    const hillBelt = smooth(squish(ridge, 0.35, 0.65)) * (1 - ridgeMask)
    const hillHeight = terrain.foothillAmplitude * foothills * hillBelt * (1 - 0.55 * erosion) * (0.5 + 0.5 * hills)
    const uncarved = baseHeight + mountainHeight + hillHeight
    const highland = squish(uncarved, fields.profile.world.seaLevel + 18, fields.profile.world.seaLevel + 82)
    const riverDepth = lerp(terrain.riverLowlandDepth, terrain.riverHighlandDepth, highland)
    const riverFloor = fields.profile.world.seaLevel - 2 + highland * 36
    // 完整河槽的床面不依赖横断面上的 riverStrength；后者只负责从岸坡平滑
    // 过渡到河槽。河面因此跨越相邻河列连续，而不会追随每列最终 surfaceY。
    const riverChannelFloor = Math.max(riverFloor, uncarved - riverDepth)
    const riverWaterLevel = Math.clamp(riverChannelFloor + 3, fields.profile.world.seaLevel, fields.profile.world.maximumNaturalSurfaceY)
    // 河床只能向下侵蚀原地表。把 channelFloor 当全局下界会把深海抬到海平面，
    // 同时把整条河谷截成平底陡壁；横断面应在岸坡与完整河床之间连续插值。
    const carved = Math.min(uncarved, lerp(uncarved, riverChannelFloor, riverStrength))
    return {
        targetSurfaceY: Math.clamp(carved, fields.profile.world.minimumY + fields.profile.world.bedrockDepth, fields.profile.world.maximumNaturalSurfaceY),
        continentalness,
        erosion,
        ridge,
        riverStrength,
        riverWaterLevel,
    }

/// 特征所有者只用这个便宜结果选择大致地下高度。最终是否允许写入仍由目标
/// Chunk 的 TerrainColumnPlan 判定，所以近似值不会成为第二份地表事实。
export def terrainTargetSurfaceY(fields: GenerationFields, position: readonly Coordinate2) -> number:
    const height = terrainShape(fields, position).targetSurfaceY
    const basin = fields.waterBodies.sample(position.x, position.z)
    return (basin == null ? height : lerp(height, basin.floorY, basin.weight)).round()

export def createGenerationFields(seed: string, profile: readonly WorldGeneratorDefinition = builtinProfile) -> GenerationFields:
    const fields: GenerationNoiseFields = {
        profile,
        continentalness: simplex2(f"{seed}:terrain:continentalness"),
        erosion: simplex2(f"{seed}:terrain:erosion"),
        ridge: simplex2(f"{seed}:terrain:ridge"),
        hills: simplex2(f"{seed}:terrain:hills"),
        river: simplex2(f"{seed}:terrain:river"),
        continentalWarpX: simplex2(f"{seed}:terrain:continental-warp-x"),
        continentalWarpZ: simplex2(f"{seed}:terrain:continental-warp-z"),
        riverWarpX: simplex2(f"{seed}:terrain:river-warp-x"),
        riverWarpZ: simplex2(f"{seed}:terrain:river-warp-z"),
        surfaceMicroDetail: simplex2(f"{seed}:terrain:surface-micro-detail"),
        detail: simplex3(f"{seed}:terrain:detail"),
        aquifer: simplex3(f"{seed}:underground:aquifer"),
        strata: simplex2(f"{seed}:terrain:strata"),
        climateNode: createWorldBaseClimateNodeSampler(seed, worldGeneratorClimate(profile)),
        forest: simplex2(f"{seed}:decoration:forest"),
        geology: simplex2(f"{seed}:surface:geology"),
        deposit: simplex2(f"{seed}:surface:deposit"),
        exposure: simplex2(f"{seed}:surface:exposure"),
    }
    def basinGroundAt(x: number, z: number) -> BasinGround:
        const shape = terrainShape(fields, {x, z})
        const step = profile.sampling.horizontalStep
        const climate = fields.climateNode({x: (x / step).floor() * step, z: (z / step).floor() * step})
        return {height: shape.targetSurfaceY, riverStrength: shape.riverStrength, humidity: climate.humidity}

    const waterBodies = createWaterBodyPlanner(seed, profile.hydrology, profile.world.seaLevel, basinGroundAt)
    def roadGroundAt(x: number, z: number) -> RoadGround:
        const shape = terrainShape(fields, {x, z})
        const basin = waterBodies.sample(x, z)
        return {height: basin == null ? shape.targetSurfaceY : lerp(shape.targetSurfaceY, basin.floorY, basin.weight), waterLevel: basin != null ? basin.waterLevel : shape.riverStrength >= 0.48 ? shape.riverWaterLevel : profile.world.seaLevel}

    return GenerationFields.from(fields, {roads: createRoadPlanner(seed, profile.roads, roadGroundAt), waterBodies})

def densityForShape(fields: GenerationFields, shape: readonly TerrainShape, worldX: number, worldY: number, worldZ: number) -> number:
    if worldY < fields.profile.world.bedrockDepth: return 64
    const vertical = shape.targetSurfaceY - worldY
    // 低幅 3D 细节只可能改变地表附近约 32 格。远离交界面的密度符号已经
    // 确定，继续采样 simplex3 既不能改变结果，也会浪费大部分网格时间。
    if vertical.abs() > 32: return vertical
    const detail = fields.profile.terrain.detail
    const detailNoise = fields.detail(worldX / detail.period, worldY / detail.period, worldZ / detail.period)
    const overhangWeight = squish(shape.ridge, 0.5, 0.9) * squish(shape.targetSurfaceY, fields.profile.world.seaLevel + 16, fields.profile.world.seaLevel + 72)
    return vertical + fields.profile.terrain.detailAmplitude * detailNoise * lerp(0.25, 1, overhangWeight)

def densityIndex(x: number, y: number, z: number, horizontalCount: number) -> number:
    return x + horizontalCount * (z + horizontalCount * y)

def sampleIndex(localX: number, localZ: number, sampleEdge: number) -> number: return localZ + sampleEdge * localX

def chooseTerrainType(profile: readonly WorldGeneratorDefinition, surfaceY: number, slope: number, shape: readonly TerrainShape) -> string:
    if surfaceY <= profile.world.seaLevel - 18: return profile.terrainTypes.deepOcean
    if surfaceY <= profile.world.seaLevel - 3: return profile.terrainTypes.ocean
    if shape.riverStrength >= 0.48 and shape.continentalness > -0.35: return profile.terrainTypes.river
    if (surfaceY - profile.world.seaLevel).abs() <= 3: return profile.terrainTypes.coast
    if surfaceY >= 108 or (shape.ridge >= 0.72 and surfaceY >= 88): return profile.terrainTypes.mountain
    if shape.ridge <= 0.2 and shape.erosion <= 0.48: return profile.terrainTypes.valley
    if slope >= 0.28 or surfaceY >= 82: return profile.terrainTypes.hill
    return profile.terrainTypes.plain

def chooseBiome(profile: readonly WorldGeneratorDefinition, terrainType: string, surfaceY: number, temperature: number, humidity: number) -> string:
    if terrainType == profile.terrainTypes.deepOcean or terrainType == profile.terrainTypes.ocean:
        return profile.biomes.ocean
    if terrainType == profile.terrainTypes.coast: return profile.biomes.coast
    if terrainType == profile.terrainTypes.river: return profile.biomes.river
    const adjustedTemperature = temperatureAtHeight(profile, temperature, surfaceY)
    if adjustedTemperature <= 3: return profile.biomes.tundra
    if adjustedTemperature >= 10 and humidity <= 5: return profile.biomes.desert
    if humidity >= 9: return profile.biomes.forest
    return profile.biomes.plains

/// 三线性插值只在粗网格的八个角之间工作。实际方块填充、表面寻找和外部 sample
/// 都调用同一个函数，因此不会出现“地表报告”和“真实固体顶面”漂移。
export def createTerrainColumnPlan(fields: GenerationFields, chunkX: number, chunkZ: number, edge: number) -> TerrainColumnPlan:
    assert edge == 16 else "Terrain column plans require a Chunk edge of 16"
    const profile = fields.profile
    const horizontalStep = profile.sampling.horizontalStep
    const verticalStep = profile.sampling.verticalStep
    const minimumX = chunkX * edge
    const minimumZ = chunkZ * edge
    const gridMinimumX = minimumX - horizontalStep
    const gridMinimumZ = minimumZ - horizontalStep
    const horizontalCount = edge / horizontalStep + 3
    const verticalCount = (profile.world.maximumY + 1 - profile.world.minimumY) / verticalStep + 1
    const densityGrid = float32Buffer(horizontalCount * horizontalCount * verticalCount)
    // 大陆度、侵蚀、山脊和河流都只依赖 X/Z。先为 7×7 水平节点计算一次，
    // 33 个垂直层随后复用；这也是“不逐方块调用 3D 地形噪声”的计数边界。
    const gridShapes: List<TerrainShape> = []
    const gridTemperatures: List<number> = []
    const gridHumidities: List<number> = []
    const gridForests: List<number> = []
    for gridX in range(horizontalCount):
        const worldX = gridMinimumX + gridX * horizontalStep
        for gridZ in range(horizontalCount):
            const worldZ = gridMinimumZ + gridZ * horizontalStep
            gridShapes.append(terrainShape(fields, {x: worldX, z: worldZ}))
            const climate = fields.climateNode({x: worldX, z: worldZ})
            gridTemperatures.append(climate.temperature)
            gridHumidities.append(climate.humidity)
            gridForests.append(saturate(fields.forest(worldX / 224, worldZ / 224) * 0.5 + 0.5))
    for gridY in range(verticalCount):
        const worldY = profile.world.minimumY + gridY * verticalStep
        for gridX in range(horizontalCount):
            const worldX = gridMinimumX + gridX * horizontalStep
            for gridZ in range(horizontalCount):
                const worldZ = gridMinimumZ + gridZ * horizontalStep
                const shape = gridShapes[gridZ + horizontalCount * gridX]
                densityGrid[densityIndex(gridX, gridY, gridZ, horizontalCount)] = densityForShape(fields, shape, worldX, worldY, worldZ)

    /// 为一个实际方块列预计算 X/Z 插值坐标。随后 16 个 Y 只需要选择相邻
    /// 两层并做垂直插值，不再重复计算水平网格位置和权重。
    def densityColumnAt(worldX: number, worldZ: number) -> DensityColumn:
        const basin = fields.waterBodies.sample(worldX, worldZ)
        const gridX = Math.clamp(((worldX - gridMinimumX) / horizontalStep).floor(), 0, horizontalCount - 2)
        const gridZ = Math.clamp(((worldZ - gridMinimumZ) / horizontalStep).floor(), 0, horizontalCount - 2)
        const amountX = saturate((worldX - (gridMinimumX + gridX * horizontalStep)) / horizontalStep)
        const amountZ = saturate((worldZ - (gridMinimumZ + gridZ * horizontalStep)) / horizontalStep)
        // 逐列二维微细节直接加入所有消费者共享的密度函数。它不改写已经
        // 整数化的 surfaceY，因此表面寻找、方块填充与跨 Chunk 查询仍同源。
        const surfaceMicroDetail = profile.terrain.surfaceMicroDetailAmplitude * fields.surfaceMicroDetail(
            worldX / profile.terrain.surfaceMicroDetailPeriod,
            worldZ / profile.terrain.surfaceMicroDetailPeriod,
        )

        def density(worldY: number) -> number:
            if worldY < profile.world.minimumY: return 64
            if worldY > profile.world.maximumY + 1: return -64
            const gridY = Math.clamp(((worldY - profile.world.minimumY) / verticalStep).floor(), 0, verticalCount - 2)
            const amountY = saturate((worldY - (profile.world.minimumY + gridY * verticalStep)) / verticalStep)
            const lowZ0 = lerp(densityGrid[densityIndex(gridX, gridY, gridZ, horizontalCount)], densityGrid[densityIndex(gridX + 1, gridY, gridZ, horizontalCount)], amountX)
            const lowZ1 = lerp(densityGrid[densityIndex(gridX, gridY, gridZ + 1, horizontalCount)], densityGrid[densityIndex(gridX + 1, gridY, gridZ + 1, horizontalCount)], amountX)
            const highZ0 = lerp(densityGrid[densityIndex(gridX, gridY + 1, gridZ, horizontalCount)], densityGrid[densityIndex(gridX + 1, gridY + 1, gridZ, horizontalCount)], amountX)
            const highZ1 = lerp(densityGrid[densityIndex(gridX, gridY + 1, gridZ + 1, horizontalCount)], densityGrid[densityIndex(gridX + 1, gridY + 1, gridZ + 1, horizontalCount)], amountX)
            const natural = lerp(lerp(lowZ0, lowZ1, amountZ), lerp(highZ0, highZ1, amountZ), amountY) + surfaceMicroDetail
            // 盆底和闭合岸圈共享一个密度函数，小水坑也按每列精确采样。
            if basin != null and worldY >= basin.floorY - 4: return lerp(natural, basin.floorY - worldY, basin.weight)
            return natural

        return density

    def densityAt(worldX: number, worldY: number, worldZ: number) -> number:
        return densityColumnAt(worldX, worldZ)(worldY)

    def horizontalCell(worldX: number, worldZ: number) -> HorizontalCell:
        const gridX = Math.clamp(((worldX - gridMinimumX) / horizontalStep).floor(), 0, horizontalCount - 2)
        const gridZ = Math.clamp(((worldZ - gridMinimumZ) / horizontalStep).floor(), 0, horizontalCount - 2)
        const amountX = smooth((worldX - (gridMinimumX + gridX * horizontalStep)) / horizontalStep)
        const amountZ = smooth((worldZ - (gridMinimumZ + gridZ * horizontalStep)) / horizontalStep)
        return {gridX, gridZ, amountX, amountZ}

    def interpolateGrid(values: readonly List<number>, cell: HorizontalCell) -> number:
        const {gridX, gridZ, amountX, amountZ} = cell
        const back = lerp(values[gridZ + horizontalCount * gridX], values[gridZ + horizontalCount * (gridX + 1)], amountX)
        const front = lerp(values[gridZ + 1 + horizontalCount * gridX], values[gridZ + 1 + horizontalCount * (gridX + 1)], amountX)
        return lerp(back, front, amountZ)

    def shapeAt(worldX: number, worldZ: number) -> TerrainShape:
        const cell = horizontalCell(worldX, worldZ)
        const {gridX, gridZ, amountX, amountZ} = cell
        const backLeft = gridShapes[gridZ + horizontalCount * gridX]
        const backRight = gridShapes[gridZ + horizontalCount * (gridX + 1)]
        const frontLeft = gridShapes[gridZ + 1 + horizontalCount * gridX]
        const frontRight = gridShapes[gridZ + 1 + horizontalCount * (gridX + 1)]

        def blend(backLeftValue: number, backRightValue: number, frontLeftValue: number, frontRightValue: number) -> number:
            return lerp(lerp(backLeftValue, backRightValue, amountX), lerp(frontLeftValue, frontRightValue, amountX), amountZ)

        const targetSurfaceY = blend(backLeft.targetSurfaceY, backRight.targetSurfaceY, frontLeft.targetSurfaceY, frontRight.targetSurfaceY)
        const continentalness = blend(backLeft.continentalness, backRight.continentalness, frontLeft.continentalness, frontRight.continentalness)
        const erosion = blend(backLeft.erosion, backRight.erosion, frontLeft.erosion, frontRight.erosion)
        const ridge = blend(backLeft.ridge, backRight.ridge, frontLeft.ridge, frontRight.ridge)
        const riverStrength = blend(backLeft.riverStrength, backRight.riverStrength, frontLeft.riverStrength, frontRight.riverStrength)
        const riverWaterLevel = blend(backLeft.riverWaterLevel, backRight.riverWaterLevel, frontLeft.riverWaterLevel, frontRight.riverWaterLevel)
        return {targetSurfaceY, continentalness, erosion, ridge, riverStrength, riverWaterLevel}

    const sampleEdge = edge + 2 * profile.sampling.halo
    const surfaceHeights = uint16Buffer(sampleEdge * sampleEdge)
    const waterLevels = float32Buffer(sampleEdge * sampleEdge)
    const sampleShapes: List<TerrainShape> = []

    def surfaceHeightFor(worldX: number, worldZ: number, shape: readonly TerrainShape) -> number:
        const densityColumn = densityColumnAt(worldX, worldZ)
        const reach = profile.terrain.detailAmplitude.abs().ceil() + profile.terrain.surfaceMicroDetailAmplitude.ceil() + verticalStep
        const topY = Math.min(profile.world.maximumNaturalSurfaceY, shape.targetSurfaceY.ceil() + reach)
        for worldY in range(topY, profile.world.minimumY - 1, -1):
            if densityColumn(worldY) >= 0: return worldY
        return profile.world.minimumY

    for localX in range(sampleEdge):
        const worldX = minimumX + localX - profile.sampling.halo
        for localZ in range(sampleEdge):
            const worldZ = minimumZ + localZ - profile.sampling.halo
            const shape = shapeAt(worldX, worldZ)
            sampleShapes.append(shape)
            // 最终密度由“目标地表减 Y”加有限幅 3D 细节组成，所以最高交界面
            // 必定位于目标高度附近。直接在这个有界窗口中向下寻找同一密度场的
            // 最高固体，避免每个采样点从世界顶端跨越 33 个粗网格层。
            const surfaceY = surfaceHeightFor(worldX, worldZ, shape)
            surfaceHeights[sampleIndex(localX, localZ, sampleEdge)] = surfaceY

    // Halo 上的坡度也使用真实左右邻列。截断到边缘会让相同世界坐标在两个
    // Chunk 中拥有不同坡度，从而出现草皮/碎石接缝及树木支撑判定分歧。
    def neighborHeight(localX: number, localZ: number) -> number:
        if localX >= 0 and localX < sampleEdge and localZ >= 0 and localZ < sampleEdge:
            return surfaceHeights[sampleIndex(localX, localZ, sampleEdge)]
        const worldX = minimumX + localX - profile.sampling.halo
        const worldZ = minimumZ + localZ - profile.sampling.halo
        return surfaceHeightFor(worldX, worldZ, shapeAt(worldX, worldZ))

    let minimumSurfaceY = profile.world.maximumY
    let maximumSurfaceY = profile.world.minimumY
    for localX in range(profile.sampling.halo, profile.sampling.halo + edge):
        for localZ in range(profile.sampling.halo, profile.sampling.halo + edge):
            const surfaceY = surfaceHeights[sampleIndex(localX, localZ, sampleEdge)]
            minimumSurfaceY = Math.min(minimumSurfaceY, surfaceY)
            maximumSurfaceY = Math.max(maximumSurfaceY, surfaceY)

    const samples: List<TerrainSample> = []
    const roads = fields.roads.area(minimumX - profile.sampling.halo, minimumZ - profile.sampling.halo, sampleEdge)
    let minimumWaterLevel = profile.world.maximumY
    let maximumWaterLevel = profile.world.minimumY
    for localX in range(sampleEdge):
        const worldX = minimumX + localX - profile.sampling.halo
        for localZ in range(sampleEdge):
            const worldZ = minimumZ + localZ - profile.sampling.halo
            const index = sampleIndex(localX, localZ, sampleEdge)
            const surfaceY = surfaceHeights[index]
            const left = neighborHeight(localX - 1, localZ)
            const right = neighborHeight(localX + 1, localZ)
            const back = neighborHeight(localX, localZ - 1)
            const front = neighborHeight(localX, localZ + 1)
            const slope = saturate(Math.max((right - left).abs(), (front - back).abs()) / 8)
            const cell = horizontalCell(worldX, worldZ)
            const shape = sampleShapes[index]
            const temperature = interpolateGrid(gridTemperatures, cell).round()
            const humidity = interpolateGrid(gridHumidities, cell).round()
            const terrainType = chooseTerrainType(profile, surfaceY, slope, shape)
            const biome = chooseBiome(profile, terrainType, surfaceY, temperature, humidity)
            // 海洋使用全局海面；河流使用同一二维骨架推导出的连续标高。
            // 是否真正填水仍由最终 surfaceY < waterLevel 决定，岸列不会被淹没。
            const basin = fields.waterBodies.sample(worldX, worldZ)
            const waterLevel = basin != null ? basin.waterLevel : terrainType == profile.terrainTypes.river ? shape.riverWaterLevel : profile.world.seaLevel
            waterLevels[index] = waterLevel
            if localX >= profile.sampling.halo and localX < profile.sampling.halo + edge and localZ >= profile.sampling.halo and localZ < profile.sampling.halo + edge:
                minimumWaterLevel = Math.min(minimumWaterLevel, waterLevel)
                maximumWaterLevel = Math.max(maximumWaterLevel, waterLevel)
            const forestNoise = interpolateGrid(gridForests, cell)
            const forestDensity = saturate(0.7 * forestNoise + 0.5 * squish(humidity, 6, 13) - 0.45 * slope)
            samples.append({
                position: {x: worldX, z: worldZ},
                surfaceY,
                slope,
                continentalness: shape.continentalness,
                erosion: shape.erosion,
                ridge: shape.ridge,
                riverStrength: shape.riverStrength,
                temperature,
                humidity,
                forestDensity,
                terrainType,
                biome,
                waterBody: basin?.kind,
                waterLevel,
                geology: fields.geology(worldX / profile.surface.geologyPeriod + 13.7, worldZ / profile.surface.geologyPeriod - 8.3),
                deposit: fields.deposit(worldX / profile.surface.depositPeriod + 3.1, worldZ / profile.surface.depositPeriod + 17.9),
                exposure: fields.exposure(worldX / profile.surface.outcropPeriod - 9.2, worldZ / profile.surface.outcropPeriod + 5.4),
                roadDistance: surfaceY > waterLevel and slope < profile.roads.maximumGrade and biome != profile.biomes.coast and biome != profile.biomes.river and biome != profile.biomes.ocean ? roads.distanceAt(worldX + 0.5, worldZ + 0.5) : null,
            })

    def requireLocalSample(worldX: number, worldZ: number) -> number:
        const localX = worldX - minimumX + profile.sampling.halo
        const localZ = worldZ - minimumZ + profile.sampling.halo
        assert localX.isInteger() and localZ.isInteger() and localX >= 0 and localX < sampleEdge and localZ >= 0 and localZ < sampleEdge else "Terrain sample is outside this column plan"
        return sampleIndex(localX, localZ, sampleEdge)

    def sampleAt(worldX: number, worldZ: number) -> readonly TerrainSample:
        return samples[requireLocalSample(worldX, worldZ)]

    def surfaceYAt(worldX: number, worldZ: number) -> number: return surfaceHeights[requireLocalSample(worldX, worldZ)]

    def waterLevelAt(worldX: number, worldZ: number) -> number: return waterLevels[requireLocalSample(worldX, worldZ)]

    return {edge, minimumX, minimumZ, densityGrid, surfaceHeights, waterLevels, minimumSurfaceY, maximumSurfaceY, minimumWaterLevel, maximumWaterLevel, samples, densityAt, densityColumnAt, sampleAt, surfaceYAt, waterLevelAt}

/// LRU 的 key 只有水平 Chunk 坐标。一个列计划包含完整世界高度，所以相同 X/Z
/// 的十六个垂直 Chunk 只构建一次密度网格和装饰所需表面事实。
export def columnPlanner(fields: GenerationFields, edge: number, capacity: number = fields.profile.sampling.columnCacheCapacity) -> ColumnPlanner:
    assert edge == 16 else "Terrain column planner requires a Chunk edge of 16"
    assert capacity.isInteger() and capacity > 0 else "Column cache capacity must be a positive integer"
    const plans: Map<string, TerrainColumnPlan> = Map()
    let builds = 0

    def cachedColumnCount() -> number: return plans.size

    def columnBuildCount() -> number: return builds

    def columns(chunkX: number, chunkZ: number) -> TerrainColumnPlan:
        const key = f"{chunkX}:{chunkZ}"
        if plans.has(key):
            const existing = plans.get(key)!
            plans.remove(key)
            plans.set(key, existing)
            return existing
        const plan = createTerrainColumnPlan(fields, chunkX, chunkZ, edge)
        builds += 1
        if plans.size >= capacity: evictOldest(plans)
        plans.set(key, plan)
        return plan

    return {cachedColumnCount, columnBuildCount, columns}

export def sampleTerrainWithFields(fields: GenerationFields, position: Coordinate2) -> TerrainSample:
    requireCoordinate2(position, "Terrain")
    const edge = 16
    const chunkX = (position.x / edge).floor()
    const chunkZ = (position.z / edge).floor()
    return TerrainSample.parse(createTerrainColumnPlan(fields, chunkX, chunkZ, edge).sampleAt(position.x, position.z))

export def sampleTerrain(seed: string, position: Coordinate2) -> TerrainSample:
    return sampleTerrainWithFields(createGenerationFields(seed), position)

export def findSurfaceY(fields: GenerationFields, position: Coordinate2) -> number:
    return sampleTerrainWithFields(fields, position).surfaceY

export def temperatureAtHeight(profile: readonly WorldGeneratorDefinition, temperature: number, y: number) -> number:
    return worldTemperatureAtHeight(temperature, y, profile.world.seaLevel).round()

export def baseTerrainBlock(fields: GenerationFields, blocks: readonly SurvivalBlockPalette, sample: readonly TerrainSample, waterLevel: number, y: number, density: number, strataBase: number) -> number:
    const profile = fields.profile
    if y < profile.world.minimumY or y > profile.world.maximumY: return blocks.air
    if density < 0:
        // 只填最终地表与连续水位之间的开放水柱。地表以下即使密度为负也
        // 属于洞穴/悬空腔，不能被表层水文误判成贯穿地下的水体。
        const fluidSurfaceY = waterLevel.floor()
        if sample.surfaceY < waterLevel and y > sample.surfaceY and y <= fluidSurfaceY:
            if y == fluidSurfaceY and temperatureAtHeight(profile, sample.temperature, y) <= profile.surface.snowTemperature:
                return blocks.ice
            return blocks.water
        return blocks.air
    if y < profile.world.bedrockDepth: return blocks.basalt
    const strata = 0.72 * strataBase + 0.28 * Math.sin(y * 0.19 + strataBase * 2.7)
    if y < 32: return blocks.basalt
    if sample.biome == profile.biomes.desert or sample.biome == profile.biomes.coast:
        if y >= sample.surfaceY - 18 and (sample.exposure ?? 0) <= 0.3: return blocks.sandstone
    if y >= sample.surfaceY - 18: return surfaceBedrock(blocks, sample)
    if strata > 0.58: return blocks.limestone
    if strata < -0.58: return blocks.granite
    return blocks.stone
