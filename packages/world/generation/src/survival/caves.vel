import {BlockRegistry} from "@openvoxel/blocks"
import {builtinIdentities} from "@openvoxel/identities"
import {Random, random} from "velar/random"
import {Chunk, Coordinate3} from "@openvoxel/world"
import {WorldGeneratorDefinition} from "../definition/catalog.vel"
import {SurvivalBlockPalette} from "./block-palette.vel"
import {evictOldest} from "./lru-cache.vel"
import {CompiledFeaturePlan, FeatureBounds, FeatureWrite, applyCompiledFeaturePlan, chunkMinimumX, chunkMinimumZ} from "./feature-plan.vel"
import {GenerationFields, TerrainColumnPlan, terrainTargetSurfaceY} from "./terrain.vel"

const cavePlanCacheCapacity = 256

export type CavePlanner:
    cachedPlanCount: () -> number
    planBuildCount: () -> number
    tunnel: (cellX: number, cellZ: number) -> readonly CompiledFeaturePlan
    chamber: (cellX: number, cellZ: number) -> readonly CompiledFeaturePlan

/// 洞穴中心线只保存球心和半径，每四个数字是一枚笔刷。真正写入某个 Chunk 的
/// 相对方块列表在第一次相交时编译并按 Chunk 缓存，避免为远端洞穴提前展开。
def appendTunnelBrushes(
    brushes: List<number>,
    stream: Random,
    start: readonly Coordinate3,
    length: number,
    minimumRadius: number,
    maximumRadius: number,
):
    let x = start.x
    let y = start.y
    let z = start.z
    let heading = stream.number() * Math.tau
    let vertical = stream.number() * 0.24 - 0.12
    const steps = Math.max(1, (length / 2).round())
    for step in range(steps):
        const phase = steps <= 1 ? 0 : step / (steps - 1)
        const taper = Math.sin(phase * Math.pi)
        const radius = minimumRadius + (maximumRadius - minimumRadius) * (0.35 + 0.65 * taper) * (0.82 + 0.36 * stream.number())
        brushes.append(x)
        brushes.append(y)
        brushes.append(z)
        brushes.append(radius)
        heading += (stream.number() - 0.5) * 0.28
        vertical = Math.clamp(vertical + (stream.number() - 0.5) * 0.08, -0.28, 0.22)
        x += Math.cos(heading) * 2
        y += vertical * 2
        z += Math.sin(heading) * 2

def brushBounds(origin: readonly Coordinate3, brushes: readonly List<number>) -> FeatureBounds:
    if brushes.size == 0:
        return {minimumX: origin.x, maximumX: origin.x, minimumY: origin.y, maximumY: origin.y, minimumZ: origin.z, maximumZ: origin.z}
    let minimumX = Math.infinity
    let maximumX = -Math.infinity
    let minimumY = Math.infinity
    let maximumY = -Math.infinity
    let minimumZ = Math.infinity
    let maximumZ = -Math.infinity
    for offset in range(0, brushes.size, 4):
        const x = brushes[offset]
        const y = brushes[offset + 1]
        const z = brushes[offset + 2]
        const radius = brushes[offset + 3]
        minimumX = Math.min(minimumX, (x - radius).floor())
        maximumX = Math.max(maximumX, (x + radius).ceil())
        minimumY = Math.min(minimumY, (y - radius).floor())
        maximumY = Math.max(maximumY, (y + radius).ceil())
        minimumZ = Math.min(minimumZ, (z - radius).floor())
        maximumZ = Math.max(maximumZ, (z + radius).ceil())
    return {minimumX, maximumX, minimumY, maximumY, minimumZ, maximumZ}

def lazyCaveFeature(owner: string, origin: Coordinate3, brushes: List<number>, air: number) -> CompiledFeaturePlan:
    const bounds = brushBounds(origin, brushes)
    const buckets: Map<string, List<FeatureWrite>> = Map()
    const writes: List<FeatureWrite> = []

    def bucket(chunkX: number, chunkY: number, chunkZ: number) -> readonly List<readonly FeatureWrite>:
        const key = f"{chunkX}:{chunkY}:{chunkZ}"
        if buckets.has(key): return buckets.get(key)!
        const compiled: List<FeatureWrite> = []
        const minimumX = chunkX * 16
        const maximumX = minimumX + 15
        const minimumY = chunkY * 16
        const maximumY = minimumY + 15
        const minimumZ = chunkZ * 16
        const maximumZ = minimumZ + 15
        for offset in range(0, brushes.size, 4):
            const centerX = brushes[offset]
            const centerY = brushes[offset + 1]
            const centerZ = brushes[offset + 2]
            const radius = brushes[offset + 3]
            if centerX + radius < minimumX or centerX - radius > maximumX or centerY + radius < minimumY or centerY - radius > maximumY or centerZ + radius < minimumZ or centerZ - radius > maximumZ:
                continue
            const radiusSquared = radius * radius
            for x in range(Math.max(minimumX, (centerX - radius).floor()), Math.min(maximumX, (centerX + radius).ceil()) + 1):
                for z in range(Math.max(minimumZ, (centerZ - radius).floor()), Math.min(maximumZ, (centerZ + radius).ceil()) + 1):
                    for y in range(Math.max(minimumY, Math.max(5, (centerY - radius).floor())), Math.min(maximumY, (centerY + radius).ceil()) + 1):
                        const dx = x + 0.5 - centerX
                        const dy = y + 0.5 - centerY
                        const dz = z + 0.5 - centerZ
                        if dx * dx + dy * dy + dz * dz <= radiusSquared:
                            compiled.append({x: x - origin.x, y: y - origin.y, z: z - origin.z, runtimeId: air})
        buckets.set(key, compiled)
        return compiled

    return {owner, origin, bounds, sortKey: owner, writes, buckets, bucket}

/// 所有者计划只编译中心线；目标 Chunk 的相对方块桶按需生成并缓存。这样既保留
/// 统一 FeaturePlan 契约，也把首次成本限制在真正与当前 Chunk 相交的洞穴片段。
export def cavePlanner(fields: GenerationFields, seed: string, blocks: readonly SurvivalBlockPalette, capacity: number = cavePlanCacheCapacity) -> CavePlanner:
    assert capacity.isInteger() and capacity > 0 else "Cave plan cache capacity must be a positive integer"
    const root = random(seed).fork("caves")
    const profile = fields.profile
    const plans: Map<string, CompiledFeaturePlan> = Map()
    let builds = 0

    def cachedPlanCount() -> number: return plans.size

    def planBuildCount() -> number: return builds

    def remember(key: string, plan: CompiledFeaturePlan) -> readonly CompiledFeaturePlan:
        builds += 1
        if plans.size >= capacity: evictOldest(plans)
        plans.set(key, plan)
        return plan

    def tunnel(cellX: number, cellZ: number) -> readonly CompiledFeaturePlan:
        const key = f"t:{cellX}:{cellZ}"
        if plans.has(key):
            const existing = plans.get(key)!
            plans.remove(key)
            plans.set(key, existing)
            return existing
        const size = profile.caves.tunnelCellSize
        const origin = {x: cellX * size, y: 0, z: cellZ * size}
        const owner = root.fork(key)
        const brushes: List<number> = []
        if owner.bool(profile.caves.tunnelChance):
            const startX = origin.x + owner.int(0, size)
            const startZ = origin.z + owner.int(0, size)
            const surfaceY = terrainTargetSurfaceY(fields, {x: startX, z: startZ})
            if surfaceY > profile.caves.surfaceThickness + 8:
                const startY = owner.int(7, Math.max(8, Math.min(surfaceY - profile.caves.surfaceThickness, 72)))
                const start = {x: startX, y: startY, z: startZ}
                const length = owner.int(profile.caves.minimumLength, profile.caves.maximumLength + 1)
                appendTunnelBrushes(brushes, owner.fork("main"), start, length, profile.caves.minimumRadius, profile.caves.maximumRadius)
                if owner.bool(profile.caves.branchChance):
                    appendTunnelBrushes(brushes, owner.fork("branch"), {x: start.x, y: start.y - 2, z: start.z}, Math.max(profile.caves.minimumLength, (length * 0.64).round()), profile.caves.minimumRadius, profile.caves.maximumRadius * 0.82)
        return remember(key, lazyCaveFeature(key, origin, brushes, blocks.air))

    def chamber(cellX: number, cellZ: number) -> readonly CompiledFeaturePlan:
        const key = f"c:{cellX}:{cellZ}"
        if plans.has(key):
            const existing = plans.get(key)!
            plans.remove(key)
            plans.set(key, existing)
            return existing
        const size = profile.caves.chamberCellSize
        const origin = {x: cellX * size, y: 0, z: cellZ * size}
        const owner = root.fork(key)
        const brushes: List<number> = []
        if owner.bool(profile.caves.chamberChance):
            const centerX = origin.x + owner.int(0, size)
            const centerZ = origin.z + owner.int(0, size)
            const surfaceY = terrainTargetSurfaceY(fields, {x: centerX, z: centerZ})
            if surfaceY > 24:
                const centerY = owner.int(10, Math.max(11, Math.min(surfaceY - profile.caves.surfaceThickness - 2, 68)))
                const radius = profile.caves.minimumChamberRadius + owner.number() * (profile.caves.maximumChamberRadius - profile.caves.minimumChamberRadius)
                brushes.append(centerX)
                brushes.append(centerY)
                brushes.append(centerZ)
                brushes.append(radius)
        return remember(key, lazyCaveFeature(key, origin, brushes, blocks.air))

    return {cachedPlanCount, planBuildCount, tunnel, chamber}

export def carveCaves(chunk: Chunk, planner: CavePlanner, profile: readonly WorldGeneratorDefinition, blocks: readonly SurvivalBlockPalette, registry: readonly BlockRegistry, terrain: readonly TerrainColumnPlan):
    const minimumX = chunkMinimumX(chunk)
    const maximumX = minimumX + chunk.edge - 1
    const minimumZ = chunkMinimumZ(chunk)
    const maximumZ = minimumZ + chunk.edge - 1
    const tunnelReach = profile.caves.maximumLength + profile.caves.maximumRadius.ceil()
    const tunnelFirstX = ((minimumX - tunnelReach) / profile.caves.tunnelCellSize).floor()
    const tunnelLastX = ((maximumX + tunnelReach) / profile.caves.tunnelCellSize).floor()
    const tunnelFirstZ = ((minimumZ - tunnelReach) / profile.caves.tunnelCellSize).floor()
    const tunnelLastZ = ((maximumZ + tunnelReach) / profile.caves.tunnelCellSize).floor()

    def carvable(current: number, target: number, worldX: number, worldY: number, worldZ: number) -> bool:
        if worldY > terrain.surfaceYAt(worldX, worldZ) - profile.caves.surfaceThickness: return false
        return registry.hasTag(current, builtinIdentities.tags.naturalRock) or current == blocks.dirt or current == blocks.grass or current == blocks.sand or current == blocks.clay or current == blocks.gravel

    const plans: List<readonly CompiledFeaturePlan> = []
    for cellX in range(tunnelFirstX, tunnelLastX + 1):
        for cellZ in range(tunnelFirstZ, tunnelLastZ + 1): plans.append(planner.tunnel(cellX, cellZ))
    const chamberReach = profile.caves.maximumChamberRadius.ceil()
    const chamberFirstX = ((minimumX - chamberReach) / profile.caves.chamberCellSize).floor()
    const chamberLastX = ((maximumX + chamberReach) / profile.caves.chamberCellSize).floor()
    const chamberFirstZ = ((minimumZ - chamberReach) / profile.caves.chamberCellSize).floor()
    const chamberLastZ = ((maximumZ + chamberReach) / profile.caves.chamberCellSize).floor()
    for cellX in range(chamberFirstX, chamberLastX + 1):
        for cellZ in range(chamberFirstZ, chamberLastZ + 1): plans.append(planner.chamber(cellX, cellZ))
    for plan in plans.sorted(by=plan => plan.sortKey): applyCompiledFeaturePlan(chunk, plan, carvable)
