import {Chunk, paintChunkBlockAtIndex} from "@openvoxel/world"
import {SurvivalBlockPalette} from "./block-palette.vel"
import {GenerationFields, TerrainColumnPlan} from "./terrain.vel"

/// 洞穴完成后才建立局部含水层。这里只决定初始水体和岩浆方块，后续流动、
/// 混合和更新仍由 blocks 之外的流体执行系统负责。
export def generateAquifers(chunk: Chunk, fields: GenerationFields, plan: readonly TerrainColumnPlan, blocks: readonly SurvivalBlockPalette):
    const profile = fields.profile
    const minimumX = chunk.position.x * chunk.edge
    const minimumY = chunk.position.y * chunk.edge
    const minimumZ = chunk.position.z * chunk.edge
    const waterPaletteEntry = chunk.paletteIndex.get(blocks.water)
    const magmaPaletteEntry = chunk.paletteIndex.get(blocks.magma)
    for localX in range(chunk.edge):
        const worldX = minimumX + localX
        for localZ in range(chunk.edge):
            const worldZ = minimumZ + localZ
            const sample = plan.sampleAt(worldX, worldZ)
            const depthRange = profile.aquifers.maximumWaterDepth - profile.aquifers.minimumWaterDepth
            const climateDepth = profile.aquifers.minimumWaterDepth + depthRange * (1 - sample.humidity / 15)
            const localWaterY = (profile.world.seaLevel - climateDepth).round()
            // 一个水平列共享湿度值。含水层不需要逐方块 3D 噪声；Y 只负责与
            // 局部水位和岩浆上限比较，既连续也更便宜。
            const wetness = fields.aquifer(worldX / 52, localWaterY / 38, worldZ / 52)
            for localY in range(chunk.edge):
                const worldY = minimumY + localY
                if worldY >= sample.surfaceY - profile.caves.surfaceThickness: continue
                const index = localX + chunk.edge * (localZ + chunk.edge * localY)
                if chunk.palette[chunk.indices[index]] != blocks.air: continue
                if worldY <= profile.aquifers.magmaMaximumY and wetness > 0.42:
                    if magmaPaletteEntry == null: paintChunkBlockAtIndex(chunk, index, blocks.magma)
                    else: chunk.indices[index] = magmaPaletteEntry
                else if worldY <= localWaterY and wetness >= profile.aquifers.wetThreshold:
                    if waterPaletteEntry == null: paintChunkBlockAtIndex(chunk, index, blocks.water)
                    else: chunk.indices[index] = waterPaletteEntry
