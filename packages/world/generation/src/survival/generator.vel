import {BlockRegistry, WorldBlockRegistry, baseWorldBlockRegistry, resolveBlockShapeBoxes} from "@openvoxel/blocks"
import {Chunk, ChunkPosition, Coordinate2, Coordinate3, chunkKey, chunkPaletteTemplate, emptyChunk} from "@openvoxel/world"
import {WorldGenerator} from "../contracts.vel"
import {WorldGeneratorDefinition, WorldGeneratorPaletteDefinition} from "../definition/catalog.vel"
import {baseWorldGeneratorCatalog} from "../runtime/builtin-catalog.vel"
import {TerrainSample} from "../terrain-sample.vel"
import {SurvivalBlockPalette, createSurvivalBlockPalette, survivalChunkPalette} from "./block-palette.vel"
import {carveCaves, cavePlanner} from "./caves.vel"
import {generateAquifers} from "./fluids.vel"
import {generateMinerals, mineralPlanner} from "./minerals.vel"
import {generateSurface, surfacePlanner} from "./surface.vel"
import {GenerationFields, TerrainColumnPlan, baseTerrainBlock, columnPlanner, createGenerationFields, terrainTargetSurfaceY} from "./terrain.vel"
import {DecorationPlan, decorationPlanner, decorationVerticalBounds, generateVegetation} from "./vegetation.vel"
import {ecologyCandidatePlanner} from "./ecology-candidates.vel"
import {evictOldest} from "./lru-cache.vel"
import {requireTreeShapeEnvelope} from "./tree-shapes.vel"
import {coastalSpawnAffinity, coastalSpawnScore} from "./coastal-spawn.vel"

/// 生成结果的代码语义版本，与可调 YAML 参数一起锁定世界。修改地形、树冠
/// 或阶段顺序时同步递增，保证旧清单不会悄悄使用新算法生成邻接区块。
export const survivalAlgorithmRevision = 1

export def generateBaseTerrain(
    chunk: Chunk,
    fields: GenerationFields,
    plan: readonly TerrainColumnPlan,
    paletteBlocks: readonly SurvivalBlockPalette,
):
    const minimumX = chunk.position.x * chunk.edge
    const minimumY = chunk.position.y * chunk.edge
    const minimumZ = chunk.position.z * chunk.edge
    for localX in range(chunk.edge):
        const worldX = minimumX + localX
        for localZ in range(chunk.edge):
            const worldZ = minimumZ + localZ
            const sample = plan.sampleAt(worldX, worldZ)
            const waterLevel = plan.waterLevelAt(worldX, worldZ)
            const strataBase = fields.strata(worldX * 0.045, worldZ * 0.045)
            const densityAtY = plan.densityColumnAt(worldX, worldZ)
            for localY in range(chunk.edge):
                const worldY = minimumY + localY
                const index = localX + chunk.edge * (localZ + chunk.edge * localY)
                // baseTerrainBlock 只关心各材料槽位中的数字含义。这里传入同形的
                // 局部索引记录，选择结果可以直接写入 UInt16Buffer，无需再执行
                // runtimeId -> paletteIndex 的逐体素 Map 查询。
                chunk.indices[index] = baseTerrainBlock(fields, paletteBlocks, sample, waterLevel, worldY, densityAtY(worldY), strataBase)

type SpawnCandidate:
    x: number
    z: number
    score: number

/// 出生点使用最终装饰计划复核脚部和头部两格。树干、叶片、仙人掌、积雪以及
/// Mod 内容都通过方块目录中的碰撞盒判断；生成器不按具体方块身份写例外。
def decorationObstructsSpawn(
    plan: readonly DecorationPlan,
    x: number,
    feetY: number,
    z: number,
    registry: readonly BlockRegistry,
) -> bool:
    for feature in plan.features:
        if x < feature.bounds.minimumX or x > feature.bounds.maximumX or z < feature.bounds.minimumZ or z > feature.bounds.maximumZ:
            continue
        for write in feature.writes:
            const worldX = feature.origin.x + write.x
            const worldY = feature.origin.y + write.y
            const worldZ = feature.origin.z + write.z
            if worldX != x or worldZ != z or worldY < feetY or worldY > feetY + 1: continue
            const state = registry.requireStateByRuntimeId(write.runtimeId)
            if resolveBlockShapeBoxes(state.physics.collision, state.properties).size > 0: return true
    return false

/// 第一遍只用地形骨架高度筛掉明显不合格的位置，并按粗略分数排序。
/// 第二遍优先检查前 16 个候选；如果它们都被最终坡度或群系淘汰，则继续沿
/// 已排序列表寻找第一个安全位置。这样常见种子维持低成本，极端种子也不会
/// 因为候选截断而错误报告整片搜索半径没有安全出生点。
def coarseSpawnCandidates(fields: GenerationFields) -> List<SpawnCandidate>:
    const profile = fields.profile
    const candidates: List<SpawnCandidate> = []
    const radius = profile.spawn.searchRadius
    const step = profile.spawn.sampleStep
    const heights: Map<string, number> = Map()

    def heightAt(position: readonly Coordinate2) -> number:
        const key = f"{position.x}:{position.z}"
        const existing = heights.get(key)
        if existing != null: return existing
        const height = terrainTargetSurfaceY(fields, position)
        heights.set(key, height)
        return height

    for x in range(-radius, radius + 1, step):
        for z in range(-radius, radius + 1, step):
            const distanceSquared = x * x + z * z
            if distanceSquared > radius * radius: continue
            const surfaceY = heightAt({x, z})
            if surfaceY < profile.spawn.minimumY - 8 or surfaceY > profile.spawn.maximumY + 8: continue
            const dx = (heightAt({x: x + step, z}) - heightAt({x: x - step, z})).abs()
            const dz = (heightAt({x, z: z + step}) - heightAt({x, z: z - step})).abs()
            const coarseSlope = Math.max(dx, dz) / (2 * step)
            const coast = surfaceY >= profile.spawn.minimumY and surfaceY <= profile.world.seaLevel + 8 ? coastalSpawnAffinity({x, z}, profile.world.seaLevel, heightAt) : 0
            const score = 220 + 160 * coast - 120 * coarseSlope - 0.035 * Math.sqrt(distanceSquared) - 3 * (surfaceY - profile.world.seaLevel - 3).abs()
            candidates.append({x, z, score})
    return candidates.sorted(by=candidate => -candidate.score)

/// 构造生存生成器时同时绑定配置、种子和当前世界方块注册表。所有方块 key 只在
/// 这里解析一次；Chunk 生成热路径只使用当前世界的数字调色板。
export def survivalWorldGenerator(
    seed: string,
    edge: number,
    worldBlocks: readonly WorldBlockRegistry = baseWorldBlockRegistry,
    profile: readonly WorldGeneratorDefinition = baseWorldGeneratorCatalog.generators[0],
    palette: readonly WorldGeneratorPaletteDefinition = baseWorldGeneratorCatalog.palettes[0],
) -> WorldGenerator:
    requireTreeShapeEnvelope(profile.vegetation.maximumTreeHeight, profile.vegetation.treeHorizontalReach)
    assert profile.palette == palette.key else f"World generator {profile.key} requires palette {profile.palette}, received {palette.key}"
    const blocks = createSurvivalBlockPalette(worldBlocks.registry, palette.blocks)
    // 基础填充会写满 4096 个位置。提前建立完整局部调色板后可直接写 UInt16
    // 索引，避免每个方块重复做 runtimeId 合法性校验和动态调色板扩容查询。
    const generationPalette = survivalChunkPalette(blocks)
    const generationChunkPalette = chunkPaletteTemplate(generationPalette.runtimeIds)
    const fields = createGenerationFields(seed, profile)
    const columns = columnPlanner(fields, edge)
    const caves = cavePlanner(fields, seed, blocks)
    const minerals = mineralPlanner(profile, palette, seed, worldBlocks.registry)
    const surfaces = surfacePlanner(profile, blocks)
    const decorations = decorationPlanner(profile, seed, blocks, columns, worldBlocks.registry)
    let minimumMineralY = profile.world.maximumY
    let maximumMineralY = profile.world.minimumY
    for mineral in profile.minerals:
        minimumMineralY = Math.min(minimumMineralY, mineral.minimumY)
        maximumMineralY = Math.max(maximumMineralY, mineral.maximumY)

    def sample(position: readonly Coordinate2) -> TerrainSample:
        const plan = columns.columns((position.x / edge).floor(), (position.z / edge).floor())
        return TerrainSample.parse(plan.sampleAt(position.x, position.z))

    def generateTerrain(position: readonly ChunkPosition) -> Chunk:
        const minimumY = position.y * edge
        const maximumY = minimumY + edge - 1
        if maximumY < profile.world.minimumY or minimumY > profile.world.maximumY:
            return emptyChunk(position, edge, blocks.air)
        // 生成器配置已经给出自然地表和装饰阶段的硬上界。这个全局包络不依赖
        // x/z，必须先于地形列规划检查；高空飞行因而不会
        // 为一批可证明为空的 section 建造昂贵的密度列缓存。
        const maximumGeneratedContentY = Math.max(
            profile.world.maximumNaturalSurfaceY + profile.vegetation.maximumTreeHeight,
            profile.world.seaLevel,
        )
        if minimumY > maximumGeneratedContentY: return emptyChunk(position, edge, blocks.air)
        const plan = columns.columns(position.x, position.z)
        const decoration = decorations.decorations(position.x, position.z)
        const decorationBounds = decorationVerticalBounds(decoration)
        // 跨 Chunk 树冠的根可能位于更高的邻接地形；只有目标列内实际装饰包络
        // 能证明高空 section 为空，不能再拿本列 surfaceY 加一个估算高度。
        let maximumContentY = Math.max(plan.maximumSurfaceY, plan.maximumWaterLevel.floor())
        if decorationBounds != null: maximumContentY = Math.max(maximumContentY, decorationBounds.maximumY)
        if minimumY > maximumContentY: return emptyChunk(position, edge, blocks.air)
        const generatedChunk = generationChunkPalette.instantiate(position, edge)
        // 固定阶段顺序是生成结果的一部分：后续阶段只覆盖前一阶段明确允许的方块。
        generateBaseTerrain(generatedChunk, fields, plan, generationPalette.indices)
        carveCaves(generatedChunk, caves, profile, blocks, worldBlocks.registry, plan)
        const highestAquiferY = Math.max(profile.world.seaLevel - profile.aquifers.minimumWaterDepth, profile.aquifers.magmaMaximumY)
        if minimumY <= highestAquiferY: generateAquifers(generatedChunk, fields, plan, blocks)
        if maximumY >= minimumMineralY and minimumY <= maximumMineralY:
            generateMinerals(generatedChunk, minerals, blocks, worldBlocks.registry)
        const minimumSurfacePaintY = plan.minimumSurfaceY - profile.surface.wetSoilDepth + 1
        if maximumY >= minimumSurfacePaintY and minimumY <= plan.maximumSurfaceY:
            generateSurface(generatedChunk, surfaces.surface(plan), blocks, worldBlocks.registry)
        // 精确包络同时覆盖本列所有者与跨边界所有者，不会漏掉高邻地形伸来的树冠。
        if decorationBounds != null and maximumY >= decorationBounds.minimumY and minimumY <= decorationBounds.maximumY:
            generateVegetation(generatedChunk, decoration, blocks, worldBlocks.registry)
        return generatedChunk

    def findSpawn() -> Coordinate3:
        let best: TerrainSample? = null
        let bestScore = -Math.infinity
        let foundCoast = false
        const preferredCandidateCount = 16
        for coarse, index in coarseSpawnCandidates(fields):
            if index >= preferredCandidateCount and best != null and (foundCoast or index >= 128): break
            const candidate = sample(Coordinate2.from(coarse))
            if candidate.surfaceY < profile.spawn.minimumY or candidate.surfaceY > profile.spawn.maximumY: continue
            if candidate.slope > profile.spawn.maximumSlope: continue
            if candidate.biome == profile.biomes.ocean: continue
            const terrain = columns.columns((candidate.position.x / edge).floor(), (candidate.position.z / edge).floor())
            if candidate.surfaceY < terrain.waterLevelAt(candidate.position.x, candidate.position.z): continue
            const coast = candidate.surfaceY <= profile.world.seaLevel + 8 ? coastalSpawnAffinity(candidate.position, profile.world.seaLevel, position => sample(position).surfaceY) : 0
            const score = coastalSpawnScore(profile, candidate, coast)
            if score <= bestScore: continue
            const feetY = candidate.surfaceY + 1
            const decoration = decorations.decorations((candidate.position.x / edge).floor(), (candidate.position.z / edge).floor())
            if decorationObstructsSpawn(decoration, candidate.position.x, feetY, candidate.position.z, worldBlocks.registry):
                continue
            if score > bestScore:
                best = candidate
                bestScore = score
                foundCoast = coast > 0
        assert best != null else "World generator could not find a safe spawn inside the configured radius"
        // best 是循环中持续改写的可选位置；断言后复制成稳定 const，让运行时只
        // 校验一次完整 TerrainSample，后面的三个字段读取无需重复深校验。
        const selected: TerrainSample = best
        return {x: selected.position.x, y: selected.surfaceY + 1, z: selected.position.z}

    // 生态候选偶尔先于冷地形请求读取相邻 section 的支撑面。保留最多十六个
    // 尚未交给调用者的结果，随后冷查询直接接管并移出缓存，不重跑完整生成。
    const preparedTerrain: Map<string, Chunk> = Map()

    def prepareForEcology(position: readonly ChunkPosition) -> Chunk:
        const key = chunkKey(position)
        const existing = preparedTerrain.get(key)
        if existing != null: return existing
        const chunk = generateTerrain(position)
        if preparedTerrain.size >= 16: evictOldest(preparedTerrain)
        preparedTerrain.set(key, chunk)
        return chunk

    const ecologyPlanner = ecologyCandidatePlanner(profile, blocks, worldBlocks.registry, columns, decorations, prepareForEcology)

    def generate(position: readonly ChunkPosition) -> Chunk:
        const key = chunkKey(position)
        const chunk = preparedTerrain.get(key) ?? generateTerrain(position)
        preparedTerrain.remove(key)
        ecologyPlanner.remember(chunk)
        return chunk

    const ecologyCandidates = ecologyPlanner.candidates
    return {sample, generate, ecologyCandidates, findSpawn}
