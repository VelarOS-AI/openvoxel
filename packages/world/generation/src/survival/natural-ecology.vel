import {biomeAffinity, ecosystemUnits, habitatWeight, stageEnabled} from "../ecosystem/composition.vel"
import {plantRuntimeId} from "./ground-plants.vel"
import {fallenTreeWrites} from "./fallen-trees.vel"
import {Random, random} from "velar/random"
import {BlockRegistry} from "@openvoxel/blocks"
import {builtinIdentities} from "@openvoxel/identities"
import {Coordinate3} from "@openvoxel/world"
import {WorldGeneratorDefinition} from "../definition/catalog.vel"
import {SurvivalBlockPalette} from "./block-palette.vel"
import {CompiledFeaturePlan, FeatureWrite, compiledFeaturePlan, featurePlansOverlap} from "./feature-plan.vel"
import {ColumnPlanner, TerrainColumnPlan, surfaceBlock, temperatureAtHeight} from "./terrain.vel"
import {surfaceBedrock} from "./surface-materials.vel"
import {EcologyPatterns, createEcologyPatterns} from "./ecology-patterns.vel"

/// 完整倒木与残枝的水平包络为六格；装饰规划器用同一包络扩展结构候选，保证
/// 跨 Chunk 的整组避让决策只依赖同一组世界坐标所有者。
export const naturalEcologyHorizontalReach = 6

type HorizontalAttachment:
    x: number
    z: number
    facing: string

type CliffSupport:
    x: number
    z: number
    facing: string
    surfaceY: number

def planAt(columns: ColumnPlanner, x: number, z: number) -> readonly TerrainColumnPlan:
    return columns.columns((x / 16).floor(), (z / 16).floor())

def horizontalAttachment(choice: number) -> HorizontalAttachment:
    if choice == 0: return {x: 0, z: 1, facing: "north"}
    if choice == 1: return {x: -1, z: 0, facing: "east"}
    if choice == 2: return {x: 0, z: -1, facing: "south"}
    return {x: 1, z: 0, facing: "west"}

def facingState(registry: readonly BlockRegistry, block: number, facing: string) -> number:
    return registry.withProperty(block, "facing", facing)

def featureSortKey(layer: string, owner: string) -> string: return f"{layer}:{owner}"

def overlapsTarget(feature: readonly CompiledFeaturePlan, minimumX: number, minimumZ: number) -> bool:
    return feature.bounds.minimumX <= minimumX + 15 and feature.bounds.maximumX >= minimumX and feature.bounds.minimumZ <= minimumZ + 15 and feature.bounds.maximumZ >= minimumZ

/// 藤蔓与树共享树候选的世界坐标所有者。一次候选只构造一条 Random 子流，
/// 向下延伸使用同一个长度结果，不按藤蔓体素创建随机对象。
export def treeVineFeature(
    owner: string,
    ground: Coordinate3,
    height: number,
    humidity: number,
    vine: number,
    registry: readonly BlockRegistry,
    stream: Random,
    tree: readonly CompiledFeaturePlan,
) -> CompiledFeaturePlan?:
    if humidity < 9 or not stream.bool(0.48): return null
    const attachment = horizontalAttachment(stream.int(0, 4))
    const occupied = Set(tree.writes.map(write => f"{write.x}:{write.y}:{write.z}"))
    let start = height - 1
    // 先找到树形真正外露的树干侧面。叶冠包住的位置不会成为藤蔓起点。
    while start >= 3 and ((f"{attachment.x}:{start}:{attachment.z}" in occupied) or not (f"0:{start}:0" in occupied)):
        start -= 1
    if start < 3: return null
    const length = Math.min(start, stream.int(2, 6))
    const state = facingState(registry, vine, attachment.facing)
    const writes: List<FeatureWrite> = []
    for offset in range(length):
        const y = start - offset
        if f"{attachment.x}:{y}:{attachment.z}" in occupied: break
        writes.append(FeatureWrite.from(attachment, {y, runtimeId: state}))
    const vineOwner = f"vine-tree:{owner}"
    return compiledFeaturePlan(vineOwner, ground, featureSortKey("0_structure", vineOwner), writes)

export def deadwoodFeature(
    profile: readonly WorldGeneratorDefinition,
    blocks: readonly SurvivalBlockPalette,
    columns: ColumnPlanner,
    registry: readonly BlockRegistry,
    cellX: number,
    cellZ: number,
    stream: Random,
) -> CompiledFeaturePlan?:
    const unit = ecosystemUnits(profile).features.find(feature => feature.algorithm == "deadwood")
    if unit == null or not stageEnabled(profile, "vegetation"): return null
    if not stream.bool(unit.chance): return null
    const deadwood = registry.defaultStateRuntimeIdForKey(unit.block)
    const size = profile.vegetation.deadwoodCellSize
    const x = cellX * size + stream.int(0, size)
    const z = cellZ * size + stream.int(0, size)
    const plan = planAt(columns, x, z)
    const sample = plan.sampleAt(x, z)
    if sample.roadDistance != null: return null
    if sample.surfaceY <= profile.world.seaLevel or sample.slope > profile.vegetation.treeMaximumSlope: return null
    const ground = surfaceBlock(profile, blocks, sample)
    if not registry.hasTag(ground, builtinIdentities.tags.treeSupport): return null
    const woodland = (sample.biomeFamily ?? sample.biome) == profile.biomes.forest or (sample.biomeFamily ?? sample.biome) == profile.biomes.taiga or (sample.biomeFamily ?? sample.biome) == profile.biomes.birchForest
    let chance = 0.008
    if woodland: chance = 0.055 + sample.forestDensity * 0.095
    else if sample.humidity >= 7: chance = 0.025
    if not stream.bool(chance): return null

    const owner = f"deadwood:{cellX}:{cellZ}"
    const writes: List<FeatureWrite> = []
    // 独立树桩只占枯木候选的 6%，其余生成完整倒木。
    if stream.bool(0.06):
        writes.append({x: 0, y: 1, z: 0, runtimeId: deadwood})
        if stream.bool(0.2): writes.append({x: 0, y: 2, z: 0, runtimeId: deadwood})
    else:
        const alongX = stream.bool()
        const length = stream.int(6, 11)
        const direction = stream.bool() ? 1 : -1
        const trunk = registry.withProperty(deadwood, "axis", alongX ? "x" : "z")
        const branch = registry.withProperty(deadwood, "axis", alongX ? "z" : "x")
        const shape = fallenTreeWrites(length, alongX, direction, trunk, branch, deadwood)
        let lowest = sample.surfaceY
        let highest = sample.surfaceY
        for write in shape:
            const blockSample = planAt(columns, x + write.x, z + write.z).sampleAt(x + write.x, z + write.z)
            if blockSample.roadDistance != null or blockSample.surfaceY <= (blockSample.waterLevel ?? profile.world.seaLevel):
                return null
            const support = surfaceBlock(profile, blocks, blockSample)
            if not registry.hasTag(support, builtinIdentities.tags.treeSupport): return null
            lowest = Math.min(lowest, blockSample.surfaceY)
            highest = Math.max(highest, blockSample.surfaceY)
        // 刚性主干保持直线，最多跨越一格浅洼，不随每列地面折成阶梯。
        if highest - lowest > 1: return null
        for write in shape: writes.append(FeatureWrite.from(write, {y: write.y + highest - sample.surfaceY + 1}))
    return compiledFeaturePlan(owner, {x, y: sample.surfaceY, z}, featureSortKey("0_structure", owner), writes)

def deadwoodOwnerPrecedes(leftX: number, leftZ: number, rightX: number, rightZ: number) -> bool:
    return leftX < rightX or (leftX == rightX and leftZ < rightZ)

/// 枯木先在世界 owner-cell 邻域内得到唯一裁决，目标 Chunk 随后只能裁剪结果。
/// 只比较拥有更小坐标序的原始候选，让每个候选的 admit/reject 不依赖扫描起点，
/// 也不通过一串已入选候选把决策传播到无界邻域。
def deadwoodOwnsOverlaps(
    profile: readonly WorldGeneratorDefinition,
    blocks: readonly SurvivalBlockPalette,
    columns: ColumnPlanner,
    registry: readonly BlockRegistry,
    cellX: number,
    cellZ: number,
    feature: readonly CompiledFeaturePlan,
    root: Random,
) -> bool:
    const cellRadius = Math.max(1, ((naturalEcologyHorizontalReach * 2) / profile.vegetation.deadwoodCellSize).ceil())
    for neighborX in range(cellX - cellRadius, cellX + cellRadius + 1):
        for neighborZ in range(cellZ - cellRadius, cellZ + cellRadius + 1):
            if not deadwoodOwnerPrecedes(neighborX, neighborZ, cellX, cellZ): continue
            const owner = f"deadwood:{neighborX}:{neighborZ}"
            const neighbor = deadwoodFeature(profile, blocks, columns, registry, neighborX, neighborZ, root.fork(owner))
            if neighbor != null and featurePlansOverlap(neighbor, feature): return false
    return true

def cliffSupport(
    profile: readonly WorldGeneratorDefinition,
    blocks: readonly SurvivalBlockPalette,
    columns: ColumnPlanner,
    registry: readonly BlockRegistry,
    x: number,
    z: number,
    firstDirection: number,
) -> CliffSupport?:
    const low = planAt(columns, x, z).sampleAt(x, z)
    for offset in range(4):
        const attachment = horizontalAttachment((firstDirection + offset) % 4)
        const supportX = x - attachment.x
        const supportZ = z - attachment.z
        const supportSample = planAt(columns, supportX, supportZ).sampleAt(supportX, supportZ)
        if supportSample.surfaceY - low.surfaceY < 3: continue
        const support = surfaceBedrock(blocks, supportSample)
        if not registry.hasTag(support, builtinIdentities.tags.vineSupport): continue
        return {x: attachment.x, z: attachment.z, facing: attachment.facing, surfaceY: supportSample.surfaceY}
    return null

def cliffVineFeature(
    profile: readonly WorldGeneratorDefinition,
    blocks: readonly SurvivalBlockPalette,
    columns: ColumnPlanner,
    registry: readonly BlockRegistry,
    cellX: number,
    cellZ: number,
    stream: Random,
) -> CompiledFeaturePlan?:
    const unit = ecosystemUnits(profile).features.find(feature => feature.algorithm == "cliff_vine")
    if unit == null or not stageEnabled(profile, "vegetation"): return null
    if not stream.bool(unit.chance): return null
    const size = profile.vegetation.cliffVineCellSize
    const x = cellX * size + stream.int(0, size)
    const z = cellZ * size + stream.int(0, size)
    const sample = planAt(columns, x, z).sampleAt(x, z)
    const adjustedTemperature = temperatureAtHeight(profile, sample.temperature, sample.surfaceY)
    if sample.humidity < 10 or adjustedTemperature <= 2 or not stream.bool(0.32): return null
    const support = cliffSupport(profile, blocks, columns, registry, x, z, stream.int(0, 4))
    if support == null: return null
    const selected: CliffSupport = support
    const available = selected.surfaceY - sample.surfaceY - 1
    const length = Math.min(available, stream.int(1, 4))
    if length <= 0: return null
    const state = facingState(registry, registry.defaultStateRuntimeIdForKey(unit.block), selected.facing)
    const writes: List<FeatureWrite> = range(0, length).map(offset => ({x: 0, y: -offset, z: 0, runtimeId: state}))
    const owner = f"vine-cliff:{cellX}:{cellZ}"
    return compiledFeaturePlan(owner, {x, y: selected.surfaceY, z}, featureSortKey("1_surface", owner), writes)

def aquaticFeature(
    profile: readonly WorldGeneratorDefinition,
    blocks: readonly SurvivalBlockPalette,
    columns: ColumnPlanner,
    registry: readonly BlockRegistry,
    cellX: number,
    cellZ: number,
    stream: Random,
    patterns: readonly EcologyPatterns,
) -> CompiledFeaturePlan?:
    if not stageEnabled(profile, "vegetation"): return null
    const size = profile.vegetation.aquaticCellSize
    const x = cellX * size + stream.int(0, size)
    const z = cellZ * size + stream.int(0, size)
    const plan = planAt(columns, x, z)
    const sample = plan.sampleAt(x, z)
    const waterTop = plan.waterLevelAt(x, z).floor()
    const depth = waterTop - sample.surfaceY
    if depth < 2 or depth > 16: return null
    const saltWater = (sample.biomeFamily ?? sample.biome) == profile.biomes.ocean or (sample.biomeFamily ?? sample.biome) == profile.biomes.coast
    // Inland lakes and pools use the same freshwater substrate rules as rivers.
    const cover = patterns.cover(x, z)
    const chance = cover > 0.5 ? 0.25 + cover * 0.65 : 0.05
    if not stream.bool(saltWater ? chance : chance * 0.7): return null
    const substrate = surfaceBlock(profile, blocks, sample)
    const units = ecosystemUnits(profile).plants.filter(unit => unit.aquatic and (unit.saltwater == null or unit.saltwater == saltWater))
    const temperature = temperatureAtHeight(profile, sample.temperature, sample.surfaceY)
    const weights = units.map(unit => registry.hasTag(substrate, unit.support) ? unit.weight * habitatWeight(temperature, unit.temperature) * habitatWeight(sample.humidity, unit.humidity) * biomeAffinity(profile, sample.biome, unit.affinities) : 0)
    let remaining = stream.number() * weights.sum()
    for unit, index in units:
        remaining -= weights[index]
        if remaining >= 0: continue
        const height = unit.surfaceClearance == null ? Math.min(depth - 1, stream.int(unit.minimumHeight, unit.maximumHeight + 1)) : Math.min(unit.maximumHeight, depth - stream.int(1, unit.surfaceClearance + 1))
        if height < unit.minimumHeight: return null
        const runtimeId = plantRuntimeId(unit, registry, stream)
        const writes: List<FeatureWrite> = range(1, height + 1).map(y => ({x: 0, y, z: 0, runtimeId}))
        const owner = f"{unit.key}:{cellX}:{cellZ}"
        return compiledFeaturePlan(owner, {x, y: sample.surfaceY, z}, featureSortKey("1_surface", owner), writes)
    return null

/// 枯木、岩壁藤蔓和水下生态都按有界二维候选格采样。浅水覆盖度与优势种
/// 来自连续世界场，海带向水面延伸并保留一格水层。目标 Chunk 只查看其
/// 水平包络可能相交的所有者；不扫描历史 Chunk、不遍历全高度，也不维护第二份缓存。
export def naturalEcologyFeatures(
    profile: readonly WorldGeneratorDefinition,
    seed: string,
    blocks: readonly SurvivalBlockPalette,
    columns: ColumnPlanner,
    registry: readonly BlockRegistry,
    chunkX: number,
    chunkZ: number,
    patterns: readonly EcologyPatterns = createEcologyPatterns(seed, "aquatic", profile.vegetation.aquaticPatchPeriod),
) -> List<CompiledFeaturePlan>:
    const root = random(seed).fork("natural-ecology")
    const output: List<CompiledFeaturePlan> = []
    const minimumX = chunkX * 16
    const minimumZ = chunkZ * 16

    const deadwoodSize = profile.vegetation.deadwoodCellSize
    const reach = naturalEcologyHorizontalReach
    const firstDeadwoodX = ((minimumX - reach) / deadwoodSize).floor()
    const lastDeadwoodX = ((minimumX + 15 + reach) / deadwoodSize).floor()
    const firstDeadwoodZ = ((minimumZ - reach) / deadwoodSize).floor()
    const lastDeadwoodZ = ((minimumZ + 15 + reach) / deadwoodSize).floor()
    for cellX in range(firstDeadwoodX, lastDeadwoodX + 1):
        for cellZ in range(firstDeadwoodZ, lastDeadwoodZ + 1):
            const feature = deadwoodFeature(profile, blocks, columns, registry, cellX, cellZ, root.fork(f"deadwood:{cellX}:{cellZ}"))
            if feature == null: continue
            if not deadwoodOwnsOverlaps(profile, blocks, columns, registry, cellX, cellZ, feature, root): continue
            if overlapsTarget(feature, minimumX, minimumZ): output.append(feature)

    const cliffSize = profile.vegetation.cliffVineCellSize
    const firstCliffX = (minimumX / cliffSize).floor()
    const lastCliffX = ((minimumX + 15) / cliffSize).floor()
    const firstCliffZ = (minimumZ / cliffSize).floor()
    const lastCliffZ = ((minimumZ + 15) / cliffSize).floor()
    for cellX in range(firstCliffX, lastCliffX + 1):
        for cellZ in range(firstCliffZ, lastCliffZ + 1):
            const feature = cliffVineFeature(profile, blocks, columns, registry, cellX, cellZ, root.fork(f"cliff-vine:{cellX}:{cellZ}"))
            if feature != null and overlapsTarget(feature, minimumX, minimumZ): output.append(feature)

    const aquaticSize = profile.vegetation.aquaticCellSize
    const firstAquaticX = (minimumX / aquaticSize).floor()
    const lastAquaticX = ((minimumX + 15) / aquaticSize).floor()
    const firstAquaticZ = (minimumZ / aquaticSize).floor()
    const lastAquaticZ = ((minimumZ + 15) / aquaticSize).floor()
    for cellX in range(firstAquaticX, lastAquaticX + 1):
        for cellZ in range(firstAquaticZ, lastAquaticZ + 1):
            const feature = aquaticFeature(profile, blocks, columns, registry, cellX, cellZ, root.fork(f"aquatic:{cellX}:{cellZ}"), patterns)
            if feature != null: output.append(feature)

    return output
