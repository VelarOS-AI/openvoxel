import {BlockRegistry} from "@openvoxel/blocks"
import {GeneratorBlockIdentities, GeneratorBlockSlots} from "../definition/catalog.vel"

/// 生存生成器只读取已经解析好的数字槽位。具体字段来自 GeneratorBlockSlots，
/// 因而配置 key、runtimeId 和 Chunk 索引始终拥有完全相同的字段集合。
export type SurvivalBlockPalette = GeneratorBlockSlots<number>

/// Chunk 模板需要 runtimeId 列表，基础密度填充需要同一顺序对应的 UInt16 索引。
/// `mapFrom` 严格按照 SurvivalBlockPalette 的声明顺序访问每个 runtimeId，并把
/// append 返回的索引写回同名字段。字段表由编译器读取，不再手写第二份 39 项
/// 映射，因此增加或重排槽位时，runtimeIds 与 indices 会自动保持一致。
export type SurvivalChunkPalette:
    runtimeIds: List<number>
    indices: readonly SurvivalBlockPalette

export def survivalChunkPalette(blocks: readonly SurvivalBlockPalette) -> SurvivalChunkPalette:
    const runtimeIds: List<number> = []

    def append(runtimeId: number) -> number:
        const index = runtimeIds.size
        runtimeIds.append(runtimeId)
        return index

    const indices = SurvivalBlockPalette.mapFrom(blocks, append)
    return {runtimeIds, indices}

/// 在生成器构造时把语义方块 key 一次性解析成当前世界的 runtimeId。之后所有
/// 热路径只读这份数字调色板，Mod 世界不会误用基础目录的全局编号。
export def createSurvivalBlockPalette(registry: readonly BlockRegistry, keys: readonly GeneratorBlockIdentities) -> SurvivalBlockPalette:
    def resolve(key: string) -> number: return registry.defaultStateRuntimeIdForKey(key)

    return SurvivalBlockPalette.mapFrom(keys, resolve)
