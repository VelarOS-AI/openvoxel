import {WorldRegionSample} from "./region-sample.vel"
import {Coordinate2} from "@openvoxel/world"

export enum WaterBodyKind:
    lake
    pond

/// 地形采样是生成器向诊断接口和客户端公开的稳定只读结果。
/// 它描述世界坐标处的基础地形，不包含已保存的方块覆盖。
export type TerrainSample:
    position: Coordinate2
    /// 最终地表高度；由当前水平列共享的密度网格推导。
    surfaceY: number
    /// 0 表示近似平坦，1 表示一格水平距离内高度变化至少八格。
    slope: number
    /// -1..1 的大陆度，决定深海、海岸与内陆基准高度。
    continentalness: number
    /// 0..1 的侵蚀度；值越大，地形整体越平缓。
    erosion: number
    /// 0..1 的山脊强度；高值形成连续山脉骨架。
    ridge: number
    /// 0..1 的河道中心强度；只改变河谷，不负责群系气候。
    riverStrength: number
    temperature: number
    humidity: number
    forestDensity: number
    /// 与气候无关的地形骨架身份。
    terrainType: string
    /// 在最终高度、坡度和地形类型确定后选出的群系身份。
    biome: string
    biomeFamily: string?
    /// 采用区域划分的生成器提供稳定所有者，供后续玩法与地图查询。
    region: WorldRegionSample?
    /// 连续地质/沉积/露头场，由生成器填入，供表层与生态共同判断最终基底。
    geology: number?
    deposit: number?
    exposure: number?
    /// 世界道路到铺装边缘的距离；负数为路内，正数为路肩，无路处为 null。
    roadDistance: number?
    waterBody: WaterBodyKind?
    waterLevel: number?
