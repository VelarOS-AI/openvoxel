import {composeWorldGeneration} from "./ecosystem/composition.vel"
import {builtinEcosystemPacks} from "./runtime/builtin-ecosystem.vel"
import {validateWorldGeneratorDefinition, validateWorldGeneratorPaletteDefinition} from "./definition/validation.vel"
import {WorldGenerationPack} from "./definition/catalog.vel"
import {WorldBlockRegistry, baseWorldBlockRegistry} from "@openvoxel/blocks"
import {builtinIdentities} from "@openvoxel/identities"
import {Chunk, ChunkPosition, WorldManifest, validateWorldManifest, worldClimateVersion} from "@openvoxel/world"
import {worldGeneratorClimate} from "./generator-climate.vel"
import {sha256Text} from "velar/hash"
import {WorldGenerator} from "./contracts.vel"
import {WorldGeneratorCatalogContribution, WorldGeneratorCatalogSource, WorldGeneratorDefinition, WorldGeneratorPaletteDefinition} from "./definition/catalog.vel"
import {baseWorldGeneratorCatalog} from "./runtime/builtin-catalog.vel"
import {survivalAlgorithmRevision, survivalWorldGenerator} from "./survival/generator.vel"
import {requireTreeShapeEnvelope} from "./survival/tree-shapes.vel"

export const defaultGenerator = builtinIdentities.generators.survival

export type WorldGeneratorRegistry:
    catalog: readonly WorldGeneratorCatalogSource
    definition: (key: string) -> readonly WorldGeneratorDefinition
    palette: (key: string) -> readonly WorldGeneratorPaletteDefinition
    definitionHash: (key: string) -> string

/// 世界哈希覆盖算法实现版本、参数、材料调色板和气候版本，避免一个世界
/// 在边界两侧使用不同的生成语义。
export def worldGeneratorDefinitionHash(definition: readonly WorldGeneratorDefinition, palette: readonly WorldGeneratorPaletteDefinition) -> string:
    return sha256Text(Json.stableStringify({algorithmRevision: survivalAlgorithmRevision, definition, palette, worldClimateVersion}))

/// 基础目录和 Mod 贡献按命名空间合成为每世界注册表。相同 key 无论来自基础
/// 目录还是另一个 Mod 都会被拒绝，不存在依赖加载顺序的隐式覆盖。
export def createWorldGeneratorRegistry(
    base: readonly WorldGeneratorCatalogSource = baseWorldGeneratorCatalog,
    contributions: readonly List<readonly WorldGeneratorCatalogContribution> = [],
    packs: readonly List<readonly WorldGenerationPack>? = null,
) -> WorldGeneratorRegistry:
    const definitions: Map<string, readonly WorldGeneratorDefinition> = Map()
    const palettes: Map<string, readonly WorldGeneratorPaletteDefinition> = Map()
    for definition in base.generators:
        worldGeneratorClimate(definition)
        requireTreeShapeEnvelope(definition.vegetation.maximumTreeHeight, definition.vegetation.treeHorizontalReach)
        assert definitions.get(definition.key) == null else f"Duplicate base world generator {definition.key}"
        definitions.set(definition.key, validateWorldGeneratorDefinition(WorldGeneratorDefinition.parse(definition)))
    for palette in base.palettes:
        assert palettes.get(palette.key) == null else f"Duplicate base world generator palette {palette.key}"
        palettes.set(palette.key, validateWorldGeneratorPaletteDefinition(WorldGeneratorPaletteDefinition.parse(palette)))
    const owners: Set<string> = Set()
    for contribution in contributions:
        assert not (contribution.owner in owners) else f"Duplicate world generator contribution owner {contribution.owner}"
        owners.add(contribution.owner)
        for definition in contribution.catalog.generators:
            worldGeneratorClimate(definition)
            requireTreeShapeEnvelope(definition.vegetation.maximumTreeHeight, definition.vegetation.treeHorizontalReach)
            assert definition.key.split(":")[0] == contribution.owner else f"World generator {definition.key} is outside contribution namespace {contribution.owner}"
            assert definitions.get(definition.key) == null else f"Duplicate world generator {definition.key}"
            definitions.set(definition.key, validateWorldGeneratorDefinition(WorldGeneratorDefinition.parse(definition)))
        for palette in contribution.catalog.palettes:
            assert palette.key.split(":")[0] == contribution.owner else f"World generator palette {palette.key} is outside contribution namespace {contribution.owner}"
            assert palettes.get(palette.key) == null else f"Duplicate world generator palette {palette.key}"
            palettes.set(palette.key, validateWorldGeneratorPaletteDefinition(WorldGeneratorPaletteDefinition.parse(palette)))
    for definition in definitions.values():
        const palette = palettes.get(definition.palette)
        assert palette != null else f"Missing generation palette {definition.palette}"
        if packs != null or definition.ecosystem == null:
            const composed = composeWorldGeneration(definition, palette, packs ?? builtinEcosystemPacks)
            definitions.set(definition.key, validateWorldGeneratorDefinition(composed.definition))
            palettes.set(palette.key, validateWorldGeneratorPaletteDefinition(composed.palette))
    const catalog: WorldGeneratorCatalogSource = {
        schemaVersion: 2,
        generators: definitions.values()
            .map(definition => WorldGeneratorDefinition.parse(definition))
            .sorted(by=definition => definition.key),
        palettes: palettes.values()
            .map(palette => WorldGeneratorPaletteDefinition.parse(palette))
            .sorted(by=palette => palette.key),
    }

    def definition(key: string) -> readonly WorldGeneratorDefinition:
        const found = definitions.get(key)
        assert found != null else f"Unknown world generator {key}"
        return WorldGeneratorDefinition.parse(found)

    def palette(key: string) -> readonly WorldGeneratorPaletteDefinition:
        const found = palettes.get(key)
        assert found != null else f"Unknown world generator palette {key}"
        return WorldGeneratorPaletteDefinition.parse(found)

    def definitionHash(key: string) -> string:
        const found = definition(key)
        return worldGeneratorDefinitionHash(found, palette(found.palette))

    return {catalog, definition, palette, definitionHash}

export const baseWorldGeneratorRegistry = createWorldGeneratorRegistry()
export const defaultGeneratorHash = baseWorldGeneratorRegistry.definitionHash(defaultGenerator)

/// 新世界尚没有可验证的清单，因此创建流程通过显式参数构造生成器并计算出生点。
/// 已有世界则必须走下面的 worldGenerator 清单哈希验证入口。
export def instantiateWorldGenerator(
    key: string,
    seed: string,
    edge: number,
    blocks: readonly WorldBlockRegistry = baseWorldBlockRegistry,
    generators: readonly WorldGeneratorRegistry = baseWorldGeneratorRegistry,
) -> WorldGenerator:
    const definition = generators.definition(key)
    return survivalWorldGenerator(seed, edge, blocks, definition, generators.palette(definition.palette))

/// 打开世界时必须同时提供该世界方块注册表和生成器注册表。清单哈希在构造前
/// 验证，配置已经改变时立即拒绝，避免未生成区域与旧区域形成永久边界断层。
export def worldGenerator(
    manifest: WorldManifest,
    blocks: readonly WorldBlockRegistry = baseWorldBlockRegistry,
    generators: readonly WorldGeneratorRegistry = baseWorldGeneratorRegistry,
) -> WorldGenerator:
    const world = validateWorldManifest(WorldManifest.parse(manifest))
    const activeHash = generators.definitionHash(world.generator)
    assert world.generatorHash == activeHash else f"World generator hash mismatch for {world.generator}"
    assert Json.stableStringify(world.climate) == Json.stableStringify(worldGeneratorClimate(generators.definition(world.generator))) else "World climate does not match its locked generator definition"
    return instantiateWorldGenerator(world.generator, world.seed, world.chunkEdge, blocks, generators)

export def generateChunk(manifest: WorldManifest, position: ChunkPosition) -> Chunk:
    return worldGenerator(manifest).generate(position)
