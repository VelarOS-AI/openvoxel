{
  "name": "@openvoxel/world-generation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "files": [
    "generated",
    "src"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./world-generator-catalog-data": "./generated/world-generator-catalog.json"
  },
  "velar": {
    "entry": "src/index.vel",
    "targets": ["core"],
    "requires": {
      "capabilities": []
    },
    "resources": {
      "./world-generator-catalog-data": {
        "path": "generated/world-generator-catalog.json",
        "type": "json"
      }
    }
  },
  "scripts": {
    "generate": "velar run tools/generate.vel",
    "generate:check": "velar run tools/check-generated.vel",
    "check": "velar check",
    "format": "velar format",
    "format:check": "velar format --check",
    "test": "velar test",
    "build": "velar build",
    "benchmark": "velar run benchmarks/world-generation.vel",
    "benchmark:caves": "velar run benchmarks/caves.vel",
    "benchmark:columns": "velar run benchmarks/columns.vel",
    "benchmark:phases": "velar run benchmarks/phases.vel",
    "quality": "velar run tools/quality-report.vel"
  },
  "dependencies": {
    "@openvoxel/blocks": "0.2.0",
    "@openvoxel/identities": "0.2.0",
    "@openvoxel/world": "0.2.0",
    "@velarscript-labs/yaml": "0.1.5",
    "@velarscript-labs/noise": "0.1.6"
  }
}
