{
  "name": "@openvoxel/world-generation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "files": [
    "generated",
    "src"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./world-generator-catalog-data": "./generated/world-generator-catalog.json",
    "./ecosystem-packs-data": "./generated/ecosystem-packs.json",
    "./compiler": "./dist/compiler/catalog-compiler.js"
  },
  "velar": {
    "entry": "src/index.vel",
    "targets": [
      "core"
    ],
    "requires": {
      "capabilities": []
    },
    "resources": {
      "./world-generator-catalog-data": {
        "path": "generated/world-generator-catalog.json",
        "type": "json"
      },
      "./ecosystem-packs-data": {
        "path": "generated/ecosystem-packs.json",
        "type": "json"
      }
    },
    "entries": {
      "./compiler": "src/compiler/catalog-compiler.vel"
    }
  },
  "scripts": {
    "generate": "node ../../../tools/run-validation.mjs -- velar run tools/generate.vel",
    "generate:check": "node ../../../tools/run-validation.mjs -- velar run tools/check-generated.vel",
    "check": "node ../../../tools/run-validation.mjs -- velar check",
    "format": "velar format",
    "format:check": "node ../../../tools/run-validation.mjs -- velar format --check",
    "test": "node ../../../tools/run-validation.mjs -- velar test",
    "build": "node ../../../tools/run-validation.mjs -- velar build",
    "benchmark": "node ../../../tools/run-validation.mjs -- velar run benchmarks/world-generation.vel",
    "benchmark:caves": "node ../../../tools/run-validation.mjs -- velar run benchmarks/caves.vel",
    "benchmark:columns": "node ../../../tools/run-validation.mjs -- velar run benchmarks/columns.vel",
    "benchmark:phases": "node ../../../tools/run-validation.mjs -- velar run benchmarks/phases.vel",
    "review:regions": "node ../../../tools/run-validation.mjs -- velar run tools/regional-review.vel",
    "quality": "node ../../../tools/run-validation.mjs -- velar run tools/quality-report.vel"
  },
  "dependencies": {
    "@openvoxel/blocks": "0.2.0",
    "@openvoxel/identities": "0.2.0",
    "@openvoxel/world": "0.2.0",
    "@velarscript-labs/yaml": "0.1.5",
    "@velarscript-labs/noise": "0.1.6"
  }
}
