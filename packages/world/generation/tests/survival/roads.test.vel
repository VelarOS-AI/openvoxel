import {expect} from "velar/test"
import {RoadConfig} from "../../src/definition/catalog.vel"
import {baseWorldGeneratorCatalog} from "../../src/runtime/builtin-catalog.vel"
import {createRoadPlanner} from "../../src/survival/roads.vel"
import {columnPlanner, createGenerationFields} from "../../src/survival/terrain.vel"

test "roads are sparse connected strips and change with the seed":
    const config = RoadConfig.from(baseWorldGeneratorCatalog.generators[0].roads, {cellSize: 128})
    const a = createRoadPlanner("road-a", config, (x, z) => ({height: 80, waterLevel: 64})).area(0, 0, 256)
    const b = createRoadPlanner("road-b", config, (x, z) => ({height: 80, waterLevel: 64})).area(0, 0, 256)
    let count = 0
    let different = 0
    let isolated = 0
    for x in range(1, 255):
        for z in range(1, 255):
            const road = (a.distanceAt(x + 0.5, z + 0.5) ?? 100) <= 0
            if road != ((b.distanceAt(x + 0.5, z + 0.5) ?? 100) <= 0): different += 1
            if not road: continue
            count += 1
            if (a.distanceAt(x - 0.5, z + 0.5) ?? 100) > 0 and (a.distanceAt(x + 1.5, z + 0.5) ?? 100) > 0 and (a.distanceAt(x + 0.5, z - 0.5) ?? 100) > 0 and (a.distanceAt(x + 0.5, z + 1.5) ?? 100) > 0:
                isolated += 1
    expect(count > 500 and count < 65536 * 0.06).toBe(true)
    expect(different > 500).toBe(true)
    expect(isolated).toBe(0)

test "road sampling is identical across negative Chunk edges and query orders":
    const config = RoadConfig.from(baseWorldGeneratorCatalog.generators[0].roads, {cellSize: 128})
    const planner = createRoadPlanner("road-seams", config, (x, z) => ({height: 80, waterLevel: 64}))
    const whole = planner.area(-128, -128, 256)
    let hits = 0
    for chunkX in range(7, -9, -1):
        const area = planner.area(chunkX * 16 - 1, -1, 18)
        for x in range(chunkX * 16 - 1, chunkX * 16 + 17):
            for z in range(-1, 17):
                const value = whole.distanceAt(x + 0.5, z + 0.5)
                expect(area.distanceAt(x + 0.5, z + 0.5)).toBe(value)
                if value != null: hits += 1
    expect(hits > 0).toBe(true)

test "roads avoid water and impassable slopes":
    const config = baseWorldGeneratorCatalog.generators[0].roads
    const ocean = createRoadPlanner("roads-water", config, (x, z) => ({height: 60, waterLevel: 64})).area(0, 0, 256)
    const cliff = createRoadPlanner("roads-cliff", config, (x, z) => ({height: 800 + x, waterLevel: 64})).area(0, 0, 256)
    for x in range(0, 256, 8):
        for z in range(0, 256, 8):
            expect(ocean.distanceAt(x, z)).toBe(null)
            expect(cliff.distanceAt(x, z)).toBe(null)

test "terrain integrates the same road distances on both sides of a Chunk boundary":
    const columns = columnPlanner(createGenerationFields("continental-ridges"), 16)
    const west = columns.columns(-1, 0)
    const east = columns.columns(0, 0)
    for x in [-1, 0]:
        for z in range(16): expect(west.sampleAt(x, z).roadDistance).toBe(east.sampleAt(x, z).roadDistance)
