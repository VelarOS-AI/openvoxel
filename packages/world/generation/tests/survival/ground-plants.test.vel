import {random} from "velar/random"
import {expect} from "velar/test"
import {baseWorldBlockRegistry} from "@openvoxel/blocks"
import {builtinIdentities} from "@openvoxel/identities"
import {VegetationConfig, WorldGeneratorDefinition} from "../../src/definition/catalog.vel"
import {baseWorldGeneratorCatalog} from "../../src/runtime/builtin-catalog.vel"
import {createSurvivalBlockPalette} from "../../src/survival/block-palette.vel"
import {groundPlantFeatures, plantRuntimeId} from "../../src/survival/ground-plants.vel"
import {TerrainSample} from "../../src/terrain-sample.vel"
import {TerrainColumnPlan, columnPlanner, createGenerationFields} from "../../src/survival/terrain.vel"

test "fruit patches retain mixed ground cover across every community band":
    const base = baseWorldGeneratorCatalog.generators[0]
    const profile = WorldGeneratorDefinition.from(base, {
        vegetation: VegetationConfig.from(base.vegetation, {groundPlantChance: 1, groundPlantCellSize: 1}),
    })
    const registry = baseWorldBlockRegistry.registry
    const blocks = createSurvivalBlockPalette(registry, baseWorldGeneratorCatalog.palettes[0].blocks)
    const actual = columnPlanner(createGenerationFields("continental-ridges", profile), 16).columns(-48, 16)
    const column = TerrainColumnPlan.from(actual, {sampleAt: (x, z) => TerrainSample.from(actual.sampleAt(x, z), {biome: profile.biomes.plains, temperature: 12, humidity: 9, slope: 0, surfaceY: 72, roadDistance: null, waterBody: null, riverStrength: 0})})
    const fruits = Set([builtinIdentities.blocks.pumpkin, builtinIdentities.blocks.rottenPumpkin])
    let fruitCount = 0
    let grassCount = 0
    // 包权重可修改，优势种对应的噪声区间也会移动；覆盖全部群落区间，
    // 而不是把某个固定噪声值永久绑定给南瓜。
    for species in range(13):
        const features = groundPlantFeatures(profile, blocks, registry, column, random("pumpkin-density"), {cover: (x, z) => 1, species: (x, z) => species})
        const count = features.filter(feature => fruits.has(registry.requireStateByRuntimeId(feature.writes[0].runtimeId).blockKey)).size
        expect(features.size >= 20).toBe(true)
        expect(count < features.size * 0.4).toBe(true)
        fruitCount += count
        grassCount += features.filter(feature => feature.writes[0].runtimeId == blocks.tallGrass).size
    expect(fruitCount > 0 and grassCount > 0).toBe(true)

test "pack-declared plant states sample every orientation without depending on rare landscape frequency":
    const registry = baseWorldBlockRegistry.registry
    const units = baseWorldGeneratorCatalog.generators[0].ecosystem!.plants
    for key in ["understory:pumpkin", "understory:rotten_pumpkin"]:
        const unit = units.find(plant => plant.key == key)!
        const facings: Set<string> = Set()
        for index in range(128):
            const id = plantRuntimeId(unit, registry, random(f"plant-facing:{index}"))
            const facing = registry.requireStateByRuntimeId(id).properties.find(property => property.name == "facing")!.value
            assert facing is string else "Expected the declared facing enum"
            facings.add(facing)
        expect(facings).toEqual(Set(["north", "east", "south", "west"]))
