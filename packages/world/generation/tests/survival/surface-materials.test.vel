import {expect} from "velar/test"
import {baseWorldBlockRegistry} from "@openvoxel/blocks"
import {baseWorldGeneratorCatalog} from "../../src/runtime/builtin-catalog.vel"
import {TerrainSample} from "../../src/terrain-sample.vel"
import {createSurvivalBlockPalette} from "../../src/survival/block-palette.vel"
import {surfaceBedrock, surfaceBlock, subsurfaceBlock} from "../../src/survival/surface-materials.vel"

test "continuous geology reveals native rock and deposit-specific coasts":
    const profile = baseWorldGeneratorCatalog.generators[0]
    const blocks = createSurvivalBlockPalette(baseWorldBlockRegistry.registry, baseWorldGeneratorCatalog.palettes[0].blocks)
    const base: TerrainSample = {
        position: {x: 0, z: 0}, surfaceY: 72, slope: 0, continentalness: 0.2,
        erosion: 0.4, ridge: 0.5, riverStrength: 0, temperature: 8, humidity: 8,
        forestDensity: 0.4, terrainType: profile.terrainTypes.plain, biome: profile.biomes.plains,
        geology: 0, deposit: 0, exposure: 0, stoneVein: 1,
    }
    const marble = TerrainSample.from(base, {stoneVein: 0.01, exposure: 0.4, slope: 0.18})
    expect(surfaceBlock(profile, blocks, marble)).toBe(blocks.marble)
    expect(subsurfaceBlock(profile, blocks, marble)).toBe(blocks.marble)
    expect(surfaceBlock(profile, blocks, TerrainSample.from(base, {stoneVein: 0.01}))).toBe(blocks.grass)
    for geology, index in [-0.7, -0.3, 0, 0.5]:
        const rock = [blocks.basalt, blocks.granite, blocks.stone, blocks.limestone][index]
        const exposed = TerrainSample.from(base, {geology, slope: 0.5})
        expect(surfaceBedrock(blocks, exposed)).toBe(rock)
        expect(surfaceBlock(profile, blocks, exposed)).toBe(rock)
        expect(subsurfaceBlock(profile, blocks, exposed)).toBe(rock)
    const coast = TerrainSample.from(base, {surfaceY: 66, biome: profile.biomes.coast, terrainType: profile.terrainTypes.coast})
    expect(surfaceBlock(profile, blocks, coast)).toBe(blocks.sand)
    expect(surfaceBlock(profile, blocks, TerrainSample.from(coast, {deposit: 0.4}))).toBe(blocks.gravel)
    expect(surfaceBlock(profile, blocks, TerrainSample.from(coast, {exposure: 0.6, geology: 0.5}))).toBe(blocks.limestone)
    expect(surfaceBlock(profile, blocks, TerrainSample.from(base, {humidity: 12, riverStrength: 0.8, deposit: 0.4}))).toBe(blocks.clay)
    const forest = TerrainSample.from(base, {biome: profile.biomes.forest, deposit: 0.8})
    expect(surfaceBlock(profile, blocks, forest)).toBe(blocks.grass)
    expect(subsurfaceBlock(profile, blocks, forest)).toBe(blocks.dirt)
