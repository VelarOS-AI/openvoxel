import {expect} from "velar/test"
import {WorldSeason, worldClimateAt, worldEcologyEpoch, worldEcologyEpochMilliseconds, worldYearMilliseconds, worldYearProgress} from "../src/environment/climate.vel"

test "world climate traverses four seasons and repeats the persisted year phase":
    const position = {x: 500, y: 64, z: -700}
    expect(worldYearProgress(0)).toBe(0.125)
    expect(worldClimateAt("seasons", 0, position).season).toBe(WorldSeason.spring)
    expect(worldClimateAt("seasons", worldYearMilliseconds * 0.25, position).season).toBe(WorldSeason.summer)
    expect(worldClimateAt("seasons", worldYearMilliseconds * 0.5, position).season).toBe(WorldSeason.autumn)
    expect(worldClimateAt("seasons", worldYearMilliseconds * 0.75, position).season).toBe(WorldSeason.winter)
    expect(worldClimateAt("seasons", worldYearMilliseconds, position)).toEqual(worldClimateAt("seasons", 0, position))

test "local temperature combines climate humidity season and altitude continuously":
    const summer = worldClimateAt("climate", worldYearMilliseconds * 0.25, {x: 2048, y: 64, z: 200})
    const winter = worldClimateAt("climate", worldYearMilliseconds * 0.75, {x: 2048, y: 64, z: 200})
    const mountain = worldClimateAt("climate", worldYearMilliseconds * 0.25, {x: 2048, y: 192, z: 200})
    const adjacent = worldClimateAt("climate", worldYearMilliseconds * 0.25, {x: 2047, y: 64, z: 200})
    expect(summer.temperatureCelsius - winter.temperatureCelsius > 20).toBe(true)
    expect(mountain.temperatureCelsius < summer.temperatureCelsius - 15).toBe(true)
    expect((adjacent.temperatureCelsius - summer.temperatureCelsius).abs() < 0.01).toBe(true)
    expect(winter.humidity).toBe(summer.humidity)
    expect(summer.humidity >= 0 and summer.humidity <= 1).toBe(true)
    expect(worldEcologyEpoch(worldEcologyEpochMilliseconds - 1)).toBe(0)
    expect(worldEcologyEpoch(worldEcologyEpochMilliseconds)).toBe(1)
