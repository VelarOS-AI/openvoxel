{
  "name": "@openvoxel/world",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "files": [
    "src"
  ],
  "velar": {
    "entry": "src/index.vel",
    "entries": {
      "./game-mode": "src/manifest/game-mode.vel"
    },
    "targets": ["core"],
    "requires": {
      "capabilities": []
    }
  },
  "scripts": {
    "check": "node ../../../tools/run-validation.mjs -- velar check",
    "format": "velar format",
    "format:check": "node ../../../tools/run-validation.mjs -- velar format --check",
    "test": "node ../../../tools/run-validation.mjs -- velar test",
    "build": "node ../../../tools/run-validation.mjs -- velar build"
  },
  "dependencies": {
    "@openvoxel/blocks": "0.2.0",
    "@velarscript-labs/noise": "0.1.6"
  },
  "devDependencies": {
    "@openvoxel/identities": "0.2.0",
    "fast-check": "4.9.0"
  }
}
