import {UInt16Buffer, uint16Buffer} from "velar/binary"
import {requireBlockStateRuntimeId} from "@openvoxel/blocks"
import {ChunkPosition, LocalPosition, requireChunkEdge, requireChunkPosition} from "../spatial/coordinates.vel"

export def chunkVolume(edge: number) -> number:
    requireChunkEdge(edge)
    return edge * edge * edge

export def blockIndex(local: readonly LocalPosition, edge: number) -> number:
    requireChunkEdge(edge)
    assert local.x.isInteger() and local.y.isInteger() and local.z.isInteger() else "Local coordinates must be integers"
    assert local.x >= 0 and local.x < edge else "Local x is outside the chunk"
    assert local.y >= 0 and local.y < edge else "Local y is outside the chunk"
    assert local.z >= 0 and local.z < edge else "Local z is outside the chunk"
    return local.x + edge * (local.z + edge * local.y)

export type Chunk:
    readonly position: readonly ChunkPosition
    edge: number
    palette: List<number>
    indices: UInt16Buffer
    paletteIndex: Map<number, number>
    revision: number

/// 经过一次完整验证、可重复实例化的 Chunk 局部调色板模板。模板只共享稳定的
/// runtimeId 顺序；每个 Chunk 仍拥有自己的可变 palette 和 paletteIndex。
export type ChunkPaletteTemplate:
    runtimeIds: readonly List<number>
    instantiate: (position: readonly ChunkPosition, edge: number) -> Chunk

/// paletteIndex 是由 palette 重建的进程内加速索引，不属于 Chunk 的存储或网络格式。
/// 对外投影只使用 position、edge、palette、indices 和 revision。

def requireStorageIndex(chunk: readonly Chunk, index: number):
    assert index.isInteger() and index >= 0 and index < chunk.indices.size else "Chunk storage index is outside the chunk"

def buildPaletteIndex(palette: readonly List<number>) -> Map<number, number>:
    assert palette.size > 0 and palette.size <= 0x10000 else "Chunk palette must contain from 1 through 65536 runtime ids"
    const paletteIndex: Map<number, number> = Map()
    for runtimeId, index in palette:
        requireBlockStateRuntimeId(runtimeId)
        assert paletteIndex.get(runtimeId) == null else f"Chunk palette repeats block state runtime id {runtimeId}"
        paletteIndex.set(runtimeId, index)
    return paletteIndex

export def chunk(
    position: readonly ChunkPosition,
    edge: number,
    palette: List<number>,
    indices: UInt16Buffer,
    revision: number = 0,
) -> Chunk:
    requireChunkPosition(position)
    requireChunkEdge(edge)
    assert indices.size == chunkVolume(edge) else "Chunk palette indices have the wrong size"
    assert revision.isInteger() and revision >= 0 else "Chunk revision must be a non-negative integer"
    const paletteIndex = buildPaletteIndex(palette)
    for paletteEntry in indices.values():
        assert paletteEntry < palette.size else f"Chunk palette index {paletteEntry} is outside the palette"
    return {position, edge, palette, indices, paletteIndex, revision}

export def chunkBlockAtIndex(chunk: readonly Chunk, index: number) -> number:
    requireStorageIndex(chunk, index)
    return chunk.palette[chunk.indices[index]]

export def chunkBlock(chunk: readonly Chunk, local: readonly LocalPosition) -> number:
    return chunkBlockAtIndex(chunk, blockIndex(local, chunk.edge))

def paletteEntryFor(chunk: Chunk, runtimeId: number) -> number:
    requireBlockStateRuntimeId(runtimeId)
    const existing = chunk.paletteIndex.get(runtimeId)
    if existing != null: return existing
    assert chunk.palette.size < 0x10000 else "Chunk palette exhausted UInt16 local indices"
    const index = chunk.palette.size
    chunk.palette.append(runtimeId)
    chunk.paletteIndex.set(runtimeId, index)
    return index

/// 世界生成阶段写入语义 runtimeId，但不改变持久化 revision。
/// 玩家或系统造成的正式修改必须使用 setChunkBlock。
export def paintChunkBlockAtIndex(chunk: Chunk, index: number, runtimeId: number):
    requireStorageIndex(chunk, index)
    chunk.indices[index] = paletteEntryFor(chunk, runtimeId)

export def setChunkBlock(chunk: Chunk, local: readonly LocalPosition, runtimeId: number) -> number:
    const index = blockIndex(local, chunk.edge)
    const previous = chunkBlockAtIndex(chunk, index)
    if previous != runtimeId:
        paintChunkBlockAtIndex(chunk, index, runtimeId)
        chunk.revision += 1
    return previous

/// 空 Chunk 本身不知道哪个方块代表空气；调用方必须从当前内容目录提供填充值。
export def emptyChunk(position: readonly ChunkPosition, edge: number, fill: number) -> Chunk:
    requireBlockStateRuntimeId(fill)
    return emptyPaletteChunk(position, edge, [fill])

/// 生成器预先知道自己可能写入的全部方块时，可以一次性建立局部调色板。新分配的
/// UInt16Buffer 保证全部索引为 0，因此这里无需像反序列化入口 chunk() 那样再扫描
/// 4096 个索引；外部不可信数据仍必须使用完整验证入口。
export def emptyPaletteChunk(position: readonly ChunkPosition, edge: number, palette: List<number>) -> Chunk:
    return chunkPaletteTemplate(palette).instantiate(position, edge)

/// 生成器构造时创建一次模板，后续每个 Chunk 只复制已经验证的几十项映射，
/// 无需再次验证同一组 runtimeId。这个入口不接受持久化或网络数据。
export def chunkPaletteTemplate(runtimeIds: List<number>) -> ChunkPaletteTemplate:
    buildPaletteIndex(runtimeIds)
    const stableRuntimeIds = runtimeIds.slice()

    def instantiate(position: readonly ChunkPosition, edge: number) -> Chunk:
        requireChunkPosition(position)
        requireChunkEdge(edge)
        const palette = stableRuntimeIds.slice()
        const paletteIndex: Map<number, number> = Map()
        for runtimeId, index in palette: paletteIndex.set(runtimeId, index)
        return {position, edge, palette, indices: uint16Buffer(chunkVolume(edge)), paletteIndex, revision: 0}

    return {runtimeIds: stableRuntimeIds, instantiate}

export def chunkChecksum(chunk: readonly Chunk) -> number:
    let checksum = 0x6d2b79f5
    for index in range(chunk.indices.size):
        checksum = ((checksum << 5) ^ (checksum >>> 2) ^ chunkBlockAtIndex(chunk, index)) & 0xffffffff
    return checksum >>> 0
