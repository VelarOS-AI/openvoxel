import {WorldBlockRegistrySnapshot} from "@openvoxel/blocks"
import {defaultGenerator} from "@openvoxel/world-generation"
import {WorldContentIdentity, WorldGameMode, WorldManifest, WorldSpawn, initialChunkEdge, maximumWorldEnvironmentMilliseconds, validateWorldManifest, worldDayMilliseconds, worldFormatVersion} from "@openvoxel/world"

/// worldEnvironmentAt(0) 是日出；再经过四分之一个世界日即为正午。
export const initialWorldMilliseconds = worldDayMilliseconds / 4

export def newWorldTimeOriginMilliseconds(wallClockMilliseconds: number) -> number:
    assert wallClockMilliseconds.isInteger() and wallClockMilliseconds >= initialWorldMilliseconds and wallClockMilliseconds <= maximumWorldEnvironmentMilliseconds else "World creation clock must be a supported integer timestamp"
    return wallClockMilliseconds - initialWorldMilliseconds

/// 创建命令属于应用用例输入，不进入持久化世界模型。
export type CreateWorld:
    id: string
    name: string
    seed: string
    /// 非交互式工具省略时使用 Survival；线上创建请求始终显式携带模式。
    mode: WorldGameMode?
    /// 为空时选择内建默认生成器；保存进清单的始终是解析后的稳定身份。
    generator: string?
    /// 为空时使用服务器默认内容集合；显式列表按 Content Pack owner 选择。
    contentPacks: List<string>?

/// 创建策略在应用层选择默认 Chunk 尺寸、生成器和基础注册表。
export def assembleWorldManifest(
    command: CreateWorld,
    blockRegistry: readonly WorldBlockRegistrySnapshot,
    content: readonly WorldContentIdentity,
    generatorHash: string,
    spawn: readonly WorldSpawn,
    worldTimeOriginMilliseconds: number,
) -> WorldManifest:
    const generatorKey = command.generator ?? defaultGenerator
    return validateWorldManifest({
        id: command.id.trim(),
        name: command.name.trim(),
        seed: command.seed.trim(),
        mode: command.mode ?? WorldGameMode.survival,
        worldTimeOriginMilliseconds,
        formatVersion: worldFormatVersion,
        chunkEdge: initialChunkEdge,
        generator: generatorKey,
        generatorHash,
        spawn: WorldSpawn.parse(spawn),
        content: WorldContentIdentity.parse(content),
        blockRegistry: WorldBlockRegistrySnapshot.parse(blockRegistry),
    })
