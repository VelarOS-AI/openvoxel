import {ChunkPosition, LocalPosition, WorldManifest} from "@openvoxel/world"

export readonly type BlockOverride:
    position: readonly LocalPosition
    blockStateRuntimeId: number

/// 持久化覆盖在可见方块身份之外保留自然演化所需的内部锚点。这个字段不进入
/// Chunk 查询和实时协议；null 表示该覆盖没有运行时作物生长语义。
export readonly type StoredBlockOverride:
    position: readonly LocalPosition
    blockStateRuntimeId: number
    growthOriginEpoch: number?

export readonly type StoredChunkDelta:
    position: readonly ChunkPosition
    /// 对外可见的方块内容版本；内部锚点变化不得推进它。
    revision: number
    /// 持久化乐观并发版本。旧版 IndexedDB 记录缺失时由适配器从 revision 迁移。
    storageRevision: number?
    overrides: readonly List<StoredBlockOverride>

/// ActiveWorldState 在内存中完成比较后，交给持久化适配器的单项变更。
/// null 表示删除稀疏覆盖，使该位置重新继承固定地形。
export readonly type BlockOverrideMutation:
    position: readonly LocalPosition
    blockStateRuntimeId: number?
    growthOriginEpoch: number?

/// 一个 Chunk 的乐观并发提交单元。
///
/// expectedStorageRevision 必须与存储中的当前内部版本完全相等；
/// storageRevision 必须恰好加一。revision 由运行时按最终可见状态决定：一批
/// 只有 ownership / growth anchor 的写入保持不变，真实方块变化才恰好加一。
export readonly type ChunkDeltaCommit:
    position: readonly ChunkPosition
    expectedStorageRevision: number
    storageRevision: number
    revision: number
    writes: readonly List<BlockOverrideMutation>

export type WorldManifestStore:
    save: (manifest: WorldManifest) -> Promise<null>
    find: (worldId: string) -> Promise<WorldManifest?>

export type WorldDeltaStore:
    findChunks: (worldId: string, positions: readonly List<readonly ChunkPosition>) -> Promise<List<StoredChunkDelta>>
    /// 在一个存储事务中提交完整 Chunk 批次。任意 Chunk 版本不匹配时拒绝整个
    /// 批次；适配器不得部分写入，也不得自行吞掉冲突后继续覆盖新数据。
    commitChunks: (worldId: string, commits: readonly List<ChunkDeltaCommit>) -> Promise<null>

export type WorldStore:
    manifests: WorldManifestStore
    deltas: WorldDeltaStore
    close: () -> Promise<null>
