import {expect} from "velar/test"
import {BlockBehaviorKind, BlockDefinition, BlockPropertyKind, BlockTypeSource, baseBlockCatalogSource, baseWorldBlockRegistry, compileModBlockCatalogContribution, createWorldBlockRegistry, defaultBlockStateRuntimeId} from "@openvoxel/blocks"
import {builtinIdentities} from "@openvoxel/identities"
import {EcologyCandidate, EcologyCandidateKind, WorldGenerator} from "@openvoxel/world-generation"
import {ChunkPosition, Coordinate2, WorldPrecipitationKind, defaultWorldClimate, emptyChunk, worldClimateAt, worldEcologyEpoch, worldEcologyEpochMilliseconds, worldPrecipitationAt, worldWeatherWindowMilliseconds, worldYearMilliseconds} from "@openvoxel/world"
import {activeWorldState} from "../src/active-world-state.vel"
import {memoryWorldStore} from "../src/memory-world-store.vel"
import {worldEcology} from "../src/world-ecology.vel"
import {snowDepthAt} from "../src/snow-accumulation.vel"
import {initialWorldMilliseconds} from "../src/world-creation.vel"
import {WorldChunkSnapshot} from "../src/world-chunk-snapshot.vel"

const air = defaultBlockStateRuntimeId(builtinIdentities.blocks.air)
const water = defaultBlockStateRuntimeId(builtinIdentities.blocks.water)
const ice = defaultBlockStateRuntimeId(builtinIdentities.blocks.ice)
const snow = defaultBlockStateRuntimeId(builtinIdentities.blocks.snow)
const stone = defaultBlockStateRuntimeId(builtinIdentities.blocks.stone)
const rye = defaultBlockStateRuntimeId(builtinIdentities.blocks.rye)
const cotton = defaultBlockStateRuntimeId(builtinIdentities.blocks.cotton)
const pumpkin = defaultBlockStateRuntimeId(builtinIdentities.blocks.pumpkin)
const kelp = defaultBlockStateRuntimeId(builtinIdentities.blocks.kelp)
const seagrass = defaultBlockStateRuntimeId(builtinIdentities.blocks.seagrass)
const ryeAge3 = baseWorldBlockRegistry.registry.withProperty(rye, "age", 3)
const cottonAge1 = baseWorldBlockRegistry.registry.withProperty(cotton, "age", 1)
const position: ChunkPosition = {x: 0, y: 4, z: 0}
const summer = worldYearMilliseconds * 0.25
const winter = worldYearMilliseconds * 0.75
const naturalGrowthOriginEpoch = worldEcologyEpoch(initialWorldMilliseconds)

type SnowfallFixture:
    seed: string
    startEpoch: number

def snowfallFixture() -> SnowfallFixture:
    const firstWindow = (winter / worldWeatherWindowMilliseconds).floor()
    const center = {x: 8, y: 72, z: 8}
    for index in range(100):
        const seed = f"snowfall-{index}"
        for offset in range(24):
            const window = firstWindow + offset
            const midpoint = window * worldWeatherWindowMilliseconds + worldWeatherWindowMilliseconds / 2
            const weather = worldPrecipitationAt(seed, midpoint, center)
            if weather.kind != WorldPrecipitationKind.snow or weather.intensity < 0.5: continue
            const startEpoch = window * (worldWeatherWindowMilliseconds / worldEcologyEpochMilliseconds)
            const initial = snowDepthAt(seed, startEpoch, center, defaultWorldClimate).floor()
            const accumulated = snowDepthAt(seed, startEpoch + 5, center, defaultWorldClimate).floor()
            if accumulated > initial: return {seed, startEpoch}
    throw Error("Snowfall fixture requires a storm that adds a visible layer")

def coldSeed() -> string:
    for index in range(100):
        const seed = f"ecology-{index}"
        const climate = worldClimateAt(seed, winter, {x: 0, y: 64, z: 0})
        if climate.frozenWater and climate.snowCover >= 0.3 and snowDepthAt(seed, worldEcologyEpoch(winter), {x: 8, y: 72, z: 8}, defaultWorldClimate) >= 1:
            return seed
    throw Error("Ecology fixture requires a freezing region with accumulated snowfall")

const candidates: readonly List<EcologyCandidate> = [
    {position: {x: 0, y: 0, z: 0}, kind: EcologyCandidateKind.water, baselineBlockStateRuntimeId: water, warmBlockStateRuntimeId: water, coldBlockStateRuntimeId: ice, exposed: true},
    {position: {x: 1, y: 1, z: 0}, kind: EcologyCandidateKind.snow, baselineBlockStateRuntimeId: air, warmBlockStateRuntimeId: air, coldBlockStateRuntimeId: snow, exposed: true},
    {position: {x: 2, y: 1, z: 0}, kind: EcologyCandidateKind.snow, baselineBlockStateRuntimeId: snow, warmBlockStateRuntimeId: air, coldBlockStateRuntimeId: snow, exposed: false},
    {position: {x: 3, y: 0, z: 0}, kind: EcologyCandidateKind.water, baselineBlockStateRuntimeId: ice, warmBlockStateRuntimeId: water, coldBlockStateRuntimeId: ice, exposed: true},
    {position: {x: 4, y: 0, z: 0}, kind: EcologyCandidateKind.water, baselineBlockStateRuntimeId: kelp, warmBlockStateRuntimeId: kelp, coldBlockStateRuntimeId: ice, exposed: true},
    {position: {x: 5, y: 0, z: 0}, kind: EcologyCandidateKind.water, baselineBlockStateRuntimeId: seagrass, warmBlockStateRuntimeId: seagrass, coldBlockStateRuntimeId: ice, exposed: true},
]

const growthCandidates: readonly List<EcologyCandidate> = [
    {position: {x: 4, y: 1, z: 0}, kind: EcologyCandidateKind.cropGrowth, baselineBlockStateRuntimeId: rye, ageProperty: "age", baselineAge: 0, maximumAge: 7, epochsPerStage: 4},
    {position: {x: 5, y: 1, z: 0}, kind: EcologyCandidateKind.cropGrowth, baselineBlockStateRuntimeId: cottonAge1, ageProperty: "age", baselineAge: 1, maximumAge: 2, epochsPerStage: 4},
    {position: {x: 6, y: 1, z: 0}, kind: EcologyCandidateKind.cropGrowth, baselineBlockStateRuntimeId: cotton, ageProperty: "age", baselineAge: 0, maximumAge: 2, epochsPerStage: 4},
    ]

def generator(natural: readonly List<EcologyCandidate> = candidates) -> WorldGenerator:
    return {
        generate: position => emptyChunk(position, 16, air),
        findSpawn: () => {x: 0, y: 65, z: 0},
        ecologyCandidates: position => position.x == 0 and position.y == 4 and position.z == 0 ? natural : [],
        sample: position => {position: Coordinate2.from(position), surfaceY: 64, slope: 0, continentalness: 0, erosion: 0, ridge: 0, riverStrength: 0, temperature: 8, humidity: 8, forestDensity: 0, terrainType: "plain", biome: "plains"},
    }

def validateRuntimeId(runtimeId: number): baseWorldBlockRegistry.registry.requireStateByRuntimeId(runtimeId)

test "seasonal ice and exposed snow freeze thaw and preserve player edits without persistence":
    const store = memoryWorldStore()
    const state = activeWorldState("ecology", store.deltas, 64, 1024, validateRuntimeId)
    const ecology = worldEcology(coldSeed(), 16, 0, 255, generator(), baseWorldBlockRegistry.registry, state, naturalGrowthOriginEpoch)
    const frozen = (await ecology.deltas([position], winter))[0]
    expect(frozen.ecologyEpoch).toBe(worldEcologyEpoch(winter))
    expect(frozen.overrides.some(entry => entry.position.x == 0 and entry.blockStateRuntimeId == ice)).toBe(true)
    expect(frozen.overrides.some(entry => entry.position.x == 1 and baseWorldBlockRegistry.registry.requireStateByRuntimeId(entry.blockStateRuntimeId).blockKey == builtinIdentities.blocks.snow)).toBe(true)
    expect(frozen.overrides.some(entry => entry.position.x == 4 and entry.blockStateRuntimeId == ice)).toBe(true)
    expect(frozen.overrides.some(entry => entry.position.x == 5 and entry.blockStateRuntimeId == ice)).toBe(true)
    expect(frozen.overrides.some(entry => entry.position.x == 2 and entry.blockStateRuntimeId == air)).toBe(true)
    expect((await state.deltas([position]))[0].overrides).toEqual([])

    const thawed = (await ecology.deltas([position], summer))[0]
    expect(thawed.overrides.some(entry => entry.position.x == 0)).toBe(false)
    expect(thawed.overrides.some(entry => entry.position.x == 1)).toBe(false)
    expect(thawed.overrides.some(entry => entry.position.x == 3 and entry.blockStateRuntimeId == water)).toBe(true)
    expect(thawed.overrides.some(entry => entry.position.x == 4)).toBe(false)
    expect(thawed.overrides.some(entry => entry.position.x == 5)).toBe(false)
    await state.commitBlocks([
        {chunk: position, local: {x: 0, y: 0, z: 0}, blockStateRuntimeId: ice, growthOriginEpoch: null, visibleChanged: true},
        {chunk: position, local: {x: 1, y: 1, z: 0}, blockStateRuntimeId: snow, growthOriginEpoch: null, visibleChanged: true},
    ])
    const preserved = (await ecology.deltas([position], summer))[0]
    expect(preserved.overrides.some(entry => entry.position.x == 0 and entry.blockStateRuntimeId == ice)).toBe(true)
    expect(preserved.overrides.some(entry => entry.position.x == 1 and entry.blockStateRuntimeId == snow)).toBe(true)
    await state.close()
    await store.close()

test "falling snow adds visible layers across ecology epochs and warm weather melts them":
    const fixture = snowfallFixture()
    const center = {x: 8, y: 72, z: 8}
    const firstDepth = snowDepthAt(fixture.seed, fixture.startEpoch, center, defaultWorldClimate)
    const laterDepth = snowDepthAt(fixture.seed, fixture.startEpoch + 5, center, defaultWorldClimate)
    expect(laterDepth.floor() > firstDepth.floor()).toBe(true)
    expect(snowDepthAt(fixture.seed, fixture.startEpoch + 5, center, defaultWorldClimate)).toBe(laterDepth)

    const natural: readonly List<EcologyCandidate> = [
        {position: {x: 8, y: 8, z: 8}, kind: EcologyCandidateKind.snow, baselineBlockStateRuntimeId: air, warmBlockStateRuntimeId: air, coldBlockStateRuntimeId: snow, exposed: true},
    ]
    const store = memoryWorldStore()
    const state = activeWorldState("snowfall", store.deltas, 64, 1024, validateRuntimeId)
    try:
        const ecology = worldEcology(fixture.seed, 16, 0, 255, generator(natural), baseWorldBlockRegistry.registry, state, naturalGrowthOriginEpoch)
        const first = (await ecology.deltas([position], fixture.startEpoch * worldEcologyEpochMilliseconds))[0]
        const later = (await ecology.deltas([position], (fixture.startEpoch + 5) * worldEcologyEpochMilliseconds))[0]
        expect(first.overrides.size).toBe(firstDepth.floor() > 0 ? 1 : 0)
        expect(later.overrides.size).toBe(1)
        expect(later.overrides[0].blockStateRuntimeId).toBe(baseWorldBlockRegistry.registry.withProperty(snow, "layers", laterDepth.floor()))
        expect((await state.deltas([position]))[0].overrides).toEqual([])
        const warm = (await ecology.deltas([position], summer))[0]
        expect(warm.overrides).toEqual([])
    finally:
        await state.close()
        await store.close()

test "snapshot epochs belong to visible ecology while storage keeps only player deltas":
    const store = memoryWorldStore()
    const state = activeWorldState("snapshots", store.deltas, 64, 1024, validateRuntimeId)
    try:
        const ecology = worldEcology(coldSeed(), 16, 0, 255, generator(), baseWorldBlockRegistry.registry, state, naturalGrowthOriginEpoch)
        const underground = {x: 0, y: 1, z: 0}
        await state.commitBlocks([{chunk: underground, local: {x: 1, y: 1, z: 1}, blockStateRuntimeId: stone, growthOriginEpoch: null, visibleChanged: true}])
        const stored = (await state.deltas([underground]))[0]
        const visible = (await ecology.deltas([underground], winter))[0]
        expect(visible.ecologyEpoch).toBe(worldEcologyEpoch(winter))
        expect(visible.revision).toBe(stored.revision)
        expect(visible.overrides.some(entry => entry.position.x == 1 and entry.blockStateRuntimeId == stone)).toBe(true)
        expect(WorldChunkSnapshot.is(stored)).toBe(false)
        expect(Json.stringify(stored).has("ecologyEpoch")).toBe(false)
        expect(Json.stringify(visible).has("growthOriginEpoch")).toBe(false)
        const persisted = (await store.deltas.findChunks("snapshots", [underground]))[0]
        expect(Json.stringify(persisted).has("ecologyEpoch")).toBe(false)
    finally:
        await state.close()
        await store.close()

test "remote player roofs and removed ground suppress natural snow and water freezing":
    const store = memoryWorldStore()
    const state = activeWorldState("shelter", store.deltas, 64, 1024, validateRuntimeId)
    const ecology = worldEcology(coldSeed(), 16, 0, 255, generator(), baseWorldBlockRegistry.registry, state, naturalGrowthOriginEpoch)
    const roof = {x: 0, y: 10, z: 0}
    await state.commitBlocks([
        {chunk: roof, local: {x: 0, y: 0, z: 0}, blockStateRuntimeId: stone, growthOriginEpoch: null, visibleChanged: true},
        {chunk: roof, local: {x: 1, y: 0, z: 0}, blockStateRuntimeId: stone, growthOriginEpoch: null, visibleChanged: true},
    ])
    const sheltered = (await ecology.deltas([position], winter))[0]
    expect(sheltered.overrides.some(entry => entry.position.x == 0 and entry.blockStateRuntimeId == ice)).toBe(false)
    expect(sheltered.overrides.some(entry => entry.position.x == 1 and entry.blockStateRuntimeId == snow)).toBe(false)
    await state.commitBlocks([
        {chunk: roof, local: {x: 1, y: 0, z: 0}, blockStateRuntimeId: null, growthOriginEpoch: null, visibleChanged: true},
        {chunk: position, local: {x: 1, y: 0, z: 0}, blockStateRuntimeId: air, growthOriginEpoch: null, visibleChanged: true},
    ])
    const unsupported = (await ecology.deltas([position], winter))[0]
    expect(unsupported.overrides.some(entry => entry.position.x == 1 and entry.blockStateRuntimeId == snow)).toBe(false)
    await state.close()
    await store.close()

test "crop growth is a deterministic epoch projection while player states remain authoritative":
    const store = memoryWorldStore()
    const firstState = activeWorldState("growth", store.deltas, 64, 1024, validateRuntimeId)
    const firstEcology = worldEcology("growth-seed", 16, 0, 255, generator(growthCandidates), baseWorldBlockRegistry.registry, firstState, naturalGrowthOriginEpoch)
    const initial = (await firstEcology.deltas([position], initialWorldMilliseconds))[0]
    expect(initial.overrides).toEqual([])
    expect((await firstState.deltas([position]))[0].overrides).toEqual([])
    expect(firstState.cachedChunkCount()).toBe(1)

    const oneStageTime = initialWorldMilliseconds + worldEcologyEpochMilliseconds * 4
    const grownAfterUnrelatedQuery = (await firstEcology.deltas([{x: 1, y: 4, z: 0}, position], oneStageTime))[1]
    expect(grownAfterUnrelatedQuery.overrides.some(entry => entry.position.x == 4 and entry.blockStateRuntimeId == baseWorldBlockRegistry.registry.withProperty(rye, "age", 1))).toBe(true)
    expect(grownAfterUnrelatedQuery.overrides.some(entry => entry.position.x == 5 and entry.blockStateRuntimeId == baseWorldBlockRegistry.registry.withProperty(cotton, "age", 2))).toBe(true)
    expect(grownAfterUnrelatedQuery.overrides.some(entry => entry.position.x == 6 and entry.blockStateRuntimeId == cottonAge1)).toBe(true)
    expect((await firstState.deltas([position]))[0].overrides).toEqual([])
    await firstState.close()

    const reloadedState = activeWorldState("growth", store.deltas, 64, 1024, validateRuntimeId)
    try:
        const reloadedEcology = worldEcology("growth-seed", 16, 0, 255, generator(growthCandidates), baseWorldBlockRegistry.registry, reloadedState, naturalGrowthOriginEpoch)
        const reloaded = (await reloadedEcology.deltas([position], oneStageTime))[0]
        expect(reloaded).toEqual(grownAfterUnrelatedQuery)

        await reloadedState.commitBlocks([
            {chunk: position, local: {x: 4, y: 1, z: 0}, blockStateRuntimeId: ryeAge3, growthOriginEpoch: null, visibleChanged: true},
            {chunk: position, local: {x: 5, y: 1, z: 0}, blockStateRuntimeId: pumpkin, growthOriginEpoch: null, visibleChanged: true},
        ])
        const playerOwned = (await reloadedEcology.deltas([position], initialWorldMilliseconds + worldEcologyEpochMilliseconds * 40))[0]
        expect(playerOwned.overrides.some(entry => entry.position.x == 4 and entry.blockStateRuntimeId == ryeAge3)).toBe(true)
        expect(playerOwned.overrides.some(entry => entry.position.x == 5 and entry.blockStateRuntimeId == pumpkin)).toBe(true)
        const persisted = (await store.deltas.findChunks("growth", [position]))[0]
        expect(persisted.overrides.size).toBe(2)
        expect(Json.stringify(persisted).has("ecologyEpoch")).toBe(false)
    finally:
        await reloadedState.close()
        await store.close()

test "crop phases start at the new-world epoch and spread work inside each stage window":
    const phasedCandidates: List<EcologyCandidate> = []
    for x in range(16):
        phasedCandidates.append({
            position: {x, y: 1, z: 0},
            kind: EcologyCandidateKind.cropGrowth,
            baselineBlockStateRuntimeId: rye,
            ageProperty: "age",
            baselineAge: 0,
            maximumAge: 7,
            epochsPerStage: 4,
        })
    const store = memoryWorldStore()
    const state = activeWorldState("growth-phases", store.deltas, 64, 1024, validateRuntimeId)
    try:
        const ecology = worldEcology("growth-phase-seed", 16, 0, 255, generator(phasedCandidates), baseWorldBlockRegistry.registry, state, naturalGrowthOriginEpoch)
        expect(worldEcologyEpoch(initialWorldMilliseconds)).toBe(10)
        expect((await ecology.deltas([position], initialWorldMilliseconds))[0].overrides).toEqual([])
        const age1 = baseWorldBlockRegistry.registry.withProperty(rye, "age", 1)
        const firstEpoch = (await ecology.deltas([position], initialWorldMilliseconds + worldEcologyEpochMilliseconds))[0]
        expect(firstEpoch.overrides.size > 0 and firstEpoch.overrides.size < phasedCandidates.size).toBe(true)
        expect(firstEpoch.overrides.every(entry => entry.blockStateRuntimeId == age1)).toBe(true)
        const completeStage = (await ecology.deltas([position], initialWorldMilliseconds + worldEcologyEpochMilliseconds * 4))[0]
        expect(completeStage.overrides.size).toBe(phasedCandidates.size)
        expect(completeStage.overrides.every(entry => entry.blockStateRuntimeId == age1)).toBe(true)
    finally:
        await state.close()
        await store.close()

test "wild cotton stays green through long time jumps while planted cotton becomes white":
    const registry = baseWorldBlockRegistry.registry
    const store = memoryWorldStore()
    const state = activeWorldState("cotton", store.deltas, 64, 1024, validateRuntimeId)
    const natural: List<EcologyCandidate> = [
        {position: {x: 5, y: 1, z: 0}, kind: EcologyCandidateKind.cropGrowth, baselineBlockStateRuntimeId: cotton, ageProperty: "age", baselineAge: 0, maximumAge: 1, epochsPerStage: 4},
    ]
    try:
        await state.commitBlocks([{chunk: position, local: {x: 7, y: 1, z: 0}, blockStateRuntimeId: cotton, growthOriginEpoch: 10, visibleChanged: true}])
        const ecology = worldEcology("cotton", 16, 0, 255, generator(natural), registry, state, 10)
        for epoch in [100, 10000]:
            const snapshot = (await ecology.deltas([position], epoch * worldEcologyEpochMilliseconds))[0]
            expect(snapshot.overrides.find(entry => entry.position.x == 5)?.blockStateRuntimeId).toBe(cottonAge1)
            expect(snapshot.overrides.find(entry => entry.position.x == 7)?.blockStateRuntimeId).toBe(registry.withProperty(cotton, "age", 2))
        expect((await state.deltas([position]))[0].overrides.size).toBe(1)
    finally:
        await state.close()
        await store.close()

test "player crop projection reads Mod age property and cadence from block behavior":
    const baseRye = BlockDefinition.parse(baseWorldBlockRegistry.registry.requireTypeByKey(builtinIdentities.blocks.rye))
    const tomato = BlockTypeSource.from(baseRye, {
        key: "farming:tomato_crop",
        translationKey: "block.farming.tomato_crop",
        tags: [],
        properties: [{name: "growth_stage", kind: BlockPropertyKind.integer, minimum: 2, maximum: 5}],
        defaultState: [{name: "growth_stage", value: 2}],
        behaviors: [{kind: BlockBehaviorKind.cropGrowth, ageProperty: "growth_stage", epochsPerStage: 6}],
        variants: [],
    })
    const farming = compileModBlockCatalogContribution("farming", "farming:catalog-v1", [tomato])
    const registry = createWorldBlockRegistry(baseBlockCatalogSource, [farming]).registry
    const planted = registry.defaultStateRuntimeIdForKey("farming:tomato_crop")
    const grown = registry.withProperty(planted, "growth_stage", 3)
    const store = memoryWorldStore()

    def validateModRuntimeId(runtimeId: number): registry.requireStateByRuntimeId(runtimeId)

    const state = activeWorldState("mod-growth", store.deltas, 64, 1024, validateModRuntimeId)
    const originEpoch = 10
    try:
        await state.commitBlocks([{chunk: position, local: {x: 7, y: 1, z: 0}, blockStateRuntimeId: planted, growthOriginEpoch: originEpoch, visibleChanged: true}])
        const ecology = worldEcology("mod-growth-seed", 16, 0, 255, generator([]), registry, state, originEpoch)
        const initial = (await ecology.deltas([position], originEpoch * worldEcologyEpochMilliseconds))[0]
        expect(initial.overrides).toEqual([{position: {x: 7, y: 1, z: 0}, blockStateRuntimeId: planted}])
        const nextStage = (await ecology.deltas([position], (originEpoch + 6) * worldEcologyEpochMilliseconds))[0]
        expect(nextStage.overrides).toEqual([{position: {x: 7, y: 1, z: 0}, blockStateRuntimeId: grown}])
    finally:
        await state.close()
        await store.close()
