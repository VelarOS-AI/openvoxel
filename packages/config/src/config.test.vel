import {expect} from "velar/test"
import {parseYaml} from "./index.vel"

type SampleConfig:
    name: string
    enabled: bool
    ports: List<number>

test "YAML adapter returns data for runtime type validation":
    const parsed = SampleConfig.parse(parseYaml("
        name: openvoxel
        enabled: true
        ports: [3000, 3001]
    "))
    expect(parsed.name).toBe("openvoxel")
    expect(parsed.enabled).toBe(true)
    expect(parsed.ports).toEqual([3000, 3001])
