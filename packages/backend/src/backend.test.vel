import {expect} from "velar/test"
import {BackendOptions, HttpMethod, HttpRequest, Response, backend} from "./index.vel"

type EchoBody:
    value: string

type ResponseBody:
    code: string
    data: unknown
    message: string

def testOptions() -> BackendOptions:
    return {
        logger: false,
        bodyLimit: 1024,
        maxMessageBytes: 1024,
        maxQueuedMessages: 4,
        maxQueuedBytes: 4096,
        maxPendingSendBytes: 4096,
        maxConnections: 4,
    }

async def mapError(error: Error) -> Response:
    return Response.failure(422, error.code, error.message)

test "backend registers typed routes and centralizes application failures":
    const app = await backend(testOptions(), mapError)

    async def echo(request: HttpRequest) -> Response:
        const body = EchoBody.parse(request.body)
        return Response.ok(body)

    async def fail(request: HttpRequest) -> Response:
        throw Error("expected failure")

    app.post("/echo", echo)
    app.get("/fail", fail)

    const echoed = await app.inject(HttpMethod.post, "/echo", {value: "velar"})
    expect(echoed.status).toBe(200)
    const echoedBody = ResponseBody.parse(echoed.json)
    expect(echoedBody.code).toBe("OK")
    expect(EchoBody.parse(echoedBody.data).value).toBe("velar")
    expect(echoedBody.message).toBe("success")

    const failed = await app.inject(HttpMethod.get, "/fail", null)
    expect(failed.status).toBe(422)
    const failedBody = ResponseBody.parse(failed.json)
    expect(failedBody.code).toBe("Error")
    expect(failedBody.data).toBe(null)

    const missing = await app.inject(HttpMethod.get, "/missing", null)
    expect(missing.status).toBe(404)
    const missingBody = ResponseBody.parse(missing.json)
    expect(missingBody.code).toBe("RouteNotFound")

    const malformed = await app.inject(HttpMethod.post, "/echo", "{broken")
    expect(malformed.status).toBe(400)

    const oversized = await app.inject(HttpMethod.post, "/echo", "x".repeat(2048))
    expect(oversized.status).toBe(413)
    await app.close()
