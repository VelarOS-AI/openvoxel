type NativeBackendOptions:
    logger: bool
    bodyLimit: number
    maxMessageBytes: number
    maxQueuedMessages: number
    maxQueuedBytes: number
    maxPendingSendBytes: number
    maxConnections: number

export type NativeRequest:
    method: string
    path: string
    requestId: string
    body: unknown

export type NativeResponse:
    status: number
    json: unknown

export type NativeFailure:
    status: number
    code: string
    message: string
    method: string
    path: string

export type NativeAddress:
    host: string
    port: number

export type NativeInjectResponse:
    status: number
    json: unknown

type NativeHttpHandler = (request: NativeRequest) -> Promise<NativeResponse>
type NativeFailureHandler = (failure: NativeFailure) -> Promise<NativeResponse>
type NativeSocketHandler = (connection: FastifySocket) -> Promise<null>

extern module "@openvoxel/fastify":
    export class FastifySocket:
        def next() -> Promise<unknown>
        def send(message: unknown) -> Promise<null>
        def close(code: number = 1000, reason: string = "") -> Promise<null>

    export class FastifyBackend:
        def route(method: string, path: string, handler: NativeHttpHandler) -> null
        def websocket(path: string, handler: NativeSocketHandler) -> null
        def listen(host: string, port: number) -> Promise<NativeAddress>
        def inject(method: string, path: string, body: unknown) -> Promise<NativeInjectResponse>
        def close() -> Promise<null>
        def info(message: string, context: unknown) -> null
        def warn(message: string, context: unknown) -> null
        def error(message: string, context: unknown) -> null

    export def createFastifyBackend(options: NativeBackendOptions, failureHandler: NativeFailureHandler) -> Promise<FastifyBackend>

import js {FastifyBackend, FastifySocket, createFastifyBackend} from "@openvoxel/fastify"

export type NativeBackend = FastifyBackend
export type NativeSocket = FastifySocket

export def createNativeBackend(options: NativeBackendOptions, failureHandler: NativeFailureHandler) -> Promise<FastifyBackend>:
    return createFastifyBackend(options, failureHandler)
