import {BlockCatalogContribution, WorldBlockRegistry, WorldBlockRegistrySnapshot, baseBlockCatalogSource, baseWorldBlockRegistrySnapshot, blockCatalogHash, createWorldBlockRegistry, requireWorldBlockStateRuntimeId} from "@openvoxel/blocks"
import {TerrainSample, WorldGenerator, worldGenerator} from "@openvoxel/world-generation"
import {BlockPosition, Chunk, ChunkPosition, Coordinate2, LocalPosition, WorldManifest, chunkBlock, chunkKey, locateBlock, setChunkBlock} from "@openvoxel/world"
import {ChunkDelta, WorldStore} from "./contracts.vel"
import {CreateWorld, createWorldManifest} from "./world-creation.vel"
import {maximumChunkBatchSize} from "./runtime-limits.vel"

export class WorldNotFoundError extends Error:
    constructor(const worldId: string): super(f"World '{worldId}' was not found")

export class WorldAlreadyExistsError extends Error:
    constructor(const worldId: string): super(f"World '{worldId}' already exists")

export type BlockChange:
    worldId: string
    position: BlockPosition
    chunk: ChunkPosition
    local: LocalPosition
    previousBlockStateRuntimeId: number
    blockStateRuntimeId: number
    revision: number

/// 一个目录集合描述某个世界当前启用的全部 Mod 方块内容。
/// revision 必须在任一 contribution 内容或顺序无关集合发生变化时更新，运行时用它
/// 失效该世界的注册表缓存。provider 接收世界清单，因此不同世界可以启用不同 Mod。
export type WorldBlockCatalogSet:
    revision: string
    contributions: readonly List<readonly BlockCatalogContribution>

export type WorldBlockCatalogProvider = (manifest: readonly WorldManifest) -> readonly WorldBlockCatalogSet

type ActiveWorld:
    manifest: WorldManifest
    blocks: WorldBlockRegistry

type CachedWorldBlocks:
    revision: string
    blocks: WorldBlockRegistry

export type WorldRuntime:
    createWorld: (command: CreateWorld) -> Promise<WorldManifest>
    findWorld: (worldId: string) -> Promise<WorldManifest?>
    requireWorld: (worldId: string) -> Promise<WorldManifest>
    chunk: (worldId: string, position: ChunkPosition) -> Promise<Chunk>
    chunks: (worldId: string, positions: List<ChunkPosition>) -> Promise<List<Chunk>>
    terrainSample: (worldId: string, position: Coordinate2) -> Promise<TerrainSample>
    setBlock: (worldId: string, position: BlockPosition, blockStateRuntimeId: number) -> Promise<BlockChange>
    close: () -> Promise<null>

/// 基础运行时没有 Mod；目录哈希就是它的缓存版本。
def baseBlockCatalogs(manifest: readonly WorldManifest) -> readonly WorldBlockCatalogSet:
    return {revision: blockCatalogHash, contributions: []}

/// 固定目录集合适合服务器启动时已经确定 Mod 列表的场景。
export def fixedWorldBlockCatalogProvider(revision: string, contributions: readonly List<readonly BlockCatalogContribution>) -> WorldBlockCatalogProvider:
    assert not revision.isBlank() else "World block catalog revision cannot be blank"

    def provide(manifest: readonly WorldManifest) -> readonly WorldBlockCatalogSet: return {revision, contributions}

    return provide

export def worldRuntime(store: WorldStore, blockCatalogs: WorldBlockCatalogProvider = baseBlockCatalogs) -> WorldRuntime:
    const generators: Map<string, WorldGenerator> = Map()
    const blockRegistries: Map<string, CachedWorldBlocks> = Map()

    def generatorFor(manifest: WorldManifest) -> WorldGenerator:
        const existing = generators.get(manifest.id)
        if existing != null: return existing
        const generator = worldGenerator(manifest)
        generators.set(manifest.id, generator)
        return generator

    def requireCatalogSet(manifest: readonly WorldManifest) -> readonly WorldBlockCatalogSet:
        const catalogs = blockCatalogs(manifest)
        assert not catalogs.revision.isBlank() else f"World {manifest.id} block catalog revision cannot be blank"
        return catalogs

    def snapshotsEqual(left: readonly WorldBlockRegistrySnapshot, right: readonly WorldBlockRegistrySnapshot) -> bool:
        return Json.stableStringify(left) == Json.stableStringify(right)

    /// 载入世界时以持久化快照为数字身份权威，并把当前目录集合投影成活动注册表。
    /// 同一世界和 revision 只构建一次；Mod 集合改变后 revision 会触发重新合成。
    async def activateWorld(manifest: WorldManifest) -> ActiveWorld:
        const catalogs = requireCatalogSet(manifest)
        const cached = blockRegistries.get(manifest.id)
        if cached != null and cached.revision == catalogs.revision: return {manifest, blocks: cached.blocks}

        const blocks = createWorldBlockRegistry(baseBlockCatalogSource, catalogs.contributions, manifest.blockRegistry)
        let activeManifest = manifest
        if not snapshotsEqual(manifest.blockRegistry, blocks.snapshot):
            await store.manifests.updateBlockRegistry(manifest.id, blocks.snapshot)
            activeManifest = WorldManifest.from(manifest, {blockRegistry: WorldBlockRegistrySnapshot.parse(blocks.snapshot)})
        blockRegistries.set(manifest.id, {revision: catalogs.revision, blocks})
        return {manifest: activeManifest, blocks}

    async def createWorld(command: CreateWorld) -> WorldManifest:
        const initial = createWorldManifest(command, baseWorldBlockRegistrySnapshot)
        const existing = await store.manifests.find(initial.id)
        if existing != null: throw WorldAlreadyExistsError(initial.id)
        const catalogs = requireCatalogSet(initial)
        const blocks = createWorldBlockRegistry(baseBlockCatalogSource, catalogs.contributions, initial.blockRegistry)
        const manifest = createWorldManifest(command, blocks.snapshot)
        await store.manifests.save(manifest)
        blockRegistries.set(manifest.id, {revision: catalogs.revision, blocks})
        return manifest

    async def findActiveWorld(worldId: string) -> ActiveWorld?:
        const manifest = await store.manifests.find(worldId)
        if manifest == null: return null
        return await activateWorld(manifest)

    async def findWorld(worldId: string) -> WorldManifest?:
        const active = await findActiveWorld(worldId)
        return active?.manifest

    async def requireActiveWorld(worldId: string) -> ActiveWorld:
        const active = await findActiveWorld(worldId)
        if active == null: throw WorldNotFoundError(worldId)
        return active

    async def requireWorld(worldId: string) -> WorldManifest: return (await requireActiveWorld(worldId)).manifest

    def applyDelta(blocks: WorldBlockRegistry, chunk: Chunk, delta: ChunkDelta):
        assert delta.revision.isInteger() and delta.revision >= 0 else "Chunk revision must be a non-negative integer"
        for entry in delta.overrides:
            requireWorldBlockStateRuntimeId(blocks.index, entry.blockStateRuntimeId)
            setChunkBlock(chunk, entry.position, entry.blockStateRuntimeId)
        chunk.revision = delta.revision

    async def chunks(worldId: string, positions: List<ChunkPosition>) -> List<Chunk>:
        assert positions.size > 0 else "A chunk batch cannot be empty"
        assert positions.size <= maximumChunkBatchSize else f"A chunk batch cannot contain more than {maximumChunkBatchSize} positions"
        const active = await requireActiveWorld(worldId)
        const manifest = active.manifest
        const generator = generatorFor(manifest)
        const stored = await store.deltas.findChunks(worldId, positions)
        const deltas: Map<string, ChunkDelta> = Map()
        for delta in stored: deltas.set(chunkKey(delta.position), delta)
        const output: List<Chunk> = []
        for position in positions:
            const chunk = generator.generate(position)
            const delta = deltas.get(chunkKey(position))
            if delta != null: applyDelta(active.blocks, chunk, delta)
            output.append(chunk)
        return output

    async def chunk(worldId: string, position: ChunkPosition) -> Chunk:
        const found = await chunks(worldId, [position])
        return found[0]

    async def terrainSample(worldId: string, position: Coordinate2) -> TerrainSample:
        const active = await requireActiveWorld(worldId)
        return generatorFor(active.manifest).sample(position)

    async def setBlock(worldId: string, position: BlockPosition, blockStateRuntimeId: number) -> BlockChange:
        const active = await requireActiveWorld(worldId)
        active.blocks.registry.requireStateByRuntimeId(blockStateRuntimeId)
        requireWorldBlockStateRuntimeId(active.blocks.index, blockStateRuntimeId)
        const manifest = active.manifest
        const located = locateBlock(position, manifest.chunkEdge)
        const generated = generatorFor(manifest).generate(located.chunk)
        const baseBlockStateRuntimeId = chunkBlock(generated, located.local)
        const overrideBlockStateRuntimeId = blockStateRuntimeId == baseBlockStateRuntimeId ? null : blockStateRuntimeId
        const commit = await store.deltas.commitBlock(worldId, located.chunk, located.local, overrideBlockStateRuntimeId)
        const previousBlockStateRuntimeId = commit.previousOverrideBlockStateRuntimeId ?? baseBlockStateRuntimeId
        return {
            worldId,
            position,
            chunk: located.chunk,
            local: located.local,
            previousBlockStateRuntimeId,
            blockStateRuntimeId,
            revision: commit.revision,
        }

    async def close(): await store.close()

    return {createWorld, findWorld, requireWorld, chunk, chunks, terrainSample, setBlock, close}
