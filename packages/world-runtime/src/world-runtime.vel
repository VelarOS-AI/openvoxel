import {BlockPosition, Chunk, ChunkPosition, Coordinate2, CreateWorld, LocalPosition, TerrainSample, WorldGenerator, WorldManifest, chunkBlock, chunkKey, createWorldManifest, locateBlock, maximumChunkBatchSize, requireBlockId, setChunkBlock, worldGenerator} from "@openvoxel/domain"
import {ChunkDelta, WorldStore} from "./contracts.vel"

export class WorldNotFoundError extends Error:
    constructor(const worldId: string):
        super(f"World '{worldId}' was not found")

export class WorldAlreadyExistsError extends Error:
    constructor(const worldId: string):
        super(f"World '{worldId}' already exists")

export type BlockChange:
    worldId: string
    position: BlockPosition
    chunk: ChunkPosition
    local: LocalPosition
    previousBlockId: number
    blockId: number
    revision: number

export type WorldRuntime:
    createWorld: (command: CreateWorld) -> Promise<WorldManifest>
    findWorld: (worldId: string) -> Promise<WorldManifest?>
    requireWorld: (worldId: string) -> Promise<WorldManifest>
    chunk: (worldId: string, position: ChunkPosition) -> Promise<Chunk>
    chunks: (worldId: string, positions: List<ChunkPosition>) -> Promise<List<Chunk>>
    terrainSample: (worldId: string, position: Coordinate2) -> Promise<TerrainSample>
    setBlock: (worldId: string, position: BlockPosition, blockId: number) -> Promise<BlockChange>
    close: () -> Promise<null>

export def worldRuntime(store: WorldStore) -> WorldRuntime:
    const generators: Map<string, WorldGenerator> = Map()

    def generatorFor(manifest: WorldManifest) -> WorldGenerator:
        const existing = generators.get(manifest.id)
        if existing != null:
            return existing
        const generator = worldGenerator(manifest)
        generators.set(manifest.id, generator)
        return generator

    async def createWorld(command: CreateWorld) -> WorldManifest:
        const manifest = createWorldManifest(command)
        const existing = await store.manifests.find(manifest.id)
        if existing != null:
            throw WorldAlreadyExistsError(manifest.id)
        await store.manifests.save(manifest)
        return manifest

    async def findWorld(worldId: string) -> WorldManifest?:
        return await store.manifests.find(worldId)

    async def requireWorld(worldId: string) -> WorldManifest:
        const manifest = await findWorld(worldId)
        if manifest == null:
            throw WorldNotFoundError(worldId)
        return manifest

    def applyDelta(chunk: Chunk, delta: ChunkDelta):
        assert delta.revision.isInteger() and delta.revision >= 0 else "Chunk revision must be a non-negative integer"
        for entry in delta.overrides:
            setChunkBlock(chunk, entry.position, entry.blockId)
        chunk.revision = delta.revision

    async def chunks(worldId: string, positions: List<ChunkPosition>) -> List<Chunk>:
        assert positions.size > 0 else "A chunk batch cannot be empty"
        assert positions.size <= maximumChunkBatchSize else f"A chunk batch cannot contain more than {maximumChunkBatchSize} positions"
        const manifest = await requireWorld(worldId)
        const generator = generatorFor(manifest)
        const stored = await store.deltas.findChunks(worldId, positions)
        const deltas: Map<string, ChunkDelta> = Map()
        for delta in stored:
            deltas.set(chunkKey(delta.position), delta)
        const output: List<Chunk> = []
        for position in positions:
            const chunk = generator.generate(position)
            const delta = deltas.get(chunkKey(position))
            if delta != null:
                applyDelta(chunk, delta)
            output.append(chunk)
        return output

    async def chunk(worldId: string, position: ChunkPosition) -> Chunk:
        const found = await chunks(worldId, [position])
        return found[0]

    async def terrainSample(worldId: string, position: Coordinate2) -> TerrainSample:
        const manifest = await requireWorld(worldId)
        return generatorFor(manifest).sample(position)

    async def setBlock(worldId: string, position: BlockPosition, blockId: number) -> BlockChange:
        requireBlockId(blockId)
        const manifest = await requireWorld(worldId)
        const located = locateBlock(position, manifest.chunkEdge)
        const generated = generatorFor(manifest).generate(located.chunk)
        const baseBlockId = chunkBlock(generated, located.local)
        const overrideBlockId = blockId == baseBlockId ? null : blockId
        const commit = await store.deltas.commitBlock(worldId, located.chunk, located.local, overrideBlockId)
        const previousBlockId = commit.previousOverrideBlockId ?? baseBlockId
        return {
            worldId,
            position,
            chunk: located.chunk,
            local: located.local,
            previousBlockId,
            blockId,
            revision: commit.revision,
        }

    async def close():
        await store.close()

    return {createWorld, findWorld, requireWorld, chunk, chunks, terrainSample, setBlock, close}
