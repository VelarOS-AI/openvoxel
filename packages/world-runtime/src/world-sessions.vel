import {WorldBlockRegistry, baseBlockCatalogSource, createWorldBlockRegistry, requireWorldBlockStateRuntimeId} from "@openvoxel/blocks"
import {ContentCatalog, WorldContentSet, baseContentCatalog} from "@openvoxel/content"
import {WorldGenerator, WorldGeneratorRegistry, createWorldGeneratorRegistry, defaultGenerator, instantiateWorldGenerator, worldGenerator} from "@openvoxel/world-generation"
import {WorldManifest, initialChunkEdge} from "@openvoxel/world"
import {WorldStore} from "./contracts.vel"
import {ActiveWorldState, activeWorldState} from "./active-world-state.vel"
import {CreateWorld, assembleWorldManifest} from "./world-creation.vel"
import {WorldNotFoundError, WorldRequestError} from "./world-errors.vel"
import {WorldContentSnapshot, createWorldContentSnapshot} from "./world-content.vel"

/// 已加载世界是 world-runtime 内部统一使用的世界上下文。
///
/// 过去清单、方块注册表和生成器分别存放在不同 Map 中，调用者必须自己保证
/// 三者属于同一个世界。现在它们被放进同一份记录，任何区块查询或方块命令
/// 只要取得 LoadedWorld，就得到了一次完整且相互匹配的运行时快照。
export type LoadedWorld:
    /// 持久化世界清单；其中包含这个世界的方块数字身份快照。
    manifest: WorldManifest
    /// 当前目录集合与持久化快照合成出的活动方块注册表。
    blocks: WorldBlockRegistry
    /// 根据清单中的生成器身份、种子和 Chunk 尺寸创建的确定性生成器。
    generator: WorldGenerator
    /// 当前世界合成后的生成器注册表。
    generators: WorldGeneratorRegistry
    /// 与 manifest.content 完全匹配的已解析内容集合。
    content: readonly WorldContentSet
    /// 已压缩并聚合完成的客户端内容目录；与世界会话同生命周期。
    contentSnapshot: readonly WorldContentSnapshot
    /// 玩家增量的世界私有热状态；查询、写入和生命周期都通过这里收口。
    state: ActiveWorldState

/// 世界会话缓存负责 LoadedWorld 的完整生命周期。
///
/// prepare 用于新世界：先构建完整上下文，但在存储成功前不放进缓存。
/// remember 只在清单已经持久化后调用，避免保存失败却留下“幽灵世界”。
/// find/require 用于已存在世界；unload 明确释放单个世界，close 则等待正在
/// 进行的载入结束后清空全部会话。
export type WorldSessionCache:
    prepare: (manifest: WorldManifest) -> LoadedWorld
    prepareNew: (command: CreateWorld) -> LoadedWorld
    remember: (world: LoadedWorld) -> null
    find: (worldId: string) -> Promise<LoadedWorld?>
    require: (worldId: string) -> Promise<LoadedWorld>
    unload: (worldId: string) -> Promise<null>
    close: () -> Promise<null>

/// 创建一个按世界隔离的会话缓存。
///
/// loaded 保存已经完成的上下文；loading 保存正在进行的载入 Promise。同一个
/// 世界同时收到多个首次请求时，后续请求会等待同一份 Promise，因而注册表、
/// 生成器和持久化快照最多构建一次。
export def worldSessionCache(
    store: WorldStore,
    contentCatalog: ContentCatalog = baseContentCatalog,
    activeChunkCapacity: number = 2048,
    activeOverrideCapacity: number = 262144,
) -> WorldSessionCache:
    const loaded: Map<string, LoadedWorld> = Map()
    const loading: Map<string, Promise<LoadedWorld?>> = Map()

    def activeState(worldId: string, blocks: readonly WorldBlockRegistry) -> ActiveWorldState:
        def validateBlockStateRuntimeId(runtimeId: number): requireWorldBlockStateRuntimeId(blocks.index, runtimeId)

        return activeWorldState(worldId, store.deltas, activeChunkCapacity, activeOverrideCapacity, validateBlockStateRuntimeId)

    def requireContentSet(manifest: readonly WorldManifest) -> readonly WorldContentSet:
        return contentCatalog.resolve(manifest.content)

    /// 把世界清单与其锁定的 Content Pack 集合合成为一份原子上下文。目录哈希
    /// 和状态集合必须与清单完全一致；生成器也在这里创建，确保它和 manifest
    /// 永远成对出现。
    def prepare(manifest: WorldManifest) -> LoadedWorld:
        const active = requireContentSet(manifest)
        const blocks = createWorldBlockRegistry(baseBlockCatalogSource, active.blockContributions, manifest.blockRegistry)
        const generators = createWorldGeneratorRegistry(contributions=active.generatorContributions)
        return {
            manifest,
            blocks,
            generator: worldGenerator(manifest, blocks, generators),
            generators,
            content: active,
            contentSnapshot: createWorldContentSnapshot(manifest, blocks, generators),
            state: activeState(manifest.id, blocks),
        }

    /// 新世界先按 worldId 选择内容，再一次性建立两个注册表、生成器哈希和出生点。
    /// 返回值尚未进入缓存，调用方只有在清单保存成功后才调用 remember。
    def prepareNew(command: CreateWorld) -> LoadedWorld:
        const worldId = command.id.trim()
        const worldName = command.name.trim()
        const worldSeed = command.seed.trim()
        if worldId.isBlank() or worldId.size > 64:
            throw WorldRequestError("World id must contain from 1 through 64 characters")
        if worldName.isBlank() or worldName.size > 80:
            throw WorldRequestError("World name must contain from 1 through 80 characters")
        if worldSeed.isBlank() or worldSeed.size > 128:
            throw WorldRequestError("World seed must contain from 1 through 128 characters")
        const active = (
            command.contentPacks == null
                ? contentCatalog.defaultContent()
                : contentCatalog.select(command.contentPacks)
        )
        const blocks = createWorldBlockRegistry(baseBlockCatalogSource, active.blockContributions)
        const generators = createWorldGeneratorRegistry(contributions=active.generatorContributions)
        const generatorKey = command.generator ?? defaultGenerator
        if generatorKey.isBlank() or generatorKey.size > 128 or not generators.catalog.generators.some(definition => definition.key == generatorKey):
            throw WorldRequestError(f"Unknown world generator {generatorKey}")
        const generatorHash = generators.definitionHash(generatorKey)
        const generator = instantiateWorldGenerator(generatorKey, command.seed.trim(), initialChunkEdge, blocks, generators)
        const manifest = assembleWorldManifest(command, blocks.snapshot, active.identity, generatorHash, generator.findSpawn())
        return {
            manifest,
            blocks,
            generator,
            generators,
            content: active,
            contentSnapshot: createWorldContentSnapshot(manifest, blocks, generators),
            state: activeState(manifest.id, blocks),
        }

    def remember(world: LoadedWorld): loaded.set(world.manifest.id, world)

    /// 从存储载入清单并重建上下文。Content Pack 构建或注册表状态不一致会直接
    /// 拒绝载入，不在打开世界时改写持久化身份。
    async def activate(worldId: string) -> LoadedWorld?:
        const existing = loaded.get(worldId)
        if existing != null: return existing
        const foundManifest = await store.manifests.find(worldId)
        if foundManifest == null: return null
        const manifest: WorldManifest = foundManifest

        const active = requireContentSet(manifest)

        const blocks = createWorldBlockRegistry(baseBlockCatalogSource, active.blockContributions, manifest.blockRegistry)
        const generators = createWorldGeneratorRegistry(contributions=active.generatorContributions)
        const world: LoadedWorld = {
            manifest,
            blocks,
            generator: worldGenerator(manifest, blocks, generators),
            generators,
            content: active,
            contentSnapshot: createWorldContentSnapshot(manifest, blocks, generators),
            state: activeState(manifest.id, blocks),
        }
        loaded.set(worldId, world)
        return world

    async def find(worldId: string) -> LoadedWorld?:
        const pending = loading.get(worldId)
        if pending != null: return await pending

        const activation = activate(worldId)
        loading.set(worldId, activation)
        try: return await activation
        finally: loading.remove(worldId)

    async def require(worldId: string) -> LoadedWorld:
        const world = await find(worldId)
        if world == null: throw WorldNotFoundError(worldId)
        return world

    /// 卸载只释放可重建的运行时状态，不删除清单或玩家修改。
    /// 如果这个世界正在首次载入，先等待该过程完成，再删除最终缓存结果。
    async def unload(worldId: string):
        const pending = loading.get(worldId)
        if pending != null: await pending
        const world = loaded.get(worldId)
        if world != null: await world.state.close()
        loaded.remove(worldId)

    /// 关闭缓存时先加入所有在途载入，避免存储已经关闭后仍有注册表快照写回。
    async def close():
        await Promise.all(loading.values())
        const closures: List<Promise<null>> = []
        for worldId in loaded:
            const world = loaded.get(worldId)
            if world != null: closures.append(world.state.close())
        await Promise.all(closures)
        loaded.clear()
        loading.clear()

    return {prepare, prepareNew, remember, find, require, unload, close}
