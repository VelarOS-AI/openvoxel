import {BlockCatalogContribution, WorldBlockRegistry, WorldBlockRegistrySnapshot, baseBlockCatalogSource, blockCatalogHash, createWorldBlockRegistry} from "@openvoxel/blocks"
import {WorldGenerator, WorldGeneratorCatalogContribution, WorldGeneratorRegistry, createWorldGeneratorRegistry, defaultGenerator, instantiateWorldGenerator, worldGenerator, worldGeneratorCatalogHash} from "@openvoxel/world-generation"
import {WorldManifest, initialChunkEdge} from "@openvoxel/world"
import {WorldStore} from "./contracts.vel"
import {CreateWorld, assembleWorldManifest} from "./world-creation.vel"
import {WorldNotFoundError} from "./world-errors.vel"

/// 一个目录集合描述某个世界当前启用的全部 Mod 方块内容。
///
/// revision 是这组输入的版本身份。任一 Mod 内容或 Mod 集合发生变化时，
/// 调用方都必须给出新的 revision。运行时只比较这个稳定值，不需要反复扫描
/// 和序列化整组目录，因此能够快速判断已加载世界是否需要刷新注册表。
export type WorldContentSet:
    revision: string
    blockContributions: readonly List<readonly BlockCatalogContribution>
    generatorContributions: readonly List<readonly WorldGeneratorCatalogContribution>

/// 方块目录提供器以世界清单为输入，因此每个世界可以拥有不同的 Mod 集合。
/// 它只回答“这个世界当前启用了什么”，不负责分配 runtimeId；runtimeId 的
/// 延续、追加和持久化仍由 blocks 包的世界注册表完成。
export type WorldContentProvider = (worldId: string) -> readonly WorldContentSet

/// 已加载世界是 world-runtime 内部统一使用的世界上下文。
///
/// 过去清单、方块注册表和生成器分别存放在不同 Map 中，调用者必须自己保证
/// 三者属于同一个世界。现在它们被放进同一份记录，任何区块查询或方块命令
/// 只要取得 LoadedWorld，就得到了一次完整且相互匹配的运行时快照。
export type LoadedWorld:
    /// 持久化世界清单；其中包含这个世界的方块数字身份快照。
    manifest: WorldManifest
    /// 当前目录集合与持久化快照合成出的活动方块注册表。
    blocks: WorldBlockRegistry
    /// 根据清单中的生成器身份、种子和 Chunk 尺寸创建的确定性生成器。
    generator: WorldGenerator
    /// 当前世界合成后的生成器注册表。
    generators: WorldGeneratorRegistry
    /// 构建 blocks 和 generator 时所使用的统一内容集合版本。
    contentRevision: string

/// 世界会话缓存负责 LoadedWorld 的完整生命周期。
///
/// prepare 用于新世界：先构建完整上下文，但在存储成功前不放进缓存。
/// remember 只在清单已经持久化后调用，避免保存失败却留下“幽灵世界”。
/// find/require 用于已存在世界；unload 明确释放单个世界，close 则等待正在
/// 进行的载入结束后清空全部会话。
export type WorldSessionCache:
    prepare: (manifest: WorldManifest) -> LoadedWorld
    prepareNew: (command: CreateWorld) -> LoadedWorld
    remember: (world: LoadedWorld) -> null
    find: (worldId: string) -> Promise<LoadedWorld?>
    require: (worldId: string) -> Promise<LoadedWorld>
    unload: (worldId: string) -> Promise<null>
    close: () -> Promise<null>

/// 基础运行时没有 Mod；基础方块目录哈希就是它的缓存版本。
def baseWorldContent(worldId: string) -> readonly WorldContentSet:
    return {revision: f"{blockCatalogHash}:{worldGeneratorCatalogHash}", blockContributions: [], generatorContributions: []}

/// 固定目录集合适合服务器启动时已经确定 Mod 列表的场景。
/// revision 由装载 Mod 的上层编译入口提供，world-runtime 不猜测它的来源。
export def fixedWorldContentProvider(
    revision: string,
    blockContributions: readonly List<readonly BlockCatalogContribution>,
    generatorContributions: readonly List<readonly WorldGeneratorCatalogContribution> = [],
) -> WorldContentProvider:
    assert not revision.isBlank() else "World content revision cannot be blank"

    def provide(worldId: string) -> readonly WorldContentSet:
        return {revision, blockContributions, generatorContributions}

    return provide

/// 创建一个按世界隔离的会话缓存。
///
/// loaded 保存已经完成的上下文；loading 保存正在进行的载入 Promise。同一个
/// 世界同时收到多个首次请求时，后续请求会等待同一份 Promise，因而注册表、
/// 生成器和持久化快照最多构建一次。
export def worldSessionCache(
    store: WorldStore,
    content: WorldContentProvider = baseWorldContent,
) -> WorldSessionCache:
    const loaded: Map<string, LoadedWorld> = Map()
    const loading: Map<string, Promise<LoadedWorld?>> = Map()

    def requireContentSet(manifest: readonly WorldManifest) -> readonly WorldContentSet:
        const active = content(manifest.id)
        assert not active.revision.isBlank() else f"World {manifest.id} content revision cannot be blank"
        return active

    def snapshotsEqual(left: readonly WorldBlockRegistrySnapshot, right: readonly WorldBlockRegistrySnapshot) -> bool:
        return Json.stableStringify(left) == Json.stableStringify(right)

    /// 把世界清单与当前目录集合合成为一份原子上下文。
    /// createWorldBlockRegistry 会保留清单中缺失 Mod 的历史映射，并只为新增状态
    /// 追加 runtimeId。生成器也在这里创建，确保它和 manifest 永远成对出现。
    def prepare(manifest: WorldManifest) -> LoadedWorld:
        const active = requireContentSet(manifest)
        const blocks = createWorldBlockRegistry(baseBlockCatalogSource, active.blockContributions, manifest.blockRegistry)
        const generators = createWorldGeneratorRegistry(contributions=active.generatorContributions)
        const activeManifest = (
            snapshotsEqual(manifest.blockRegistry, blocks.snapshot)
                ? manifest
                : WorldManifest.from(manifest, {blockRegistry: WorldBlockRegistrySnapshot.parse(blocks.snapshot)})
        )
        return {
            manifest: activeManifest,
            blocks,
            generator: worldGenerator(activeManifest, blocks, generators),
            generators,
            contentRevision: active.revision,
        }

    /// 新世界先按 worldId 选择内容，再一次性建立两个注册表、生成器哈希和出生点。
    /// 返回值尚未进入缓存，调用方只有在清单保存成功后才调用 remember。
    def prepareNew(command: CreateWorld) -> LoadedWorld:
        const worldId = command.id.trim()
        const active = content(worldId)
        assert not active.revision.isBlank() else f"World {worldId} content revision cannot be blank"
        const blocks = createWorldBlockRegistry(baseBlockCatalogSource, active.blockContributions)
        const generators = createWorldGeneratorRegistry(contributions=active.generatorContributions)
        const generatorKey = command.generator ?? defaultGenerator
        const generatorHash = generators.definitionHash(generatorKey)
        const generator = instantiateWorldGenerator(generatorKey, command.seed.trim(), initialChunkEdge, blocks, generators)
        const manifest = assembleWorldManifest(command, blocks.snapshot, generatorHash, generator.findSpawn())
        return {manifest, blocks, generator, generators, contentRevision: active.revision}

    def remember(world: LoadedWorld): loaded.set(world.manifest.id, world)

    /// 从存储载入清单，或在目录 revision 改变后重建上下文。
    /// 注册表快照发生变化时先写回存储，再替换内存缓存；外部永远看不到一份
    /// 尚未持久化完成的活动注册表。
    async def activate(worldId: string) -> LoadedWorld?:
        const existing = loaded.get(worldId)
        const foundManifest = existing?.manifest ?? await store.manifests.find(worldId)
        if foundManifest == null: return null
        let manifest: WorldManifest = foundManifest

        const active = requireContentSet(manifest)
        if existing != null and existing.contentRevision == active.revision: return existing

        const blocks = createWorldBlockRegistry(baseBlockCatalogSource, active.blockContributions, manifest.blockRegistry)
        const generators = createWorldGeneratorRegistry(contributions=active.generatorContributions)
        if not snapshotsEqual(manifest.blockRegistry, blocks.snapshot):
            await store.manifests.updateBlockRegistry(manifest.id, blocks.snapshot)
            manifest = WorldManifest.from(manifest, {blockRegistry: WorldBlockRegistrySnapshot.parse(blocks.snapshot)})

        const world: LoadedWorld = {
            manifest,
            blocks,
            generator: worldGenerator(manifest, blocks, generators),
            generators,
            contentRevision: active.revision,
        }
        loaded.set(worldId, world)
        return world

    async def find(worldId: string) -> LoadedWorld?:
        const pending = loading.get(worldId)
        if pending != null: return await pending

        const activation = activate(worldId)
        loading.set(worldId, activation)
        try: return await activation
        finally: loading.remove(worldId)

    async def require(worldId: string) -> LoadedWorld:
        const world = await find(worldId)
        if world == null: throw WorldNotFoundError(worldId)
        return world

    /// 卸载只释放可重建的运行时状态，不删除清单或玩家修改。
    /// 如果这个世界正在首次载入，先等待该过程完成，再删除最终缓存结果。
    async def unload(worldId: string):
        const pending = loading.get(worldId)
        if pending != null: await pending
        loaded.remove(worldId)

    /// 关闭缓存时先加入所有在途载入，避免存储已经关闭后仍有注册表快照写回。
    async def close():
        await Promise.all(loading.values())
        loaded.clear()
        loading.clear()

    return {prepare, prepareNew, remember, find, require, unload, close}
