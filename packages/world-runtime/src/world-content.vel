import {BlockCatalogSource, BlockRenderResources, PackedBlockCatalogSource, WorldBlockRegistry, WorldBlockRegistrySnapshot, collectBlockRenderResources, packBlockCatalog} from "@openvoxel/blocks"
import {WorldContentIdentity, WorldManifest} from "@openvoxel/world"
import {WorldGeneratorDefinition, WorldGeneratorRegistry} from "@openvoxel/world-generation"
import {sha256Text} from "@openvoxel/hash"

/// 客户端进入一个世界时需要的活动内容事实。
///
/// 这不是基础方块包的全局目录：所有 runtimeId、组件档案和生成器参数都来自
/// LoadedWorld，因而与该世界持久化的 Content Pack 身份和方块快照严格匹配。
export type WorldContentSnapshot:
    content: WorldContentIdentity
    stateMapHash: string
    generator: string
    generatorHash: string
    generatorCatalogHash: string
    definition: WorldGeneratorDefinition
    catalog: PackedBlockCatalogSource
    resources: BlockRenderResources

/// 内容快照只在 LoadedWorld 装配时创建一次。组件压缩、资源聚合和目录哈希都与
/// 玩家热状态无关，HTTP 请求只读取这份不可变结果。
export def createWorldContentSnapshot(
    manifest: readonly WorldManifest,
    blocks: readonly WorldBlockRegistry,
    generators: readonly WorldGeneratorRegistry,
) -> WorldContentSnapshot:
    const definition = generators.definition(manifest.generator)
    return {
        content: WorldContentIdentity.parse(manifest.content),
        stateMapHash: sha256Text(Json.stableStringify(WorldBlockRegistrySnapshot.parse(blocks.snapshot))),
        generator: manifest.generator,
        generatorHash: manifest.generatorHash,
        generatorCatalogHash: sha256Text(Json.stableStringify(generators.catalog)),
        definition: WorldGeneratorDefinition.parse(definition),
        catalog: packBlockCatalog(BlockCatalogSource.parse(blocks.source)),
        resources: collectBlockRenderResources(blocks.source.states),
    }
