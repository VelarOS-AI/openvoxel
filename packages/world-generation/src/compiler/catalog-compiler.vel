import {BuiltinIdentityDocument, IdentityResolution, mergeIdentityTrees, resolveIdentityReferences} from "@openvoxel/identities"
import {parseYaml} from "@velarscript-labs/yaml"
import {sha256Text} from "@openvoxel/hash"
import {CurvePoint, WorldGeneratorCatalogArtifact, WorldGeneratorCatalogContribution, WorldGeneratorCatalogManifest, WorldGeneratorCatalogSource, WorldGeneratorDefinition, WorldGeneratorPaletteDefinition} from "../definition/catalog.vel"

def requirePositiveInteger(value: number, label: string):
    assert value.isInteger() and value > 0 else f"{label} must be a positive integer"

def requireProbability(value: number, label: string):
    assert value.isFinite() and value >= 0 and value <= 1 else f"{label} must be between 0 and 1"

def requireNamespacedKey(value: string, label: string):
    assert Text.matches(value, r"^[a-z][a-z0-9_.-]*:[a-z0-9][a-z0-9_./-]*$") else f"{label} must be a lowercase namespaced key"

def validateCurve(points: readonly List<readonly CurvePoint>):
    assert points.size >= 2 else "Continental height curve requires at least two points"
    let previousInput = -Math.infinity
    for point in points:
        assert point.input.isFinite() and point.output.isFinite() else "Continental height curve values must be finite"
        assert point.input > previousInput else "Continental height curve inputs must be strictly increasing"
        previousInput = point.input
    assert points[0].input <= -1 and points[points.size - 1].input >= 1 else "Continental height curve must cover -1 through 1"

/// 校验一个生成器定义中的跨字段约束。Type.parse 已经保证字段完整和类型正确，
/// 这里继续保证世界边界、采样步长、概率和曲线能够组成可执行的有限算法。
export def validateWorldGeneratorDefinition(definition: WorldGeneratorDefinition) -> WorldGeneratorDefinition:
    assert definition.schemaVersion == 1 else "Unsupported world generator definition schema version"
    requireNamespacedKey(definition.key, "World generator key")
    requireNamespacedKey(definition.palette, "World generator palette key")
    assert definition.world.minimumY == 0 and definition.world.maximumY == 255 else "Survival world height must be 0 through 255"
    assert definition.world.minimumY < definition.world.seaLevel and definition.world.seaLevel < definition.world.maximumNaturalSurfaceY else "Sea level must sit inside the natural surface range"
    assert definition.world.maximumNaturalSurfaceY < definition.world.maximumY else "Natural surface limit must be below world maximum"
    requirePositiveInteger(definition.world.bedrockDepth, "Bedrock depth")
    requirePositiveInteger(definition.sampling.horizontalStep, "Horizontal density step")
    requirePositiveInteger(definition.sampling.verticalStep, "Vertical density step")
    assert 16 % definition.sampling.horizontalStep == 0 else "Horizontal density step must divide a Chunk edge"
    assert 256 % definition.sampling.verticalStep == 0 else "Vertical density step must divide world height"
    assert definition.sampling.halo == 1 else "Terrain column halo must be one block"
    requirePositiveInteger(definition.sampling.columnCacheCapacity, "Column cache capacity")
    validateCurve(definition.terrain.continentalHeight)
    assert definition.terrain.riverHalfWidth > 0 and definition.terrain.riverHalfWidth <= 1 else "River half width must be between 0 and 1"
    requireProbability(definition.caves.branchChance, "Cave branch chance")
    requireProbability(definition.caves.tunnelChance, "Cave tunnel chance")
    requireProbability(definition.caves.chamberChance, "Cave chamber chance")
    requirePositiveInteger(definition.vegetation.treeCellSize, "Tree candidate cell size")
    requirePositiveInteger(definition.vegetation.cactusCellSize, "Cactus candidate cell size")
    requirePositiveInteger(definition.vegetation.groundPlantCellSize, "Ground plant candidate cell size")
    requireProbability(definition.vegetation.groundPlantChance, "Ground plant chance")
    assert definition.caves.minimumLength <= definition.caves.maximumLength else "Cave length range is reversed"
    assert definition.caves.minimumRadius <= definition.caves.maximumRadius else "Cave radius range is reversed"
    assert definition.aquifers.minimumWaterDepth <= definition.aquifers.maximumWaterDepth else "Aquifer depth range is reversed"
    for mineral in definition.minerals:
        assert Text.matches(mineral.key, r"^[a-z][a-z0-9_-]*$") else f"Mineral {mineral.key} must use a stable local key"
        requireProbability(mineral.chance, f"Mineral {mineral.key} chance")
        requireProbability(mineral.largeChance, f"Mineral {mineral.key} large chance")
        assert mineral.minimumY <= mineral.maximumY else f"Mineral {mineral.key} height range is reversed"
        assert mineral.minimumSize <= mineral.maximumSize else f"Mineral {mineral.key} size range is reversed"
    return definition

/// 材料调色板只校验内容绑定，不拥有任何地形参数。这里拒绝重复矿物槽位，
/// 保证算法定义中的每个矿物 key 最终只能解析到一组方块。
export def validateWorldGeneratorPaletteDefinition(palette: WorldGeneratorPaletteDefinition) -> WorldGeneratorPaletteDefinition:
    assert palette.schemaVersion == 1 else "Unsupported world generator palette schema version"
    requireNamespacedKey(palette.key, "World generator palette key")
    const keys: Set<string> = Set()
    for mineral in palette.minerals:
        assert Text.matches(mineral.key, r"^[a-z][a-z0-9_-]*$") else f"Mineral material {mineral.key} must use a stable local key"
        assert not (mineral.key in keys) else f"Duplicate mineral material {mineral.key}"
        keys.add(mineral.key)
        requireNamespacedKey(mineral.block, f"Mineral material {mineral.key} block")
        requireNamespacedKey(mineral.source, f"Mineral material {mineral.key} source")
    return palette

def requireUniqueGenerators(generators: readonly List<readonly WorldGeneratorDefinition>):
    const keys: Set<string> = Set()
    for generator in generators:
        assert not (generator.key in keys) else f"Duplicate world generator {generator.key}"
        keys.add(generator.key)

def requireUniquePalettes(palettes: readonly List<readonly WorldGeneratorPaletteDefinition>):
    const keys: Set<string> = Set()
    for palette in palettes:
        assert not (palette.key in keys) else f"Duplicate world generator palette {palette.key}"
        keys.add(palette.key)

def requireGeneratorPaletteBindings(generators: readonly List<readonly WorldGeneratorDefinition>, palettes: readonly List<readonly WorldGeneratorPaletteDefinition>):
    const byKey: Map<string, readonly WorldGeneratorPaletteDefinition> = Map()
    for palette in palettes: byKey.set(palette.key, palette)
    for generator in generators:
        const palette = byKey.get(generator.palette)
        assert palette != null else f"World generator {generator.key} references unknown palette {generator.palette}"
        const materialKeys = Set(palette.minerals.map(mineral => mineral.key))
        for mineral in generator.minerals:
            assert mineral.key in materialKeys else f"World generator {generator.key} mineral {mineral.key} has no material binding in palette {palette.key}"

/// 把一组 YAML 文本解析成运行时目录。打点身份在这里一次性解析，生成产物中
/// 保存的已经是真实 key，运行时不会再做字符串路径转换。
export def compileWorldGeneratorCatalog(
    manifestText: string,
    generatorSourceTexts: readonly List<string>,
    paletteSourceTexts: readonly List<string>,
    identityTree: readonly Record<unknown>,
) -> WorldGeneratorCatalogArtifact:
    const manifest = WorldGeneratorCatalogManifest.parse(parseYaml(manifestText))
    assert manifest.formatVersion == 2 else "Unsupported world generator catalog format version"
    assert manifest.generatorSources.size == generatorSourceTexts.size else "World generator source count does not match its manifest"
    assert manifest.paletteSources.size == paletteSourceTexts.size else "World generator palette source count does not match its manifest"
    const generators: List<WorldGeneratorDefinition> = []
    for sourceText in generatorSourceTexts:
        const resolution = IdentityResolution.parse(resolveIdentityReferences(parseYaml(sourceText), identityTree))
        generators.append(validateWorldGeneratorDefinition(WorldGeneratorDefinition.parse(resolution.value)))
    const palettes: List<WorldGeneratorPaletteDefinition> = []
    for sourceText in paletteSourceTexts:
        const resolution = IdentityResolution.parse(resolveIdentityReferences(parseYaml(sourceText), identityTree))
        palettes.append(validateWorldGeneratorPaletteDefinition(WorldGeneratorPaletteDefinition.parse(resolution.value)))
    requireUniqueGenerators(generators)
    requireUniquePalettes(palettes)
    requireGeneratorPaletteBindings(generators, palettes)
    const catalog: WorldGeneratorCatalogSource = {
        schemaVersion: 2,
        generators: generators.sorted(by=generator => generator.key),
        palettes: palettes.sorted(by=palette => palette.key),
    }
    return {
        artifactVersion: 1,
        contentHash: sha256Text(Json.stableStringify(catalog)),
        catalog,
    }

/// Mod 编译入口接收已经由上层目录读取器整理出的 YAML 文本。owner 必须与
/// 每个生成器 key 的命名空间一致，防止一个 Mod 覆盖其他内容所有者。
export def compileModWorldGeneratorContribution(
    owner: string,
    manifestText: string,
    identitiesText: string,
    generatorSourceTexts: readonly List<string>,
    paletteSourceTexts: readonly List<string>,
    baseIdentities: readonly Record<unknown>,
) -> WorldGeneratorCatalogContribution:
    assert Text.matches(owner, r"^[a-z][a-z0-9_.-]*$") else "World generator contribution owner must be a lowercase namespace"
    const identityDocument = BuiltinIdentityDocument.parse(parseYaml(identitiesText))
    assert identityDocument.formatVersion == 3 else "Unsupported Mod identity format version"
    const mergedIdentities = mergeIdentityTrees(baseIdentities, identityDocument.identities)
    const artifact = compileWorldGeneratorCatalog(manifestText, generatorSourceTexts, paletteSourceTexts, mergedIdentities)
    for generator in artifact.catalog.generators:
        assert generator.key.split(":")[0] == owner else f"World generator {generator.key} is outside contribution namespace {owner}"
    for palette in artifact.catalog.palettes:
        assert palette.key.split(":")[0] == owner else f"World generator palette {palette.key} is outside contribution namespace {owner}"
    return {owner, catalog: artifact.catalog}
