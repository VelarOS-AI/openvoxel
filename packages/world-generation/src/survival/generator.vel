import {Chunk, ChunkPosition, Coordinate2, chunkBlockAtIndex, emptyChunk, paintChunkBlockAtIndex} from "@openvoxel/world"
import {isFluidBlock} from "@openvoxel/blocks"
import {WorldGenerator} from "../contracts.vel"
import {TerrainSample} from "../terrain-sample.vel"
import {carveCaves, cavePlanner} from "./caves.vel"
import {generateFluidPockets} from "./fluids.vel"
import {generateMinerals} from "./minerals.vel"
import {generateVegetation} from "./vegetation.vel"
import {survivalBlocks} from "./block-palette.vel"
import {ColumnCache, GenerationFields, baseTerrainBlock, columnPlanner, createGenerationFields, maximumWorldY, minimumWorldY, sampleTerrainWithFields, subsurfaceBlock, surfaceBlock} from "./terrain.vel"

def chunkMinimumX(chunk: Chunk) -> number: return chunk.position.x * chunk.edge

def chunkMinimumY(chunk: Chunk) -> number: return chunk.position.y * chunk.edge

def chunkMinimumZ(chunk: Chunk) -> number: return chunk.position.z * chunk.edge

def insideY(chunk: Chunk, y: number) -> bool:
    const minimumY = chunkMinimumY(chunk)
    return y >= minimumY and y < minimumY + chunk.edge

def indexAt(chunk: Chunk, worldX: number, worldY: number, worldZ: number) -> number:
    const localX = worldX - chunkMinimumX(chunk)
    const localY = worldY - chunkMinimumY(chunk)
    const localZ = worldZ - chunkMinimumZ(chunk)
    return localX + chunk.edge * (localZ + chunk.edge * localY)

def generateBaseTerrain(chunk: Chunk, fields: GenerationFields, cache: ColumnCache):
    const minimumY = chunkMinimumY(chunk)
    for localX in range(chunk.edge):
        for localZ in range(chunk.edge):
            const sample = cache.samples[localZ + chunk.edge * localX]
            for localY in range(chunk.edge):
                const worldY = minimumY + localY
                const index = localX + chunk.edge * (localZ + chunk.edge * localY)
                paintChunkBlockAtIndex(chunk, index, baseTerrainBlock(fields, sample, worldY))

def paintSurfaceColumn(chunk: Chunk, sample: TerrainSample, topY: number):
    const topBlock = surfaceBlock(sample, topY)
    const underBlock = subsurfaceBlock(sample, topY)
    let thickness = 4
    if sample.mountainFactor > 0.9: thickness = 2
    else if sample.humidity > 11: thickness = 6
    for depth in range(thickness):
        const worldY = topY - depth
        if not insideY(chunk, worldY): continue
        const index = indexAt(chunk, sample.position.x, worldY, sample.position.z)
        const current = chunkBlockAtIndex(chunk, index)
        if current != survivalBlocks.air and not isFluidBlock(current):
            paintChunkBlockAtIndex(chunk, index, depth == 0 ? topBlock : underBlock)

def generateSurface(chunk: Chunk, cache: ColumnCache):
    for localX in range(chunk.edge):
        for localZ in range(chunk.edge):
            const index = localZ + chunk.edge * localX
            paintSurfaceColumn(chunk, cache.samples[index], cache.surfaceHeights[index])

/// 构造内建生存生成器。生成器只接收已经验证过的种子和 Chunk 边长，
/// 生成器身份选择由上层 registry 统一处理。
export def survivalWorldGenerator(seed: string, edge: number) -> WorldGenerator:
    const fields = createGenerationFields(seed)
    const columns = columnPlanner(fields, edge)
    const caves = cavePlanner(fields, seed)

    def sample(position: Coordinate2) -> TerrainSample: return sampleTerrainWithFields(fields, position)

    def generate(position: ChunkPosition) -> Chunk:
        const chunk = emptyChunk(position, edge, survivalBlocks.air)
        const minimumY = position.y * edge
        const maximumY = minimumY + edge - 1
        if maximumY < minimumWorldY or minimumY > maximumWorldY: return chunk

        const cache = columns.columns(position.x, position.z)
        generateBaseTerrain(chunk, fields, cache)
        carveCaves(chunk, caves)
        generateFluidPockets(chunk, seed)
        generateMinerals(chunk, seed)
        generateSurface(chunk, cache)
        generateVegetation(chunk, fields, seed, cache)
        return chunk

    return {sample, generate}
