import {BlockRegistry} from "@openvoxel/blocks"
import {builtinIdentities} from "@openvoxel/identities"
import {Random, random} from "velar/random"
import {Chunk, Coordinate3} from "@openvoxel/world"
import {MineralConfig, MineralMaterialBinding, WorldGeneratorDefinition, WorldGeneratorPaletteDefinition} from "../definition/catalog.vel"
import {SurvivalBlockPalette} from "./block-palette.vel"
import {evictOldest} from "./lru-cache.vel"
import {CompiledFeaturePlan, FeatureWrite, applyCompiledFeaturePlan, chunkMinimumX, chunkMinimumY, chunkMinimumZ, compiledFeaturePlan} from "./feature-plan.vel"

export type MineralPlanner:
    cachedPlanCount: () -> number
    planBuildCount: () -> number
    small: (cellX: number, cellY: number, cellZ: number) -> readonly CompiledFeaturePlan
    large: (cellX: number, cellY: number, cellZ: number) -> readonly CompiledFeaturePlan
    sourceFor: (runtimeId: number) -> number?

def heightWeight(config: readonly MineralConfig, y: number) -> number:
    const center = (config.minimumY + config.maximumY) / 2
    const half = Math.max(1, (config.maximumY - config.minimumY) / 2)
    return Math.clamp(1 - (y - center).abs() / half, 0, 1)

def appendVein(writes: List<FeatureWrite>, origin: readonly Coordinate3, stream: Random, start: readonly Coordinate3, runtimeId: number, minimumSize: number, maximumSize: number):
    let x = start.x
    let y = start.y
    let z = start.z
    const size = stream.int(minimumSize, maximumSize + 1)
    for step in range(size):
        writes.append({x: x - origin.x, y: y - origin.y, z: z - origin.z, runtimeId})
        if step % 3 == 0 and stream.bool(0.52):
            writes.append({x: x + stream.int(-1, 2) - origin.x, y: y + stream.int(-1, 2) - origin.y, z: z + stream.int(-1, 2) - origin.z, runtimeId})
        let dx = stream.int(-1, 2)
        const dy = stream.int(-1, 2)
        const dz = stream.int(-1, 2)
        if dx == 0 and dy == 0 and dz == 0: dx = 1
        x += dx
        y += dy
        z += dz

def appendLargeBody(writes: List<FeatureWrite>, origin: readonly Coordinate3, stream: Random, center: readonly Coordinate3, runtimeId: number):
    const radiusX = stream.int(7, 15)
    const radiusY = stream.int(3, 7)
    const radiusZ = stream.int(7, 15)
    for x in range(center.x - radiusX, center.x + radiusX + 1):
        for y in range(center.y - radiusY, center.y + radiusY + 1):
            for z in range(center.z - radiusZ, center.z + radiusZ + 1):
                const distance = Math.pow((x - center.x) / radiusX, 2) + Math.pow((y - center.y) / radiusY, 2) + Math.pow((z - center.z) / radiusZ, 2)
                if distance > 1 or not stream.bool(0.34 + 0.48 * (1 - distance)): continue
                writes.append({x: x - origin.x, y: y - origin.y, z: z - origin.z, runtimeId})

/// 普通矿脉由 16³ 单元拥有，大型铁铜矿体由 64³ 单元拥有。两类计划都在首次
/// 访问时展开成相对方块列表，后续只做包围盒判断和 Chunk 裁剪。
export def mineralPlanner(
    profile: readonly WorldGeneratorDefinition,
    palette: readonly WorldGeneratorPaletteDefinition,
    seed: string,
    registry: readonly BlockRegistry,
    capacity: number = 512,
) -> MineralPlanner:
    assert capacity.isInteger() and capacity > 0 else "Mineral plan cache capacity must be a positive integer"
    const root = random(seed).fork("minerals")
    const plans: Map<string, CompiledFeaturePlan> = Map()
    const materialByKey: Map<string, readonly MineralMaterialBinding> = Map()
    for material in palette.minerals: materialByKey.set(material.key, material)
    const sourceByOre: Map<number, number> = Map()
    for mineral in profile.minerals:
        const material = materialByKey.get(mineral.key)
        assert material != null else f"Mineral {mineral.key} has no material binding in palette {palette.key}"
        // material 来自可变 Map；复制到 const 后只在这里验证一次，两个注册表
        // 查询之间不再重复深校验同一份绑定记录。
        const selected: readonly MineralMaterialBinding = material
        const blockKey = selected.block
        const sourceKey = selected.source
        sourceByOre.set(registry.defaultStateRuntimeIdForKey(blockKey), registry.defaultStateRuntimeIdForKey(sourceKey))
    let builds = 0

    def cachedPlanCount() -> number: return plans.size

    def planBuildCount() -> number: return builds

    def remember(key: string, plan: CompiledFeaturePlan) -> readonly CompiledFeaturePlan:
        builds += 1
        if plans.size >= capacity: evictOldest(plans)
        plans.set(key, plan)
        return plan

    def small(cellX: number, cellY: number, cellZ: number) -> readonly CompiledFeaturePlan:
        const key = f"s:{cellX}:{cellY}:{cellZ}"
        if plans.has(key):
            const existing = plans.get(key)!
            plans.remove(key)
            plans.set(key, existing)
            return existing
        const origin = {x: cellX * 16, y: cellY * 16, z: cellZ * 16}
        const writes: List<FeatureWrite> = []
        for mineral in profile.minerals:
            const stream = root.fork(f"{key}:{mineral.key}")
            const start = {x: origin.x + stream.int(0, 16), y: origin.y + stream.int(0, 16), z: origin.z + stream.int(0, 16)}
            if start.y < mineral.minimumY or start.y > mineral.maximumY: continue
            if not stream.bool(mineral.chance * heightWeight(mineral, start.y)): continue
            const material = materialByKey.get(mineral.key)
            assert material != null else f"Mineral {mineral.key} has no material binding"
            const selected: readonly MineralMaterialBinding = material
            const blockKey = selected.block
            appendVein(writes, origin, stream, start, registry.defaultStateRuntimeIdForKey(blockKey), mineral.minimumSize, mineral.maximumSize)
        return remember(key, compiledFeaturePlan(key, origin, key, writes))

    def large(cellX: number, cellY: number, cellZ: number) -> readonly CompiledFeaturePlan:
        const key = f"l:{cellX}:{cellY}:{cellZ}"
        if plans.has(key):
            const existing = plans.get(key)!
            plans.remove(key)
            plans.set(key, existing)
            return existing
        const origin = {x: cellX * 64, y: cellY * 64, z: cellZ * 64}
        const writes: List<FeatureWrite> = []
        for mineral in profile.minerals:
            if mineral.largeChance <= 0: continue
            const stream = root.fork(f"{key}:{mineral.key}")
            if not stream.bool(mineral.largeChance): continue
            const minimumY = Math.max(origin.y, mineral.minimumY)
            const maximumY = Math.min(origin.y + 63, mineral.maximumY)
            if minimumY > maximumY: continue
            const center = {x: origin.x + stream.int(8, 56), y: stream.int(minimumY, maximumY + 1), z: origin.z + stream.int(8, 56)}
            const material = materialByKey.get(mineral.key)
            assert material != null else f"Mineral {mineral.key} has no material binding"
            const selected: readonly MineralMaterialBinding = material
            const blockKey = selected.block
            appendLargeBody(writes, origin, stream, center, registry.defaultStateRuntimeIdForKey(blockKey))
        return remember(key, compiledFeaturePlan(key, origin, key, writes))

    def sourceFor(runtimeId: number) -> number?: return sourceByOre.get(runtimeId)

    return {cachedPlanCount, planBuildCount, small, large, sourceFor}

export def generateMinerals(chunk: Chunk, planner: MineralPlanner, blocks: readonly SurvivalBlockPalette, registry: readonly BlockRegistry):
    def replaceable(current: number, target: number, worldX: number, worldY: number, worldZ: number) -> bool:
        const source = planner.sourceFor(target)
        if source == null: return false
        const expected: number = source
        if expected == blocks.stone: return registry.hasTag(current, builtinIdentities.tags.naturalRock)
        return current == expected

    const smallReach = 16
    const smallFirstX = ((chunkMinimumX(chunk) - smallReach) / 16).floor()
    const smallLastX = ((chunkMinimumX(chunk) + chunk.edge - 1 + smallReach) / 16).floor()
    const smallFirstY = ((chunkMinimumY(chunk) - smallReach) / 16).floor()
    const smallLastY = ((chunkMinimumY(chunk) + chunk.edge - 1 + smallReach) / 16).floor()
    const smallFirstZ = ((chunkMinimumZ(chunk) - smallReach) / 16).floor()
    const smallLastZ = ((chunkMinimumZ(chunk) + chunk.edge - 1 + smallReach) / 16).floor()
    const plans: List<readonly CompiledFeaturePlan> = []
    for cellX in range(smallFirstX, smallLastX + 1):
        for cellY in range(smallFirstY, smallLastY + 1):
            for cellZ in range(smallFirstZ, smallLastZ + 1): plans.append(planner.small(cellX, cellY, cellZ))

    const largeReach = 16
    const largeFirstX = ((chunkMinimumX(chunk) - largeReach) / 64).floor()
    const largeLastX = ((chunkMinimumX(chunk) + chunk.edge - 1 + largeReach) / 64).floor()
    const largeFirstY = ((chunkMinimumY(chunk) - largeReach) / 64).floor()
    const largeLastY = ((chunkMinimumY(chunk) + chunk.edge - 1 + largeReach) / 64).floor()
    const largeFirstZ = ((chunkMinimumZ(chunk) - largeReach) / 64).floor()
    const largeLastZ = ((chunkMinimumZ(chunk) + chunk.edge - 1 + largeReach) / 64).floor()
    for cellX in range(largeFirstX, largeLastX + 1):
        for cellY in range(largeFirstY, largeLastY + 1):
            for cellZ in range(largeFirstZ, largeLastZ + 1): plans.append(planner.large(cellX, cellY, cellZ))
    for plan in plans.sorted(by=plan => plan.sortKey): applyCompiledFeaturePlan(chunk, plan, replaceable)
