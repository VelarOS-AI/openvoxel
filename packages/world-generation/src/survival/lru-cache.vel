/// 删除 Map 插入顺序中的最旧项目。
///
/// VelarScript 的 Map 迭代器直接包裹宿主 Map 的 key iterator，取第一个 key 是
/// O(1)；`keys()[0]` 会先复制完整 key 列表，缓存越大，淘汰一次制造的临时对象
/// 越多。各规划器在命中时都会把项目 remove 后重新 set，因此插入顺序就是 LRU
/// 顺序，这个公共动作可被所有缓存安全复用。
export def evictOldest<T>(entries: Map<string, T>):
    for key in entries:
        entries.remove(key)
        break
