    copperOre: defaultBlockStateRuntimeId(builtinIdentities.blocks.copperOre),
    diamondOre: defaultBlockStateRuntimeId(builtinIdentities.blocks.diamondOre),
    dirt: defaultBlockStateRuntimeId(builtinIdentities.blocks.dirt),
    dryBush: defaultBlockStateRuntimeId(builtinIdentities.blocks.dryBush),
    germaniumOre: defaultBlockStateRuntimeId(builtinIdentities.blocks.germaniumOre),
    granite: defaultBlockStateRuntimeId(builtinIdentities.blocks.granite),
    grass: defaultBlockStateRuntimeId(builtinIdentities.blocks.grass),
    gravel: defaultBlockStateRuntimeId(builtinIdentities.blocks.gravel),
    ice: defaultBlockStateRuntimeId(builtinIdentities.blocks.ice),
    ironOre: defaultBlockStateRuntimeId(builtinIdentities.blocks.ironOre),
    limestone: defaultBlockStateRuntimeId(builtinIdentities.blocks.limestone),
    magma: defaultBlockStateRuntimeId(builtinIdentities.blocks.magma),
    mimosaLeaves: defaultBlockStateRuntimeId(builtinIdentities.blocks.mimosaLeaves),
    mimosaLog: defaultBlockStateRuntimeId(builtinIdentities.blocks.mimosaLog),
    oakLeaves: defaultBlockStateRuntimeId(builtinIdentities.blocks.oakLeaves),
    oakLog: defaultBlockStateRuntimeId(builtinIdentities.blocks.oakLog),
    poplarLeaves: defaultBlockStateRuntimeId(builtinIdentities.blocks.poplarLeaves),
    poplarLog: defaultBlockStateRuntimeId(builtinIdentities.blocks.poplarLog),
    purpleFlower: defaultBlockStateRuntimeId(builtinIdentities.blocks.purpleFlower),
    redFlower: defaultBlockStateRuntimeId(builtinIdentities.blocks.redFlower),
    saltpeterOre: defaultBlockStateRuntimeId(builtinIdentities.blocks.saltpeterOre),
    sand: defaultBlockStateRuntimeId(builtinIdentities.blocks.sand),
