import {builtinIdentities, defaultBlockStateRuntimeId} from "@openvoxel/blocks"

/// 生存生成器需要的内建状态集中在这里解析。各阶段只引用语义字段，避免在地形、
/// 洞穴、矿物和植被模块中重复查找身份或散落数字 runtimeId。
export const survivalBlocks = {
    air: defaultBlockStateRuntimeId(builtinIdentities.blocks.air),
    basalt: defaultBlockStateRuntimeId(builtinIdentities.blocks.basalt),
    birchLeaves: defaultBlockStateRuntimeId(builtinIdentities.blocks.birchLeaves),
    birchLog: defaultBlockStateRuntimeId(builtinIdentities.blocks.birchLog),
