import {random} from "velar/random"
import {isNaturalRock} from "@openvoxel/blocks"
import {Chunk, Coordinate3} from "@openvoxel/world"
import {survivalBlocks} from "./block-palette.vel"
import {chunkMinimumX, chunkMinimumY, chunkMinimumZ, generatedBlock, paintGeneratedBlock} from "./chunk-brush.vel"

def paintFluidPocket(chunk: Chunk, center: Coordinate3, radius: number, fluidBlock: number):
    const minimumX = Math.max(chunkMinimumX(chunk), center.x - radius)
    const maximumX = Math.min(chunkMinimumX(chunk) + chunk.edge - 1, center.x + radius)
    const minimumY = Math.max(chunkMinimumY(chunk), center.y - radius)
    const maximumY = Math.min(chunkMinimumY(chunk) + chunk.edge - 1, center.y + radius)
    const minimumZ = Math.max(chunkMinimumZ(chunk), center.z - radius)
    const maximumZ = Math.min(chunkMinimumZ(chunk) + chunk.edge - 1, center.z + radius)
    const radiusSquared = radius * radius
    for x in range(minimumX, maximumX + 1):
        for z in range(minimumZ, maximumZ + 1):
            for y in range(minimumY, maximumY + 1):
                const dx = x - center.x
                const dy = y - center.y
                const dz = z - center.z
                if dx * dx + dy * dy + dz * dz > radiusSquared: continue
                const position = {x, y, z}
                const current = generatedBlock(chunk, position)
                if isNaturalRock(current):
                    paintGeneratedBlock(chunk, position, y <= center.y ? fluidBlock : survivalBlocks.air)

/// 地下流体只负责初始世界生成；流体后续传播由独立执行系统处理。
export def generateFluidPockets(chunk: Chunk, seed: string):
    const firstCellX = ((chunkMinimumX(chunk) - 5) / 16).floor()
    const lastCellX = ((chunkMinimumX(chunk) + chunk.edge - 1 + 5) / 16).floor()
    const firstCellY = ((chunkMinimumY(chunk) - 5) / 16).floor()
    const lastCellY = ((chunkMinimumY(chunk) + chunk.edge - 1 + 5) / 16).floor()
    const firstCellZ = ((chunkMinimumZ(chunk) - 5) / 16).floor()
    const lastCellZ = ((chunkMinimumZ(chunk) + chunk.edge - 1 + 5) / 16).floor()
    const pocketRoot = random(seed).fork("fluid-pockets")
    for cellX in range(firstCellX, lastCellX + 1):
        for cellZ in range(firstCellZ, lastCellZ + 1):
            for cellY in range(firstCellY, lastCellY + 1):
                const water = pocketRoot.fork(f"water:{cellX}:{cellY}:{cellZ}")
                const waterY = cellY * 16 + water.int(0, 16)
                if waterY >= 28 and waterY <= 58 and water.bool(0.035):
                    paintFluidPocket(
                        chunk,
                        {x: cellX * 16 + water.int(0, 16), y: waterY, z: cellZ * 16 + water.int(0, 16)},
                        water.int(2, 5),
                        survivalBlocks.water,
                    )
                const magma = pocketRoot.fork(f"magma:{cellX}:{cellY}:{cellZ}")
                const magmaY = cellY * 16 + magma.int(0, 16)
                if magmaY >= 7 and magmaY <= 30 and magma.bool(0.05):
                    paintFluidPocket(
                        chunk,
                        {x: cellX * 16 + magma.int(0, 16), y: magmaY, z: cellZ * 16 + magma.int(0, 16)},
                        magma.int(2, 5),
                        survivalBlocks.magma,
                    )
