/// Focused baseline for the bounded cave-plan cache. A capacity of one models
/// repeated owner reconstruction; the production capacity demonstrates reuse
/// across adjacent and vertically stacked chunks without changing checksums.

import {monotonic} from "velar/time"
import {baseWorldBlockRegistry, defaultBlockStateRuntimeId} from "@openvoxel/blocks"
import {builtinIdentities} from "@openvoxel/identities"
import {Chunk, ChunkPosition, chunkChecksum, emptyChunk} from "@openvoxel/world"
import {carveCaves, cavePlanner} from "../src/survival/caves.vel"
import {createSurvivalBlockPalette} from "../src/survival/block-palette.vel"
import {baseWorldGeneratorCatalog} from "../src/runtime/builtin-catalog.vel"
import {columnPlanner, createGenerationFields} from "../src/survival/terrain.vel"

const stoneBlock = defaultBlockStateRuntimeId(builtinIdentities.blocks.stone)

type CaveBenchmarkResult:
    averageMs: number
    checksum: number
    chunks: number
    planBuilds: number
    totalMs: number

const seed = "openvoxel-benchmark"

def benchmarkPositions() -> List<ChunkPosition>:
    const positions: List<ChunkPosition> = []
    for y in range(2, 6):
        for x in range(-6, 6):
            for z in range(-2, 2): positions.append({x, y, z})
    return positions

def rockChunk(position: ChunkPosition) -> Chunk: return emptyChunk(position, 16, fill=stoneBlock)

def measure(positions: List<ChunkPosition>, capacity: number) -> CaveBenchmarkResult:
    const profile = baseWorldGeneratorCatalog.generators[0]
    const fields = createGenerationFields(seed, profile)
    const columns = columnPlanner(fields, 16)
    const blocks = createSurvivalBlockPalette(baseWorldBlockRegistry.registry, baseWorldGeneratorCatalog.palettes[0].blocks)
    const planner = cavePlanner(fields, seed, blocks, capacity)
    const started = monotonic()
    let checksumElapsed = 0
    let checksum = 0
    for position in positions:
        const chunk = rockChunk(position)
        carveCaves(chunk, planner, profile, blocks, baseWorldBlockRegistry.registry, columns.columns(position.x, position.z))
        const checksumStarted = monotonic()
        checksum = (checksum ^ chunkChecksum(chunk)) >>> 0
        checksumElapsed += monotonic() - checksumStarted
    const totalMs = monotonic() - started - checksumElapsed
    return {
        averageMs: totalMs / positions.size,
        checksum,
        chunks: positions.size,
        planBuilds: planner.planBuildCount(),
        totalMs,
    }

@main:
    const positions = benchmarkPositions()

    // Warm both paths before reporting so compiler and runtime startup do not
    // favor the second measurement.
    measure(positions, 1)
    measure(positions, 256)

    const replayed = measure(positions, 1)
    const cached = measure(positions, 256)
    assert replayed.checksum == cached.checksum else "Cave plan caching changed generated blocks"
    print(f"caves replayed chunks={replayed.chunks} totalMs={replayed.totalMs.round()} averageMs={replayed.averageMs} planBuilds={replayed.planBuilds} checksum={replayed.checksum}")
    print(f"caves cached chunks={cached.chunks} totalMs={cached.totalMs.round()} averageMs={cached.averageMs} planBuilds={cached.planBuilds} checksum={cached.checksum}")
