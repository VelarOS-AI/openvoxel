import {BlockComponentProfile, BlockDefinition, BlockRenderResources, PackedBlockStateDefinition} from "@openvoxel/blocks"
import {ChunkPosition, Coordinate2, WorldContentIdentity, WorldManifest} from "@openvoxel/world"

/// HTTP 与实时消息共同遵循的当前线上语义代际。
///
/// 路由不是协议包里的字符串常量。HTTP 路由由服务端注解直接声明，并由框架生成
/// OpenAPI；这个包只拥有可以在网络上传输的数据形状和稳定版本事实。
export const protocolVersion = 8
export const clientContractVersion = 8
export const chunkBlockIndexOrder = "x + edge * (z + edge * y)"
export const protocolServiceName = "openvoxel"
export const httpEncoding = "json"
export const realtimeEncoding = "messagepack"
export const chunkPaletteEntryEncoding = "uint32-runtime-id"
export const chunkLocalIndexEncoding = "uint16-list"

/// 客户端按这些稳定身份从 OpenAPI 查找能力；URL、HTTP 方法和参数仍只由服务端
/// 路由注解声明。这里集中的是协议语义名，不复制任何传输地址。
export const apiOperationNames = {
    health: "health",
    clientContract: "clientContract",
    createWorld: "createWorld",
    findWorld: "findWorld",
    worldBootstrap: "worldBootstrap",
    worldContent: "worldContent",
    terrainChunks: "terrainChunks",
    generationSample: "generationSample",
    worldRealtime: "worldRealtime",
}

export type ClientTransportLimits:
    requestBodyBytes: number
    realtimeMessageBytes: number

export type ClientHttpContract:
    encoding: string
    descriptionFormat: string

export type ClientRealtimeContract:
    encoding: string
    commands: readonly List<string>
    events: readonly List<string>

export type ClientChunkContract:
    paletteEntries: string
    localIndices: string
    indexOrder: string
    maximumBatchSize: number

/// API 根资源发布能力和编码，不再复制一份 HTTP 路由表。
///
/// HTTP 的完整权威描述来自服务端生成的 OpenAPI。这样修改注解时，客户端看到的
/// 路径、必选参数和类型会一起变化，不存在“代码已改、协议字符串忘了改”的漂移。
export type ClientContractResponse:
    service: string
    contractVersion: number
    protocolVersion: number
    capabilities: readonly List<string>
    errorCodes: readonly List<string>
    http: ClientHttpContract
    realtime: ClientRealtimeContract
    chunks: ClientChunkContract
    limits: ClientTransportLimits

/// 创建世界的 HTTP 输入。协议层只描述线上可传输字段；默认生成器、内容集合和
/// 清单装配仍由 WorldRuntime 的创建用例决定。
export type CreateWorldRequest:
    readonly id: string
    readonly name: string
    readonly seed: string
    readonly generator: string?
    readonly contentPacks: readonly List<string>?

export type TerrainChunkBatchRequest:
    readonly positions: readonly List<readonly ChunkPosition>

export type TerrainChunkResponse:
    readonly position: readonly ChunkPosition
    readonly edge: number
    readonly palette: readonly List<number>
    readonly indices: readonly List<number>

export type TerrainChunkBatchResponse:
    readonly worldId: string
    readonly chunks: readonly List<readonly TerrainChunkResponse>

/// 地形采样的线上数据形状。
///
/// 这里显式列出可公开字段，避免协议包依赖完整生成器实现。服务端 presentation
/// 层负责把当前 TerrainSample 投影成这份稳定的传输契约。
export type GenerationSampleResponse:
    readonly worldId: string
    readonly position: readonly Coordinate2
    readonly surfaceY: number
    readonly slope: number
    readonly continentalness: number
    readonly erosion: number
    readonly ridge: number
    readonly riverStrength: number
    readonly temperature: number
    readonly humidity: number
    readonly forestDensity: number
    readonly terrainType: string
    readonly biome: string

export type WorldContentResponse:
    readonly content: readonly WorldContentIdentity
    readonly schemaVersion: number
    readonly catalogVersion: string
    readonly stateMapHash: string
    readonly generator: string
    readonly generatorHash: string
    readonly generatorCatalogHash: string
    readonly minimumWorldY: number
    readonly maximumWorldY: number
    readonly seaLevel: number
    readonly resources: readonly BlockRenderResources
    readonly blocks: readonly List<readonly BlockDefinition>
    readonly componentProfiles: readonly List<readonly BlockComponentProfile>
    readonly states: readonly List<readonly PackedBlockStateDefinition>

/// 世界启动数据只携带需要校验的事实，不发布另一套手写路由模板。
export type WorldBootstrapResponse extends WorldManifest:
    readonly clientContractVersion: number
    readonly protocolVersion: number
    readonly contentStateMapHash: string
    readonly minimumWorldY: number
    readonly maximumWorldY: number
    readonly seaLevel: number
    readonly maximumChunkBatchSize: number

/// 客户端可以稳定分支处理的公共错误码。
export const protocolErrorCodes: readonly List<string> = [
    "world.not_found",
    "world.already_exists",
    "block.invalid_state",
    "block.unknown_state",
    "block.reserved_state",
    "block.unknown_world_state",
    "request.invalid",
    "request.invalid.request",
    "request.invalid.json",
    "request.request.too.large",
    "request.unsupported.media.type",
    "request.body_too_large",
    "route.not_found",
    "route.method_not_allowed",
    "security.origin_not_allowed",
    "realtime.unsupported_operation",
    "realtime.text_unsupported",
    "server.internal",
]

export const clientCapabilities: readonly List<string> = [
    "openapi-3.1",
    "world-content-etag",
    "block-component-profiles",
    "world-block-registry",
    "world-generator-hash",
    "terrain-chunk-batches",
    "world-scoped-realtime",
    "atomic-block-edit-batches",
    "chunk-delta-sync",
    "realtime-sequence-cursor",
]

export const realtimeCommandNames: readonly List<string> = ["chunks.sync", "blocks.apply"]
export const realtimeEventNames: readonly List<string> = ["world.ready", "chunks.synced", "blocks.applied", "blocks.changed", "error"]
