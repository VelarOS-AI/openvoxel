import {expect} from "velar/test"
import {GenerationSampleResponse, TerrainChunkBatchRequest, apiOperationNames, chunkBlockIndexOrder, chunkLocalIndexEncoding, chunkPaletteEntryEncoding, clientCapabilities, clientContractVersion, httpEncoding, protocolErrorCodes, protocolServiceName, protocolVersion, realtimeCommandNames, realtimeEncoding, realtimeEventNames} from "../src/http.vel"
import {ApplyBlockEditsCommand, RealtimeCommandEnvelope, SocketErrorEvent, SyncChunksCommand} from "../src/realtime.vel"

test "protocol package owns wire facts without duplicating route strings":
    expect(protocolServiceName).toBe("openvoxel")
    expect(protocolVersion).toBe(8)
    expect(clientContractVersion).toBe(8)
    expect(httpEncoding).toBe("json")
    expect(realtimeEncoding).toBe("messagepack")
    expect(chunkPaletteEntryEncoding).toBe("uint32-runtime-id")
    expect(chunkLocalIndexEncoding).toBe("uint16-list")
    expect(chunkBlockIndexOrder).toBe("x + edge * (z + edge * y)")
    expect(realtimeCommandNames).toEqual(["chunks.sync", "blocks.apply"])
    expect(realtimeEventNames).toEqual(["world.ready", "chunks.synced", "blocks.applied", "blocks.changed", "error"])
    expect(clientCapabilities).toContain("openapi-3.1")
    expect(clientCapabilities).toContain("realtime-sequence-cursor")
    expect(protocolErrorCodes).toContain("request.invalid")
    expect(Set([
        apiOperationNames.health,
        apiOperationNames.clientContract,
        apiOperationNames.createWorld,
        apiOperationNames.findWorld,
        apiOperationNames.worldBootstrap,
        apiOperationNames.worldContent,
        apiOperationNames.terrainChunks,
        apiOperationNames.generationSample,
        apiOperationNames.worldRealtime,
    ]).size).toBe(9)

test "cold terrain and realtime commands keep world identity outside their bodies":
    const batch = TerrainChunkBatchRequest.parse({positions: [{x: 1, y: 2, z: 3}]})
    expect(batch.positions.size).toBe(1)

    const sync = SyncChunksCommand.parse({
        operation: "chunks.sync",
        requestId: "sync-1",
        positions: [{x: 0, y: 1, z: 0}],
    })
    expect(RealtimeCommandEnvelope.is(sync)).toBe(true)
    expect(sync.positions[0].y).toBe(1)

    const edit = ApplyBlockEditsCommand.parse({
        operation: "blocks.apply",
        requestId: "edit-1",
        edits: [{position: {x: 4, y: 5, z: 6}, blockStateRuntimeId: 147}],
    })
    expect(RealtimeCommandEnvelope.is(edit)).toBe(true)
    expect(edit.edits[0].position.z).toBe(6)

    const error = SocketErrorEvent.parse({
        event: "error",
        requestId: null,
        code: "request.invalid",
        message: "invalid",
    })
    expect(error.requestId).toBe(null)

test "generation sample response is a standalone wire contract":
    const response = GenerationSampleResponse.parse({
        worldId: "protocol",
        position: {x: 12, z: -8},
        surfaceY: 70,
        slope: 0.25,
        continentalness: 0.5,
        erosion: 0.4,
        ridge: 0.7,
        riverStrength: 0.1,
        temperature: 8,
        humidity: 9,
        forestDensity: 0.6,
        terrainType: "openvoxel:terrain/plains",
        biome: "openvoxel:biome/forest",
    })
    expect(response.worldId).toBe("protocol")
    expect(response.position.z).toBe(-8)
    expect(response.biome).toBe("openvoxel:biome/forest")
