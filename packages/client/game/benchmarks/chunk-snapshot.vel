import {clientWorldState} from "@openvoxel/client"
import {snapshotChunkNeighborhood} from "@openvoxel/renderer"
import {ChunkPosition} from "@openvoxel/world"
import {uint16Buffer} from "velar/binary"
import {monotonic} from "velar/time"

@main:
    const center: ChunkPosition = {x: 0, y: 0, z: 0}
    const positions: List<ChunkPosition> = [center, {x: -1, y: 0, z: 0}, {x: 1, y: 0, z: 0},
        {x: 0, y: -1, z: 0}, {x: 0, y: 1, z: 0}, {x: 0, y: 0, z: -1}, {x: 0, y: 0, z: 1}]
    for scenario in ["air", "mixed", "unloaded"]:
        const state = clientWorldState("snapshot-benchmark", 16)
        for position in positions:
            if scenario == "unloaded" and (position.x != 0 or position.y != 0 or position.z != 0): continue
            const indices = uint16Buffer(4096)
            if scenario != "air":
                for index in range(4096): indices[index] = index % 3
            state.rememberTerrain({worldId: "snapshot-benchmark", chunks: [{position, edge: 16, palette: [0, 1, 2], indices}]})
        const source = state.chunk(center)!
        for _warmup in range(20): snapshotChunkNeighborhood(source, state.chunk, sealUnloaded=true)
        const times: List<number> = []
        for _run in range(5):
            const started = monotonic()
            for _sample in range(200):
                const snapshot = snapshotChunkNeighborhood(source, state.chunk, sealUnloaded=true)
                assert snapshot.size == 5832 else "Snapshot volume changed"
            times.append(monotonic() - started)
        print(Json.stringify({scenario, snapshots: 200, runs: 5, medianMs: times.sorted()[2]}))
