{
  "name": "@openvoxel/game",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "imports": {
    "#openvoxel/game/preferences": "./src/settings/preferences.mjs",
    "#openvoxel/game/babylon-surface": "./src/backends/babylon/native/surface.mjs",
    "#openvoxel/game/web-audio": "./src/host/web/audio.mjs",
    "#openvoxel/game/web-navigation": "./src/host/web/navigation.mjs",
    "#openvoxel/game/portal-visibility": "./src/runtime/native/portal-visibility.mjs"
  },
  "files": [
    "data",
    "tools",
    "src"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./meshing-worker": "./dist/meshing-worker.js",
    "./lighting-worker": "./dist/lighting-worker.js",
    "./creative-palette-data": "./data/creative-palette.json",
    "./creative-preview-assets": "./tools/creative-preview-assets.mjs",
    "./webgpu-runtime-assets": "./tools/webgpu-runtime-assets.mjs",
    "./settings": "./dist/settings/game-settings.js",
    "./block-labels-data": "./data/block-labels.json"
  },
  "velar": {
    "entry": "src/index.vel",
    "resources": {
      "./creative-palette-data": {
        "path": "data/creative-palette.json",
        "type": "json"
      },
      "./block-labels-data": {
        "path": "data/block-labels.json",
        "type": "json"
      }
    },
    "entries": {
      "./meshing-worker": "src/meshing-worker.vel",
      "./lighting-worker": "src/lighting-worker.vel",
      "./settings": "src/settings/game-settings.vel"
    },
    "targets": [
      "web",
      "desktop"
    ],
    "requires": {
      "capabilities": [
        "web"
      ]
    }
  },
  "scripts": {
    "check": "node ../../../tools/run-validation.mjs -- velar check",
    "format": "velar format",
    "format:check": "node ../../../tools/run-validation.mjs -- velar format --check",
    "test": "node ../../../tools/run-validation.mjs --shell \"velar test && node --test --test-concurrency=1 tests/*.test.mjs\"",
    "test:gpu": "node ../../../tools/run-validation.mjs --shell \"velar build && node tests/gpu-render-probe.mjs\"",
    "build": "node ../../../tools/run-validation.mjs -- velar build",
    "test:gpu:built": "node ../../../tools/run-validation.mjs -- node tests/gpu-render-probe.mjs",
    "benchmark:translucency": "node ../../../tools/run-validation.mjs -- node tests/translucent-sort-benchmark.mjs",
    "benchmark:visibility": "node ../../../tools/run-validation.mjs -- velar run benchmarks/portal-visibility.vel",
    "benchmark:demand": "node ../../../tools/run-validation.mjs -- velar run benchmarks/mesh-demand.vel",
    "benchmark:priority": "node ../../../tools/run-validation.mjs -- velar run benchmarks/mesh-priority.vel",
    "benchmark:defines": "node ../../../tools/run-validation.mjs -- node tests/material-defines-benchmark.mjs",
    "benchmark:snapshot": "node ../../../tools/run-validation.mjs -- velar run benchmarks/chunk-snapshot.vel"
  },
  "dependencies": {
    "@babylonjs/core": "9.23.0",
    "@openvoxel/client": "0.2.0",
    "@openvoxel/renderer": "0.2.0",
    "@openvoxel/world": "0.2.0"
  },
  "devDependencies": {
    "@openvoxel/blocks": "0.2.0",
    "@openvoxel/content": "0.2.0",
    "@openvoxel/world-generation": "0.2.0",
    "@velarscript/cli": "0.34.2",
    "@velarscript/web": "0.34.2",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "sharp": "0.35.4",
    "yaml": "2.9.0"
  }
}
