import {expect} from "velar/test"
import {meshCache} from "../../src/runtime/mesh-cache.vel"

test "back-facing mesh cache independently bounds bytes and draw objects":
    const cache = meshCache(100, 4)
    const a = {position: {x: 0, y: 0, z: 0}, bytes: 40, meshes: 2}
    const b = {position: {x: 1, y: 0, z: 0}, bytes: 40, meshes: 2}
    const c = {position: {x: 2, y: 0, z: 0}, bytes: 30, meshes: 1}
    expect(cache.retain(a)).toEqual([])
    expect(cache.retain(b)).toEqual([])
    expect(cache.retain(c)).toEqual([a.position])
    expect(cache.has("0:0:0")).toBe(false)
    cache.remove("1:0:0")
    expect(cache.retain(a)).toEqual([])
    expect(cache.retain({position: b.position, bytes: 1, meshes: 3})).toEqual([c.position, a.position])
    cache.clear()
    expect(cache.has("1:0:0")).toBe(false)

test "mesh replacement updates the budget and oversized entries cannot displace active world data":
    const cache = meshCache(100, 4)
    const position = {x: 0, y: 0, z: 0}
    expect(cache.retain({position, bytes: 20, meshes: 1})).toEqual([])
    expect(cache.retain({position, bytes: 90, meshes: 3})).toEqual([])
    expect(cache.retain({position: {x: 1, y: 0, z: 0}, bytes: 20, meshes: 1})).toEqual([position])
    expect(cache.retain({position, bytes: 120, meshes: 1})).toEqual([{x: 1, y: 0, z: 0}, position])
    expect(cache.has("0:0:0")).toBe(false)
