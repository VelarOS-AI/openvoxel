import {ChunkMesh, ClientAnimationResource, ClientMaterialResource, ClientRenderCatalog, ClientResourceEnvironment, ClientTextureBank, ClientTextureResource, WorldLightingUpdate} from "@openvoxel/renderer"
import {WorldClimateDefinition, WorldClimateSample, WorldEnvironmentSample, worldClimateAt} from "@openvoxel/world"
import {WorldMovementFlightState, worldMovementFlightState, stepWorldMovementFlight} from "../controls/creative-flight.vel"
import {WorldMovementCollisionQuery, WorldMovementWalkState, stepWorldMovementWalk, worldMovementEyeHeight, worldMovementPlayerHeight, worldMovementWalkState} from "../controls/survival-walk.vel"
import {WorldCreativeAction, WorldMovementFlightStep, WorldMovementMode, WorldMovementWalkStep, WorldNavigationFactory, WorldNavigationMode, WorldNavigationPosition, WorldNavigationStats, createWorldNavigation} from "../controls/world-navigation.vel"
import {WorldGraphicsEnvironmentFrame, worldGraphicsEnvironmentFrame} from "./environment-frame.vel"

export {WorldMovementMode, WorldNavigationMode, WorldNavigationStats} from "../controls/world-navigation.vel"

export readonly type WorldGraphicsEnvironmentStats:
    environmentTextureReady: bool
    environmentTextureUpdates: number
    precipitation: string
    precipitationIntensity: number
    precipitationSeverity: string
    cloudiness: number
    activeRainParticles: number
    activeSnowParticles: number
    activeRainSplashes: number
    activeSnowSplashes: number
    /// 成功创建的真实碰地粒子累计数，生命周期结束前单调递增。
    rainSplashContacts: number
    snowSplashContacts: number
    rainSplashGrounded: bool
    rainSplashGroundY: number?
    shadowCasters: number
    activeShadowCasters: number
    sunVisible: bool
    moonVisible: bool
    starVisibility: number
    lightningSequence: number?

export readonly type WorldGraphicsStats:
    chunks: number
    meshes: number
    quads: number
    uploadQueuedChunks: number
    translucentSortQueuedMeshes: number
    navigationMode: WorldNavigationMode
    movementMode: WorldMovementMode
    viewX: number
    viewY: number
    viewZ: number
    viewChunkX: number
    viewChunkY: number
    viewChunkZ: number
    forwardX: number
    forwardY: number
    forwardZ: number
    pointerLocked: bool

/// OpenVoxel 游戏层的稳定图形表面。Chunk 网格和资源目录仍由 Renderer 拥有；
/// 具体 GPU 后端只实现这组游戏所需操作。
export type WorldGraphics:
    setLighting: (update: WorldLightingUpdate) -> null
    setChunkMesh: (mesh: ChunkMesh) -> null
    enqueueChunkMesh: (mesh: ChunkMesh, mayCommit: () -> bool) -> Promise<bool>
    removeChunk: (x: number, y: number, z: number) -> null
    stats: () -> WorldGraphicsStats
    environmentStats: () -> WorldGraphicsEnvironmentStats
    setEnvironment: (sample: WorldEnvironmentSample) -> null
    close: () -> null

export readonly type WorldGraphicsRequest:
    canvas: CanvasElement
    minimapCanvas: CanvasElement?
    catalog: readonly ClientRenderCatalog
    edge: number
    targetX: number
    targetY: number
    targetZ: number
    horizontalChunkRadius: number
    viewChanged: (chunkX: number, chunkY: number, chunkZ: number, forwardX: number, forwardY: number, forwardZ: number) -> null
    initialEnvironment: WorldEnvironmentSample
    navigationMode: WorldNavigationMode
    movementMode: WorldMovementMode
    collisionAt: WorldMovementCollisionQuery
    aimChanged: (origin: WorldNavigationPosition, forward: WorldNavigationPosition) -> null
    creativeAction: (action: WorldCreativeAction, origin: WorldNavigationPosition, forward: WorldNavigationPosition) -> null
    creativeSlot: (slot: number) -> null
    walkSound: (position: WorldNavigationPosition, crouching: bool, landed: bool) -> null
    minimumWorldY: number
    maximumWorldY: number
    worldSeed: string
    worldClimate: WorldClimateDefinition

/// 记录型测试和未来后端替换都注入这一游戏专用工厂，不复制 Renderer 的资源描述。
export type WorldGraphicsFactory = (request: WorldGraphicsRequest) -> Promise<WorldGraphics>

readonly type NativeWorldGraphicsOptions:
    minimapCanvas: CanvasElement?
    textureBanks: readonly List<ClientTextureBank>
    environmentResources: ClientResourceEnvironment
    environmentFrame: WorldGraphicsEnvironmentFrame
    climateAt: (worldMilliseconds: number, x: number, y: number, z: number) -> WorldClimateSample
    edge: number
    materials: readonly List<ClientMaterialResource>
    textures: readonly List<ClientTextureResource>
    animations: readonly List<ClientAnimationResource>
    targetX: number
    targetY: number
    targetZ: number
    horizontalChunkRadius: number
    navigationMode: WorldNavigationMode
    movementMode: WorldMovementMode
    collisionAt: WorldMovementCollisionQuery
    aimChanged: (origin: WorldNavigationPosition, forward: WorldNavigationPosition) -> null
    creativeAction: (action: WorldCreativeAction, origin: WorldNavigationPosition, forward: WorldNavigationPosition) -> null
    creativeSlot: (slot: number) -> null
    walkSound: (position: WorldNavigationPosition, crouching: bool, landed: bool) -> null
    survivalEyeHeight: number
    survivalPlayerHeight: number
    minimumWorldY: number
    maximumWorldY: number
    viewChanged: (chunkX: number, chunkY: number, chunkZ: number, forwardX: number, forwardY: number, forwardZ: number) -> null

readonly type NativeWorldGraphicsDependencies:
    createNavigation: WorldNavigationFactory
    createFlightState: (x: number, y: number, z: number) -> WorldMovementFlightState
    createWalkState: (x: number, y: number, z: number) -> WorldMovementWalkState
    stepFlight: WorldMovementFlightStep
    stepWalk: WorldMovementWalkStep

type NativeWorldGraphics:
    setLighting: (update: WorldLightingUpdate) -> null
    setChunkMesh: (mesh: ChunkMesh) -> null
    enqueueChunkMesh: (mesh: ChunkMesh, mayCommit: () -> bool) -> Promise<bool>
    removeChunk: (x: number, y: number, z: number) -> null
    stats: () -> WorldGraphicsStats
    environmentStats: () -> WorldGraphicsEnvironmentStats
    setEnvironmentFrame: (frame: WorldGraphicsEnvironmentFrame) -> null
    release: () -> null

extern module "#openvoxel/game/babylon-surface":
    export async def createSurfaceAdapter(
        canvas: CanvasElement,
        options: NativeWorldGraphicsOptions,
        dependencies: NativeWorldGraphicsDependencies,
    ) -> NativeWorldGraphics

import js {createSurfaceAdapter} from "#openvoxel/game/babylon-surface"

async def openDefaultWorldGraphics(request: WorldGraphicsRequest) -> WorldGraphics:
    const catalog = request.catalog
    const native = await createSurfaceAdapter(request.canvas, {
        minimapCanvas: request.minimapCanvas,
        textureBanks: catalog.textureBanks,
        environmentResources: catalog.environment,
        environmentFrame: worldGraphicsEnvironmentFrame(request.initialEnvironment),
        climateAt: (worldMilliseconds, x, y, z) => worldClimateAt(request.worldSeed, worldMilliseconds, {x, y, z}, request.worldClimate),
        edge: request.edge,
        materials: catalog.materials,
        textures: catalog.textures,
        animations: catalog.animations,
        targetX: request.targetX,
        targetY: request.targetY,
        targetZ: request.targetZ,
        horizontalChunkRadius: request.horizontalChunkRadius,
        navigationMode: request.navigationMode,
        movementMode: request.movementMode,
        collisionAt: request.collisionAt,
        aimChanged: request.aimChanged,
        creativeAction: request.creativeAction,
        creativeSlot: request.creativeSlot,
        walkSound: request.walkSound,
        survivalEyeHeight: worldMovementEyeHeight,
        survivalPlayerHeight: worldMovementPlayerHeight,
        minimumWorldY: request.minimumWorldY,
        maximumWorldY: request.maximumWorldY,
        viewChanged: request.viewChanged,
    }, {
        createNavigation: createWorldNavigation,
        createFlightState: worldMovementFlightState,
        createWalkState: worldMovementWalkState,
        stepFlight: stepWorldMovementFlight,
        stepWalk: stepWorldMovementWalk,
    })

    def setEnvironment(sample: WorldEnvironmentSample):
        native.setEnvironmentFrame(worldGraphicsEnvironmentFrame(sample))

    return {
        setLighting: update => native.setLighting(update),
        setChunkMesh: mesh => native.setChunkMesh(mesh),
        enqueueChunkMesh: (mesh, mayCommit) => native.enqueueChunkMesh(mesh, mayCommit),
        removeChunk: (x, y, z) => native.removeChunk(x, y, z),
        stats: () => native.stats(),
        environmentStats: () => native.environmentStats(),
        setEnvironment,
        close: () => native.release(),
    }

export async def openWorldGraphicsWithBackend(
    request: WorldGraphicsRequest,
    factory: WorldGraphicsFactory,
) -> WorldGraphics: return await factory(request)

export async def openWorldGraphics(request: WorldGraphicsRequest) -> WorldGraphics:
    return await openWorldGraphicsWithBackend(request, openDefaultWorldGraphics)
