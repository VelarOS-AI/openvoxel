import {ClientWorldChange, ClientWorldChangeKind, ClientWorldChangeSubscription, ClientWorldSession} from "@openvoxel/client"
import {ClientBlockCollisionBox, loadBuiltinClientResourcePack, createClientRenderCatalog} from "@openvoxel/renderer"
import {ChunkPosition, WorldGameMode, WorldManifest, chunkCoordinate, chunkKey, locateBlock} from "@openvoxel/world"
import {Cancellation} from "velar/task"
import {WorldMovementMode, WorldNavigationMode} from "../controls/world-navigation.vel"
import {WorldGraphics, openWorldGraphics} from "../graphics/world-graphics.vel"
import {ChunkMeshing, chunkMeshing} from "./chunk-meshing.vel"
import {chunkMeshWorker} from "./chunk-mesh-worker.vel"
import {ChunkStreamer, chunkStreamer} from "./chunk-streamer.vel"
import {EnvironmentSync, environmentSync} from "./environment-sync.vel"
import {WorldGameOwner, closeWorldGameOwners} from "./ownership.vel"
import {ChunkWindowView, environmentSamplePositionForChunk, horizontalRenderChunkRadius} from "./render-window.vel"

export readonly type WorldGameStats:
    chunks: number
    meshes: number
    quads: number
    residentChunks: number
    terrainPendingChunks: number
    meshQueuedChunks: number
    meshActiveChunks: number
    uploadQueuedChunks: number
    translucentSortQueuedMeshes: number
    pending: number
    startupPending: number
    ready: bool
    navigationMode: WorldNavigationMode
    movementMode: WorldMovementMode
    viewX: number
    viewY: number
    viewZ: number
    viewChunkX: number
    viewChunkY: number
    viewChunkZ: number
    forwardX: number
    forwardY: number
    forwardZ: number
    pointerLocked: bool

export type WorldGameRuntime = WorldGameOwner

const unloadedCollisionBoxes: readonly List<ClientBlockCollisionBox> = [{
    minimumX: 0, minimumY: 0, minimumZ: 0,
    maximumX: 1, maximumY: 1, maximumZ: 1,
}]

/// 游戏运行时组合根连接会话、构网、流送、环境与图形表面的所有权。
/// 各工作队列独立收敛，碰撞 readiness 则只接受已经完成冷热同步的 Chunk。
export async def openWorldGameRuntime(
    canvas: CanvasElement,
    session: readonly ClientWorldSession,
    manifest: WorldManifest,
    changed: (stats: WorldGameStats) -> null,
    failed: (message: string) -> null,
    minimapCanvas: CanvasElement? = null,
) -> WorldGameRuntime:
    const resources = await loadBuiltinClientResourcePack()
    const catalog = createClientRenderCatalog(session.content, resources)
    const startupPositions = session.state.trackedPositions()
    assert startupPositions.size > 0 else "World renderer requires resident startup Chunks"
    const collisionReady = Set(startupPositions.map(position => chunkKey(position)))
    let view: ChunkWindowView = {
        center: locateBlock(manifest.spawn, manifest.chunkEdge).chunk,
        forwardX: 0, forwardY: 0, forwardZ: -1,
        minimap: minimapCanvas != null,
    }
    let graphics: WorldGraphics? = null
    let meshing: ChunkMeshing? = null
    let streaming: ChunkStreamer? = null
    let environment: EnvironmentSync? = null
    let subscription: ClientWorldChangeSubscription? = null
    let closed = false
    let closing: Promise<null>? = null

    def activeGraphics() -> WorldGraphics:
        const current = graphics
        assert current != null and not closed else "World graphics are not ready"
        return current

    def publishStats():
        const currentGraphics = graphics
        const currentMeshing = meshing
        if closed or currentGraphics == null or currentMeshing == null: return
        const mesh = currentMeshing.stats()
        const loading = streaming?.pending() ?? 0
        changed(WorldGameStats.from(currentGraphics.stats(), {
            pending: mesh.active + mesh.queued + loading,
            residentChunks: mesh.resident,
            terrainPendingChunks: loading,
            meshQueuedChunks: mesh.queued,
            meshActiveChunks: mesh.active,
            startupPending: mesh.startupPending,
            ready: mesh.startupPending == 0,
        }))

    def collisionAt(x: number, y: number, z: number) -> readonly List<ClientBlockCollisionBox>:
        if y < session.content.minimumWorldY or y > session.content.maximumWorldY: return unloadedCollisionBoxes
        const position = {x, y, z}
        if chunkKey(locateBlock(position, manifest.chunkEdge).chunk) not in collisionReady:
            return unloadedCollisionBoxes
        const runtimeId = session.state.block(position)
        if runtimeId == null: return unloadedCollisionBoxes
        return catalog.requireState(runtimeId).collisionBoxes

    def invalidate(event: ClientWorldChange):
        if closed: return
        if event.kind == ClientWorldChangeKind.synchronizationStarted or event.kind == ClientWorldChangeKind.terrainUnloaded:
            for position in event.positions: collisionReady.remove(chunkKey(position))
        if event.kind == ClientWorldChangeKind.chunksSynchronized:
            for position in event.positions: collisionReady.add(chunkKey(position))
        meshing?.invalidate(event)
        if event.kind == ClientWorldChangeKind.synchronizationStarted: publishStats()

    def viewChanged(x: number, y: number, z: number, forwardX: number, forwardY: number, forwardZ: number):
        if closed: return
        const centerChanged = view.center.x != x or view.center.y != y or view.center.z != z
        view = {center: {x, y, z}, forwardX, forwardY, forwardZ, minimap: minimapCanvas != null}
        if centerChanged: environment?.sampleAt(environmentSamplePositionForChunk(view.center, manifest.chunkEdge))
        streaming?.request(view)
        meshing?.reconcile(true)

    /// 正常退出和任意初始化失败共用关闭顺序。先封住回调并关闭图形表面，使
    /// 等待 GPU 提交的任务结束。各所有者先同步封口，再等待所有后台工作回收。
    async def shutdown():
        closed = true
        subscription?.close()
        subscription = null
        const ownedGraphics = graphics
        graphics = null
        const owners: List<WorldGameOwner?> = [environment, streaming, meshing]
        const stopped = owners.map(owner => closeWorldGameOwners([owner]))
        try:
            if ownedGraphics != null: ownedGraphics.close()
        finally: await Promise.all(stopped)
        collisionReady.clear()

    def close() -> Promise<null>:
        if closing == null: closing = shutdown()
        return closing!

    async def loadStreamedChunks(positions: readonly List<readonly ChunkPosition>, cancellation: Cancellation):
        await session.loadChunks(positions, cancellation)
        for position in positions: collisionReady.add(chunkKey(position))

    try:
        meshing = chunkMeshing(
            session.state, manifest.chunkEdge, startupPositions,
            chunkMeshWorker(catalog.states, session.state, manifest.chunkEdge),
            {
                enqueueChunkMesh: mesh => activeGraphics().enqueueChunkMesh(mesh),
                removeChunk: (x, y, z) => activeGraphics().removeChunk(x, y, z),
            },
            () => view,
            publishStats, failed,
            () => streaming?.resume(),
        )
        streaming = chunkStreamer(
            {
                trackedPositions: () => session.state.trackedPositions(),
                load: loadStreamedChunks,
                unload: positions => session.unloadChunks(positions),
            },
            chunkCoordinate(session.content.minimumWorldY, manifest.chunkEdge),
            chunkCoordinate(session.content.maximumWorldY, manifest.chunkEdge),
            () => meshing?.stats()?.startupPending == 0,
            publishStats, failed,
        )
        graphics = await openWorldGraphics({
            canvas,
            minimapCanvas,
            catalog,
            edge: manifest.chunkEdge,
            targetX: manifest.spawn.x,
            targetY: manifest.spawn.y,
            targetZ: manifest.spawn.z,
            horizontalChunkRadius: horizontalRenderChunkRadius,
            viewChanged,
            initialEnvironment: session.environment(),
            navigationMode: WorldNavigationMode.firstPerson,
            movementMode: manifest.mode == WorldGameMode.creative
                ? WorldMovementMode.creativeFlight
                : WorldMovementMode.survivalWalk,
            collisionAt,
            minimumWorldY: session.content.minimumWorldY,
            maximumWorldY: session.content.maximumWorldY,
            worldSeed: manifest.seed,
            worldClimate: manifest.climate,
        })
        await meshing.initialize()
        subscription = session.subscribeChanges(invalidate)
        meshing.start()
        const initialView = activeGraphics().stats()
        viewChanged(initialView.viewChunkX, initialView.viewChunkY, initialView.viewChunkZ, initialView.forwardX, initialView.forwardY, initialView.forwardZ)
        environment = environmentSync(
            {environment: position => session.environment(position), refreshEcology: session.refreshEcology},
            environmentSamplePositionForChunk(view.center, manifest.chunkEdge),
            sample => activeGraphics().setEnvironment(sample), failed,
        )
        publishStats()
    catch error:
        try: await close()
        finally: throw error

    return {close}
