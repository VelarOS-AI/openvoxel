import {ChunkPosition} from "@openvoxel/world"
import {Cancellation, Task, task} from "velar/task"
import {chunkRetirement} from "./chunk-retirement.vel"
import {ChunkWindowView, batchChunkWindowTransition, chunkRetainsResidency, planChunkWindow, shouldRefreshChunkWindow, streamedChunkPositions} from "./render-window.vel"
import {commitStreamBatch} from "./stream-commit.vel"

export type ChunkStreamSource:
    trackedPositions: () -> readonly List<readonly ChunkPosition>
    load: (positions: readonly List<readonly ChunkPosition>, cancellation: Cancellation) -> Promise<null>
    unload: (positions: readonly List<readonly ChunkPosition>) -> null

export type ChunkStreamer:
    request: (view: ChunkWindowView) -> null
    resume: () -> null
    pending: () -> number
    close: () -> Promise<null>

readonly type RequestedChunkWindow:
    view: ChunkWindowView
    version: number

/// 一个流送所有者只保留最新目标。正在提交的有界批次完成 load/unload 配对后
/// 才切到新目标；回收计划经最新视窗复核和有界延迟后执行。
export def chunkStreamer(
    source: readonly ChunkStreamSource,
    minimumChunkY: number,
    maximumChunkY: number,
    ready: () -> bool,
    changed: () -> null,
    failed: (message: string) -> null,
    batchSize: number = 4,
) -> ChunkStreamer:
    let requested: RequestedChunkWindow? = null
    let previousView: ChunkWindowView? = null
    let version = 0
    let loading = 0
    let owner: Task<null>? = null
    let closed = false
    let closing: Promise<null>? = null
    // 每次实际回收复核最新视窗，不能执行已经被转身/回退取代的批次卸载计划。
    const retirement = chunkRetirement(
        (_key, position) => previousView != null and not chunkRetainsResidency(position, previousView),
        source.unload,
        64,
    )

    def unload(positions: readonly List<readonly ChunkPosition>):
        if closed: source.unload(positions)
        else: retirement.defer(positions)

    async def stream(request: RequestedChunkWindow, cancellation: Cancellation):
        const tracked = source.trackedPositions()
        const desired = streamedChunkPositions(request.view, minimumChunkY, maximumChunkY, tracked)
        const plan = planChunkWindow(desired, tracked)
        const transition = batchChunkWindowTransition(plan, batchSize)
        loading = plan.missing.size
        changed()
        try:
            if transition.surplus.size > 0: unload(transition.surplus)
            let loaded = 0
            for batch in transition.batches:
                await cancellation.checkpoint()
                const current = await commitStreamBatch(
                    batch,
                    positions => source.load(positions, cancellation),
                    unload,
                    () => not closed and version == request.version,
                )
                loaded += batch.load.size
                if not current: return
                loading = plan.missing.size - loaded
                changed()
            await cancellation.checkpoint()
        finally:
            if version == request.version:
                loading = 0
                if not closed: changed()

    async def pump(cancellation: Cancellation):
        try:
            while not closed and ready():
                await cancellation.checkpoint()
                const next = requested
                if next == null: return
                requested = null
                try: await stream(next, cancellation)
                catch error:
                    if not closed and version == next.version: failed(error.message)
        finally:
            owner = null
            if not closed: resume()

    def resume():
        if closed or not ready() or owner != null or requested == null: return
        owner = task(pump)

    def request(view: ChunkWindowView):
        if closed or not shouldRefreshChunkWindow(previousView, view): return
        previousView = view
        retirement.refresh()
        version += 1
        requested = {view, version}
        resume()

    async def shutdown():
        closed = true
        requested = null
        loading = 0
        const active = owner
        owner = null
        const retiring = retirement.close()
        try:
            if active != null: await active.cancel("Chunk streamer closed")
        finally: await retiring

    def close() -> Promise<null>:
        if closing == null: closing = shutdown()
        return closing!

    return {request, resume, pending: () => loading, close}
