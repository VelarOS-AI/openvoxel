import {ChunkPosition, Coordinate3, WorldManifest, chunkCoordinate, chunkKey, locateBlock, requireChunkEdge, requireChunkPosition, requireCoordinate3} from "@openvoxel/world"

const initialHorizontalChunkRadius = 1
const initialVerticalOffsets: readonly List<number> = [0, -1, 1]
const collisionSafetyChunkRadius = 2
const visibleAlignmentThreshold = 0.2
const streamDirectionCosineThreshold = 0.9659258262890683

/// 可见需求向视点前方扩张到半径六；碰撞安全区独立保留全方向半径二。
/// 初次进入仍只加载 3×3×3 的近邻，完整窗口在后台按近到远补齐。
export const horizontalRenderChunkRadius = 6

export readonly type ChunkWindowView:
    center: readonly ChunkPosition
    forwardX: number
    forwardY: number
    forwardZ: number
    minimap: bool?
    radius: number?

def normalizedChunkWindowView(view: ChunkWindowView) -> ChunkWindowView:
    requireChunkPosition(view.center)
    const length = Math.sqrt(view.forwardX * view.forwardX + view.forwardY * view.forwardY + view.forwardZ * view.forwardZ)
    assert length.isFinite() and length > 0 else "Chunk window direction must be finite and non-zero"
    return {
        center: view.center,
        forwardX: view.forwardX / length,
        forwardY: view.forwardY / length,
        forwardZ: view.forwardZ / length,
        minimap: view.minimap,
        radius: Math.clamp(view.radius ?? horizontalRenderChunkRadius, 3, 8),
    }

/// 一次窗口决策共用归一化方向与半径，逐区块查询只执行标量运算。
export readonly type ChunkWindowQuery:
    needs: (position: readonly ChunkPosition) -> bool
    retains: (position: readonly ChunkPosition) -> bool

export def chunkWindowQuery(view: ChunkWindowView) -> ChunkWindowQuery:
    const normalized = normalizedChunkWindowView(view)
    const centerX = normalized.center.x
    const centerY = normalized.center.y
    const centerZ = normalized.center.z
    const forwardX = normalized.forwardX
    const forwardY = normalized.forwardY
    const forwardZ = normalized.forwardZ
    const radius = normalized.radius ?? horizontalRenderChunkRadius
    const radiusSquared = radius * radius
    const retainedSquared = (radius + 1) * (radius + 1)
    const minimap = normalized.minimap == true

    def needs(position: readonly ChunkPosition) -> bool:
        const dx = position.x - centerX
        const dy = position.y - centerY
        const dz = position.z - centerZ
        const distanceSquared = dx * dx + dy * dy + dz * dz
        if minimap and dx * dx + dz * dz <= 9 and dy.abs() <= 3: return true
        if distanceSquared <= collisionSafetyChunkRadius * collisionSafetyChunkRadius: return true
        if distanceSquared > radiusSquared: return false
        return (dx * forwardX + dy * forwardY + dz * forwardZ) / Math.sqrt(distanceSquared) >= visibleAlignmentThreshold

    def retains(position: readonly ChunkPosition) -> bool:
        const dx = position.x - centerX
        const dy = position.y - centerY
        const dz = position.z - centerZ
        return (minimap and dx * dx + dz * dz <= 9 and dy.abs() <= 3) or dx * dx + dy * dy + dz * dz <= retainedSquared

    return {needs, retains}

/// 新驻留需求由全方向碰撞安全球和前向扩张视区组成。方向判定使用完整三维
/// forward，因此水平观察不会把同一 x/z 下整根高空柱当作可见数据。
export def chunkNeedsResidency(position: readonly ChunkPosition, view: ChunkWindowView) -> bool:
    return chunkWindowQuery(view).needs(position)

/// 已经访问的区块在全方向距离球内保留。转头只改变新数据的优先需求，
/// 不淘汰身后的数据；移动越过半径加一的边界才回收，内存始终有空间上界。
export def chunkRetainsResidency(position: readonly ChunkPosition, view: ChunkWindowView) -> bool:
    return chunkWindowQuery(view).retains(position)

/// 64m 俯视图需要身后三格内的地表。只为启用地图的会话补一个有界局部柱体，
/// 不扩大主相机前向远景，也不让地图依赖玩家当前朝向或 Portal 遮挡。
export def chunkNeedsMinimap(position: readonly ChunkPosition, view: ChunkWindowView) -> bool:
    if view.minimap != true: return false
    const dx = position.x - view.center.x
    const dz = position.z - view.center.z
    return dx * dx + dz * dz <= 9 and (position.y - view.center.y).abs() <= 3

/// Chunk 跨越必须立即刷新；同一 Chunk 内只有累计到显著方向变化才提交新的
/// 数据窗口。该阈值与导航输入节流分层，保证未来的其他相机源也不会制造抖动。
export def shouldRefreshChunkWindow(
    previous: ChunkWindowView?,
    next: ChunkWindowView,
) -> bool:
    const normalizedNext = normalizedChunkWindowView(next)
    if previous == null: return true
    const normalizedPrevious = normalizedChunkWindowView(previous)
    if normalizedPrevious.minimap != normalizedNext.minimap or normalizedPrevious.radius != normalizedNext.radius:
        return true
    if normalizedPrevious.center.x != normalizedNext.center.x
        or normalizedPrevious.center.y != normalizedNext.center.y
        or normalizedPrevious.center.z != normalizedNext.center.z: return true
    const alignment = normalizedPrevious.forwardX * normalizedNext.forwardX
        + normalizedPrevious.forwardY * normalizedNext.forwardY
        + normalizedPrevious.forwardZ * normalizedNext.forwardZ
    return alignment <= streamDirectionCosineThreshold

/// 环境场按视窗中心 Chunk 的整数中心采样。这个投影与流送窗口共用同一坐标
/// 事实，避免相机已经跨区而天气和闪电仍停留在出生点。
export def environmentSamplePositionForChunk(position: readonly ChunkPosition, edge: number) -> Coordinate3:
    requireChunkEdge(edge)
    const halfEdge = (edge / 2).floor()
    const samplePosition: Coordinate3 = {
        x: position.x * edge + halfEdge,
        y: position.y * edge + halfEdge,
        z: position.z * edge + halfEdge,
    }
    requireCoordinate3(samplePosition, "Environment sample")
    return samplePosition

export readonly type ChunkWindowPlan:
    missing: readonly List<readonly ChunkPosition>
    obsolete: readonly List<readonly ChunkPosition>

export readonly type ChunkWindowBatch:
    load: readonly List<readonly ChunkPosition>
    unload: readonly List<readonly ChunkPosition>

export readonly type ChunkWindowTransition:
    surplus: readonly List<readonly ChunkPosition>
    batches: readonly List<ChunkWindowBatch>

/// 对比目标窗口与当前驻留集。调用方逐批载入 missing，并在每批成功后淘汰
/// 等量 obsolete；失败时仍保留尚未被替换的旧窗口，峰值只多一个流送批次。
export def planChunkWindow(
    desired: readonly List<readonly ChunkPosition>,
    tracked: readonly List<readonly ChunkPosition>,
) -> ChunkWindowPlan:
    const desiredKeys: Set<string> = Set()
    const trackedKeys: Set<string> = Set()
    for position in desired: desiredKeys.add(chunkKey(position))
    for position in tracked: trackedKeys.add(chunkKey(position))
    return {
        missing: desired.filter(position => chunkKey(position) not in trackedKeys),
        obsolete: tracked.filter(position => chunkKey(position) not in desiredKeys),
    }

/// 将窗口差异拆成有界批次。目标缩小时，多出的 obsolete 可立即释放；其余
/// obsolete 与 load 一一配对，调用方必须先完成 load，再提交对应 unload。
export def batchChunkWindowTransition(
    plan: ChunkWindowPlan,
    batchSize: number,
) -> ChunkWindowTransition:
    assert batchSize.isInteger() and batchSize > 0 else "Chunk stream batch size must be a positive integer"
    let obsoleteStart = plan.obsolete.size - plan.missing.size
    if obsoleteStart < 0: obsoleteStart = 0
    const surplus = plan.obsolete.slice(0, obsoleteStart)
    const batches: List<ChunkWindowBatch> = []
    let start = 0
    while start < plan.missing.size:
        let end = start + batchSize
        if end > plan.missing.size: end = plan.missing.size
        let obsoleteEnd = obsoleteStart + end - start
        if obsoleteEnd > plan.obsolete.size: obsoleteEnd = plan.obsolete.size
        batches.append({
            load: plan.missing.slice(start, end),
            unload: plan.obsolete.slice(obsoleteStart, obsoleteEnd),
        })
        obsoleteStart = obsoleteEnd
        start = end
    return {surplus, batches}

/// Chunk 离开驻留窗口后，仍驻留的六面邻居必须重新构网，补回此前因共享边界
/// 被剔除的外露面。Map 同时保持稳定顺序并合并多个淘汰项指向的同一邻居。
export def retainedNeighborsAfterEviction(
    evicted: readonly List<readonly ChunkPosition>,
    retained: (position: readonly ChunkPosition) -> bool,
) -> List<readonly ChunkPosition>:
    const output: Map<string, readonly ChunkPosition> = Map()

    def add(position: readonly ChunkPosition):
        if retained(position): output.set(chunkKey(position), position)

    for position in evicted:
        add({x: position.x + 1, y: position.y, z: position.z})
        add({x: position.x - 1, y: position.y, z: position.z})
        add({x: position.x, y: position.y + 1, z: position.z})
        add({x: position.x, y: position.y - 1, z: position.z})
        add({x: position.x, y: position.y, z: position.z + 1})
        add({x: position.x, y: position.y, z: position.z - 1})
    return output.values()

/// 首屏先加载出生点附近的小窗口，避免首次进入世界被完整流送窗口阻塞。
export def initialRenderChunkPositions(
    manifest: WorldManifest,
    minimumWorldY: number,
    maximumWorldY: number,
) -> List<readonly ChunkPosition>:
    const center = locateBlock(manifest.spawn, manifest.chunkEdge).chunk
    const minimumChunkY = chunkCoordinate(minimumWorldY, manifest.chunkEdge)
    const maximumChunkY = chunkCoordinate(maximumWorldY, manifest.chunkEdge)
    const positions: List<readonly ChunkPosition> = []
    for dy in initialVerticalOffsets:
        const y = center.y + dy
        if y < minimumChunkY or y > maximumChunkY: continue
        for dz in range(-initialHorizontalChunkRadius, initialHorizontalChunkRadius + 1):
            for dx in range(-initialHorizontalChunkRadius, initialHorizontalChunkRadius + 1):
                positions.append({x: center.x + dx, y, z: center.z + dz})
    return positions

/// 返回碰撞安全球与前向扩张视区的并集，并只为 tracked 应用释放迟滞。同一
/// x/z 地形柱的垂直 Chunk 仍连续排列，使服务端或本地生成器可以复用列规划。
export def streamedChunkPositions(
    view: ChunkWindowView,
    minimumChunkY: number,
    maximumChunkY: number,
    tracked: readonly List<readonly ChunkPosition> = [],
) -> List<readonly ChunkPosition>:
    assert minimumChunkY.isInteger() and maximumChunkY.isInteger() and minimumChunkY <= maximumChunkY else "Chunk window height bounds must be ordered integers"
    const normalizedView = normalizedChunkWindowView(view)
    const query = chunkWindowQuery(normalizedView)
    const trackedKeys = Set(tracked.map(position => chunkKey(position)))
    const verticalOffsets: List<number> = [0]
    for height in range(1, (normalizedView.radius ?? horizontalRenderChunkRadius) + 2):
        verticalOffsets.append(-height)
        verticalOffsets.append(height)
    const positions: List<readonly ChunkPosition> = []
    for ring in range((normalizedView.radius ?? horizontalRenderChunkRadius) + 2):
        const outerSquared = ring * ring
        const innerSquared = (ring - 1) * (ring - 1)
        for dz in range(-ring, ring + 1):
            for dx in range(-ring, ring + 1):
                const horizontalSquared = dx * dx + dz * dz
                if horizontalSquared > outerSquared: continue
                if ring > 0 and horizontalSquared <= innerSquared: continue
                for dy in verticalOffsets:
                    const y = normalizedView.center.y + dy
                    if y < minimumChunkY or y > maximumChunkY: continue
                    const position: ChunkPosition = {
                        x: normalizedView.center.x + dx,
                        y,
                        z: normalizedView.center.z + dz,
                    }
                    const acquire = query.needs(position)
                    const retain = not acquire and (chunkKey(position) in trackedKeys) and query.retains(position)
                    if acquire or retain: positions.append(position)
    return positions
