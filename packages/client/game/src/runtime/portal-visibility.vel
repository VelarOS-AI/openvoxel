import {ChunkPosition, requireChunkPosition} from "@openvoxel/world"

/// `@openvoxel/renderer.ChunkPortalSummary` 在可见性策略内的纯数据投影。
/// 保持本地结构类型可让单元测试不加载 Babylon 所属的 Web 运行时入口。
export readonly type PortalVisibilitySummary:
    empty: bool
    fullyOccluding: bool
    openFaces: number
    connectedFaces: number

export type PortalVisibilityWorkspace:
    rebuild: (candidates: readonly List<readonly ChunkPosition>, center: readonly ChunkPosition) -> null
    visibleChunkKeys: (summaries: readonly Map<string, PortalVisibilitySummary>) -> Set<string>
    revision: () -> number

extern module "#openvoxel/game/portal-visibility":
    export def createPortalVisibilityWorkspace() -> PortalVisibilityWorkspace

import js {createPortalVisibilityWorkspace} from "#openvoxel/game/portal-visibility"

/// 紧凑邻接表和洪泛缓冲留在纯计算模块内；边界只接收已校验的位置与摘要。
export def portalVisibilityWorkspace() -> PortalVisibilityWorkspace:
    const workspace = createPortalVisibilityWorkspace()
    def rebuild(candidates: readonly List<readonly ChunkPosition>, center: readonly ChunkPosition):
        requireChunkPosition(center)
        for position in candidates: requireChunkPosition(position)
        workspace.rebuild(candidates, center)
    return PortalVisibilityWorkspace.from(workspace, {rebuild})

/// 在候选 Chunk 集内做保守的六面 Portal 洪泛。摘要尚未生成的 Chunk 按完全
/// 连通处理，避免异步构网阶段出现错误空洞；已知实心 Chunk 自身可见但会终止
/// 传播。调用方负责把碰撞安全邻域与结果并集，本策略不拥有驻留半径。
export def portalVisibleChunkKeys(
    candidates: readonly List<readonly ChunkPosition>,
    summaries: readonly Map<string, PortalVisibilitySummary>,
    center: readonly ChunkPosition,
) -> Set<string>:
    const workspace = portalVisibilityWorkspace()
    workspace.rebuild(candidates, center)
    return workspace.visibleChunkKeys(summaries)
