import {ChunkPosition} from "@openvoxel/world"
import {ChunkWindowBatch} from "./render-window.vel"

export type ChunkBatchLoader = (positions: readonly List<readonly ChunkPosition>) -> Promise<null>
export type ChunkBatchUnloader = (positions: readonly List<readonly ChunkPosition>) -> null

/// 地形 load 成功后始终交付配对回收计划，由调用方按最新视窗和缓冲容量处理。
/// `current` 只决定是否继续旧目标，不能使已完成批次的回收计划丢失。
export async def commitStreamBatch(
    batch: ChunkWindowBatch,
    load: ChunkBatchLoader,
    unload: ChunkBatchUnloader,
    current: () -> bool,
) -> bool:
    if not current(): return false
    await load(batch.load)
    if batch.unload.size > 0: unload(batch.unload)
    return current()
