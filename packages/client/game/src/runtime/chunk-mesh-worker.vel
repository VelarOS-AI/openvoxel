import {ClientWorldState} from "@openvoxel/client"
import {ChunkMesh, ClientChunkBlockView, ClientClimateTint, ClientRenderState, MeshingWorkerRequest, MeshingWorkerResponse, meshingWorkerOperations, snapshotChunkNeighborhood, snapshotFluidDepthHalo, snapshotNeedsFluidDepthHalo} from "@openvoxel/renderer"
import {ChunkPosition} from "@openvoxel/world"
import {Cancellation} from "velar/task"
import {workerPool} from "velar/worker"
import {ChunkMeshWorker, meshingWorkerCount} from "./chunk-meshing.vel"

/// Worker 边界只接收构网时捕获的邻域快照。调度队列本身不保存过早的快照，
/// 所以尚未开始的邻居无需因新地形到达而反复重发 ticket。
export def chunkMeshWorker(
    states: readonly List<ClientRenderState>,
    state: readonly ClientWorldState,
    edge: number,
    minimumWorldY: number,
    maximumWorldY: number,
) -> ChunkMeshWorker:
    const pool = workerPool("openvoxel-meshing", MeshingWorkerRequest, MeshingWorkerResponse, meshingWorkerCount, 32)
    const waterIds: Set<number> = Set(states.filter(renderState => renderState.climateTint == ClientClimateTint.water).map(renderState => renderState.runtimeId))

    async def initialize(): await pool.broadcast({operation: meshingWorkerOperations.initialize, states}, null, 10s)

    async def build(position: readonly ChunkPosition, ticket: number, cancellation: Cancellation) -> ChunkMesh:
        const center = state.chunk(position)
        assert center != null else "Cannot mesh an untracked client Chunk"
        def neighbor(candidate: readonly ChunkPosition) -> readonly ClientChunkBlockView?:
            // 世界高度之外是真正的空气；世界内部缺失的是尚未加载的数据。
            if candidate.y * edge > maximumWorldY or (candidate.y + 1) * edge <= minimumWorldY:
                return {position: candidate, edge, blockAtIndex: _index => 0}
            return state.chunk(candidate)
        const paddedBlocks = snapshotChunkNeighborhood(center, neighbor, sealUnloaded=true)
        const needsDepthHalo = snapshotNeedsFluidDepthHalo(paddedBlocks, edge, waterIds)
        const fluidDepthHalo = needsDepthHalo ? snapshotFluidDepthHalo(state.chunk({x: position.x, y: position.y - 1, z: position.z})) : null
        const response = await pool.call({operation: meshingWorkerOperations.mesh, position, edge, paddedBlocks, fluidDepthHalo, ticket}, cancellation, 15s)
        assert response.operation == meshingWorkerOperations.mesh else "Meshing Worker returned a mismatched operation"
        const mesh = response.mesh
        assert mesh != null else "Meshing Worker returned no Chunk mesh"
        assert mesh.ticket == ticket else "Meshing Worker returned a mismatched Chunk ticket"
        assert mesh.position.x == position.x and mesh.position.y == position.y and mesh.position.z == position.z else "Meshing Worker returned a mismatched Chunk position"
        return mesh

    return {initialize, build, close: () => pool.close()}
