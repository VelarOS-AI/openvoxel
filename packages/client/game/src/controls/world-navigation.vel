import {WorldMovementFlightBasis, WorldMovementFlightBounds, WorldMovementFlightIntent, WorldMovementFlightState} from "./creative-flight.vel"
import {WorldMovementCollisionQuery, WorldMovementWalkBasis, WorldMovementWalkBounds, WorldMovementWalkIntent, WorldMovementWalkState} from "./survival-walk.vel"

export enum WorldNavigationMode:
    orbit
    firstPerson = "first-person"

export enum WorldMovementMode:
    creativeFlight = "creative-flight"
    survivalWalk = "survival-walk"

export enum WorldCreativeAction:
    breakBlock = "break"
    placeBlock = "place"

export readonly type WorldNavigationPosition:
    x: number
    y: number
    z: number

export readonly type WorldNavigationStats:
    navigationMode: WorldNavigationMode
    movementMode: WorldMovementMode
    viewX: number
    viewY: number
    viewZ: number
    viewChunkX: number
    viewChunkY: number
    viewChunkZ: number
    forwardX: number
    forwardY: number
    forwardZ: number
    pointerLocked: bool

export type WorldMovementFlightStep = (
    state: WorldMovementFlightState,
    intent: WorldMovementFlightIntent,
    basis: WorldMovementFlightBasis,
    deltaMilliseconds: number,
    bounds: WorldMovementFlightBounds,
) -> WorldMovementFlightState

export type WorldMovementWalkStep = (
    state: WorldMovementWalkState,
    intent: WorldMovementWalkIntent,
    basis: WorldMovementWalkBasis,
    deltaMilliseconds: number,
    bounds: WorldMovementWalkBounds,
    collisionAt: WorldMovementCollisionQuery,
) -> WorldMovementWalkState

/// Web 宿主适配器只经这些强类型闭包读写相机。原生场景、相机和事件对象
/// 不进入 VelarScript 领域；移动积分仍由纯 WorldMovement 策略拥有。
export readonly type WorldNavigationOptions:
    canvas: CanvasElement
    mode: WorldNavigationMode
    movementMode: WorldMovementMode
    edge: number
    bounds: WorldMovementFlightBounds
    initialFlightState: WorldMovementFlightState
    initialWalkState: WorldMovementWalkState
    stepFlight: WorldMovementFlightStep
    stepWalk: WorldMovementWalkStep
    collisionAt: WorldMovementCollisionQuery
    readViewPosition: () -> WorldNavigationPosition
    readViewForward: () -> WorldNavigationPosition
    readHorizontalBasis: () -> WorldMovementFlightBasis
    applyFlightState: (state: WorldMovementFlightState) -> null
    applyWalkState: (state: WorldMovementWalkState) -> null
    rotateView: (horizontalRadians: number, verticalRadians: number) -> null
    releaseView: () -> null
    viewChanged: (chunkX: number, chunkY: number, chunkZ: number, forwardX: number, forwardY: number, forwardZ: number) -> null
    aimChanged: (origin: WorldNavigationPosition, forward: WorldNavigationPosition) -> null
    creativeAction: (action: WorldCreativeAction, origin: WorldNavigationPosition, forward: WorldNavigationPosition) -> null
    creativeSlot: (slot: number) -> null
    walkSound: (position: WorldNavigationPosition, crouching: bool, landed: bool) -> null

export type WorldNavigation:
    update: (deltaMilliseconds: number) -> null
    viewPosition: () -> WorldNavigationPosition
    stats: () -> WorldNavigationStats
    release: () -> null

export type WorldNavigationFactory = (options: WorldNavigationOptions) -> WorldNavigation

extern module "#openvoxel/game/web-navigation":
    export def createNavigationAdapter(options: WorldNavigationOptions) -> WorldNavigation

import js {createNavigationAdapter} from "#openvoxel/game/web-navigation"

export def createWorldNavigation(options: WorldNavigationOptions) -> WorldNavigation:
    return createNavigationAdapter(options)
