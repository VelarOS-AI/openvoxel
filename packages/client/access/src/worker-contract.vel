import {WorldBackendContract} from "./backend.vel"
import {BlockEditsAppliedEvent, ChunksSyncedEvent, CreateWorldRequest, RealtimeBlockEdit, WorldBlocksChangedEvent, WorldBootstrapResponse, WorldContentResponse, WorldReadyEvent} from "@openvoxel/protocol"
import {ChunkPosition, WorldManifest} from "@openvoxel/world"
import {ClientTerrainBatchSnapshot} from "./terrain-snapshot.vel"

export const localWorkerOperations = {
    initialize: "initialize",
    contract: "contract",
    createWorld: "create-world",
    findWorld: "find-world",
    bootstrap: "bootstrap",
    content: "content",
    terrainChunks: "terrain-chunks",
    openConnection: "open-connection",
    pollEvent: "poll-event",
    syncChunks: "sync-chunks",
    applyBlocks: "apply-blocks",
    closeConnection: "close-connection",
    shutdown: "shutdown",
}

/// Worker 的唯一请求信封。所有可选载荷都会在 operation 分支内再次收窄；
/// Worker Runtime Type 先保证跨线程结构只能包含这里声明的数据。
export readonly type LocalWorkerRequest:
    operation: string
    databaseName: string?
    worldId: string?
    connectionId: string?
    requestId: string?
    command: CreateWorldRequest?
    positions: readonly List<readonly ChunkPosition>?
    edits: readonly List<RealtimeBlockEdit>?

export readonly type LocalWorkerResponse:
    operation: string
    contract: WorldBackendContract?
    manifest: WorldManifest?
    bootstrap: WorldBootstrapResponse?
    content: WorldContentResponse?
    terrain: ClientTerrainBatchSnapshot?
    ready: readonly WorldReadyEvent?
    changed: readonly WorldBlocksChangedEvent?
    chunks: readonly ChunksSyncedEvent?
    blocks: readonly BlockEditsAppliedEvent?
    closed: bool?
