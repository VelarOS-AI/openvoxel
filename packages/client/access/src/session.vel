import {BlockEditsAppliedEvent, ChunksSyncedEvent, RealtimeBlockEdit, WorldBlocksChangedEvent, WorldBootstrapResponse, WorldContentResponse, WorldReadyEvent, clientContractVersion, protocolServiceName, protocolVersion} from "@openvoxel/protocol"
import {ChunkPosition, Coordinate3, WorldEnvironmentSample, chunkKey} from "@openvoxel/world"
import {Cancellation} from "velar/task"
import {monotonic} from "velar/time"
import {WorldBackend, WorldBackendContract} from "./backend.vel"
import {chunkLoadOwnership} from "./chunk-load-ownership.vel"
import {sessionConnection} from "./session-connection.vel"
import {sessionEnvironment} from "./session-environment.vel"
import {ClientChunkState} from "./chunk-state.vel"
import {ClientWorldChangeListener, ClientWorldChangeSubscription, ClientWorldState, clientWorldState} from "./world-state.vel"

/// 客户端世界会话拥有后端连接、当前世界事实和冷热 Chunk 状态。
/// 调用者不直接操作 requestId、sequence 或增量重同步。
export type ClientWorldSession:
    readonly worldId: string
    readonly contract: readonly WorldBackendContract
    readonly bootstrap: readonly WorldBootstrapResponse
    readonly content: readonly WorldContentResponse
    readonly state: ClientWorldState
    /// 从最近一次 world.ready 权威锚点按单调时钟推进；位置默认使用锚点位置，视点
    /// 流送可显式请求大世界中的另一处连续环境场。
    environment: (samplePosition?: readonly Coordinate3) -> readonly WorldEnvironmentSample
    /// 宿主可约每 100ms 调用；内部只保留一个请求，每次最多同步四个 Chunk。
    /// 仅时间槽变化或热编辑遮挡失效时入队，同值快照不会触发构网。
    /// 任务取消沿同步请求传到后端；关闭呈现任务不需要先关闭整个世界连接。
    refreshEcology: (cancellation?: Cancellation) -> Promise<bool>
    loadChunks: (positions: readonly List<readonly ChunkPosition>, cancellation?: Cancellation) -> Promise<readonly List<readonly ClientChunkState>>
    unloadChunks: (positions: readonly List<readonly ChunkPosition>) -> null
    applyBlocks: (edits: readonly List<readonly RealtimeBlockEdit>) -> Promise<readonly BlockEditsAppliedEvent>
    subscribeChanges: (listener: ClientWorldChangeListener) -> ClientWorldChangeSubscription
    reconnect: () -> Promise<null>
    close: () -> Promise<null>

/// 实时适配器已经负责结构解析；会话仍拥有一次请求与一次响应之间的语义关联。
/// 必须先完整验证批次，避免前面的合法增量已写入、后面的缺失或乱序项才让请求失败。
def requireSynchronizedChunkBatch(
    event: readonly ChunksSyncedEvent,
    expectedRequestId: string,
    expectedWorldId: string,
    expectedPositions: readonly List<readonly ChunkPosition>,
):
    assert event.event == "chunks.synced" else "Client expected a chunks.synced event"
    assert event.requestId == expectedRequestId else "Client Chunk synchronization returned a different request id"
    assert event.worldId == expectedWorldId else "Client Chunk synchronization returned a different world"
    assert event.chunks.size == expectedPositions.size else "Client Chunk synchronization returned the wrong Chunk count"
    for delta, offset in event.chunks:
        const expected = expectedPositions[offset]
        assert chunkKey(delta.position) == chunkKey(expected) else "Client Chunk synchronization changed the requested Chunk order"

type SynchronizationState:
    depth: number
    changes: List<readonly WorldBlocksChangedEvent>

/// 建立统一世界会话，在下载 Chunk 前验证版本、内容哈希和世界身份。
export async def openClientWorld(backend: WorldBackend, worldId: string, clock: () -> number = monotonic) -> ClientWorldSession:
    const contract = await backend.contract()
    assert contract.service == protocolServiceName else "Backend is not an OpenVoxel service"
    assert contract.contractVersion == clientContractVersion else "Client contract version does not match the backend"
    assert contract.protocolVersion == protocolVersion else "Client protocol version does not match the backend"
    assert contract.chunks.maximumBatchSize.isInteger() and contract.chunks.maximumBatchSize > 0 else "Backend Chunk batch limit must be positive"
    const bootstrap = await backend.bootstrap(worldId)
    assert bootstrap.id == worldId else "World bootstrap returned a different world"
    assert bootstrap.clientContractVersion == contract.contractVersion else "World bootstrap changed the client contract version"
    assert bootstrap.protocolVersion == contract.protocolVersion else "World bootstrap changed the protocol version"
    assert bootstrap.maximumChunkBatchSize == contract.chunks.maximumBatchSize else "World bootstrap changed the Chunk batch limit"
    const content = await backend.content(worldId)
    assert content.content.contentHash == bootstrap.content.contentHash else "World content hash does not match bootstrap"
    assert content.stateMapHash == bootstrap.contentStateMapHash else "World state map hash does not match bootstrap"
    assert content.generator == bootstrap.generator else "World content generator does not match bootstrap"
    assert content.generatorHash == bootstrap.generatorHash else "World generator hash does not match bootstrap"

    const state = clientWorldState(worldId, bootstrap.chunkEdge)
    let nextRequestId = 1
    let synchronization: SynchronizationState = {depth: 0, changes: []}
    const loads = chunkLoadOwnership(state)
    const connections = sessionConnection(listener => backend.connect(worldId, listener), installConnection, receiveChanges)
    const ecology = sessionEnvironment(bootstrap.seed, state, clock, synchronize, () => connections.connected() and synchronization.depth == 0)

    def installConnection(event: readonly WorldReadyEvent):
        ecology.install(event.environment)
        synchronization.changes.clear()
        synchronization = {depth: 0, changes: []}
        state.beginConnection(event)

    def requestId(prefix: string) -> string:
        const value = f"{prefix}-{nextRequestId}"
        nextRequestId += 1
        return value

    def receiveChanges(event: readonly WorldBlocksChangedEvent):
        if connections.closed(): return
        ecology.changed(event.changes)
        // 完整增量与世界广播可能在网络上交错。同步期间先保留广播，等所有增量
        // 批次替换完成后按原始到达顺序重放，旧快照便不会覆盖刚收到的热变化。
        if synchronization.depth > 0: synchronization.changes.append(event)
        else: state.applyChanges(event)

    def replayDeferredChanges(owner: SynchronizationState):
        if owner.depth > 0: return
        const pending = owner.changes.slice()
        owner.changes.clear()
        if connections.closed() or owner != synchronization: return
        for event in pending: state.applyChanges(event)

    async def checkpoint(cancellation: Cancellation?):
        if cancellation != null: await cancellation.checkpoint()

    async def synchronize(positions: readonly List<readonly ChunkPosition>, cancellation: Cancellation? = null):
        if positions.size == 0: return
        const owner = connections.current()
        const pending = synchronization
        pending.depth += 1
        try:
            const limit = contract.chunks.maximumBatchSize
            let start = 0
            while start < positions.size:
                let end = start + limit
                if end > positions.size: end = positions.size
                const batch = positions.slice(start, end)
                await checkpoint(cancellation)
                if not connections.owns(owner): return
                const syncRequestId = requestId("sync")
                const event = (
                    cancellation == null
                        ? await owner.syncChunks(syncRequestId, batch)
                        : await owner.syncChunks(syncRequestId, batch, cancellation)
                )
                await checkpoint(cancellation)
                if not connections.owns(owner): return
                requireSynchronizedChunkBatch(event, syncRequestId, worldId, batch)
                state.replaceDeltas(event)
                loads.synchronized(batch)
                start = end
        catch error:
            if connections.owns(owner): throw error
        finally:
            pending.depth -= 1
            replayDeferredChanges(pending)

    async def loadChunks(
        positions: readonly List<readonly ChunkPosition>,
        cancellation: Cancellation? = null,
    ) -> readonly List<readonly ClientChunkState>:
        assert not connections.closed() else "Client world session is closed"
        assert positions.size > 0 else "Client Chunk load cannot be empty"
        const seen: Set<string> = Set()
        for position in positions:
            const key = chunkKey(position)
            assert key not in seen else "Client Chunk load repeats one position"
            seen.add(key)

        const output: List<readonly ClientChunkState> = []
        const limit = contract.chunks.maximumBatchSize
        let start = 0
        while start < positions.size:
            let end = start + limit
            if end > positions.size: end = positions.size
            const batch = positions.slice(start, end)
            loads.claim(batch)
            let succeeded = false
            try:
                await checkpoint(cancellation)
                const terrain = (
                    cancellation == null
                        ? await backend.terrainChunks(worldId, batch)
                        : await backend.terrainChunks(worldId, batch, cancellation)
                )
                await checkpoint(cancellation)
                assert not connections.closed() else "Client world session is closed"
                const loaded = state.rememberTerrain(terrain)
                const synchronizedBy = connections.current()
                await synchronize(batch, cancellation)
                assert connections.owns(synchronizedBy) else "Client Chunk load was retired before synchronization completed"
                for chunk in loaded: output.append(chunk)
                succeeded = true
            finally: loads.release(batch, succeeded)
            start = end
        return output

    def unloadChunks(positions: readonly List<readonly ChunkPosition>):
        state.forgetChunks(positions)
        ecology.forget(positions)

    async def applyBlocks(edits: readonly List<readonly RealtimeBlockEdit>) -> readonly BlockEditsAppliedEvent:
        assert edits.size > 0 else "Client block edit batch cannot be empty"
        const owner = connections.current()
        const event = await owner.applyBlocks(requestId("edit"), edits)
        if not connections.owns(owner): return event
        // 服务端会向请求方广播同一批变化；若适配器先交付广播，这里是幂等确认，
        // 若广播尚未到达，这里先让本地视图收敛到已提交结果。
        state.applyAcknowledgement(event)
        ecology.changed(event.changes)
        return event

    async def reconnect():
        if await connections.open(): await synchronize(state.trackedPositions())

    async def close():
        ecology.close()
        synchronization.changes.clear()
        await connections.close()

    def subscribeChanges(listener: ClientWorldChangeListener) -> ClientWorldChangeSubscription:
        return state.subscribeChanges(listener)

    await connections.open()
    return {worldId, contract, bootstrap, content, state, environment: ecology.sample, refreshEcology: ecology.refresh, loadChunks, unloadChunks, applyBlocks, subscribeChanges, reconnect, close}
