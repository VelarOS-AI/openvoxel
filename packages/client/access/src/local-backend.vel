import {Worker, worker} from "velar/worker"
import {WorldBackend, WorldBackendConnection, WorldBackendContract} from "./backend.vel"
import {BlockEditsAppliedEvent, ChunksSyncedEvent, CreateWorldRequest, RealtimeBlockEdit, TerrainChunkBatchResponse, WorldBlocksChangedEvent, WorldBootstrapResponse, WorldContentResponse, WorldReadyEvent} from "@openvoxel/protocol"
import {ChunkPosition, WorldManifest} from "@openvoxel/world"
import {LocalWorkerRequest, LocalWorkerResponse, localWorkerOperations} from "./worker-contract.vel"
import {Cancellation} from "velar/task"

def request(operation: string) -> LocalWorkerRequest: return {operation}

/// 浏览器本地适配器。主线程只拥有类型化 Worker 客户端和事件泵；生成器、
/// WorldRuntime、活动世界缓存与 IndexedDB 全部留在专用 Worker 内。
export def localBackend(
    databaseName: string = "openvoxel-local",
    workerName: string = "openvoxel-local",
) -> WorldBackend:
    assert not databaseName.isBlank() else "LocalBackend database name cannot be blank"
    assert not workerName.isBlank() else "LocalBackend Worker name cannot be blank"
    let transport: Worker<LocalWorkerRequest, LocalWorkerResponse>? = null
    let initialization: Promise<LocalWorkerResponse>? = null
    let nextConnectionId = 1
    let backendClosed = false

    async def activeTransport() -> Worker<LocalWorkerRequest, LocalWorkerResponse>:
        assert not backendClosed else "LocalBackend is closed"
        let current = transport
        if current == null:
            current = worker(workerName, LocalWorkerRequest, LocalWorkerResponse, 128)
            transport = current
            initialization = current.call({
                operation: localWorkerOperations.initialize,
                databaseName,
            })
        const pending = initialization
        assert pending != null else "LocalBackend initialization disappeared"
        const ready = current
        assert ready != null else "LocalBackend transport disappeared"
        try: await pending
        catch error:
            transport = null
            initialization = null
            await ready.close()
            throw error
        return ready

    async def call(message: LocalWorkerRequest, cancellation: Cancellation? = null) -> LocalWorkerResponse:
        if cancellation != null: await cancellation.checkpoint()
        const current = await activeTransport()
        const response = await current.call(message, cancellation)
        assert response.operation == message.operation else "LocalBackend Worker returned the wrong operation"
        return response

    async def contract() -> readonly WorldBackendContract:
        const response = await call(request(localWorkerOperations.contract))
        assert response.contract != null else "LocalBackend Worker omitted its contract"
        return response.contract

    async def createWorld(command: readonly CreateWorldRequest) -> readonly WorldManifest:
        const response = await call({operation: localWorkerOperations.createWorld, command})
        assert response.manifest != null else "LocalBackend Worker omitted the created world"
        return response.manifest

    async def findWorld(worldId: string) -> readonly WorldManifest:
        const response = await call({operation: localWorkerOperations.findWorld, worldId})
        assert response.manifest != null else "LocalBackend Worker omitted the found world"
        return response.manifest

    async def bootstrap(worldId: string) -> readonly WorldBootstrapResponse:
        const response = await call({operation: localWorkerOperations.bootstrap, worldId})
        assert response.bootstrap != null else "LocalBackend Worker omitted world bootstrap"
        return response.bootstrap

    async def content(worldId: string) -> readonly WorldContentResponse:
        const response = await call({operation: localWorkerOperations.content, worldId})
        assert response.content != null else "LocalBackend Worker omitted world content"
        return response.content

    async def terrainChunks(
        worldId: string,
        positions: readonly List<readonly ChunkPosition>,
        cancellation: Cancellation? = null,
    ) -> readonly TerrainChunkBatchResponse:
        const response = await call({operation: localWorkerOperations.terrainChunks, worldId, positions}, cancellation)
        assert response.terrain != null else "LocalBackend Worker omitted terrain Chunks"
        return response.terrain

    async def connect(worldId: string, listener: (event: readonly WorldBlocksChangedEvent) -> null) -> WorldBackendConnection:
        const connectionId = f"local-{nextConnectionId}"
        nextConnectionId += 1
        const opened = await call({operation: localWorkerOperations.openConnection, worldId, connectionId})
        const ready = opened.ready
        assert ready != null else "LocalBackend Worker omitted world.ready"
        let connectionClosed = false
        let connectionFailure: Error? = null

        def requireHealthy():
            if connectionFailure != null: throw connectionFailure
            assert not connectionClosed else "LocalBackend connection is closed"

        async def pump():
            // connect 必须先把 ready 交给会话；下一轮任务才开始投递世界广播。
            await Promise.sleep(0ms)
            try:
                while not connectionClosed:
                    const response = await call({operation: localWorkerOperations.pollEvent, connectionId})
                    if response.closed == true: return
                    const changed = response.changed
                    if changed != null: listener(changed)
                    else: await Promise.sleep(10ms)
            catch error:
                if not connectionClosed: connectionFailure = error

        detach pump()

        async def syncChunks(
            requestId: string,
            positions: readonly List<readonly ChunkPosition>,
            cancellation: Cancellation? = null,
        ) -> readonly ChunksSyncedEvent:
            requireHealthy()
            const response = await call({
                operation: localWorkerOperations.syncChunks,
                connectionId,
                requestId,
                positions,
            }, cancellation)
            assert response.chunks != null else "LocalBackend Worker omitted chunks.synced"
            return response.chunks

        async def applyBlocks(requestId: string, edits: readonly List<readonly RealtimeBlockEdit>) -> readonly BlockEditsAppliedEvent:
            requireHealthy()
            const response = await call({
                operation: localWorkerOperations.applyBlocks,
                connectionId,
                requestId,
                edits,
            })
            assert response.blocks != null else "LocalBackend Worker omitted blocks.applied"
            return response.blocks

        async def close():
            if connectionClosed: return
            connectionClosed = true
            if backendClosed: return
            await call({operation: localWorkerOperations.closeConnection, connectionId})

        return {ready, syncChunks, applyBlocks, close}

    async def close():
        if backendClosed: return
        const current = transport
        if current == null:
            backendClosed = true
            return
        try:
            const pending = initialization
            if pending != null: await pending
            await current.call(request(localWorkerOperations.shutdown))
        finally:
            backendClosed = true
            await current.close()

    return {contract, createWorld, findWorld, bootstrap, content, terrainChunks, connect, close}
