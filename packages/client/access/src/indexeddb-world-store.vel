import {storedKeyBelongsToWorld, worldManifestKey, worldDeltaKey} from "./world-storage-keys.vel"
import {Bytes} from "velar/binary"
import {database} from "velar/storage"
import {decode, encode} from "@velarscript-labs/msgpack"
import {ChunkPosition, LocalPosition, WorldManifest, chunkKey} from "@openvoxel/world"
import {StoredBlockOverride, StoredChunkDelta, ChunkDeltaCommit, WorldStore} from "@openvoxel/world-runtime"

type DatabaseBatchChange:
    key: string
    bytes: Bytes?

def localKey(position: readonly LocalPosition) -> string: return f"{position.x}:{position.y}:{position.z}"

def localOrder(entry: StoredBlockOverride) -> number:
    return entry.position.x + 1024 * entry.position.z + 1048576 * entry.position.y

/// OpenVoxel 的浏览器持久化适配器。一个 LocalBackend 只让自己的专用 Worker
/// 写入这个实例；WorldRuntime 在该 Worker 内串行化世界命令，batch 再把一次
/// 多 Chunk 发布收敛成单个 IndexedDB 事务。
export def indexedDbWorldStore(name: string) -> WorldStore:
    const storage = database(name)

    async def saveManifest(manifest: WorldManifest): await storage.set(worldManifestKey(manifest.id), manifest)

    async def findManifest(worldId: string) -> WorldManifest?:
        return await storage.get(worldManifestKey(worldId), WorldManifest)

    async def storedDelta(worldId: string, position: readonly ChunkPosition) -> StoredChunkDelta?:
        const bytes = await storage.getBytes(worldDeltaKey(worldId, position))
        if bytes == null: return null
        const decoded = StoredChunkDelta.parse(decode(bytes))
        if decoded.storageRevision != null: return decoded
        // v7 本地记录只有公开 revision；首次读时在内存中提升为双版本，下一次
        // 原子写会把 storageRevision 一并编码，不需要全库扫描迁移。
        return StoredChunkDelta.from(decoded, {storageRevision: decoded.revision})

    async def findChunks(worldId: string, positions: readonly List<readonly ChunkPosition>) -> List<StoredChunkDelta>:
        const found: List<StoredChunkDelta> = []
        for position in positions:
            const delta = await storedDelta(worldId, position)
            if delta != null: found.append(delta)
        return found

    async def commitChunks(worldId: string, commits: readonly List<ChunkDeltaCommit>):
        const changes: List<DatabaseBatchChange> = []
        for commit in commits:
            const current = await storedDelta(worldId, commit.position) ?? {
                position: commit.position,
                revision: 0,
                storageRevision: 0,
                overrides: [],
            }
            const currentStorageRevision = current.storageRevision ?? current.revision
            assert currentStorageRevision == commit.expectedStorageRevision else f"Chunk storage revision conflict at {chunkKey(commit.position)}"
            assert commit.storageRevision == commit.expectedStorageRevision + 1 else "Chunk storage revision must advance exactly once"
            assert commit.revision == current.revision or commit.revision == current.revision + 1 else "Chunk visible revision must stay or advance exactly once"

            const byPosition: Map<string, StoredBlockOverride> = Map()
            for entry in current.overrides: byPosition.set(localKey(entry.position), entry)
            for write in commit.writes:
                if write.blockStateRuntimeId != null:
                    byPosition.set(localKey(write.position), StoredBlockOverride.from(write, {
                        blockStateRuntimeId: write.blockStateRuntimeId,
                    }))
                else: byPosition.remove(localKey(write.position))
            const overrides = byPosition.values().sorted(by=localOrder)
            const next = StoredChunkDelta.from(commit, {overrides})
            changes.append({key: worldDeltaKey(worldId, commit.position), bytes: encode(next)})

        await storage.batch(changes)

    async def close(): pass

    return {
        manifests: {save: saveManifest, find: findManifest},
        deltas: {findChunks, commitChunks},
        close,
    }

/// 清单与稀疏方块覆盖在同一事务删除，失败时保留完整存档。
export async def deleteIndexedDbWorld(name: string, worldId: string):
    assert not name.isBlank() and not worldId.isBlank() else "删除世界需要数据库名称和世界编号"
    const storage = database(name)
    const changes: List<DatabaseBatchChange> = []
    for key in await storage.keys():
        if storedKeyBelongsToWorld(key, worldId): changes.append({key, bytes: null})
    if changes.size > 0: await storage.batch(changes)
