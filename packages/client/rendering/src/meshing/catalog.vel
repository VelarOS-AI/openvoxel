import {UInt32Buffer} from "velar/binary"
import {ClientRenderState} from "../contracts.vel"

export def blockIndex(x: number, y: number, z: number, edge: number) -> number: return x + edge * (z + edge * y)

export def indexRenderStates(states: readonly List<ClientRenderState>) -> Map<number, ClientRenderState>:
    const result: Map<number, ClientRenderState> = Map()
    for state in states:
        assert not result.has(state.runtimeId) else f"Meshing catalog repeats runtimeId {state.runtimeId}"
        result.set(state.runtimeId, state)
    return result

def requireRenderState(
    byRuntimeId: Map<number, ClientRenderState>,
    runtimeId: number,
) -> ClientRenderState:
    const state = byRuntimeId.get(runtimeId)
    assert state != null else f"Chunk references unknown runtimeId {runtimeId}"
    return state

export def centerChunkStates(
    edge: number,
    paddedBlocks: UInt32Buffer,
    byRuntimeId: Map<number, ClientRenderState>,
) -> List<ClientRenderState>:
    const paddedEdge = edge + 2
    let previousRuntimeId = paddedBlocks[blockIndex(1, 1, 1, paddedEdge)]
    let previousState = requireRenderState(byRuntimeId, previousRuntimeId)
    // Air and terrain strata form long runs. Resolve a catalog entry only when
    // its runtimeId changes, instead of repeating a Map lookup per voxel.
    def centerState(index: number) -> ClientRenderState:
        const x = index % edge
        const z = (index / edge).floor() % edge
        const y = (index / (edge * edge)).floor()
        const runtimeId = paddedBlocks[blockIndex(x + 1, y + 1, z + 1, paddedEdge)]
        if runtimeId != previousRuntimeId:
            previousState = requireRenderState(byRuntimeId, runtimeId)
            previousRuntimeId = runtimeId
        return previousState
    return range(edge * edge * edge).map(centerState)

export def stateAt(
    states: Map<number, ClientRenderState>,
    blocks: UInt32Buffer,
    paddedEdge: number,
    x: number,
    y: number,
    z: number,
) -> ClientRenderState:
    const runtimeId = blocks[blockIndex(x, y, z, paddedEdge)]
    return requireRenderState(states, runtimeId)
