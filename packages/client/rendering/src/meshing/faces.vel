import {BlockRenderLayer} from "@openvoxel/blocks"
import {ClientBlockModelKind, ClientClimateTint, ClientRenderAttachment, ClientRenderState, ClientRenderTexture, ClientTextureVariant, ClientTintCoverage} from "../contracts.vel"
import {stableCoordinateOffset} from "./variation.vel"

type ClientMeshSurface = ClientRenderState | ClientRenderAttachment

export readonly type MeshFace:
    salt: number
    shade: number
    top: bool
    bottom: bool
    columnTopAxis: string
    columnBottomAxis: string
    horizontalFacing: string?

readonly type BoxBounds:
    minimumX: number
    minimumY: number
    minimumZ: number
    maximumX: number
    maximumY: number
    maximumZ: number

export const eastFace: MeshFace = {salt: 0x45d9, shade: 0.98, top: false, bottom: false, columnTopAxis: "x", columnBottomAxis: "", horizontalFacing: "east"}
export const westFace: MeshFace = {salt: 0x119d, shade: 0.95, top: false, bottom: false, columnTopAxis: "", columnBottomAxis: "x", horizontalFacing: "west"}
export const topFace: MeshFace = {salt: 0x27d4, shade: 1, top: true, bottom: false, columnTopAxis: "", columnBottomAxis: "", horizontalFacing: null}
export const bottomFace: MeshFace = {salt: 0x1656, shade: 0.9, top: false, bottom: true, columnTopAxis: "", columnBottomAxis: "", horizontalFacing: null}
export const southFace: MeshFace = {salt: 0x9e37, shade: 1, top: false, bottom: false, columnTopAxis: "z", columnBottomAxis: "", horizontalFacing: "south"}
export const northFace: MeshFace = {salt: 0x7f4a, shade: 0.94, top: false, bottom: false, columnTopAxis: "", columnBottomAxis: "z", horizontalFacing: "north"}

def textureResourceForFace(state: ClientMeshSurface, face: MeshFace) -> ClientRenderTexture:
    const textures = state.textures
    assert textures != null else f"Rendered state {state.runtimeId} has no textures"
    if state.model == ClientBlockModelKind.column:
        const axis = state.axis ?? "y"
        if axis == face.columnTopAxis: return textures.top
        if axis == face.columnBottomAxis: return textures.bottom
        if axis == "x" or axis == "z": return textures.side
    const horizontalFacing = face.horizontalFacing
    const front = textures.front
    if horizontalFacing != null and front != null and state.facing == horizontalFacing: return front
    if face.top: return textures.top
    if face.bottom: return textures.bottom
    return textures.side

/// 选择只取决于持久世界坐标、方块状态和面；同一位置在重新加载或由另一个
/// Worker 构网时会得到同一个结果，区块边界也不会成为纹理分布边界。
export def textureForFace(
    state: ClientMeshSurface,
    face: MeshFace,
    worldX: number,
    worldY: number,
    worldZ: number,
) -> ClientTextureVariant:
    const texture = textureResourceForFace(state, face)
    const variants = texture.variants
    assert variants.size > 0 else f"Texture {texture.key} has no surface variants"
    if variants.size == 1: return variants[0]
    let offset = stableCoordinateOffset(state.runtimeId, worldX, worldY, worldZ, face.salt, texture.totalWeight)
    for variant in variants:
        if offset < variant.weight: return variant
        offset -= variant.weight
    return variants[variants.size - 1]

export def faceShade(face: MeshFace, emission: number) -> number:
    // 真实场景光负责主要明暗，这里只保留轻微方向差，避免每层方块底面形成黑线。
    return Math.max(face.shade, emission / 15)

export def climateTintRole(state: ClientMeshSurface, face: MeshFace) -> number:
    match state.climateTint:
        case ClientClimateTint.neutral: return 0
        case ClientClimateTint.foliage: return 2
        case ClientClimateTint.water: return 3
        case ClientClimateTint.evergreenFoliage: return 5
        case ClientClimateTint.drylandFoliage: return 6
        case ClientClimateTint.aquaticFoliage: return 7
        case ClientClimateTint.birchFoliage: return 8
        case ClientClimateTint.poplarFoliage: return 9
        case ClientClimateTint.tallSpruceFoliage: return 10
        case ClientClimateTint.grass:
            if state.tintCoverage == ClientTintCoverage.all: return 1
            if face.bottom: return 0
            return face.top ? 1 : 4

export def sameTranslucentVolume(current: ClientRenderState, neighbor: ClientRenderState) -> bool:
    if current.model == ClientBlockModelKind.fluid or neighbor.model == ClientBlockModelKind.fluid:
        return current.model == ClientBlockModelKind.fluid and neighbor.model == ClientBlockModelKind.fluid and current.canonicalFluidKey != null and current.canonicalFluidKey == neighbor.canonicalFluidKey
    return current.layer == BlockRenderLayer.translucent and neighbor.layer == BlockRenderLayer.translucent and current.model == neighbor.model and current.materialKey == neighbor.materialKey

def fullFaceModel(state: ClientRenderState) -> bool:
    return state.model == ClientBlockModelKind.cube or state.model == ClientBlockModelKind.column

/// Cutout 方块不会遮挡它旁边的不透明表面，但同一剔除组里的完整立方体仍共享
/// 一张内部边界。树叶种类可以使用不同纹理，只要材质职责相同就不会重复生成
/// 两组永远不可见的内部面。
def sameCullVolume(current: ClientRenderState, neighbor: ClientRenderState) -> bool:
    return current.cullFaces and neighbor.cullFaces and fullFaceModel(current) and fullFaceModel(neighbor) and current.layer == neighbor.layer and current.materialKey == neighbor.materialKey

export def boxBounds(state: ClientRenderState) -> BoxBounds?:
    if state.geometry != null: return null
    const model = state.model
    if model == ClientBlockModelKind.cube or model == ClientBlockModelKind.column:
        return {minimumX: 0, minimumY: 0, minimumZ: 0, maximumX: 1, maximumY: 1, maximumZ: 1}
    if model == ClientBlockModelKind.cactus:
        return {minimumX: 1 / 16, minimumY: 0, minimumZ: 1 / 16, maximumX: 15 / 16, maximumY: 1, maximumZ: 15 / 16}
    if model == ClientBlockModelKind.snowLayer:
        return {minimumX: 0, minimumY: 0, minimumZ: 0, maximumX: 1, maximumY: (state.layers ?? 1) / 8, maximumZ: 1}
    if model == ClientBlockModelKind.groundCover:
        return {minimumX: 0, minimumY: 0, minimumZ: 0, maximumX: 1, maximumY: (state.layers ?? 1) / 16, maximumZ: 1}
    return null

export def sameBoxContactVolume(current: ClientRenderState, neighbor: ClientRenderState) -> bool:
    return current.model == neighbor.model and current.layer == neighbor.layer and current.materialKey == neighbor.materialKey

/// 相邻格只会遮住落在共享格边界上的模型面。仙人掌的四个侧面内缩，雪层顶面
/// 通常低于格顶；这些面与相邻格之间仍有空间，不能仅凭邻居是实体方块就剔除。
export def faceVisible(
    current: ClientRenderState,
    neighbor: ClientRenderState,
    currentTouchesBoundary: bool,
    neighborTouchesBoundary: bool,
) -> bool:
    if neighbor.model == null or not currentTouchesBoundary or not neighborTouchesBoundary: return true
    if neighbor.occludes: return false
    if sameCullVolume(current, neighbor): return false
    if sameTranslucentVolume(current, neighbor): return false
    return not sameBoxContactVolume(current, neighbor)
