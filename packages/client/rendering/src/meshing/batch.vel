import {BlockRenderLayer} from "@openvoxel/blocks"
import {Float32Builder, UInt32Builder, float32Builder, uint32Builder} from "velar/binary"
import {ChunkMeshBatch, ClientModelTriangle, ClientRenderAttachment, ClientRenderState, ClientTextureVariant} from "../contracts.vel"
import {MeshFace, climateTintRole, faceShade} from "./faces.vel"

export type ClientMeshSurface = ClientRenderState | ClientRenderAttachment

const maximumChunkMeshBytes = 8 * 1024 * 1024
// 四顶点的六组属性与六个 UInt32 索引：每个 quad 恰好 248 bytes。
const meshQuadBytes = (12 + 12 + 8 + 4 + 4 + 16 + 6) * 4
export const maximumChunkMeshQuads = (maximumChunkMeshBytes / meshQuadBytes).floor()
const triangleVertexOffsets: readonly List<number> = [0, 8, 16]

type MeshBudget:
    quads: number

export type MutableMeshBatch:
    budget: MeshBudget
    pipelineKey: string
    layer: BlockRenderLayer
    bankKey: string
    materialKey: string
    animationKey: string?
    positions: Float32Builder
    normals: Float32Builder
    uvs: Float32Builder
    textureLayers: Float32Builder
    tintRoles: Float32Builder
    colors: Float32Builder
    indices: UInt32Builder
    vertexCount: number
    quadCount: number
    triangleCount: number

export def batchFor(
    batches: Map<string, MutableMeshBatch>,
    state: ClientMeshSurface,
    maximumFaces: number,
) -> MutableMeshBatch:
    const materialKey = state.materialKey
    const layer = state.layer
    const bankKey = state.bankKey
    const pipelineKey = state.pipelineKey
    assert materialKey != null and layer != null and bankKey != null and pipelineKey != null else f"Rendered state {state.runtimeId} has no material pipeline"
    const existing = batches.get(pipelineKey)
    if existing != null: return existing
    const first = batches.iterator().next()?.value
    const budget = first == null ? {quads: 0} : batches.get(first)!.budget
    const created: MutableMeshBatch = {
        budget,
        pipelineKey,
        layer,
        bankKey,
        materialKey,
        animationKey: state.animationKey,
        positions: float32Builder(maximumFaces * 12),
        normals: float32Builder(maximumFaces * 12),
        uvs: float32Builder(maximumFaces * 8),
        textureLayers: float32Builder(maximumFaces * 4),
        tintRoles: float32Builder(maximumFaces * 4),
        colors: float32Builder(maximumFaces * 16),
        indices: uint32Builder(maximumFaces * 6),
        vertexCount: 0,
        quadCount: 0,
        triangleCount: 0,
    }
    batches.set(pipelineKey, created)
    return created

def pushVertex(
    batch: MutableMeshBatch,
    state: ClientMeshSurface,
    shade: number,
    x: number,
    y: number,
    z: number,
    nx: number,
    ny: number,
    nz: number,
    u: number,
    v: number,
    textureLayer: number,
    tintRole: number,
    red: number = 1,
    green: number = 1,
    blue: number = 1,
    alpha: number = 1,
):
    batch.positions.push(x)
    batch.positions.push(y)
    batch.positions.push(z)
    batch.normals.push(nx)
    batch.normals.push(ny)
    batch.normals.push(nz)
    batch.uvs.push(u)
    batch.uvs.push(v)
    batch.textureLayers.push(textureLayer)
    batch.tintRoles.push(tintRole)
    batch.colors.push(state.tintRed * shade * red)
    batch.colors.push(state.tintGreen * shade * green)
    batch.colors.push(state.tintBlue * shade * blue)
    batch.colors.push(alpha)

export def emitQuad(
    batch: MutableMeshBatch,
    state: ClientMeshSurface,
    face: MeshFace,
    texture: ClientTextureVariant,
    ax: number,
    ay: number,
    az: number,
    bx: number,
    by: number,
    bz: number,
    cx: number,
    cy: number,
    cz: number,
    dx: number,
    dy: number,
    dz: number,
    nx: number,
    ny: number,
    nz: number,
    alpha: number = 1,
    aoA: number = 1,
    aoB: number = 1,
    aoC: number = 1,
    aoD: number = 1,
):
    assert batch.budget.quads < maximumChunkMeshQuads else "Chunk mesh exceeds the 8 MiB geometry budget"
    batch.budget.quads += 1
    const first = batch.vertexCount
    const shade = faceShade(face, state.emission)
    const tintRole = climateTintRole(state, face)
    pushVertex(batch, state, shade * aoA, ax, ay, az, nx, ny, nz, 0, 0, texture.layer, tintRole, 1, 1, 1, alpha)
    pushVertex(batch, state, shade * aoB, bx, by, bz, nx, ny, nz, 1, 0, texture.layer, tintRole, 1, 1, 1, alpha)
    pushVertex(batch, state, shade * aoC, cx, cy, cz, nx, ny, nz, 1, 1, texture.layer, tintRole, 1, 1, 1, alpha)
    pushVertex(batch, state, shade * aoD, dx, dy, dz, nx, ny, nz, 0, 1, texture.layer, tintRole, 1, 1, 1, alpha)
    // Choose the diagonal with the smoother occlusion interpolation.
    if aoA + aoC > aoB + aoD:
        batch.indices.push(first)
        batch.indices.push(first + 1)
        batch.indices.push(first + 3)
        batch.indices.push(first + 1)
        batch.indices.push(first + 2)
        batch.indices.push(first + 3)
    else:
        batch.indices.push(first)
        batch.indices.push(first + 1)
        batch.indices.push(first + 2)
        batch.indices.push(first)
        batch.indices.push(first + 2)
        batch.indices.push(first + 3)
    batch.vertexCount += 4
    batch.quadCount += 1

export type FinishedMeshBatches:
    batches: List<ChunkMeshBatch>
    quadCount: number
    byteSize: number

/// 任意模型保留三角形和原始法线，不生成退化四边形。预算按一个 quad 保守计费，
/// 最终仍以实际字节数检查；因此与体素面共享硬上限、批次和一次 GPU 上传。
export def emitModelTriangle(batch: MutableMeshBatch, state: ClientMeshSurface, triangle: ClientModelTriangle, texture: ClientTextureVariant, x: number, y: number, z: number, cosine: number, sine: number, tintRole: number):
    assert batch.budget.quads < maximumChunkMeshQuads else "Chunk mesh exceeds the 8 MiB geometry budget"
    const geometry = state.geometry
    assert geometry != null else "Model triangle requires resolved geometry"
    batch.budget.quads += 1
    const first = batch.vertexCount
    const values = triangle.vertices
    for offset in triangleVertexOffsets:
        const px = values[offset] - 0.5
        const pz = values[offset + 2] - 0.5
        const nx = values[offset + 3]
        const nz = values[offset + 5]
        pushVertex(batch, state, 1, x + 0.5 + px * cosine - pz * sine, y + values[offset + 1], z + 0.5 + px * sine + pz * cosine,
            nx * cosine - nz * sine, values[offset + 4], nx * sine + nz * cosine, values[offset + 6], values[offset + 7], texture.layer, tintRole,
            geometry.color[0], geometry.color[1], geometry.color[2])
    batch.indices.push(first)
    batch.indices.push(first + 1)
    batch.indices.push(first + 2)
    batch.vertexCount += 3
    batch.triangleCount += 1

/// Finalize each pipeline once in stable order and enforce the complete upload bound.
export def finishMeshBatches(batches: Map<string, MutableMeshBatch>) -> FinishedMeshBatches:
    const finished: List<ChunkMeshBatch> = []
    let quadCount = 0
    let byteSize = 0
    for key in batches.keys().sorted():
        const batch = batches.get(key)!
        if batch.quadCount == 0 and batch.triangleCount == 0: continue
        const output: ChunkMeshBatch = {
            pipelineKey: batch.pipelineKey,
            layer: batch.layer,
            bankKey: batch.bankKey,
            materialKey: batch.materialKey,
            animationKey: batch.animationKey,
            positions: batch.positions.finish(),
            normals: batch.normals.finish(),
            uvs: batch.uvs.finish(),
            textureLayers: batch.textureLayers.finish(),
            tintRoles: batch.tintRoles.finish(),
            colors: batch.colors.finish(),
            indices: batch.indices.finish(),
            quadCount: batch.quadCount,
            triangleCount: batch.triangleCount,
        }
        quadCount += output.quadCount
        byteSize += (output.positions.size + output.normals.size + output.uvs.size + output.textureLayers.size + output.tintRoles.size + output.colors.size + output.indices.size) * 4
        assert byteSize <= maximumChunkMeshBytes else "Chunk mesh exceeds the 8 MiB output bound"
        finished.append(output)
    return {batches: finished, quadCount, byteSize}
