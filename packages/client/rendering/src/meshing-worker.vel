import {Cancellation} from "velar/task"
import {serveWorker} from "velar/worker"
import {ClientRenderState, MeshingWorkerRequest, MeshingWorkerResponse, meshingWorkerOperations} from "./contracts.vel"
import {indexRenderStates, meshChunkWithIndex} from "./mesher.vel"

let activeStates: Map<number, readonly ClientRenderState>? = null

async def handleMeshingWorker(request: readonly MeshingWorkerRequest, cancellation: Cancellation) -> MeshingWorkerResponse:
    await cancellation.checkpoint()
    if request.operation == meshingWorkerOperations.initialize:
        const states = request.states
        assert states != null and states.size > 0 else "Meshing Worker initialization requires render states"
        activeStates = indexRenderStates(states)
        return {operation: request.operation, ready: true}
    if request.operation == meshingWorkerOperations.mesh:
        const states = activeStates
        const position = request.position
        const edge = request.edge
        const paddedBlocks = request.paddedBlocks
        const ticket = request.ticket
        assert states != null else "Meshing Worker is not initialized"
        assert position != null and edge != null and paddedBlocks != null and ticket != null else "Meshing Worker request is incomplete"
        const mesh = meshChunkWithIndex(position, edge, paddedBlocks, states, ticket)
        await cancellation.checkpoint()
        return {operation: request.operation, mesh}
    throw Error(f"Unsupported Meshing Worker operation {request.operation}")

/// 这是 @openvoxel/renderer/meshing-worker 的唯一宿主启动 API。精确包入口
/// 只闭包构网依赖；Babylon 表面和内置资源包仍只属于渲染器主入口。
export def serveMeshingWorker(): serveWorker(MeshingWorkerRequest, MeshingWorkerResponse, handleMeshingWorker, 32)
