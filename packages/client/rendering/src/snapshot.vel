import {ChunkPosition, requireChunkEdge, requireChunkPosition} from "@openvoxel/world"
import {UInt32Buffer, uint32Buffer} from "velar/binary"

def paddedIndex(x: number, y: number, z: number, edge: number) -> number: return x + edge * (z + edge * y)

def chunkIndex(x: number, y: number, z: number, edge: number) -> number: return x + edge * (z + edge * y)

/// 构网快照只依赖 Chunk 的线性只读视图，不依赖客户端会话或存储实现。
export type ClientChunkBlockView:
    readonly position: readonly ChunkPosition
    readonly edge: number
    blockAtIndex: (index: number) -> number

/// 网格只读取已经捕获的中心 Chunk 与六个相邻面。先解析六个邻居，再按线性索引
/// 复制，避免为 18³ 快照中的每个方块重复做世界坐标定位和 Chunk Map 查询。
/// 缺失邻居以当前内容目录的空气 runtimeId 填充；调用方在邻居载入或卸载时
/// 会让仍驻留的边界 Chunk 失效，因此共享边界的剔除结果可以收敛。
export def snapshotChunkNeighborhood(
    center: readonly ClientChunkBlockView,
    chunk: (position: readonly ChunkPosition) -> readonly ClientChunkBlockView?,
    missingRuntimeId: number = 0,
) -> UInt32Buffer:
    const position = center.position
    const edge = center.edge
    requireChunkPosition(position)
    requireChunkEdge(edge)
    const paddedEdge = edge + 2
    const snapshot = uint32Buffer(paddedEdge * paddedEdge * paddedEdge)
    if missingRuntimeId != 0:
        for index in range(snapshot.size): snapshot[index] = missingRuntimeId

    def resolve(dx: number, dy: number, dz: number) -> readonly ClientChunkBlockView?:
        const expected: ChunkPosition = {x: position.x + dx, y: position.y + dy, z: position.z + dz}
        const value = chunk(expected)
        if value != null:
            assert value.edge == edge else "Chunk neighborhood changed edge"
            assert value.position.x == expected.x and value.position.y == expected.y and value.position.z == expected.z else "Chunk neighborhood returned the wrong position"
        return value

    const centerBlockAtIndex = center.blockAtIndex
    for y in range(edge):
        for z in range(edge):
            for x in range(edge):
                snapshot[paddedIndex(x + 1, y + 1, z + 1, paddedEdge)] = centerBlockAtIndex(chunkIndex(x, y, z, edge))

    const west = resolve(-1, 0, 0)
    const east = resolve(1, 0, 0)
    const below = resolve(0, -1, 0)
    const above = resolve(0, 1, 0)
    const north = resolve(0, 0, -1)
    const south = resolve(0, 0, 1)
    if west != null:
        const blockAtIndex = west.blockAtIndex
        for y in range(edge):
            for z in range(edge):
                snapshot[paddedIndex(0, y + 1, z + 1, paddedEdge)] = blockAtIndex(chunkIndex(edge - 1, y, z, edge))
    if east != null:
        const blockAtIndex = east.blockAtIndex
        for y in range(edge):
            for z in range(edge):
                snapshot[paddedIndex(edge + 1, y + 1, z + 1, paddedEdge)] = blockAtIndex(chunkIndex(0, y, z, edge))
    if below != null:
        const blockAtIndex = below.blockAtIndex
        for z in range(edge):
            for x in range(edge):
                snapshot[paddedIndex(x + 1, 0, z + 1, paddedEdge)] = blockAtIndex(chunkIndex(x, edge - 1, z, edge))
    if above != null:
        const blockAtIndex = above.blockAtIndex
        for z in range(edge):
            for x in range(edge):
                snapshot[paddedIndex(x + 1, edge + 1, z + 1, paddedEdge)] = blockAtIndex(chunkIndex(x, 0, z, edge))
    if north != null:
        const blockAtIndex = north.blockAtIndex
        for y in range(edge):
            for x in range(edge):
                snapshot[paddedIndex(x + 1, y + 1, 0, paddedEdge)] = blockAtIndex(chunkIndex(x, y, edge - 1, edge))
    if south != null:
        const blockAtIndex = south.blockAtIndex
        for y in range(edge):
            for x in range(edge):
                snapshot[paddedIndex(x + 1, y + 1, edge + 1, paddedEdge)] = blockAtIndex(chunkIndex(x, y, 0, edge))
    return snapshot
