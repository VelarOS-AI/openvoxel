import {ClientBlockModelKind, ClientClimateTint, ClientTextureVariant, ClientTintCoverage} from "./contracts.vel"

/// 客户端资源包把世界内容中的逻辑资源身份解析成有界的呈现配方。
/// 这个格式没有 runtimeId 字段；数字状态只通过 WorldContentResponse 的状态目录
/// 到达 RenderCatalog，资源包本身不会成为第二份方块目录。

export enum ClientTextureBankRole:
    opaque
    cutout
    translucent
    fluid

export enum ClientTextureBankStorage:
    texture2dArray = "texture_2d_array"

/// 降水碰到这个呈现表面时采用的反馈；独立于方块运行时身份、染色和透明层。
export enum ClientPrecipitationSurface:
    permeable = "none"
    solid
    water

const maximumTextureBankChannelBytes = 16 * 1024 * 1024
const maximumClientTextureResidentBytes = 128 * 1024 * 1024

export type ClientTextureBankLevel:
    readonly width: number
    readonly height: number
    readonly albedoData: string
    readonly normalData: string
    readonly materialData: string
    readonly emissiveData: string

export type ClientTextureBank:
    readonly key: string
    readonly role: ClientTextureBankRole
    readonly storage: ClientTextureBankStorage
    readonly layerCount: number
    /// 每个 mip level 的四个 RGBA8 数据块共享 layer 顺序并按 GPU 的自下而上
    /// 行序保存；材质层按 R=AO、G=roughness、B=metallic 编码。
    readonly levels: readonly List<readonly ClientTextureBankLevel>

export type ClientSkyEnvironmentResources:
    readonly sunDataUrl: string
    readonly glowDataUrl: string
    readonly starDataUrl: string
    readonly moonDataUrls: readonly List<string>

export type ClientCloudEnvironmentResources:
    readonly textureDataUrl: string

export type ClientPrecipitationEnvironmentResources:
    readonly rainDataUrl: string
    readonly rainSplashDataUrl: string
    readonly snowDataUrl: string

export type ClientResourceEnvironment:
    readonly sky: readonly ClientSkyEnvironmentResources
    readonly clouds: readonly ClientCloudEnvironmentResources
    readonly precipitation: readonly ClientPrecipitationEnvironmentResources

export type ClientModelResource:
    readonly key: string
    readonly kind: ClientBlockModelKind

export type ClientMaterialResource:
    readonly key: string
    readonly precipitationSurface: ClientPrecipitationSurface
    readonly alpha: number
    readonly alphaCutoff: number
    readonly doubleSided: bool
    readonly castsShadows: bool
    readonly environmentIntensity: number
    readonly clearCoat: number
    readonly clearCoatRoughness: number
    readonly unlit: bool

/// layer 是所属纹理数组中的稳定层索引；weight 只参与确定性的表面变体选择，
/// 不改变纹理的逻辑资源身份。
export type ClientTextureResource:
    readonly key: string
    readonly bankKey: string
    /// cutout 纹理记录生成 mip 时使用的实际材质阈值；其他 bank 必须为 null。
    readonly alphaCutoff: number?
    readonly variants: readonly List<readonly ClientTextureVariant>

export type ClientTintResource:
    readonly key: string
    readonly climate: ClientClimateTint
    readonly coverage: ClientTintCoverage
    readonly red: number
    readonly green: number
    readonly blue: number

export type ClientAnimationResource:
    readonly key: string
    readonly frameDurationMs: number
    readonly frames: readonly List<string>

export type ClientResourcePackArtifact:
    readonly artifactVersion: number
    readonly formatVersion: number
    readonly owner: string
    readonly targetContentHash: string
    readonly resourceHash: string
    readonly textureBanks: readonly List<readonly ClientTextureBank>
    readonly environment: readonly ClientResourceEnvironment
    readonly models: readonly List<readonly ClientModelResource>
    readonly materials: readonly List<readonly ClientMaterialResource>
    readonly textures: readonly List<readonly ClientTextureResource>
    readonly tints: readonly List<readonly ClientTintResource>
    readonly animations: readonly List<readonly ClientAnimationResource>

def requireHash(value: string, label: string):
    assert Text.matches(value, r"^[0-9a-f]{64}$") else f"{label} must be a lowercase SHA-256 value"

def requireOwnedKey(key: string, owner: string, label: string):
    assert key.startsWith(f"{owner}:") else f"{label} {key} does not belong to resource pack {owner}"

def requireUnit(value: number, label: string):
    assert value.isFinite() and value >= 0 and value <= 1 else f"{label} must be from 0 through 1"

def requireUniqueKey(key: string, keys: Set<string>, owner: string, label: string):
    requireOwnedKey(key, owner, label)
    assert key not in keys else f"Client resource pack repeats {label} {key}"
    keys.add(key)

def requireTextureData(value: string, expectedBytes: number, label: string):
    const expectedEncodedSize = ((expectedBytes + 2) / 3).floor() * 4
    assert value.size == expectedEncodedSize else f"{label} must be complete RGBA8 base64 data"
    const remainder = expectedBytes % 3
    let hasCanonicalPadding = false
    if remainder == 0: hasCanonicalPadding = Text.matches(value, r"^[A-Za-z0-9+/]+$")
    else if remainder == 1: hasCanonicalPadding = Text.matches(value, r"^[A-Za-z0-9+/]+==$")
    else: hasCanonicalPadding = Text.matches(value, r"^[A-Za-z0-9+/]+=$")
    assert hasCanonicalPadding else f"{label} must be complete RGBA8 base64 data"

def requireEmbeddedWebp(value: string, label: string):
    assert value.startsWith("data:image/webp;base64,") else f"{label} must be an embedded WebP image"

/// 包内 JSON 已由生成阶段计算 resourceHash；运行时再次验证结构、范围、命名空间
/// 和交叉引用，避免损坏的静态资源走到图形引擎边界。
export def validateClientResourcePack(artifact: readonly ClientResourcePackArtifact) -> readonly ClientResourcePackArtifact:
    assert artifact.artifactVersion == 8 else "Unsupported client resource pack artifact version"
    assert artifact.formatVersion == 8 else "Unsupported client resource pack format version"
    assert Text.matches(artifact.owner, r"^[a-z][a-z0-9_.-]*$") else "Client resource pack owner is invalid"
    requireHash(artifact.targetContentHash, "Client resource target content hash")
    requireHash(artifact.resourceHash, "Client resource hash")
    requireEmbeddedWebp(artifact.environment.sky.sunDataUrl, "Client resource sun")
    requireEmbeddedWebp(artifact.environment.sky.glowDataUrl, "Client resource sky glow")
    requireEmbeddedWebp(artifact.environment.sky.starDataUrl, "Client resource star")
    assert artifact.environment.sky.moonDataUrls.size == 8 else "Client resources need exactly eight moon phase images"
    for dataUrl in artifact.environment.sky.moonDataUrls: requireEmbeddedWebp(dataUrl, "Client resource moon phase")
    requireEmbeddedWebp(artifact.environment.clouds.textureDataUrl, "Client resource clouds")
    requireEmbeddedWebp(artifact.environment.precipitation.rainDataUrl, "Client resource rain")
    requireEmbeddedWebp(artifact.environment.precipitation.rainSplashDataUrl, "Client resource rain splash")
    requireEmbeddedWebp(artifact.environment.precipitation.snowDataUrl, "Client resource snow")

    const textureBankKeys: Set<string> = Set()
    const textureBankLayers: Map<string, number> = Map()
    const textureBankRoles: Map<string, ClientTextureBankRole> = Map()
    const referencedLayers: Set<string> = Set()
    const modelKeys: Set<string> = Set()
    const materialKeys: Set<string> = Set()
    const textureKeys: Set<string> = Set()
    const texturesByKey: Map<string, readonly ClientTextureResource> = Map()
    const tintKeys: Set<string> = Set()
    const animationKeys: Set<string> = Set()
    let estimatedResidentTextureBytes = 0
    for bank in artifact.textureBanks:
        requireUniqueKey(bank.key, textureBankKeys, artifact.owner, "texture bank")
        assert bank.storage == ClientTextureBankStorage.texture2dArray else f"Texture bank {bank.key} uses unsupported storage {bank.storage}"
        assert bank.layerCount.isInteger() and bank.layerCount > 0 and bank.layerCount <= 2048 else f"Texture bank {bank.key} layer count is invalid"
        assert bank.levels.size > 0 and bank.levels.size <= 9 else f"Texture bank {bank.key} mip level count is invalid"
        let previousWidth = 0
        let previousHeight = 0
        let channelBytes = 0
        let encodedCharacters = 0
        for level, levelIndex in bank.levels:
            assert level.width.isInteger() and level.width > 0 and level.width <= 256 else f"Texture bank {bank.key} mip {levelIndex} width is invalid"
            assert level.height.isInteger() and level.height > 0 and level.height <= 256 else f"Texture bank {bank.key} mip {levelIndex} height is invalid"
            if levelIndex > 0:
                assert previousWidth > 1 or previousHeight > 1 else f"Texture bank {bank.key} has a mip level after 1x1"
                assert level.width == Math.max(1, (previousWidth / 2).floor()) and level.height == Math.max(1, (previousHeight / 2).floor()) else f"Texture bank {bank.key} mip {levelIndex} dimensions are invalid"
            previousWidth = level.width
            previousHeight = level.height
            const expectedBytes = level.width * level.height * bank.layerCount * 4
            channelBytes += expectedBytes
            const expectedEncodedSize = ((expectedBytes + 2) / 3).floor() * 4
            encodedCharacters += expectedEncodedSize * 4
            assert channelBytes <= maximumTextureBankChannelBytes else f"Texture bank {bank.key} exceeds the 16 MiB per-channel limit"
            const currentResidentBytes = channelBytes * 4 * 2 + encodedCharacters * 2
            assert estimatedResidentTextureBytes + currentResidentBytes <= maximumClientTextureResidentBytes else "Client resource pack exceeds the 128 MiB estimated resident texture limit"
            requireTextureData(level.albedoData, expectedBytes, f"Texture bank {bank.key} mip {levelIndex} albedo")
            requireTextureData(level.normalData, expectedBytes, f"Texture bank {bank.key} mip {levelIndex} normal map")
            requireTextureData(level.materialData, expectedBytes, f"Texture bank {bank.key} mip {levelIndex} material map")
            requireTextureData(level.emissiveData, expectedBytes, f"Texture bank {bank.key} mip {levelIndex} emissive map")
        if bank.levels.size > 1:
            assert previousWidth == 1 and previousHeight == 1 else f"Texture bank {bank.key} mip chain is incomplete"
        const rgbaBytes = channelBytes * 4
        estimatedResidentTextureBytes += rgbaBytes * 2 + encodedCharacters * 2
        textureBankLayers.set(bank.key, bank.layerCount)
        textureBankRoles.set(bank.key, bank.role)
    assert estimatedResidentTextureBytes <= maximumClientTextureResidentBytes else "Client resource pack exceeds the 128 MiB estimated resident texture limit"
    for value in artifact.models: requireUniqueKey(value.key, modelKeys, artifact.owner, "model")
    for value in artifact.materials: requireUniqueKey(value.key, materialKeys, artifact.owner, "material")
    for value in artifact.textures:
        requireUniqueKey(value.key, textureKeys, artifact.owner, "texture")
        texturesByKey.set(value.key, value)
    for value in artifact.tints: requireUniqueKey(value.key, tintKeys, artifact.owner, "tint")
    for value in artifact.animations: requireUniqueKey(value.key, animationKeys, artifact.owner, "animation")

    for material in artifact.materials:
        requireUnit(material.alpha, f"Material {material.key} alpha")
        requireUnit(material.alphaCutoff, f"Material {material.key} alpha cutoff")
        assert material.environmentIntensity.isFinite() and material.environmentIntensity >= 0 and material.environmentIntensity <= 4 else f"Material {material.key} environment intensity must be from 0 through 4"
        requireUnit(material.clearCoat, f"Material {material.key} clear coat")
        requireUnit(material.clearCoatRoughness, f"Material {material.key} clear coat roughness")
    for texture in artifact.textures:
        assert texture.bankKey in textureBankKeys else f"Texture {texture.key} references unknown texture bank {texture.bankKey}"
        const bankRole = textureBankRoles.get(texture.bankKey)!
        if bankRole == ClientTextureBankRole.cutout:
            assert texture.alphaCutoff != null else f"Cutout texture {texture.key} has no mip alpha cutoff"
            requireUnit(texture.alphaCutoff, f"Texture {texture.key} alpha cutoff")
        else:
            assert texture.alphaCutoff == null else f"Texture {texture.key} outside the cutout bank declares an alpha cutoff"
        assert texture.variants.size > 0 else f"Texture {texture.key} has no surface variants"
        const layerCount = textureBankLayers.get(texture.bankKey)!
        let totalWeight = 0
        for variant in texture.variants:
            assert variant.layer.isInteger() and variant.layer >= 0 and variant.layer < layerCount else f"Texture {texture.key} variant layer is invalid"
            const layerKey = f"{texture.bankKey}:{variant.layer}"
            assert layerKey not in referencedLayers else f"Texture array layer {layerKey} is assigned more than once"
            referencedLayers.add(layerKey)
            assert variant.weight.isInteger() and variant.weight >= 1 and variant.weight <= 1024 else f"Texture {texture.key} variant weight is invalid"
            totalWeight += variant.weight
        assert totalWeight <= 65_535 else f"Texture {texture.key} variant weights exceed the supported total"
    for bank in artifact.textureBanks:
        for layer in range(bank.layerCount):
            assert f"{bank.key}:{layer}" in referencedLayers else f"Texture bank {bank.key} has orphan layer {layer}"
    for tint in artifact.tints:
        assert tint.coverage != ClientTintCoverage.grassCap or tint.climate == ClientClimateTint.grass else "Grass-cap tint coverage requires the grass climate policy"
        requireUnit(tint.red, f"Tint {tint.key} red")
        requireUnit(tint.green, f"Tint {tint.key} green")
        requireUnit(tint.blue, f"Tint {tint.key} blue")

    for animation in artifact.animations:
        assert animation.frameDurationMs.isInteger() and animation.frameDurationMs >= 16 and animation.frameDurationMs <= 60_000 else f"Animation {animation.key} frame duration is invalid"
        assert animation.frames.size >= 2 else f"Animation {animation.key} needs at least two frames"
        const firstFrameTexture = texturesByKey.get(animation.frames[0])!
        let frameBankKey: string? = null
        const frameLayers: Set<string> = Set()
        for frame in animation.frames:
            assert frame in textureKeys else f"Animation {animation.key} references unknown texture {frame}"
            const texture = texturesByKey.get(frame)!
            assert texture.variants.size == 1 else f"Animation {animation.key} frame {frame} must have exactly one texture layer"
            assert texture.alphaCutoff == firstFrameTexture.alphaCutoff else f"Animation {animation.key} frames must use one alpha cutoff"
            const frameLayer = f"{texture.bankKey}:{texture.variants[0].layer}"
            assert frameLayer not in frameLayers else f"Animation {animation.key} repeats texture layer {frameLayer}"
            frameLayers.add(frameLayer)
            if frameBankKey == null: frameBankKey = texture.bankKey
            else:
                assert texture.bankKey == frameBankKey else f"Animation {animation.key} frames must use one texture bank"
    return artifact
