import {ChunkMesh} from "./contracts.vel"
import {WorldClimateSample, WorldEnvironmentSample, worldClimateAt} from "@openvoxel/world"
import {BabylonVoxelEnvironmentFactory, VoxelEnvironmentStats, createBabylonVoxelEnvironment} from "./environment/babylon-environment.vel"
import {ClientEnvironmentFrame, environmentFrame} from "./environment/frame.vel"
import {BabylonVoxelNavigationFactory, BabylonVoxelNavigationHandle, CreativeFlightStep, SurvivalWalkStep, VoxelMovementMode, VoxelNavigationMode, VoxelNavigationStats, createBabylonVoxelNavigation} from "./navigation/babylon-navigation.vel"
import {CreativeFlightState, creativeFlightState, stepCreativeFlight} from "./navigation/creative-flight.vel"
import {SurvivalCollisionQuery, SurvivalWalkState, stepSurvivalWalk, survivalEyeHeight, survivalPlayerHeight, survivalWalkState} from "./navigation/survival-walk.vel"
import {ClientRenderCatalog} from "./render-catalog.vel"
import {ClientAnimationResource, ClientMaterialResource, ClientResourceEnvironment, ClientTextureBank, ClientTextureResource} from "./resource-pack.vel"

export {VoxelEnvironmentStats} from "./environment/babylon-environment.vel"
export {VoxelMovementMode, VoxelNavigationMode, VoxelNavigationStats} from "./navigation/babylon-navigation.vel"

export type VoxelSurfaceOptions:
    readonly textureBanks: readonly List<readonly ClientTextureBank>
    readonly environmentResources: readonly ClientResourceEnvironment
    readonly environmentFrame: readonly ClientEnvironmentFrame
    readonly climateAt: (worldMilliseconds: number, x: number, y: number, z: number) -> WorldClimateSample
    readonly edge: number
    readonly materials: readonly List<readonly ClientMaterialResource>
    readonly textures: readonly List<readonly ClientTextureResource>
    readonly animations: readonly List<readonly ClientAnimationResource>
    readonly targetX: number
    readonly targetY: number
    readonly targetZ: number
    readonly horizontalChunkRadius: number
    readonly navigationMode: VoxelNavigationMode
    readonly movementMode: VoxelMovementMode
    readonly collisionAt: SurvivalCollisionQuery
    readonly survivalEyeHeight: number
    readonly survivalPlayerHeight: number
    readonly minimumWorldY: number
    readonly maximumWorldY: number
    readonly viewChanged: (chunkX: number, chunkY: number, chunkZ: number, forwardX: number, forwardY: number, forwardZ: number) -> null

export type VoxelSurfaceStats:
    readonly chunks: number
    readonly meshes: number
    readonly quads: number
    readonly uploadQueuedChunks: number
    readonly translucentSortQueuedMeshes: number
    readonly navigationMode: VoxelNavigationMode
    readonly movementMode: VoxelMovementMode
    readonly viewX: number
    readonly viewY: number
    readonly viewZ: number
    readonly viewChunkX: number
    readonly viewChunkY: number
    readonly viewChunkZ: number
    readonly forwardX: number
    readonly forwardY: number
    readonly forwardZ: number
    readonly pointerLocked: bool

type BabylonVoxelSurfaceDependencies:
    readonly createEnvironment: BabylonVoxelEnvironmentFactory
    readonly createNavigation: BabylonVoxelNavigationFactory
    readonly createFlightState: (x: number, y: number, z: number) -> CreativeFlightState
    readonly createSurvivalState: (x: number, y: number, z: number) -> SurvivalWalkState
    readonly stepFlight: CreativeFlightStep
    readonly stepSurvival: SurvivalWalkStep

extern module "#openvoxel/renderer/babylon-surface":
    export class BabylonVoxelSurface:
        def setChunkMesh(mesh: readonly ChunkMesh) -> null
        async def enqueueChunkMesh(mesh: readonly ChunkMesh) -> bool
        def removeChunk(x: number, y: number, z: number) -> null
        def stats() -> VoxelSurfaceStats
        def environmentStats() -> VoxelEnvironmentStats
        def setEnvironmentFrame(frame: readonly ClientEnvironmentFrame) -> null
        def release() -> null

    export async def createSurfaceAdapter(
        canvas: CanvasElement,
        options: readonly VoxelSurfaceOptions,
        dependencies: readonly BabylonVoxelSurfaceDependencies,
    ) -> BabylonVoxelSurface

import js {BabylonVoxelSurface, createSurfaceAdapter} from "#openvoxel/renderer/babylon-surface"

/// 渲染职责包只暴露 OpenVoxel 自己的窄表面；Babylon 类、Scene、Mesh 和 GPU 资源均
/// 停留在私有 JS 适配器中。
export type VoxelRenderSurface:
    setChunkMesh: (mesh: readonly ChunkMesh) -> null
    enqueueChunkMesh: (mesh: readonly ChunkMesh) -> Promise<bool>
    removeChunk: (x: number, y: number, z: number) -> null
    stats: () -> VoxelSurfaceStats
    environmentStats: () -> VoxelEnvironmentStats
    setEnvironment: (sample: readonly WorldEnvironmentSample) -> null
    release: () -> null

export async def openVoxelRenderSurface(
    canvas: CanvasElement,
    catalog: readonly ClientRenderCatalog,
    edge: number,
    targetX: number,
    targetY: number,
    targetZ: number,
    horizontalChunkRadius: number,
    viewChanged: (chunkX: number, chunkY: number, chunkZ: number, forwardX: number, forwardY: number, forwardZ: number) -> null,
    initialEnvironment: readonly WorldEnvironmentSample,
    navigationMode: VoxelNavigationMode,
    movementMode: VoxelMovementMode,
    collisionAt: SurvivalCollisionQuery,
    minimumWorldY: number,
    maximumWorldY: number,
    worldSeed: string,
) -> VoxelRenderSurface:
    const native: BabylonVoxelSurface = await createSurfaceAdapter(canvas, {
        textureBanks: catalog.textureBanks,
        environmentResources: catalog.environment,
        environmentFrame: environmentFrame(initialEnvironment),
        climateAt: (worldMilliseconds, x, y, z) => worldClimateAt(worldSeed, worldMilliseconds, {x, y, z}),
        edge,
        materials: catalog.materials,
        textures: catalog.textures,
        animations: catalog.animations,
        targetX,
        targetY,
        targetZ,
        horizontalChunkRadius,
        navigationMode,
        movementMode,
        collisionAt,
        survivalEyeHeight,
        survivalPlayerHeight,
        minimumWorldY,
        maximumWorldY,
        viewChanged,
    }, {
        createEnvironment: createBabylonVoxelEnvironment,
        createNavigation: createBabylonVoxelNavigation,
        createFlightState: creativeFlightState,
        createSurvivalState: survivalWalkState,
        stepFlight: stepCreativeFlight,
        stepSurvival: stepSurvivalWalk,
    })

    def setEnvironment(sample: readonly WorldEnvironmentSample): native.setEnvironmentFrame(environmentFrame(sample))

    return {
        setChunkMesh: mesh => native.setChunkMesh(mesh),
        enqueueChunkMesh: mesh => native.enqueueChunkMesh(mesh),
        removeChunk: (x, y, z) => native.removeChunk(x, y, z),
        stats: () => native.stats(),
        environmentStats: () => native.environmentStats(),
        setEnvironment,
        release: () => native.release(),
    }
