import {ChunkMesh} from "./contracts.vel"
import {ClientRenderCatalog} from "./render-catalog.vel"
import {ClientAnimationResource, ClientMaterialResource, ClientTextureBank, ClientTextureResource} from "./resource-pack.vel"

export type VoxelSurfaceOptions:
    readonly textureBanks: readonly List<readonly ClientTextureBank>
    readonly cloudsDataUrl: string
    readonly edge: number
    readonly materials: readonly List<readonly ClientMaterialResource>
    readonly textures: readonly List<readonly ClientTextureResource>
    readonly animations: readonly List<readonly ClientAnimationResource>
    readonly targetX: number
    readonly targetY: number
    readonly targetZ: number
    readonly horizontalChunkRadius: number
    readonly viewChanged: (chunkX: number, chunkY: number, chunkZ: number) -> null

export type VoxelSurfaceStats:
    readonly chunks: number
    readonly meshes: number
    readonly quads: number

extern js`
    import {
      ArcRotateCamera,
      Color3,
      Color4,
      DirectionalLight,
      Engine,
      HemisphericLight,
      Material,
      Mesh,
      MeshBuilder,
      PBRMaterial,
      Scene,
      ShadowGenerator,
      StandardMaterial,
      Texture,
      Vector3,
      VertexData,
    } from "@babylonjs/core";

    const surfaces = new WeakSet();

    function requireCanvas(canvas) {
      if (!(canvas instanceof globalThis.HTMLCanvasElement)) throw new TypeError("Voxel surface requires a canvas element");
      return canvas;
    }

    function requireFinite(value, label) {
      if (typeof value !== "number" || !Number.isFinite(value)) throw new TypeError(label + " must be a finite number");
      return value;
    }

    function requireInteger(value, minimum, maximum, label) {
      if (!Number.isSafeInteger(value) || value < minimum || value > maximum) {
        throw new RangeError(label + " must be an integer from " + minimum + " through " + maximum);
      }
      return value;
    }

    function chunkKey(x, y, z) {
      return x + ":" + y + ":" + z;
    }

    function requireTypedArray(value, Constructor, label) {
      if (!(value instanceof Constructor) || value.byteOffset !== 0 || value.byteLength !== value.buffer.byteLength) {
        throw new TypeError(label + " must be a full-storage " + Constructor.name);
      }
      return value;
    }

    function waitForTexture(scene, dataUrl, mipmaps, samplingMode = Texture.NEAREST_SAMPLINGMODE) {
      return new Promise((resolve, reject) => {
        let texture = null;
        // ResourcePack UV 是左下原点；浏览器解码 PNG 使用左上原点，由 Babylon
        // 在上传阶段翻转一次，不能再把逻辑 UV 当作 PNG 行坐标使用。
        texture = new Texture(
          dataUrl,
          scene,
          !mipmaps,
          true,
          samplingMode,
          () => resolve(texture),
          (message, error) => reject(error instanceof Error ? error : new Error(message || "Voxel texture atlas failed to load")),
        );
      });
    }

    function requireTextureBankDefinitions(value) {
      if (!Array.isArray(value) || value.length === 0) throw new TypeError("Voxel surface texture banks must be a non-empty list");
      const keys = new Set();
      for (const definition of value) {
        if (typeof definition !== "object" || definition === null) throw new TypeError("Voxel surface texture bank must be a record");
        if (typeof definition.key !== "string" || definition.key.length === 0) throw new TypeError("Voxel surface texture bank key must be a non-empty string");
        if (keys.has(definition.key)) throw new Error("Voxel surface repeats texture bank " + definition.key);
        keys.add(definition.key);
        if (!["opaque", "cutout", "translucent", "fluid"].includes(definition.role)) throw new TypeError("Voxel surface texture bank has an invalid role: " + definition.key);
        if (definition.storage !== "atlas") throw new TypeError("Voxel surface texture bank uses unsupported storage: " + definition.key);
        requireInteger(definition.width, 1, 8192, "Texture bank width");
        requireInteger(definition.height, 1, 8192, "Texture bank height");
        if (typeof definition.mipmaps !== "boolean") throw new TypeError("Voxel surface texture bank mipmaps must be boolean: " + definition.key);
        for (const [label, dataUrl] of [
          ["albedo", definition.albedoDataUrl],
          ["normal", definition.normalDataUrl],
          ["material", definition.materialDataUrl],
          ["emissive", definition.emissiveDataUrl],
        ]) {
          if (typeof dataUrl !== "string" || !dataUrl.startsWith("data:image/png;base64,")) {
            throw new TypeError("Voxel surface texture bank " + definition.key + " " + label + " map must be an embedded PNG");
          }
        }
      }
      return value;
    }

    async function loadTextureBank(scene, definition) {
      const samplingMode = definition.mipmaps ? Texture.NEAREST_NEAREST_MIPNEAREST : Texture.NEAREST_SAMPLINGMODE;
      const [albedo, normal, material, emissive] = await Promise.all([
        waitForTexture(scene, definition.albedoDataUrl, definition.mipmaps, samplingMode),
        waitForTexture(scene, definition.normalDataUrl, definition.mipmaps, samplingMode),
        waitForTexture(scene, definition.materialDataUrl, definition.mipmaps, samplingMode),
        waitForTexture(scene, definition.emissiveDataUrl, definition.mipmaps, samplingMode),
      ]);
      for (const [label, texture] of [["albedo", albedo], ["normal", normal], ["material", material], ["emissive", emissive]]) {
        const size = texture.getSize();
        if (size.width !== definition.width || size.height !== definition.height) {
          throw new Error("Texture bank " + definition.key + " " + label + " map dimensions do not match its contract");
        }
        texture.name = "texture-bank:" + definition.key + ":" + label;
        texture.wrapU = Texture.CLAMP_ADDRESSMODE;
        texture.wrapV = Texture.CLAMP_ADDRESSMODE;
      }
      albedo.hasAlpha = true;
      normal.gammaSpace = false;
      material.gammaSpace = false;
      return {key: definition.key, role: definition.role, storage: definition.storage, albedo, normal, material, emissive};
    }

    export class BabylonVoxelSurface {
      constructor(canvas, options, engine, scene, camera, textureBanks, environment) {
        this.canvas = canvas;
        this.options = options;
        this.engine = engine;
        this.scene = scene;
        this.camera = camera;
        this.textureBanks = textureBanks;
        this.environment = environment;
        this.materialDefinitions = new Map(options.materials.map((definition) => [definition.key, definition]));
        this.textureDefinitions = new Map(options.textures.map((definition) => [definition.key, definition]));
        this.animationDefinitions = new Map(options.animations.map((definition) => [definition.key, definition]));
        this.materials = new Map();
        this.animatedMaterials = [];
        this.chunks = new Map();
        this.meshCount = 0;
        this.quadCount = 0;
        this.translucentMeshes = new Set();
        this.lastTranslucentSortPosition = new Vector3(Number.NaN, Number.NaN, Number.NaN);
        this.translucentSortElapsedMs = Number.POSITIVE_INFINITY;
        this.translucentSortDirty = false;
        this.animationClockMs = 0;
        this.released = false;
        this.keys = new Set();
        this.lastViewCenterX = Math.floor(camera.target.x / options.edge);
        this.lastViewCenterY = Math.floor(camera.target.y / options.edge);
        this.lastViewCenterZ = Math.floor(camera.target.z / options.edge);
        this.keyDown = (event) => {
          if (["KeyW", "KeyA", "KeyS", "KeyD", "ShiftLeft", "ShiftRight"].includes(event.code)) {
            event.preventDefault();
            this.keys.add(event.code);
          }
        };
        this.keyUp = (event) => this.keys.delete(event.code);
        this.clearKeys = () => this.keys.clear();
        this.focusCanvas = () => canvas.focus({preventScroll: true});
        canvas.addEventListener("keydown", this.keyDown);
        canvas.addEventListener("keyup", this.keyUp);
        canvas.addEventListener("blur", this.clearKeys);
        canvas.addEventListener("pointerdown", this.focusCanvas);
        this.resizeObserver = new ResizeObserver(() => engine.resize());
        this.resizeObserver.observe(canvas);
        this.render = () => {
          const deltaMs = Math.min(engine.getDeltaTime(), 100);
          this.updateNavigation(deltaMs);
          this.translucentSortElapsedMs += deltaMs;
          this.sortTranslucentFacets();
          this.updateAnimations(deltaMs);
          environment.cloudTexture.uOffset = (environment.cloudTexture.uOffset + deltaMs * 0.0000025) % 1;
          environment.cloudLayer.position.x = camera.target.x;
          environment.cloudLayer.position.z = camera.target.z;
          scene.render();
        };
        engine.runRenderLoop(this.render);
        surfaces.add(this);
      }

      requireLive() {
        if (!surfaces.has(this) || this.released) throw new Error("Voxel surface is released");
      }

      updateNavigation(deltaMs) {
        const deltaSeconds = Math.min(deltaMs / 1000, 0.05);
        let forward = 0;
        let sideways = 0;
        if (this.keys.has("KeyW")) forward += 1;
        if (this.keys.has("KeyS")) forward -= 1;
        if (this.keys.has("KeyD")) sideways += 1;
        if (this.keys.has("KeyA")) sideways -= 1;
        if (forward !== 0 || sideways !== 0) {
          const length = Math.hypot(forward, sideways);
          const speed = this.keys.has("ShiftLeft") || this.keys.has("ShiftRight") ? 32 : 12;
          const step = speed * deltaSeconds / length;
          const forwardX = Math.cos(this.camera.alpha);
          const forwardZ = Math.sin(this.camera.alpha);
          const rightX = -forwardZ;
          const rightZ = forwardX;
          this.camera.target.x += (forwardX * forward + rightX * sideways) * step;
          this.camera.target.z += (forwardZ * forward + rightZ * sideways) * step;
        }
        const centerX = Math.floor(this.camera.target.x / this.options.edge);
        const centerY = Math.floor(this.camera.target.y / this.options.edge);
        const centerZ = Math.floor(this.camera.target.z / this.options.edge);
        if (centerX !== this.lastViewCenterX || centerY !== this.lastViewCenterY || centerZ !== this.lastViewCenterZ) {
          this.lastViewCenterX = centerX;
          this.lastViewCenterY = centerY;
          this.lastViewCenterZ = centerZ;
          this.options.viewChanged(centerX, centerY, centerZ);
        }
      }

      sortTranslucentFacets() {
        const position = this.camera.globalPosition;
        const dx = position.x - this.lastTranslucentSortPosition.x;
        const dy = position.y - this.lastTranslucentSortPosition.y;
        const dz = position.z - this.lastTranslucentSortPosition.z;
        const cameraMoved = !Number.isFinite(dx + dy + dz) || dx * dx + dy * dy + dz * dz >= 0.0625;
        if (!this.translucentSortDirty && !cameraMoved) return;
        if (this.translucentSortElapsedMs < 80) return;
        for (const mesh of this.translucentMeshes) {
          // Facet sorting works in mesh-local space. Chunk meshes carry their world
          // origin as a transform, so a shared world-space camera point sorts every
          // Chunk except the origin incorrectly.
          mesh.facetDepthSortFrom = position.subtract(mesh.position);
          mesh.updateFacetData();
        }
        this.lastTranslucentSortPosition.copyFrom(position);
        this.translucentSortElapsedMs = 0;
        this.translucentSortDirty = false;
      }

      updateAnimations(deltaMs) {
        if (this.animatedMaterials.length === 0) return;
        this.animationClockMs += deltaMs;
        for (const animation of this.animatedMaterials) {
          const frameIndex = Math.floor(this.animationClockMs / animation.frameDurationMs) % animation.frames.length;
          if (frameIndex === animation.frameIndex) continue;
          animation.frameIndex = frameIndex;
          const frame = animation.frames[frameIndex];
          for (const texture of animation.textures) {
            texture.uOffset = frame.uOffset;
            texture.vOffset = frame.vOffset;
          }
        }
      }

      materialFor(batch) {
        const key = batch.pipelineKey;
        const expectedKey = batch.layer + "|" + batch.bankKey + "|" + batch.materialKey + "|" + (batch.animationKey ?? "-");
        if (key !== expectedKey) throw new Error("Voxel material pipeline key does not match its batch contract");
        const existing = this.materials.get(key);
        if (existing !== undefined) return existing;
        const definition = this.materialDefinitions.get(batch.materialKey);
        if (definition === undefined) throw new Error("Unknown voxel material " + batch.materialKey);
        const textureBank = this.textureBanks.get(batch.bankKey);
        if (textureBank === undefined) throw new Error("Unknown voxel texture bank " + batch.bankKey);
        if (textureBank.role !== batch.layer && !(batch.layer === "translucent" && textureBank.role === "fluid")) {
          throw new Error("Voxel texture bank " + batch.bankKey + " cannot serve render layer " + batch.layer);
        }
        const material = new PBRMaterial("material:" + key, this.scene);
        const albedoTexture = textureBank.albedo.clone();
        albedoTexture.name = "albedo-bank:" + batch.bankKey + ":" + key;
        albedoTexture.hasAlpha = true;
        albedoTexture.wrapU = Texture.CLAMP_ADDRESSMODE;
        albedoTexture.wrapV = Texture.CLAMP_ADDRESSMODE;
        const normalTexture = textureBank.normal.clone();
        normalTexture.name = "normal-bank:" + batch.bankKey + ":" + key;
        normalTexture.gammaSpace = false;
        normalTexture.wrapU = Texture.CLAMP_ADDRESSMODE;
        normalTexture.wrapV = Texture.CLAMP_ADDRESSMODE;
        const materialTexture = textureBank.material.clone();
        materialTexture.name = "material-bank:" + batch.bankKey + ":" + key;
        materialTexture.gammaSpace = false;
        materialTexture.wrapU = Texture.CLAMP_ADDRESSMODE;
        materialTexture.wrapV = Texture.CLAMP_ADDRESSMODE;
        const emissiveTexture = textureBank.emissive.clone();
        emissiveTexture.name = "emissive-bank:" + batch.bankKey + ":" + key;
        emissiveTexture.wrapU = Texture.CLAMP_ADDRESSMODE;
        emissiveTexture.wrapV = Texture.CLAMP_ADDRESSMODE;
        material.albedoTexture = albedoTexture;
        material.bumpTexture = normalTexture;
        material.metallicTexture = materialTexture;
        material.emissiveTexture = emissiveTexture;
        material.albedoColor = Color3.White();
        material.ambientColor = new Color3(0.38, 0.4, 0.38);
        material.emissiveColor = Color3.White();
        material.metallic = 1;
        material.roughness = 1;
        material.useRoughnessFromMetallicTextureAlpha = false;
        material.useRoughnessFromMetallicTextureGreen = true;
        material.useMetallnessFromMetallicTextureBlue = true;
        material.useAmbientOcclusionFromMetallicTextureRed = true;
        material.environmentIntensity = definition.environmentIntensity;
        material.clearCoat.isEnabled = definition.clearCoat > 0;
        material.clearCoat.intensity = definition.clearCoat;
        material.clearCoat.roughness = definition.clearCoatRoughness;
        material.unlit = definition.unlit;
        // OpenVoxel 的网格从外侧观察使用逆时针顶点绕序。Babylon 的右手场景会
        // 默认把 Mesh 设为顺时针正面，因此这里必须在材质边界显式对齐。
        material.sideOrientation = Material.CounterClockWiseSideOrientation;
        material.backFaceCulling = !definition.doubleSided;
        material.twoSidedLighting = definition.doubleSided;
        material.separateCullingPass = definition.doubleSided;
        if (batch.layer === "cutout") {
          material.transparencyMode = Material.MATERIAL_ALPHATEST;
          material.alphaCutOff = definition.alphaCutoff;
          material.useAlphaFromAlbedoTexture = true;
        } else if (batch.layer === "translucent") {
          material.transparencyMode = Material.MATERIAL_ALPHABLEND;
          material.alpha = definition.alpha;
          material.useAlphaFromAlbedoTexture = true;
        } else {
          material.transparencyMode = Material.MATERIAL_OPAQUE;
          material.alpha = 1;
        }
        if (batch.animationKey != null) {
          const animation = this.animationDefinitions.get(batch.animationKey);
          if (animation === undefined) throw new Error("Unknown voxel animation " + batch.animationKey);
          const firstTexture = this.textureDefinitions.get(animation.frames[0]);
          if (firstTexture === undefined || firstTexture.variants.length !== 1) throw new Error("Animated voxel texture must have exactly one variant: " + animation.frames[0]);
          if (firstTexture.bankKey !== batch.bankKey) throw new Error("Voxel animation " + batch.animationKey + " crosses texture banks");
          const base = firstTexture.variants[0];
          const frames = animation.frames.map((key) => {
            const texture = this.textureDefinitions.get(key);
            if (texture === undefined || texture.variants.length !== 1) throw new Error("Animated voxel texture must have exactly one variant: " + key);
            if (texture.bankKey !== batch.bankKey) throw new Error("Voxel animation " + batch.animationKey + " crosses texture banks");
            const frame = texture.variants[0];
            return {uOffset: frame.u0 - base.u0, vOffset: frame.v0 - base.v0};
          });
          if (frames.length > 1) {
            this.animatedMaterials.push({
              frameDurationMs: animation.frameDurationMs,
              frames,
              frameIndex: -1,
              textures: [albedoTexture, normalTexture, materialTexture, emissiveTexture],
            });
          }
        }
        this.materials.set(key, material);
        return material;
      }

      disposeChunk(key) {
        const current = this.chunks.get(key);
        if (current === undefined) return;
        for (const mesh of current.meshes) {
          this.translucentMeshes.delete(mesh);
          this.environment.shadowGenerator.removeShadowCaster(mesh);
          mesh.dispose(false, false);
        }
        this.meshCount -= current.meshes.length;
        this.quadCount -= current.quads;
        this.chunks.delete(key);
      }

      setChunkMesh(chunk) {
        this.requireLive();
        const position = chunk?.position;
        const x = requireInteger(position?.x, -33_554_431, 33_554_431, "Chunk x");
        const y = requireInteger(position?.y, -33_554_431, 33_554_431, "Chunk y");
        const z = requireInteger(position?.z, -33_554_431, 33_554_431, "Chunk z");
        if (!Array.isArray(chunk.batches)) throw new TypeError("Chunk mesh batches must be a list");
        const key = chunkKey(x, y, z);
        this.disposeChunk(key);
        const meshes = [];
        let quads = 0;
        try {
          for (const [index, batch] of chunk.batches.entries()) {
            const positions = requireTypedArray(batch.positions, Float32Array, "Chunk mesh positions");
            const normals = requireTypedArray(batch.normals, Float32Array, "Chunk mesh normals");
            const uvs = requireTypedArray(batch.uvs, Float32Array, "Chunk mesh UVs");
            const colors = requireTypedArray(batch.colors, Float32Array, "Chunk mesh colors");
            const indices = requireTypedArray(batch.indices, Uint32Array, "Chunk mesh indices");
            if (positions.length % 3 !== 0 || normals.length !== positions.length || uvs.length / 2 !== positions.length / 3 || colors.length / 4 !== positions.length / 3) {
              throw new Error("Chunk mesh vertex buffers have inconsistent lengths");
            }
            const mesh = new Mesh("chunk:" + key + ":" + index, this.scene);
            meshes.push(mesh);
            const data = new VertexData();
            data.positions = positions;
            data.normals = normals;
            data.uvs = uvs;
            data.colors = colors;
            data.indices = indices;
            // Babylon 只会在 Mesh 之间排序透明对象。水面和侧壁在一个 Chunk
            // 内仍需按三角形从远到近排序，因此透明索引缓冲必须保持可更新。
            data.applyToMesh(mesh, batch.layer === "translucent");
            mesh.material = this.materialFor(batch);
            mesh.position.set(x * this.options.edge, y * this.options.edge, z * this.options.edge);
            mesh.useVertexColors = true;
            mesh.hasVertexAlpha = false;
            mesh.isPickable = false;
            mesh.checkCollisions = batch.layer === "opaque";
            mesh.receiveShadows = batch.layer !== "translucent";
            // Babylon 会在不同 renderingGroup 之间默认清空深度。体素的 opaque、
            // cutout、translucent 必须留在同一组，由组内队列依次绘制并共享深度。
            mesh.renderingGroupId = 0;
            mesh.freezeWorldMatrix();
            if (batch.layer === "translucent") {
              mesh.mustDepthSortFacets = true;
              this.translucentMeshes.add(mesh);
              this.translucentSortDirty = true;
            } else {
              const definition = this.materialDefinitions.get(batch.materialKey);
              if (definition === undefined) throw new Error("Unknown voxel material " + batch.materialKey);
              if (definition.castsShadows) this.environment.shadowGenerator.addShadowCaster(mesh, false);
            }
            quads += requireInteger(batch.quadCount, 0, 1_000_000, "Chunk mesh quad count");
          }
          this.meshCount += meshes.length;
          this.quadCount += quads;
          this.chunks.set(key, {meshes, quads});
        } catch (error) {
          for (const mesh of meshes) {
            this.translucentMeshes.delete(mesh);
            this.environment.shadowGenerator.removeShadowCaster(mesh);
            mesh.dispose(false, false);
          }
          throw error;
        }
      }

      removeChunk(x, y, z) {
        this.requireLive();
        this.disposeChunk(chunkKey(x, y, z));
      }

      stats() {
        this.requireLive();
        return {chunks: this.chunks.size, meshes: this.meshCount, quads: this.quadCount};
      }

      release() {
        if (!surfaces.has(this) || this.released) return;
        this.released = true;
        this.engine.stopRenderLoop(this.render);
        this.resizeObserver.disconnect();
        this.canvas.removeEventListener("keydown", this.keyDown);
        this.canvas.removeEventListener("keyup", this.keyUp);
        this.canvas.removeEventListener("blur", this.clearKeys);
        this.canvas.removeEventListener("pointerdown", this.focusCanvas);
        for (const key of [...this.chunks.keys()]) this.disposeChunk(key);
        this.translucentMeshes.clear();
        this.animatedMaterials.length = 0;
        for (const material of this.materials.values()) material.dispose(true, true);
        this.materials.clear();
        for (const textureBank of this.textureBanks.values()) {
          textureBank.albedo.dispose();
          textureBank.normal.dispose();
          textureBank.material.dispose();
          textureBank.emissive.dispose();
        }
        this.textureBanks.clear();
        this.scene.dispose();
        this.engine.dispose();
        surfaces.delete(this);
      }
    }

    export async function createBabylonVoxelSurface(canvas, options) {
      canvas = requireCanvas(canvas);
      if (typeof options !== "object" || options === null) throw new TypeError("Voxel surface options must be a record");
      const edge = requireInteger(options.edge, 4, 64, "Voxel Chunk edge");
      const textureBankDefinitions = requireTextureBankDefinitions(options.textureBanks);
      if (typeof options.cloudsDataUrl !== "string" || !options.cloudsDataUrl.startsWith("data:image/webp;base64,")) throw new TypeError("Voxel surface clouds must be an embedded WebP image");
      if (!Array.isArray(options.materials) || !Array.isArray(options.textures) || !Array.isArray(options.animations)) throw new TypeError("Voxel surface resources must be lists");
      if (typeof options.viewChanged !== "function") throw new TypeError("Voxel surface viewChanged must be a function");
      if (canvas.tabIndex < 0) canvas.tabIndex = 0;
      const engine = new Engine(canvas, true, {preserveDrawingBuffer: false, stencil: true, antialias: true}, true);
      const scene = new Scene(engine);
      scene.useRightHandedSystem = true;
      scene.collisionsEnabled = true;
      scene.clearColor = new Color4(0.19, 0.4, 0.66, 1);
      scene.ambientColor = new Color3(0.22, 0.25, 0.28);
      scene.skipPointerMovePicking = true;
      scene.imageProcessingConfiguration.toneMappingEnabled = true;
      scene.imageProcessingConfiguration.exposure = 0.84;
      scene.imageProcessingConfiguration.contrast = 1.06;
      const target = new Vector3(
        requireFinite(options.targetX, "Camera target x"),
        requireFinite(options.targetY, "Camera target y"),
        requireFinite(options.targetZ, "Camera target z"),
      );
      const horizontalChunkRadius = requireInteger(options.horizontalChunkRadius, 1, 8, "Horizontal render Chunk radius");
      const orbitTarget = target.add(new Vector3(0, edge * 0.2, 0));
      const camera = new ArcRotateCamera("voxel-camera", -Math.PI / 4, Math.PI / 4.5, edge * 2.25, orbitTarget, scene);
      camera.lowerRadiusLimit = edge * 0.5;
      camera.upperRadiusLimit = edge * Math.max(2.5, horizontalChunkRadius - 0.5);
      camera.lowerBetaLimit = 0.08;
      camera.upperBetaLimit = Math.PI / 2.35;
      camera.checkCollisions = true;
      camera.collisionRadius = new Vector3(0.35, 0.7, 0.35);
      camera.wheelPrecision = 45;
      camera.panningSensibility = 720;
      camera.attachControl(canvas, true);
      const sky = new HemisphericLight("voxel-sky", new Vector3(0.25, 1, 0.1), scene);
      sky.intensity = 0.78;
      sky.groundColor = new Color3(0.42, 0.48, 0.42);
      const sun = new DirectionalLight("voxel-sun", new Vector3(-0.38, -1, -0.28), scene);
      sun.position = target.add(new Vector3(edge * 4, edge * 8, edge * 3));
      sun.intensity = 0.62;
      const shadowGenerator = new ShadowGenerator(2048, sun);
      shadowGenerator.bias = 0.0008;
      shadowGenerator.normalBias = 0.035;
      shadowGenerator.setDarkness(0.55);
      shadowGenerator.usePercentageCloserFiltering = true;
      shadowGenerator.filteringQuality = ShadowGenerator.QUALITY_MEDIUM;
      // cutout 植物和树叶共享图集；阴影阶段也必须读取 diffuse alpha，不能把
      // 整张交叉四边形当成不透明遮挡体投到地面。
      shadowGenerator.transparencyShadow = true;
      shadowGenerator.enableSoftTransparentShadow = true;
      const renderDistance = edge * (horizontalChunkRadius + 1.5);
      scene.fogMode = Scene.FOGMODE_LINEAR;
      scene.fogColor = new Color3(0.19, 0.4, 0.66);
      scene.fogStart = renderDistance * 0.78;
      scene.fogEnd = renderDistance * 1.2;
      try {
        const [loadedTextureBanks, cloudTexture] = await Promise.all([
          Promise.all(textureBankDefinitions.map((definition) => loadTextureBank(scene, definition))),
          waitForTexture(scene, options.cloudsDataUrl, false, Texture.BILINEAR_SAMPLINGMODE),
        ]);
        const textureBanks = new Map(loadedTextureBanks.map((bank) => [bank.key, bank]));
        cloudTexture.name = "openvoxel-clouds";
        cloudTexture.hasAlpha = true;
        cloudTexture.wrapU = Texture.WRAP_ADDRESSMODE;
        cloudTexture.wrapV = Texture.WRAP_ADDRESSMODE;
        cloudTexture.uScale = 4;
        cloudTexture.vScale = 4;
        const cloudMaterial = new StandardMaterial("openvoxel-cloud-material", scene);
        cloudMaterial.diffuseTexture = cloudTexture;
        cloudMaterial.opacityTexture = cloudTexture;
        cloudMaterial.emissiveColor = new Color3(0.92, 0.96, 1);
        cloudMaterial.disableLighting = true;
        cloudMaterial.backFaceCulling = false;
        cloudMaterial.useAlphaFromDiffuseTexture = true;
        const cloudLayer = MeshBuilder.CreateGround("openvoxel-cloud-layer", {
          width: renderDistance * 3,
          height: renderDistance * 3,
        }, scene);
        cloudLayer.position.set(target.x, target.y + edge * 9, target.z);
        cloudLayer.material = cloudMaterial;
        cloudLayer.isPickable = false;
        cloudLayer.infiniteDistance = true;
        return new BabylonVoxelSurface(
          canvas,
          {...options, edge},
          engine,
          scene,
          camera,
          textureBanks,
          {cloudLayer, cloudTexture, shadowGenerator},
        );
      } catch (error) {
        scene.dispose();
        engine.dispose();
        throw error;
      }
    }
`:
    export class BabylonVoxelSurface:
        def setChunkMesh(mesh: readonly ChunkMesh) -> null
        def removeChunk(x: number, y: number, z: number) -> null
        def stats() -> VoxelSurfaceStats
        def release() -> null

    export async def createBabylonVoxelSurface(canvas: CanvasElement, options: readonly VoxelSurfaceOptions) -> BabylonVoxelSurface

/// 渲染职责包只暴露 OpenVoxel 自己的窄表面；Babylon 类、Scene、Mesh 和 GPU 资源均
/// 停留在私有 JS 适配器中。
export type VoxelRenderSurface:
    setChunkMesh: (mesh: readonly ChunkMesh) -> null
    removeChunk: (x: number, y: number, z: number) -> null
    stats: () -> VoxelSurfaceStats
    release: () -> null

export async def openVoxelRenderSurface(
    canvas: CanvasElement,
    catalog: readonly ClientRenderCatalog,
    edge: number,
    targetX: number,
    targetY: number,
    targetZ: number,
    horizontalChunkRadius: number,
    viewChanged: (chunkX: number, chunkY: number, chunkZ: number) -> null,
) -> VoxelRenderSurface:
    const native: BabylonVoxelSurface = await createBabylonVoxelSurface(canvas, {
        textureBanks: catalog.textureBanks,
        cloudsDataUrl: catalog.environment.cloudsDataUrl,
        edge,
        materials: catalog.materials,
        textures: catalog.textures,
        animations: catalog.animations,
        targetX,
        targetY,
        targetZ,
        horizontalChunkRadius,
        viewChanged,
    })
    return {
        setChunkMesh: mesh => native.setChunkMesh(mesh),
        removeChunk: (x, y, z) => native.removeChunk(x, y, z),
        stats: () => native.stats(),
        release: () => native.release(),
    }
