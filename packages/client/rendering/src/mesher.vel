import {ChunkPosition, requireChunkEdge, requireChunkPosition} from "@openvoxel/world"
import {UInt32Buffer} from "velar/binary"
import {ChunkMesh, ClientBlockModelKind, ClientRenderAttachment, ClientRenderState} from "./contracts.vel"
import {MutableMeshBatch, finishMeshBatches, maximumChunkMeshQuads} from "./meshing/batch.vel"
import {emitSubmergedCross, emitSubmergedSurface, emitWallOverlay} from "./meshing/attachments.vel"
import {emitAuthoredModel} from "./meshing/authored-model.vel"
import {blockIndex, indexRenderStates} from "./meshing/catalog.vel"
import {emitBox, emitCross, emitFluid, emitGroundCover, emitSnowLayer} from "./meshing/models.vel"
import {scanGeometry} from "./meshing/scan.vel"

def emitAttachment(
    batches: Map<string, MutableMeshBatch>,
    attachment: ClientRenderAttachment,
    maximumFaces: number,
    x: number,
    y: number,
    z: number,
    worldX: number,
    worldY: number,
    worldZ: number,
):
    if attachment.geometry != null:
        emitAuthoredModel(batches, attachment, maximumFaces, x, y, z, worldX, worldY, worldZ)
        return
    match attachment.model:
        case ClientBlockModelKind.submergedCross:
            emitSubmergedCross(batches, attachment, maximumFaces, x, y, z, worldX, worldY, worldZ)
        case ClientBlockModelKind.submergedSurface:
            emitSubmergedSurface(batches, attachment, maximumFaces, x, y, z, worldX, worldY, worldZ)
        case ClientBlockModelKind.wallOverlay:
            emitWallOverlay(batches, attachment, maximumFaces, x, y, z, worldX, worldY, worldZ)
        case _: throw Error(f"Unsupported render attachment model {attachment.model}")

/// Worker 在初始化时构造一次 runtimeId 索引，后续 Chunk 直接复用，避免为每个
/// 网格重复扫描完整内容目录。任何 Chunk 的输出都受 8 MiB 硬上限保护。
export def meshChunkWithIndex(
    position: readonly ChunkPosition,
    edge: number,
    paddedBlocks: UInt32Buffer,
    byRuntimeId: Map<number, ClientRenderState>,
    ticket: number,
    fluidDepthHalo: UInt32Buffer? = null,
) -> ChunkMesh:
    requireChunkPosition(position)
    requireChunkEdge(edge)
    assert ticket.isInteger() and ticket >= 0 else "Chunk mesh ticket must be a non-negative integer"
    const paddedEdge = edge + 2
    assert paddedBlocks.size == paddedEdge * paddedEdge * paddedEdge else "Chunk meshing input has the wrong padded volume"
    if fluidDepthHalo != null:
        assert fluidDepthHalo.size == edge * edge * Math.min(7, edge - 1) else "Chunk fluid depth halo has the wrong volume"
    const maximumFaces = maximumChunkMeshQuads
    const batches: Map<string, MutableMeshBatch> = Map()
    const scan = scanGeometry(edge, paddedBlocks, byRuntimeId)
    const portalSummary = scan.portalSummary
    const worldOriginX = position.x * edge
    const worldOriginY = position.y * edge
    const worldOriginZ = position.z * edge
    const visibleBlocks = scan.visibleBlocks

    for index in scan.indices:
        const x = index % edge
        const z = (index / edge).floor() % edge
        const y = (index / (edge * edge)).floor()
        const state = byRuntimeId.get(paddedBlocks[blockIndex(x + 1, y + 1, z + 1, paddedEdge)])!
        const model = state.model
        const worldX = worldOriginX + x
        const worldY = worldOriginY + y
        const worldZ = worldOriginZ + z
        if state.geometry != null: emitAuthoredModel(batches, state, maximumFaces, x, y, z, worldX, worldY, worldZ)
        else if model == ClientBlockModelKind.cube or model == ClientBlockModelKind.column:
            emitBox(batches, byRuntimeId, paddedBlocks, paddedEdge, maximumFaces, state, x, y, z, worldX, worldY, worldZ, 0, 0, 0, 1, 1, 1)
        else if model == ClientBlockModelKind.cross:
            emitCross(batches, state, maximumFaces, x, y, z, worldX, worldY, worldZ)
        else if model == ClientBlockModelKind.wallOverlay:
            emitWallOverlay(batches, state, maximumFaces, x, y, z, worldX, worldY, worldZ)
        else if model == ClientBlockModelKind.cactus:
            emitBox(batches, byRuntimeId, paddedBlocks, paddedEdge, maximumFaces, state, x, y, z, worldX, worldY, worldZ, 1 / 16, 0, 1 / 16, 15 / 16, 1, 15 / 16)
        else if model == ClientBlockModelKind.snowLayer:
            emitSnowLayer(batches, byRuntimeId, paddedBlocks, paddedEdge, maximumFaces, state, x, y, z, worldX, worldY, worldZ)
        else if model == ClientBlockModelKind.groundCover:
            emitGroundCover(batches, byRuntimeId, paddedBlocks, paddedEdge, maximumFaces, state, x, y, z, worldX, worldY, worldZ)
        else:
            assert model == ClientBlockModelKind.fluid else f"Unsupported primary block model {model}"
            emitFluid(batches, byRuntimeId, paddedBlocks, paddedEdge, maximumFaces, state, x, y, z, worldX, worldY, worldZ, fluidDepthHalo)
        for attachment in state.attachments:
            emitAttachment(batches, attachment, maximumFaces, x, y, z, worldX, worldY, worldZ)

    const finished = finishMeshBatches(batches)
    return ChunkMesh.from(finished, {position, ticket, portalSummary, visibleBlocks})

/// 直接调用入口为测试和同步工具保留；Worker 热路径使用 meshChunkWithIndex。
export def meshChunk(
    position: readonly ChunkPosition,
    edge: number,
    paddedBlocks: UInt32Buffer,
    states: readonly List<ClientRenderState>,
    ticket: number,
    fluidDepthHalo: UInt32Buffer? = null,
) -> ChunkMesh:
    return meshChunkWithIndex(position, edge, paddedBlocks, indexRenderStates(states), ticket, fluidDepthHalo)
