{
  "name": "@openvoxel/renderer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "files": [
    "data",
    "generated",
    "src"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./meshing-worker": "./dist/meshing-worker.js",
    "./resource-pack-data": "./generated/client-resource-pack.json"
  },
  "velar": {
    "entry": "src/index.vel",
    "entries": {
      "./meshing-worker": "src/meshing-worker.vel"
    },
    "targets": [
      "web",
      "desktop"
    ],
    "requires": {
      "capabilities": [
        "web"
      ]
    },
    "resources": {
      "./resource-pack-data": {
        "path": "generated/client-resource-pack.json",
        "type": "json"
      }
    }
  },
  "scripts": {
    "generate": "node ../../../tools/run-validation.mjs -- node tools/generate.mjs",
    "generate:check": "node ../../../tools/run-validation.mjs -- node tools/check-generated.mjs",
    "check": "node ../../../tools/run-validation.mjs -- velar check",
    "format": "velar format",
    "format:check": "node ../../../tools/run-validation.mjs -- velar format --check",
    "test": "node ../../../tools/run-validation.mjs --shell \"velar test && node --test --test-concurrency=1 tests/*.test.mjs\"",
    "build": "node ../../../tools/run-validation.mjs -- velar build"
  },
  "dependencies": {
    "@openvoxel/blocks": "0.2.0",
    "@openvoxel/protocol": "0.2.0",
    "@openvoxel/world": "0.2.0"
  },
  "devDependencies": {
    "@openvoxel/world-generation": "0.2.0",
    "@velarscript/cli": "0.34.0",
    "@velarscript/web": "0.34.0",
    "sharp": "0.35.4",
    "yaml": "2.9.0"
  }
}
