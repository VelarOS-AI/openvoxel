import {ChunkPosition, chunkKey} from "@openvoxel/world"
import {expect} from "velar/test"
import {uint32Buffer} from "velar/binary"
import {ClientChunkBlockView, snapshotChunkNeighborhood, snapshotFluidDepthHalo, snapshotNeedsFluidDepthHalo} from "../src/snapshot.vel"

const edge = 4
const paddedEdge = edge + 2

def paddedIndex(x: number, y: number, z: number) -> number: return x + paddedEdge * (z + paddedEdge * y)

def blockIndex(x: number, y: number, z: number) -> number: return x + edge * (z + edge * y)

def view(position: readonly ChunkPosition, base: number) -> ClientChunkBlockView:
    def blockAtIndex(index: number) -> number: return base + index
    return {position, edge, blockAtIndex}

test "Chunk neighborhood copies the center and six adjacent faces without reading diagonal Chunks":
    const center: ChunkPosition = {x: 4, y: 5, z: 6}
    const current = view(center, 100)
    const chunks: Map<string, readonly ClientChunkBlockView> = Map()
    chunks.set(chunkKey(center), current)
    chunks.set(chunkKey({x: 3, y: 5, z: 6}), view({x: 3, y: 5, z: 6}, 200))
    chunks.set(chunkKey({x: 5, y: 5, z: 6}), view({x: 5, y: 5, z: 6}, 300))
    chunks.set(chunkKey({x: 4, y: 4, z: 6}), view({x: 4, y: 4, z: 6}, 400))
    chunks.set(chunkKey({x: 4, y: 6, z: 6}), view({x: 4, y: 6, z: 6}, 500))
    chunks.set(chunkKey({x: 4, y: 5, z: 5}), view({x: 4, y: 5, z: 5}, 600))
    chunks.set(chunkKey({x: 4, y: 5, z: 7}), view({x: 4, y: 5, z: 7}, 700))

    const snapshot = snapshotChunkNeighborhood(current, position => chunks.get(chunkKey(position)), 9)
    expect(snapshot[paddedIndex(1, 1, 1)]).toBe(100 + blockIndex(0, 0, 0))
    expect(snapshot[paddedIndex(2, 2, 2)]).toBe(100 + blockIndex(1, 1, 1))
    expect(snapshot[paddedIndex(0, 1, 1)]).toBe(200 + blockIndex(edge - 1, 0, 0))
    expect(snapshot[paddedIndex(edge + 1, 1, 1)]).toBe(300 + blockIndex(0, 0, 0))
    expect(snapshot[paddedIndex(1, 0, 1)]).toBe(400 + blockIndex(0, edge - 1, 0))
    expect(snapshot[paddedIndex(1, edge + 1, 1)]).toBe(500 + blockIndex(0, 0, 0))
    expect(snapshot[paddedIndex(1, 1, 0)]).toBe(600 + blockIndex(0, 0, edge - 1))
    expect(snapshot[paddedIndex(1, 1, edge + 1)]).toBe(700 + blockIndex(0, 0, 0))
    expect(snapshot[paddedIndex(0, 0, 0)]).toBe(9)

test "missing neighbor faces keep the requested runtime id":
    const center: ChunkPosition = {x: 0, y: 0, z: 0}
    const current = view(center, 50)
    const snapshot = snapshotChunkNeighborhood(current, _position => null, 17)
    expect(snapshot[paddedIndex(0, 1, 1)]).toBe(17)
    expect(snapshot[paddedIndex(1, 1, 1)]).toBe(50)

test "streaming seals unknown cut faces but honors a loaded air neighbor":
    const current = view({x: -1, y: 1, z: -1}, 50)
    const unknown = snapshotChunkNeighborhood(current, _position => null, sealUnloaded=true)
    for a in range(edge):
        for b in range(edge):
            expect(unknown[paddedIndex(0, a + 1, b + 1)]).toBe(50 + blockIndex(0, a, b))
            expect(unknown[paddedIndex(edge + 1, a + 1, b + 1)]).toBe(50 + blockIndex(edge - 1, a, b))
            expect(unknown[paddedIndex(a + 1, 0, b + 1)]).toBe(50 + blockIndex(a, 0, b))
            expect(unknown[paddedIndex(a + 1, edge + 1, b + 1)]).toBe(50 + blockIndex(a, edge - 1, b))
            expect(unknown[paddedIndex(a + 1, b + 1, 0)]).toBe(50 + blockIndex(a, b, 0))
            expect(unknown[paddedIndex(a + 1, b + 1, edge + 1)]).toBe(50 + blockIndex(a, b, edge - 1))
    def airNeighbor(position: readonly ChunkPosition) -> ClientChunkBlockView?:
        if position.y != 2: return null
        return {position, edge, blockAtIndex: _index => 0}
    const exposed = snapshotChunkNeighborhood(current, airNeighbor, sealUnloaded=true)
    expect(exposed[paddedIndex(1, edge + 1, 1)]).toBe(0)
    expect(exposed[paddedIndex(0, 1, 1)]).toBe(50)

test "fluid depth halo copies successive layers below the ordinary neighbor face":
    const below = view({x: 0, y: 3, z: 0}, 100)
    const halo = snapshotFluidDepthHalo(below)
    assert halo != null else "Expected fluid depth halo"
    expect(halo.size).toBe(edge * edge * (edge - 1))
    expect(halo[0]).toBe(100 + blockIndex(0, edge - 2, 0))
    expect(halo[edge * edge]).toBe(100 + blockIndex(0, edge - 3, 0))
    expect(snapshotFluidDepthHalo(null)).toBe(null)

test "snapshot reuses the captured center and resolves only six neighbors":
    const center: ChunkPosition = {x: 0, y: 0, z: 0}
    let resolutions = 0
    let reads = 0
    def resolve(position: readonly ChunkPosition) -> readonly ClientChunkBlockView?:
        resolutions += 1
        def blockAtIndex(_index: number) -> number:
            reads += 1
            return 1
        return {position, edge, blockAtIndex}

    def countedCenterBlockAtIndex(_index: number) -> number:
        reads += 1
        return 1

    snapshotChunkNeighborhood({position: center, edge, blockAtIndex: countedCenterBlockAtIndex}, resolve)
    expect(resolutions).toBe(6)
    expect(reads).toBe(edge * edge * edge + 6 * edge * edge)

test "owned bulk snapshots match computed views with all combinations of missing faces":
    const position: ChunkPosition = {x: -4, y: -2, z: -7}
    const backing = uint32Buffer(edge * edge * edge)
    for index in range(backing.size): backing[index] = 4294967295 - index
    const computed: ClientChunkBlockView = {position, edge, blockAtIndex: index => backing[index]}
    let scalarReads = 0
    let copies = 0
    def snapshotBlocks():
        copies += 1
        return backing.copy()
    def unexpectedRead(_index: number) -> number:
        scalarReads += 1
        return 0
    const bulk: ClientChunkBlockView = {position, edge, blockAtIndex: unexpectedRead, snapshotBlocks}
    for mask in range(64):
        def neighbor(candidate: readonly ChunkPosition) -> ClientChunkBlockView?:
            let face = 0
            if candidate.x > position.x: face = 1
            else if candidate.y < position.y: face = 2
            else if candidate.y > position.y: face = 3
            else if candidate.z < position.z: face = 4
            else if candidate.z > position.z: face = 5
            if (mask / (2 ** face)).floor() % 2 == 0: return null
            return view(candidate, 100 * (face + 1))
        for seal in [false, true]:
            const reference = snapshotChunkNeighborhood(computed, neighbor, 19, seal)
            const actual = snapshotChunkNeighborhood(bulk, neighbor, 19, seal)
            expect(actual.values()).toEqual(reference.values())
    expect(scalarReads).toBe(0)
    expect(copies).toBe(128)
    const independent = snapshotChunkNeighborhood(bulk, _candidate => null, sealUnloaded=true)
    backing[0] = 17
    expect(independent[paddedIndex(1, 1, 1)]).toBe(4294967295)
    independent[paddedIndex(1, 1, 1)] = 29
    expect(backing[0]).toBe(17)

test "bulk snapshot rejects an incorrectly sized copy":
    const invalid: ClientChunkBlockView = {
        position: {x: 0, y: 0, z: 0}, edge, blockAtIndex: _index => 0,
        snapshotBlocks: () => uint32Buffer(1),
    }
    expect(() => snapshotChunkNeighborhood(invalid, _candidate => null)).toThrow()

test "fluid depth reads the captured bottom surface and ignores surrounding halo":
    const blocks = uint32Buffer(paddedEdge * paddedEdge * paddedEdge)
    const waterIds: Set<number> = Set([7, 8])
    blocks[paddedIndex(0, 1, 1)] = 7
    blocks[paddedIndex(1, 0, 1)] = 7
    blocks[paddedIndex(2, 2, 2)] = 7
    expect(snapshotNeedsFluidDepthHalo(blocks, edge, waterIds)).toBe(false)
    const bottom = paddedIndex(edge, 1, edge)
    const upper = paddedIndex(edge, 2, edge)
    blocks[bottom] = 7
    blocks[upper] = 8
    expect(snapshotNeedsFluidDepthHalo(blocks, edge, waterIds)).toBe(false)
    blocks[upper] = 0
    expect(snapshotNeedsFluidDepthHalo(blocks, edge, waterIds)).toBe(true)
    expect(snapshotNeedsFluidDepthHalo(blocks, edge, Set())).toBe(false)
    expect(() => snapshotNeedsFluidDepthHalo(uint32Buffer(1), edge, waterIds)).toThrow()
