import {BlockRenderLayer} from "@openvoxel/blocks"
import {expect} from "velar/test"
import {Float32Buffer, UInt32Buffer, uint32Buffer} from "velar/binary"
import {meshChunk} from "../src/mesher.vel"
import {ClientBlockModelKind, ClientClimateTint, ClientRenderAttachment, ClientRenderState, ClientRenderTexture, ClientTextureVariant, ClientTintCoverage, chunkPortalFaceCount, chunkPortalFaceIndices} from "../src/contracts.vel"
import {climateTintRole, topFace} from "../src/meshing/faces.vel"
import {stableCoordinateOffset} from "../src/meshing/variation.vel"
import {snapshotChunkNeighborhood} from "../src/snapshot.vel"

const edge = 4
const paddedEdge = edge + 2
const textureBankKey = "test:texture-bank"

def renderTexture(key: string, variants: readonly List<ClientTextureVariant>) -> ClientRenderTexture:
    return {
        key,
        bankKey: textureBankKey,
        variants,
        totalWeight: variants.reduce((total, variant) => total + variant.weight, 0),
    }

const region = renderTexture("test:texture", [{layer: 0, weight: 1}])

def state(
    runtimeId: number,
    model: ClientBlockModelKind?,
    occludes: bool,
    layer: BlockRenderLayer? = null,
    texture: ClientRenderTexture = region,
) -> ClientRenderState:
    return {
        runtimeId,
        modelKey: model == null ? null : f"test:model/{model}",
        model,
        layer,
        materialKey: model == null ? null : "test:material",
        bankKey: model == null ? null : texture.bankKey,
        pipelineKey: model == null ? null : f"{layer}|{texture.bankKey}|test:material|-",
        textures: model == null ? null : {top: texture, bottom: texture, side: texture, front: null},
        tintKey: null,
        climateTint: ClientClimateTint.neutral,
        tintCoverage: ClientTintCoverage.all,
        tintRed: 1,
        tintGreen: 1,
        tintBlue: 1,
        animationKey: null,
        cullFaces: model == ClientBlockModelKind.cube,
        occludes,
        emission: 0,
        collisionBoxes: model == null ? [] : [{minimumX: 0, minimumY: 0, minimumZ: 0, maximumX: 1, maximumY: 1, maximumZ: 1}],
        attachments: [],
        canonicalFluidKey: model == ClientBlockModelKind.fluid ? "test:water" : null,
        axis: null,
        facing: null,
        level: model == ClientBlockModelKind.fluid ? 0 : null,
        falling: model == ClientBlockModelKind.fluid ? false : null,
        layers: model == ClientBlockModelKind.snowLayer or model == ClientBlockModelKind.groundCover ? 1 : null,
    }

def attachment(runtimeId: number, model: ClientBlockModelKind, facing: string? = null) -> ClientRenderAttachment:
    return {
        modelKey: f"test:model/{model}",
        model,
        layer: BlockRenderLayer.cutout,
        materialKey: "test:attachment-material",
        bankKey: region.bankKey,
        pipelineKey: f"cutout|{region.bankKey}|test:attachment-material|-",
        textures: {top: region, bottom: region, side: region, front: null},
        tintKey: null,
        climateTint: ClientClimateTint.neutral,
        tintCoverage: ClientTintCoverage.all,
        tintRed: 1,
        tintGreen: 1,
        tintBlue: 1,
        animationKey: null,
        cullFaces: false,
        runtimeId,
        emission: 0,
        axis: null,
        facing,
    }

def index(x: number, y: number, z: number) -> number: return x + paddedEdge * (z + paddedEdge * y)

def blocks() -> UInt32Buffer: return uint32Buffer(paddedEdge * paddedEdge * paddedEdge)

const air = state(0, null, false)
const stone = state(7, ClientBlockModelKind.cube, true, BlockRenderLayer.opaque)
const plant = state(9, ClientBlockModelKind.cross, false, BlockRenderLayer.cutout)
const water = state(11, ClientBlockModelKind.fluid, false, BlockRenderLayer.translucent)
const oakLeaves = state(12, ClientBlockModelKind.cube, false, BlockRenderLayer.cutout)
const birchLeaves = state(13, ClientBlockModelKind.cube, false, BlockRenderLayer.cutout)
const cactus = state(14, ClientBlockModelKind.cactus, false, BlockRenderLayer.cutout)
const snowLayer = state(15, ClientBlockModelKind.snowLayer, false, BlockRenderLayer.cutout)
const groundCover = state(18, ClientBlockModelKind.groundCover, false, BlockRenderLayer.cutout)
const glass = state(17, ClientBlockModelKind.cube, false, BlockRenderLayer.translucent)

test "unloaded streaming boundaries never publish temporary solid cut walls":
    const position = {x: -1, y: 0, z: 1}
    const center = {position, edge, blockAtIndex: _index => stone.runtimeId}
    const unknown = snapshotChunkNeighborhood(center, _position => null, sealUnloaded=true)
    const sealed = meshChunk(position, edge, unknown, [air, stone], 1)
    expect(sealed.quadCount).toBe(0)
    const complete = snapshotChunkNeighborhood(center, candidate => ({position: candidate, edge, blockAtIndex: _index => stone.runtimeId}), sealUnloaded=true)
    expect(meshChunk(position, edge, complete, [air, stone], 2).quadCount).toBe(0)
    const exposed = snapshotChunkNeighborhood(center, candidate => ({position: candidate, edge, blockAtIndex: _index => air.runtimeId}), sealUnloaded=true)
    expect(meshChunk(position, edge, exposed, [air, stone], 3).quadCount).toBe(6 * edge * edge)

test "water surface carries depth and flow while keeping mesh vertex alpha disabled":
    const still = ClientRenderState.from(water, {runtimeId: 20, climateTint: ClientClimateTint.water})
    const flowing = ClientRenderState.from(water, {runtimeId: 21, climateTint: ClientClimateTint.water, falling: true})
    const volume = blocks()
    volume[index(2, 2, 2)] = still.runtimeId
    volume[index(3, 2, 2)] = flowing.runtimeId
    volume[index(3, 1, 2)] = flowing.runtimeId
    volume[index(3, 0, 2)] = flowing.runtimeId
    const batch = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, still, flowing], 32).batches[0]
    const topCodes: List<number> = []
    for vertex in range(batch.tintRoles.size):
        if batch.normals[vertex * 3 + 1] > 0.5: topCodes.append(batch.colors[vertex * 4 + 3])
    expect(topCodes.some(code => code < 0.1)).toBe(true)
    expect(topCodes.some(code => code > 0.6 and code < 1)).toBe(true)

test "water depth continues through the loaded lower section":
    const stream = ClientRenderState.from(water, {climateTint: ClientClimateTint.water})
    const volume = blocks()
    volume[index(2, 1, 2)] = stream.runtimeId
    volume[index(3, 1, 2)] = stream.runtimeId
    volume[index(2, 0, 2)] = stream.runtimeId
    volume[index(3, 0, 2)] = stream.runtimeId
    const halo = uint32Buffer(edge * edge * (edge - 1))
    halo[1 + edge * 1] = stream.runtimeId
    const batch = meshChunk({x: 0, y: 4, z: 0}, edge, volume, [air, stream], 33, halo).batches[0]
    const topCodes: List<number> = []
    for vertex in range(batch.tintRoles.size):
        if batch.normals[vertex * 3 + 1] > 0.5: topCodes.append(batch.colors[vertex * 4 + 3])
    expect(topCodes.every(code => code < 0.5)).toBe(true)
    expect(topCodes.some(code => code > 0.1 and code < 0.13)).toBe(true)
    expect(topCodes.some(code => code > 0.15 and code < 0.18)).toBe(true)

test "fluid culling follows canonical identity across material changes":
    const volume = blocks()
    volume[index(2, 2, 2)] = water.runtimeId
    volume[index(3, 2, 2)] = 19
    const styledWater = ClientRenderState.from(water, {
        runtimeId: 19,
        materialKey: "test:styled-water",
        pipelineKey: f"translucent|{textureBankKey}|test:styled-water|-",
    })
    expect(meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, water, styledWater], 1).quadCount).toBe(10)
    const otherFluid = ClientRenderState.from(water, {runtimeId: 19, canonicalFluidKey: "test:oil"})
    expect(meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, water, otherFluid], 2).quadCount).toBe(12)

test "water and ice share one transparent face at their boundary":
    const ice = ClientRenderState.from(glass, {
        runtimeId: 31,
        materialKey: "test:ice",
        pipelineKey: f"translucent|{textureBankKey}|test:ice|-",
    })
    const side = blocks()
    side[index(2, 2, 2)] = water.runtimeId
    side[index(3, 2, 2)] = ice.runtimeId
    const sideMesh = meshChunk({x: 0, y: 0, z: 0}, edge, side, [air, water, ice], 35)
    expect(sideMesh.batches.find(batch => batch.materialKey == water.materialKey)?.quadCount).toBe(5)
    expect(sideMesh.batches.find(batch => batch.materialKey == ice.materialKey)?.quadCount).toBe(6)

    const seam = blocks()
    seam[index(4, 2, 2)] = water.runtimeId
    seam[index(5, 2, 2)] = ice.runtimeId
    const seamMesh = meshChunk({x: 0, y: 0, z: 0}, edge, seam, [air, water, ice], 38)
    expect(seamMesh.batches.find(batch => batch.materialKey == water.materialKey)?.quadCount).toBe(5)

    const stacked = blocks()
    stacked[index(2, 2, 2)] = water.runtimeId
    stacked[index(2, 3, 2)] = ice.runtimeId
    const stackedMesh = meshChunk({x: 0, y: 0, z: 0}, edge, stacked, [air, water, ice], 36)
    expect(stackedMesh.batches.find(batch => batch.materialKey == water.materialKey)?.quadCount).toBe(5)
    expect(stackedMesh.batches.find(batch => batch.materialKey == ice.materialKey)?.quadCount).toBe(6)

    const lowWater = ClientRenderState.from(water, {runtimeId: 32, level: 4})
    stacked[index(2, 2, 2)] = lowWater.runtimeId
    const separatedMesh = meshChunk({x: 0, y: 0, z: 0}, edge, stacked, [air, lowWater, ice], 37)
    expect(separatedMesh.batches.find(batch => batch.materialKey == water.materialKey)?.quadCount).toBe(6)

test "attachment geometry shares a bounded Chunk budget across all pipelines":
    const size = 16
    const padded = size + 2
    const volume = uint32Buffer(padded * padded * padded)
    for y in range(size):
        for z in range(size):
            for x in range(size): volume[x + 1 + padded * (z + 1 + padded * (y + 1))] = 19
    const cross = attachment(19, ClientBlockModelKind.submergedCross)
    const allowed = ClientRenderState.from(water, {runtimeId: 19, attachments: [cross, cross, cross]})
    const mesh = meshChunk({x: 0, y: 0, z: 0}, size, volume, [air, allowed], 1)
    expect(mesh.quadCount > size * size * size * 6).toBe(true)
    expect(mesh.byteSize <= 8 * 1024 * 1024).toBe(true)
    const excessive = ClientRenderState.from(water, {runtimeId: 19, attachments: [cross, cross, cross, cross, cross]})
    let rejected = false
    try: meshChunk({x: 0, y: 0, z: 0}, size, volume, [air, excessive], 2)
    catch error: rejected = error.message == "Chunk mesh exceeds the 8 MiB geometry budget"
    expect(rejected).toBe(true)

def faceBit(face: number) -> number: return Math.pow(2, face)

def connectedFaceBit(source: number, target: number) -> number:
    return Math.pow(2, source * chunkPortalFaceCount + target)

def filledChunk(runtimeId: number) -> UInt32Buffer:
    const volume = blocks()
    for y in range(edge):
        for z in range(edge):
            for x in range(edge): volume[index(x + 1, y + 1, z + 1)] = runtimeId
    return volume

test "empty Chunk exposes and connects all six portal faces":
    const summary = meshChunk({x: 0, y: 0, z: 0}, edge, blocks(), [air], 20).portalSummary
    expect(summary.empty).toBe(true)
    expect(summary.fullyOccluding).toBe(false)
    expect(summary.openFaces).toBe(Math.pow(2, chunkPortalFaceCount) - 1)
    expect(summary.connectedFaces).toBe(Math.pow(2, chunkPortalFaceCount * chunkPortalFaceCount) - 1)

test "fully occluding Chunk has no open portal face":
    const summary = meshChunk({x: 0, y: 0, z: 0}, edge, filledChunk(stone.runtimeId), [air, stone], 21).portalSummary
    expect(summary.empty).toBe(false)
    expect(summary.fullyOccluding).toBe(true)
    expect(summary.openFaces).toBe(0)
    expect(summary.connectedFaces).toBe(0)

test "non-occluding leaf, water, glass, and air states form a portal tunnel":
    const volume = filledChunk(stone.runtimeId)
    const passage = [oakLeaves.runtimeId, water.runtimeId, glass.runtimeId, air.runtimeId]
    for runtimeId, x in passage: volume[index(x + 1, 2, 2)] = runtimeId
    const summary = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, stone, oakLeaves, water, glass], 22).portalSummary
    const west = chunkPortalFaceIndices.west
    const east = chunkPortalFaceIndices.east
    expect(summary.empty).toBe(false)
    expect(summary.fullyOccluding).toBe(false)
    expect(summary.openFaces).toBe(faceBit(west) + faceBit(east))
    expect(summary.connectedFaces).toBe(
        connectedFaceBit(west, west)
        + connectedFaceBit(west, east)
        + connectedFaceBit(east, west)
        + connectedFaceBit(east, east),
    )

test "sealed interior air cavity does not open a Chunk portal":
    const volume = filledChunk(stone.runtimeId)
    volume[index(2, 2, 2)] = air.runtimeId
    const summary = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, stone], 23).portalSummary
    expect(summary.empty).toBe(false)
    expect(summary.fullyOccluding).toBe(false)
    expect(summary.openFaces).toBe(0)
    expect(summary.connectedFaces).toBe(0)

test "disconnected boundary pockets do not claim cross-Chunk visibility":
    const volume = filledChunk(stone.runtimeId)
    volume[index(1, 2, 2)] = air.runtimeId
    volume[index(edge, 2, 2)] = air.runtimeId
    const summary = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, stone], 24).portalSummary
    const west = chunkPortalFaceIndices.west
    const east = chunkPortalFaceIndices.east
    expect(summary.openFaces).toBe(faceBit(west) + faceBit(east))
    expect(summary.connectedFaces).toBe(connectedFaceBit(west, west) + connectedFaceBit(east, east))

test "portal summary preserves unknown runtimeId rejection":
    const volume = blocks()
    volume[index(2, 2, 2)] = 0xffffffff
    expect(() => meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air], 25)).toThrow()

test "visible-face meshing emits six quads for one cube and ten for two adjacent cubes":
    const one = blocks()
    one[index(2, 2, 2)] = stone.runtimeId
    const oneMesh = meshChunk({x: 0, y: 0, z: 0}, edge, one, [air, stone], 1)
    expect(oneMesh.visibleBlocks).toBe(1)
    expect(oneMesh.quadCount).toBe(6)
    expect(oneMesh.batches[0].textureLayers.size).toBe(oneMesh.batches[0].positions.size / 3)
    expect(oneMesh.byteSize).toBe(1488)

    const two = one.copy()
    two[index(3, 2, 2)] = stone.runtimeId
    const twoMesh = meshChunk({x: 0, y: 0, z: 0}, edge, two, [air, stone], 2)
    expect(twoMesh.visibleBlocks).toBe(2)
    expect(twoMesh.quadCount).toBe(10)

test "mesh triangles use outward counter-clockwise winding":
    const volume = blocks()
    volume[index(2, 2, 2)] = stone.runtimeId
    const mesh = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, stone], 5)
    for batch in mesh.batches:
        for offset in range(0, batch.positions.size, 12):
            const ax = batch.positions[offset + 3] - batch.positions[offset]
            const ay = batch.positions[offset + 4] - batch.positions[offset + 1]
            const az = batch.positions[offset + 5] - batch.positions[offset + 2]
            const bx = batch.positions[offset + 6] - batch.positions[offset]
            const by = batch.positions[offset + 7] - batch.positions[offset + 1]
            const bz = batch.positions[offset + 8] - batch.positions[offset + 2]
            const crossX = ay * bz - az * by
            const crossY = az * bx - ax * bz
            const crossZ = ax * by - ay * bx
            const dot = crossX * batch.normals[offset] + crossY * batch.normals[offset + 1] + crossZ * batch.normals[offset + 2]
            expect(dot > 0).toBe(true)

test "horizontal column axes rotate end textures without changing the four side faces":
    const topTexture = renderTexture("test:texture/top", [{layer: 2, weight: 1}])
    const bottomTexture = renderTexture("test:texture/bottom", [{layer: 3, weight: 1}])
    const sideTexture = renderTexture("test:texture/side", [{layer: 4, weight: 1}])
    const baseColumn = state(8, ClientBlockModelKind.column, true, BlockRenderLayer.opaque)
    const textures = {top: topTexture, bottom: bottomTexture, side: sideTexture, front: null}

    const xColumn = ClientRenderState.from(baseColumn, {axis: "x", textures})
    const xVolume = blocks()
    xVolume[index(2, 2, 2)] = xColumn.runtimeId
    const xLayers = meshChunk({x: 0, y: 0, z: 0}, edge, xVolume, [air, xColumn], 1).batches[0].textureLayers
    expect(xLayers[0]).toBe(2)
    expect(xLayers[4]).toBe(3)
    for offset in range(8, 24, 4): expect(xLayers[offset]).toBe(4)

    const zColumn = ClientRenderState.from(baseColumn, {axis: "z", textures})
    const zVolume = blocks()
    zVolume[index(2, 2, 2)] = zColumn.runtimeId
    const zLayers = meshChunk({x: 0, y: 0, z: 0}, edge, zVolume, [air, zColumn], 2).batches[0].textureLayers
    for offset in range(0, 16, 4): expect(zLayers[offset]).toBe(4)
    expect(zLayers[16]).toBe(2)
    expect(zLayers[20]).toBe(3)

test "front texture follows all four horizontal facing states and other faces use side":
    const sideTexture = renderTexture("test:texture/oriented-side", [{layer: 4, weight: 1}])
    const frontTexture = renderTexture("test:texture/oriented-front", [{layer: 9, weight: 1}])
    const baseOriented = state(20, ClientBlockModelKind.cube, true, BlockRenderLayer.opaque)
    const textures = {top: sideTexture, bottom: sideTexture, side: sideTexture, front: frontTexture}
    const orientations = [
        {facing: "east", frontOffset: 0},
        {facing: "west", frontOffset: 4},
        {facing: "south", frontOffset: 16},
        {facing: "north", frontOffset: 20},
    ]

    for orientation, orientationIndex in orientations:
        const oriented = ClientRenderState.from(baseOriented, {runtimeId: 20 + orientationIndex, textures, facing: orientation.facing})
        const volume = blocks()
        volume[index(2, 2, 2)] = oriented.runtimeId
        const layers = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, oriented], orientationIndex).batches[0].textureLayers
        for offset in [0, 4, 8, 12, 16, 20]:
            const expected = offset == orientation.frontOffset ? 9 : 4
            for vertexOffset in range(4): expect(layers[offset + vertexOffset]).toBe(expected)

test "neighbor halo culls a Chunk seam while cross and fluid models keep their own geometry":
    const seam = blocks()
    seam[index(edge, 2, 2)] = stone.runtimeId
    seam[index(edge + 1, 2, 2)] = stone.runtimeId
    expect(meshChunk({x: 0, y: 0, z: 0}, edge, seam, [air, stone], 3).quadCount).toBe(5)

    const models = blocks()
    models[index(2, 2, 2)] = plant.runtimeId
    models[index(3, 2, 2)] = water.runtimeId
    const mesh = meshChunk({x: 0, y: 0, z: 0}, edge, models, [air, plant, water], 4)
    expect(mesh.visibleBlocks).toBe(2)
    expect(mesh.batches.size).toBe(2)
    expect(mesh.quadCount).toBe(8)
    expect(mesh.byteSize > 0).toBe(true)

test "ground plants vary by world position while roots and bounds stay inside their supporting cell":
    const volume = blocks()
    volume[index(2, 2, 2)] = plant.runtimeId
    const a = meshChunk({x: -4, y: 0, z: 3}, edge, volume, [air, plant], 1).batches[0]
    const b = meshChunk({x: -4, y: 0, z: 3}, edge, volume, [air, plant], 2).batches[0]
    const c = meshChunk({x: -3, y: 0, z: 3}, edge, volume, [air, plant], 3).batches[0]
    expect(a.quadCount).toBe(2)
    let changed = false
    let roots = 0
    for vertex in range(8):
        const offset = vertex * 3
        expect(a.positions[offset] >= 1 and a.positions[offset] <= 2).toBe(true)
        expect(a.positions[offset + 2] >= 1 and a.positions[offset + 2] <= 2).toBe(true)
        const height = a.positions[offset + 1]
        expect(height == 1 or (height >= 1.8 and height <= 2)).toBe(true)
        if height == 1: roots += 1
        for axis in range(3):
            expect(a.positions[offset + axis]).toBe(b.positions[offset + axis])
            if a.positions[offset + axis] != c.positions[offset + axis]: changed = true
    expect(roots).toBe(4)
    expect(changed).toBe(true)

test "submerged attachments preserve water volume and batch cutout geometry separately":
    const grass = attachment(16, ClientBlockModelKind.submergedCross)
    const plantedWater = ClientRenderState.from(water, {runtimeId: 16, attachments: [grass]})
    const volume = blocks()
    volume[index(2, 2, 2)] = plantedWater.runtimeId
    volume[index(3, 2, 2)] = water.runtimeId
    const mesh = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, water, plantedWater], 26)
    expect(mesh.visibleBlocks).toBe(2)
    expect(mesh.batches.size).toBe(2)
    expect(mesh.quadCount).toBe(12)
    const fluidBatch = mesh.batches.find(batch => batch.layer == BlockRenderLayer.translucent)
    const plantBatch = mesh.batches.find(batch => batch.layer == BlockRenderLayer.cutout)
    assert fluidBatch != null and plantBatch != null else "Expected fluid and attachment batches"
    expect(fluidBatch.quadCount).toBe(10)
    expect(plantBatch.quadCount).toBe(2)

test "submerged surface attachments stay low while retaining the surrounding fluid":
    const surface = attachment(water.runtimeId, ClientBlockModelKind.submergedSurface)
    const inhabitedWater = ClientRenderState.from(water, {attachments: [surface]})
    const volume = blocks()
    volume[index(2, 2, 2)] = inhabitedWater.runtimeId
    const mesh = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, inhabitedWater], 27)
    expect(mesh.quadCount).toBe(9)
    const groundBatch = mesh.batches.find(batch => batch.layer == BlockRenderLayer.cutout)
    assert groundBatch != null else "Expected a bottom-dweller batch"
    expect(groundBatch.quadCount).toBe(3)
    expect(groundBatch.positions.size).toBe(36)

test "submerged surfaces default to the bottom and expose six batch-meshed orientations":
    const directions = [
        {facing: "up", normal: [0, 1, 0]},
        {facing: "down", normal: [0, -1, 0]},
        {facing: "north", normal: [0, 0, -1]},
        {facing: "east", normal: [1, 0, 0]},
        {facing: "south", normal: [0, 0, 1]},
        {facing: "west", normal: [-1, 0, 0]},
    ]
    let upwardPositions: Float32Buffer? = null
    for direction in directions:
        const facing = direction.facing
        const surface = attachment(16, ClientBlockModelKind.submergedSurface, facing)
        const inhabitedWater = ClientRenderState.from(water, {runtimeId: 16, attachments: [surface]})
        const volume = blocks()
        volume[index(2, 2, 2)] = inhabitedWater.runtimeId
        const mesh = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, inhabitedWater], 35)
        const batch = mesh.batches.find(candidate => candidate.layer == BlockRenderLayer.cutout)
        assert batch != null else f"Expected submerged surface batch facing {facing}"
        expect(batch.quadCount).toBe(3)
        const flatNormalOffset = 8 * 3
        expect(batch.normals[flatNormalOffset]).toBe(direction.normal[0])
        expect(batch.normals[flatNormalOffset + 1]).toBe(direction.normal[1])
        expect(batch.normals[flatNormalOffset + 2]).toBe(direction.normal[2])
        for coordinate in batch.positions: expect(coordinate >= 1 and coordinate <= 2).toBe(true)
        if facing == "up": upwardPositions = batch.positions

    const defaultSurface = attachment(16, ClientBlockModelKind.submergedSurface)
    const defaultWater = ClientRenderState.from(water, {runtimeId: 16, attachments: [defaultSurface]})
    const defaultVolume = blocks()
    defaultVolume[index(2, 2, 2)] = defaultWater.runtimeId
    const defaultMesh = meshChunk({x: 0, y: 0, z: 0}, edge, defaultVolume, [air, defaultWater], 36)
    const defaultBatch = defaultMesh.batches.find(candidate => candidate.layer == BlockRenderLayer.cutout)
    assert defaultBatch != null and upwardPositions != null else "Expected default bottom surface geometry"
    expect(defaultBatch.positions.size).toBe(upwardPositions.size)
    for offset in range(defaultBatch.positions.size):
        expect(defaultBatch.positions[offset]).toBe(upwardPositions[offset])

test "submerged surface visual variants derive stably from coordinates without state properties":
    const same = stableCoordinateOffset(16, -31, 8, 47, 0x5bd1, 4)
    expect(stableCoordinateOffset(16, -31, 8, 47, 0x5bd1, 4)).toBe(same)
    const variants: Set<number> = Set()
    for worldX in range(32): variants.add(stableCoordinateOffset(16, worldX, 8, 47, 0x5bd1, 4))
    expect(variants.size).toBe(4)

test "wall overlays follow the four support faces without creating cube geometry":
    const directions = ["north", "east", "south", "west"]
    for facing, directionIndex in directions:
        const vine = ClientRenderState.from(state(30 + directionIndex, ClientBlockModelKind.wallOverlay, false, BlockRenderLayer.cutout), {facing})
        const volume = blocks()
        volume[index(2, 2, 2)] = vine.runtimeId
        const mesh = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, vine], 28 + directionIndex)
        expect(mesh.visibleBlocks).toBe(1)
        expect(mesh.quadCount).toBe(1)
        expect(mesh.batches[0].positions.size).toBe(12)

test "adjacent leaf cubes share internal faces across state and Chunk boundaries":
    const cluster = blocks()
    cluster[index(2, 2, 2)] = oakLeaves.runtimeId
    cluster[index(3, 2, 2)] = birchLeaves.runtimeId
    expect(meshChunk({x: 0, y: 0, z: 0}, edge, cluster, [air, oakLeaves, birchLeaves], 8).quadCount).toBe(10)

    const seam = blocks()
    seam[index(edge, 2, 2)] = oakLeaves.runtimeId
    seam[index(edge + 1, 2, 2)] = birchLeaves.runtimeId
    expect(meshChunk({x: 0, y: 0, z: 0}, edge, seam, [air, oakLeaves, birchLeaves], 9).quadCount).toBe(5)

test "resource climate policy colors grass caps while preserving soil and PBR geometry":
    const grass = ClientRenderState.from(stone, {
        climateTint: ClientClimateTint.grass,
        tintCoverage: ClientTintCoverage.grassCap,
    })
    const volume = blocks()
    volume[index(2, 2, 2)] = grass.runtimeId
    const batch = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, grass], 30).batches[0]
    for vertex in range(batch.tintRoles.size):
        const verticalNormal = batch.normals[vertex * 3 + 1]
        const expected = verticalNormal > 0 ? 1 : verticalNormal < 0 ? 0 : 4
        expect(batch.tintRoles[vertex]).toBe(expected)
    expect(batch.quadCount).toBe(6)
    expect(batch.textureLayers.size).toBe(batch.tintRoles.size)

test "foliage and water climate roles do not depend on resource key spelling":
    const leaves = ClientRenderState.from(oakLeaves, {tintKey: "test:any-name", climateTint: ClientClimateTint.foliage})
    const stream = ClientRenderState.from(water, {tintKey: "test:another-name", climateTint: ClientClimateTint.water})
    const volume = blocks()
    volume[index(2, 2, 2)] = leaves.runtimeId
    volume[index(3, 2, 2)] = stream.runtimeId
    const mesh = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, leaves, stream], 31)
    for batch in mesh.batches:
        const expected = batch.layer == BlockRenderLayer.cutout ? 2 : 3
        for role in batch.tintRoles: expect(role).toBe(expected)

test "distinct foliage families keep stable renderer roles":
    const policies = [
        {climate: ClientClimateTint.foliage, role: 2},
        {climate: ClientClimateTint.evergreenFoliage, role: 5},
        {climate: ClientClimateTint.drylandFoliage, role: 6},
        {climate: ClientClimateTint.aquaticFoliage, role: 7},
    ]
    for policy in policies:
        const surface = ClientRenderState.from(oakLeaves, {climateTint: policy.climate})
        expect(climateTintRole(surface, topFace)).toBe(policy.role)

test "box culling follows the model boundary instead of the occupied cell":
    const cactusSeam = blocks()
    cactusSeam[index(edge, 2, 2)] = cactus.runtimeId
    cactusSeam[index(edge + 1, 2, 2)] = stone.runtimeId
    expect(meshChunk({x: 0, y: 0, z: 0}, edge, cactusSeam, [air, stone, cactus], 10).quadCount).toBe(6)

    const snowFloor = blocks()
    snowFloor[index(2, 1, 2)] = snowLayer.runtimeId
    snowFloor[index(2, 0, 2)] = stone.runtimeId
    expect(meshChunk({x: 0, y: 0, z: 0}, edge, snowFloor, [air, stone, snowLayer], 11).quadCount).toBe(5)

    const snowCeiling = blocks()
    snowCeiling[index(2, edge, 2)] = snowLayer.runtimeId
    snowCeiling[index(2, edge + 1, 2)] = stone.runtimeId
    expect(meshChunk({x: 0, y: 0, z: 0}, edge, snowCeiling, [air, stone, snowLayer], 12).quadCount).toBe(6)

test "adjacent snow layers cull or clip only their shared height":
    const equalLayers = blocks()
    equalLayers[index(2, 2, 2)] = snowLayer.runtimeId
    equalLayers[index(3, 2, 2)] = snowLayer.runtimeId
    expect(meshChunk({x: 0, y: 0, z: 0}, edge, equalLayers, [air, snowLayer], 13).quadCount).toBe(10)

    const deepSnow = ClientRenderState.from(snowLayer, {runtimeId: 16, layers: 4})
    const steppedLayers = blocks()
    steppedLayers[index(2, 2, 2)] = snowLayer.runtimeId
    steppedLayers[index(3, 2, 2)] = deepSnow.runtimeId
    expect(meshChunk({x: 0, y: 0, z: 0}, edge, steppedLayers, [air, snowLayer, deepSnow], 14).quadCount).toBe(11)

test "ground cover keeps a one-sixteenth layer scale independent from snow":
    const deepCover = ClientRenderState.from(groundCover, {runtimeId: 19, layers: 4})
    const coverVolume = blocks()
    coverVolume[index(2, 2, 2)] = deepCover.runtimeId
    const coverMesh = meshChunk({x: 0, y: 0, z: 0}, edge, coverVolume, [air, deepCover], 32)
    expect(coverMesh.quadCount).toBe(6)
    expect(coverMesh.batches[0].positions[1]).toBe(1.25)

    const deepSnow = ClientRenderState.from(snowLayer, {runtimeId: 20, layers: 4})
    const snowVolume = blocks()
    snowVolume[index(2, 2, 2)] = deepSnow.runtimeId
    const snowMesh = meshChunk({x: 0, y: 0, z: 0}, edge, snowVolume, [air, deepSnow], 33)
    expect(snowMesh.batches[0].positions[1]).toBe(1.5)

    coverVolume[index(3, 2, 2)] = deepCover.runtimeId
    expect(meshChunk({x: 0, y: 0, z: 0}, edge, coverVolume, [air, deepCover], 34).quadCount).toBe(10)

test "weighted texture variants are deterministic and distributed by world position":
    const mixedTexture = renderTexture(
        "test:texture/mixed",
        [
            {layer: 5, weight: 1},
            {layer: 9, weight: 1},
        ],
    )
    const mixedStone = state(7, ClientBlockModelKind.cube, true, BlockRenderLayer.opaque, mixedTexture)
    const volume = blocks()
    for z in range(edge):
        for x in range(edge): volume[index(x + 1, 2, z + 1)] = mixedStone.runtimeId
    const first = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, mixedStone], 6)
    const second = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, mixedStone], 7)
    expect(first.batches.size).toBe(second.batches.size)
    for batch, batchIndex in first.batches:
        const replayed = second.batches[batchIndex]
        expect(batch.textureLayers.size).toBe(replayed.textureLayers.size)
        for layer, offset in batch.textureLayers: expect(layer).toBe(replayed.textureLayers[offset])
    let sawPrimary = false
    let sawAlternative = false
    for offset in range(0, first.batches[0].textureLayers.size, 4):
        const layer = first.batches[0].textureLayers[offset]
        for vertexOffset in range(1, 4): expect(first.batches[0].textureLayers[offset + vertexOffset]).toBe(layer)
        if layer == 5: sawPrimary = true
        if layer == 9: sawAlternative = true
    expect(sawPrimary).toBe(true)
    expect(sawAlternative).toBe(true)

    for offset in range(0, first.batches[0].uvs.size, 8):
        expect(first.batches[0].uvs[offset]).toBe(0)
        expect(first.batches[0].uvs[offset + 1]).toBe(0)
        expect(first.batches[0].uvs[offset + 2]).toBe(1)
        expect(first.batches[0].uvs[offset + 3]).toBe(0)
        expect(first.batches[0].uvs[offset + 4]).toBe(1)
        expect(first.batches[0].uvs[offset + 5]).toBe(1)
        expect(first.batches[0].uvs[offset + 6]).toBe(0)
        expect(first.batches[0].uvs[offset + 7]).toBe(1)

test "terrain corner occlusion responds to solid neighbours and keeps plants and water clear":
    for neighbour in [stone, plant, water]:
        const volume = blocks()
        volume[index(2, 2, 2)] = stone.runtimeId
        volume[index(1, 3, 2)] = neighbour.runtimeId
        volume[index(2, 3, 1)] = neighbour.runtimeId
        const mesh = meshChunk({x: 0, y: 0, z: 0}, edge, volume, [air, stone, plant, water], 50)
        const batch = mesh.batches.filter(candidate => candidate.layer == BlockRenderLayer.opaque)[0]
        let dark = 1
        let bright = 0
        for vertex in range(batch.tintRoles.size):
            const offset = vertex * 3
            if batch.normals[offset + 1] != 1 or batch.positions[offset + 1] != 2: continue
            dark = Math.min(dark, batch.colors[vertex * 4])
            bright = Math.max(bright, batch.colors[vertex * 4])
        expect(bright).toBe(1)
        if neighbour.occludes: expect(dark > 0.63 and dark < 0.65).toBe(true)
        else: expect(dark).toBe(1)
