const catalogSource = BlockCatalogSource.parse(Json.parse(catalogJson))

export const blockRegistry = BlockRegistry(catalogSource)
export const blockCatalogSchemaVersion = catalogSource.schemaVersion
export const blockCatalogVersion = catalogSource.catalogVersion
export const blockCatalogHash = "4791c2de60a146c5949747ffe0bfe6ada7bcccd8b16c630e4b69222cf0b66e5c"

export def blockCatalog() -> List<BlockDefinition>:
    return blockRegistry.catalog()

export def requireBlockId(blockId: number):
    blockRegistry.requireById(blockId)

export def blockDefinition(blockId: number) -> BlockDefinition:
    return blockRegistry.requireById(blockId)

export def isFluidBlock(blockId: number) -> bool:
    return blockDefinition(blockId).simulation.fluid != BlockFluid.empty

export def isNaturalRock(blockId: number) -> bool:
    return blockRegistry.hasTag(blockId, "natural_rock")

export const airBlock = blockRegistry.idForKey("openvoxel:air")
export const grassBlock = blockRegistry.idForKey("openvoxel:grass")
export const dirtBlock = blockRegistry.idForKey("openvoxel:dirt")
export const stoneBlock = blockRegistry.idForKey("openvoxel:stone")
export const waterBlock = blockRegistry.idForKey("openvoxel:water")
export const magmaBlock = blockRegistry.idForKey("openvoxel:magma")
export const sandBlock = blockRegistry.idForKey("openvoxel:sand")
export const sandstoneBlock = blockRegistry.idForKey("openvoxel:sandstone")
export const graniteBlock = blockRegistry.idForKey("openvoxel:granite")
export const basaltBlock = blockRegistry.idForKey("openvoxel:basalt")
export const gravelBlock = blockRegistry.idForKey("openvoxel:gravel")
export const limestoneBlock = blockRegistry.idForKey("openvoxel:limestone")
export const clayBlock = blockRegistry.idForKey("openvoxel:clay")
export const iceBlock = blockRegistry.idForKey("openvoxel:ice")
export const snowBlock = blockRegistry.idForKey("openvoxel:snow")
