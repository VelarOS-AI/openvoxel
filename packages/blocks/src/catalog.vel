import {BlockCatalogArtifact, BlockDefinition, BlockFluid} from "./schema.vel"
import {createBlockRegistry} from "./registry.vel"
import json blockCatalogData from "@openvoxel/blocks/block-catalog-data"

const artifact = BlockCatalogArtifact.parse(blockCatalogData)
assert artifact.artifactVersion == 1 else "Unsupported generated block catalog artifact version"
const catalogSource = artifact.catalog

export const blockRegistry = createBlockRegistry(catalogSource)
export const blockCatalogSchemaVersion = catalogSource.schemaVersion
export const blockCatalogVersion = catalogSource.catalogVersion
export const blockCatalogHash = artifact.contentHash
export const blockIdMapHash = artifact.idMapHash

export def blockCatalog() -> readonly List<readonly BlockDefinition>: return blockRegistry.catalog()

export def blockId(key: string) -> number: return blockRegistry.idForKey(key)

export def requireBlockId(blockId: number): blockRegistry.requireById(blockId)

export def blockDefinition(blockId: number) -> readonly BlockDefinition: return blockRegistry.requireById(blockId)

export def isFluidBlock(blockId: number) -> bool: return blockDefinition(blockId).simulation.fluid != BlockFluid.empty

export def isNaturalRock(blockId: number) -> bool: return blockRegistry.hasTag(blockId, "natural_rock")
