export enum BlockCollision:
    empty = "none"
    fullCube = "full_cube"

export enum BlockOcclusion:
    empty = "none"
    fullCube = "full_cube"

export enum BlockFluid:
    empty = "none"
    water
    magma

export enum BlockRenderShape:
    empty = "none"
    cube
    cross
    model

export enum BlockRenderLayer:
    opaque
    cutout
    translucent

export type BlockTextures:
    all: string?
    top: string?
    bottom: string?
    side: string?

export type BlockSimulation:
    collision: BlockCollision
    occlusion: BlockOcclusion
    fluid: BlockFluid

export type EmptyBlockRender:
    shape: BlockRenderShape.empty

export type CubeBlockRender:
    shape: BlockRenderShape.cube
    layer: BlockRenderLayer
    material: string
    textures: BlockTextures
    tint: string?
    animation: string?

export type CrossBlockRender:
    shape: BlockRenderShape.cross
    layer: BlockRenderLayer
    material: string
    textures: BlockTextures
    tint: string?
    animation: string?

export type ModelBlockRender:
    shape: BlockRenderShape.model
    layer: BlockRenderLayer
    material: string
    model: string
    tint: string?
    animation: string?

export type BlockRender = EmptyBlockRender | CubeBlockRender | CrossBlockRender | ModelBlockRender

export type BlockDefinition:
    readonly id: number
    readonly key: string
    readonly translationKey: string
    readonly tags: List<string>
    readonly simulation: BlockSimulation
    readonly render: BlockRender

export type BlockCatalogSource:
    readonly schemaVersion: number
    readonly catalogVersion: string
    readonly retiredIds: List<number>
    readonly blocks: List<BlockDefinition>

export type BlockCatalogArtifact:
    readonly artifactVersion: number
    readonly contentHash: string
    readonly idMapHash: string
    readonly catalog: BlockCatalogSource
