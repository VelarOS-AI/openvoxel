import {BlockCatalogSource, BlockDefinition, BlockFluid, BlockRenderShape} from "./schema.vel"

export class InvalidBlockIdError extends Error:
    constructor(const blockId: number): super(f"Block id {blockId} must be an integer from 0 through 65535")

export class UnknownBlockIdError extends Error:
    constructor(const blockId: number): super(f"Unknown block id {blockId}")

export class RetiredBlockIdError extends Error:
    constructor(const blockId: number): super(f"Retired block id {blockId}")

def requireTextureKey(value: string?, label: string):
    if value != null: assert not value.isBlank() else f"{label} cannot be blank"

def validateRender(definition: readonly BlockDefinition):
    const render = definition.render
    match render.shape:
        case BlockRenderShape.empty: assert definition.id == 0 else "Only the air block may omit rendering"
        case BlockRenderShape.model:
            assert not render.material.isBlank() else f"Model block {definition.key} requires a material key"
            assert not render.model.isBlank() else f"Model block {definition.key} requires a model key"
        case _:
            assert not render.material.isBlank() else f"Block {definition.key} requires a material key"
            const textures = render.textures
            requireTextureKey(textures.all, f"Block {definition.key} all texture")
            requireTextureKey(textures.top, f"Block {definition.key} top texture")
            requireTextureKey(textures.bottom, f"Block {definition.key} bottom texture")
            requireTextureKey(textures.side, f"Block {definition.key} side texture")
            const hasUniform = textures.all != null
            const hasFaces = textures.top != null and textures.bottom != null and textures.side != null
            assert hasUniform or hasFaces else f"Block {definition.key} requires either one uniform texture or top, bottom, and side textures"

def validateDefinition(definition: readonly BlockDefinition):
    assert definition.id.isInteger() else "Block id must be an integer"
    assert definition.id >= 0 and definition.id <= 0xffff else "Block id must fit in UInt16"
    assert not definition.key.isBlank() and definition.key.has(":") else "Block key must be a namespaced value"
    assert not definition.translationKey.isBlank() else f"Block {definition.key} requires a translation key"
    const tags: Set<string> = Set()
    for tag in definition.tags:
        assert not tag.isBlank() else f"Block {definition.key} cannot contain a blank tag"
        assert not (tag in tags) else f"Block {definition.key} contains duplicate tag {tag}"
        tags.add(tag)
    if definition.simulation.fluid != BlockFluid.empty:
        assert str(definition.simulation.fluid) in tags else f"Fluid block {definition.key} must carry its fluid tag"
    validateRender(definition)

export def requireBlockStorageId(blockId: number):
    if not blockId.isInteger() or blockId < 0 or blockId > 0xffff: throw InvalidBlockIdError(blockId)

/// Immutable catalog data plus the small lookup functions built from it. The
/// Maps stay inside the factory closure instead of becoming a mutable service
/// object with constructor-owned state.
export type BlockRegistry:
    catalog: () -> readonly List<readonly BlockDefinition>
    requireById: (blockId: number) -> readonly BlockDefinition
    requireByKey: (key: string) -> readonly BlockDefinition
    idForKey: (key: string) -> number
    hasTag: (blockId: number, tag: string) -> bool

export def createBlockRegistry(source: readonly BlockCatalogSource) -> BlockRegistry:
    assert source.schemaVersion == 1 else "Unsupported block catalog schema version"
    assert not source.catalogVersion.isBlank() else "Block catalog version cannot be blank"
    assert source.blocks.size > 0 and source.blocks.size <= 0x10000 else "Block catalog must contain from 1 through 65536 definitions"
    const byId: Map<number, readonly BlockDefinition> = Map()
    const byKey: Map<string, readonly BlockDefinition> = Map()
    const tagsById: Map<number, readonly Set<string>> = Map()
    const retiredIds: Set<number> = Set()

    for retiredId in source.retiredIds:
        requireBlockStorageId(retiredId)
        assert not (retiredId in retiredIds) else f"Duplicate retired block id {retiredId}"
        retiredIds.add(retiredId)
    for definition in source.blocks:
        validateDefinition(definition)
        assert not (definition.id in retiredIds) else f"Active block id {definition.id} is also retired"
        assert byId.get(definition.id) == null else f"Duplicate block id {definition.id}"
        assert byKey.get(definition.key) == null else f"Duplicate block key {definition.key}"
        byId.set(definition.id, definition)
        byKey.set(definition.key, definition)
        tagsById.set(definition.id, Set(definition.tags))

    def catalog() -> readonly List<readonly BlockDefinition>: return source.blocks

    def requireById(blockId: number) -> readonly BlockDefinition:
        requireBlockStorageId(blockId)
        if blockId in retiredIds: throw RetiredBlockIdError(blockId)
        const definition = byId.get(blockId)
        if definition == null: throw UnknownBlockIdError(blockId)
        return definition

    def requireByKey(key: string) -> readonly BlockDefinition:
        const definition = byKey.get(key)
        assert definition != null else f"Unknown block key {key}"
        return definition

    def idForKey(key: string) -> number: return requireByKey(key).id

    def hasTag(blockId: number, tag: string) -> bool:
        requireById(blockId)
        const tags = tagsById.get(blockId)
        assert tags != null else f"Missing tag index for block id {blockId}"
        return tag in tags

    const air = requireById(0)
    assert air.key == "openvoxel:air" else "Block id 0 must be openvoxel:air"
    return {catalog, requireById, requireByKey, idForKey, hasTag}
