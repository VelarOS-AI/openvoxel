import {exists, makeDirectory, readText, writeText} from "velar/fs"
import {generateCatalogArtifacts} from "./catalog-artifact.vel"
import {readBlockCatalogInputs} from "./catalog-input.vel"

const inputs = await readBlockCatalogInputs()
const output = generateCatalogArtifacts(inputs.manifestText, inputs.identitiesText, inputs.sourceTexts)

const generatedDirectory = "generated"
if not await exists(generatedDirectory): await makeDirectory(generatedDirectory)
const catalogPath = "generated/block-catalog.json"
if not await exists(catalogPath) or await readText(catalogPath, 4 * 1024 * 1024) != output.catalogText:
    await writeText(catalogPath, output.catalogText)
