{
  "name": "@openvoxel/blocks",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "files": [
    "data",
    "generated",
    "src"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./block-catalog-data": "./generated/block-catalog.json"
  },
  "velar": {
    "entry": "src/index.vel",
    "targets": [
      "core",
      "node",
      "web",
      "desktop"
    ],
    "requires": {
      "capabilities": []
    },
    "resources": {
      "./block-catalog-data": {
        "path": "generated/block-catalog.json",
        "type": "json"
      }
    }
  },
  "scripts": {
    "generate": "velar run tools/generate.vel",
    "generate:check": "velar run tools/check-generated.vel",
    "check": "velar check",
    "format": "velar format",
    "format:check": "velar format --check",
    "test": "velar test",
    "build": "velar build"
  },
  "dependencies": {
    "@openvoxel/identities": "0.2.0",
    "@velarscript-labs/yaml": "0.1.5"
  },
  "devDependencies": {
    "@velarscript/cli": "0.20.0",
    "@velarscript/node": "0.20.0"
  }
}
