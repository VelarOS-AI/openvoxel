import {expect} from "velar/test"
import {BlockBehaviorKind, BlockCatalogContribution, BlockCatalogSource, BlockDefinition, BlockRenderLayer, BlockStateDefinition, baseBlockCatalogSource, blockCatalog, blockCatalogHash, blockCatalogSchemaVersion, blockCatalogVersion, blockStateCatalog, blockStateDefinition, blockStateMapHash, blockStateRuntimeId, blockTypeDefinition, builtinIdentities, createWorldBlockRegistry, defaultBlockStateRuntimeId, firstModBlockStateRuntimeId, hasBlockBehavior, isFluidBlock, isNaturalRock, requireBlockState, withBlockStateProperty, worldBlockStateRuntimeId} from "../src/index.vel"

const airBlockState = defaultBlockStateRuntimeId(builtinIdentities.blocks.air)
const grassBlockState = defaultBlockStateRuntimeId(builtinIdentities.blocks.grass)
const stoneBlockState = defaultBlockStateRuntimeId(builtinIdentities.blocks.stone)
const waterBlockState = defaultBlockStateRuntimeId(builtinIdentities.blocks.water)

def contributionCatalog(blockKey: string) -> BlockCatalogSource:
    const sourceState = BlockStateDefinition.parse(blockStateDefinition(stoneBlockState))
    const state = BlockStateDefinition.from(sourceState, {
        runtimeId: 0,
        stateKey: blockKey,
        blockKey,
        properties: [],
    })
    const sourceBlock = BlockDefinition.parse(blockTypeDefinition(builtinIdentities.blocks.stone))
    const block = BlockDefinition.from(sourceBlock, {
        defaultStateRuntimeId: 0,
        key: blockKey,
        translationKey: f"block.{blockKey.replace(":", ".")}",
        tags: [],
        properties: [],
        defaultState: [],
    })
    return {
        schemaVersion: 3,
        catalogVersion: f"{blockKey}:v1",
        reservedRuntimeIds: [],
        blocks: [block],
        states: [state],
    }

def contribution(owner: string, blockKey: string) -> BlockCatalogContribution:
    return {owner, catalog: contributionCatalog(blockKey), stateAliases: []}

test "generated runtime catalog expands finite states with UInt32 identities":
    expect(blockCatalogSchemaVersion).toBe(3)
    expect(blockCatalogVersion).toBe(baseBlockCatalogSource.catalogVersion)
    expect(blockCatalogHash).toBe("c51b21d7471c32c5e881772e1c48edcc2eb6eb3fec06fd782ce444712defb17e")
    expect(blockStateMapHash).toBe("e6e74b3af819c55d563a4688f7945ef5319369e5b6721cb5b26e268879e81832")
    expect(blockCatalog().size).toBe(38)
    expect(blockStateCatalog().size).toBe(183)
    expect(airBlockState).toBe(0)
    expect(stoneBlockState).toBe(147)
    expect(grassBlockState).toBe(28)
    expect(blockTypeDefinition(builtinIdentities.blocks.grass).render.layer).toBe(BlockRenderLayer.opaque)
    expect(blockTypeDefinition(builtinIdentities.blocks.water).render.model).toBe(builtinIdentities.models.block.fluid)
    expect(blockTypeDefinition(builtinIdentities.blocks.air).interaction.breakable).toBe(false)
    expect(isFluidBlock(waterBlockState)).toBe(true)
    expect(isNaturalRock(stoneBlockState)).toBe(true)

test "state registry resolves properties through explicit runtime ids":
    const oakLog = defaultBlockStateRuntimeId(builtinIdentities.blocks.oakLog)
    const oakLogX = blockStateRuntimeId(builtinIdentities.blocks.oakLog, [{name: "axis", value: "x"}])
    expect(oakLog).toBe(98)
    expect(oakLogX).toBe(97)
    expect(withBlockStateProperty(oakLog, "axis", "x")).toBe(oakLogX)
    expect(blockStateDefinition(oakLogX).stateKey).toBe(f"{builtinIdentities.blocks.oakLog}[axis=x]")
    expect(hasBlockBehavior(oakLogX, BlockBehaviorKind.placement)).toBe(true)
    requireBlockState(oakLogX)
    expect(blockStateDefinition(oakLogX).runtimeId).toBe(oakLogX)
    expect(() => requireBlockState(0xffffffff)).toThrow()

test "world registry assigns Mod states above the built-in range and keeps missing mappings":
    const farming = contribution("farming", "farming:tomato_crop")
    const installed = createWorldBlockRegistry(baseBlockCatalogSource, [farming])
    const tomatoRuntimeId = worldBlockStateRuntimeId(installed.snapshot, "farming:tomato_crop")
    expect(tomatoRuntimeId).toBe(firstModBlockStateRuntimeId)
    expect(tomatoRuntimeId > 0xffff).toBe(true)
    expect(installed.registry.requireStateByRuntimeId(tomatoRuntimeId).blockKey).toBe("farming:tomato_crop")

    const unavailable = createWorldBlockRegistry(baseBlockCatalogSource, [], installed.snapshot)
    expect(unavailable.missingStates.size).toBe(1)
    expect(unavailable.missingStates[0].runtimeId).toBe(tomatoRuntimeId)

    const restored = createWorldBlockRegistry(baseBlockCatalogSource, [farming], unavailable.snapshot)
    expect(worldBlockStateRuntimeId(restored.snapshot, "farming:tomato_crop")).toBe(tomatoRuntimeId)
    expect(restored.missingStates.size).toBe(0)

test "explicit Mod aliases move an existing world mapping to the renamed state":
    const original = contribution("farming", "farming:tomato_crop")
    const installed = createWorldBlockRegistry(baseBlockCatalogSource, [original])
    const originalRuntimeId = worldBlockStateRuntimeId(installed.snapshot, "farming:tomato_crop")
    const renamed: BlockCatalogContribution = {
        owner: "farming",
        catalog: contributionCatalog("farming:tomato_plant"),
        stateAliases: [{from: "farming:tomato_crop", to: "farming:tomato_plant"}],
    }
    const updated = createWorldBlockRegistry(baseBlockCatalogSource, [renamed], installed.snapshot)
    expect(worldBlockStateRuntimeId(updated.snapshot, "farming:tomato_plant")).toBe(originalRuntimeId)
    expect(updated.missingStates.size).toBe(0)
