export type BuiltinLootKeys:
    empty: string
    block: BuiltinBlockLootKeys

/// 放置、行走、命中和破坏反馈使用的声音组身份。
export type BuiltinSoundKeys:
    glass: string
    grass: string
    gravel: string
    leaves: string
    magma: string
    silent: string
    sand: string
    snow: string
    stone: string
    water: string
    wood: string

/// 工具类别标签，用于挖掘效率和掉落条件判断。
export type BuiltinToolKeys:
    axe: string
    pickaxe: string
    shears: string
    shovel: string

/// 流体模拟类型身份，行为系统根据它选择水或岩浆规则。
export type BuiltinFluidKeys:
    magma: string
    water: string

/// 数据驱动行为指向的稳定处理器身份。
export type BuiltinHandlerKeys:
    leafDecay: string

/// 方块显示名称的本地化键，结构与 blocks 保持一致以便查找。
export type BuiltinTranslationKeys:
    block: BuiltinBlockKeys

/// 运行时身份树直接嵌入生成产物，业务代码通过相同层级访问。
/// 每个字段名同时也是方块 YAML 打点路径的第一段。
export type BuiltinIdentities:
    /// 命名空间所有权。
    namespaces: BuiltinNamespaces
    /// 内容目录版本。
    catalogs: BuiltinCatalogKeys
    /// 世界生成器身份。
    generators: BuiltinWorldGenerators
    /// 世界生成材料调色板身份。
    worldGeneratorPalettes: BuiltinWorldGeneratorPalettes
    /// 与气候解耦的地形骨架类型。
    terrainTypes: BuiltinTerrainTypeKeys
    /// 最终气候群系身份。
    biomes: BuiltinBiomeKeys
    /// 方块家族身份。
    blocks: BuiltinBlockKeys
    /// 方块语义标签。
    tags: BuiltinBlockTags
    /// 自定义体素形状。
    shapes: BuiltinShapeKeys
    /// 逻辑渲染模型。
    models: BuiltinModelKeys
    /// 材质规则。
    materials: BuiltinMaterialKeys
    /// 逻辑纹理。
    textures: BuiltinTextureKeys
    /// 染色规则。
    tints: BuiltinTintKeys
    /// 动画规则。
    animations: BuiltinAnimationKeys
    /// 掉落表。
    loot: BuiltinLootKeys
    /// 声音组。
    sounds: BuiltinSoundKeys
    /// 工具标签。
    tools: BuiltinToolKeys
    /// 流体类型。
    fluids: BuiltinFluidKeys
    /// 行为处理器。
    handlers: BuiltinHandlerKeys
    /// 本地化键。
    translations: BuiltinTranslationKeys

/// 方块编译器只消费自己负责的身份根。这个窄视图避免方块配置因为地形类型、
/// 群系或生成器身份的变化而重新承担世界生成配置校验。
export type BuiltinBlockIdentities:
    namespaces: BuiltinNamespaces
    blocks: BuiltinBlockKeys
    tags: BuiltinBlockTags
    loot: BuiltinLootKeys

/// identities.yml 顶层文档保留独立格式版本，便于生成器先验证结构再读取身份树。
export type BuiltinIdentityDocument:
    formatVersion: number
    /// 保留 identities.yml 的完整开放树；强类型核心视图在使用边界另行解析。
    identities: Record<unknown>
