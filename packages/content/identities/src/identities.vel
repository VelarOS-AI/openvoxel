/// 生物群系或其他环境颜色修正规则。
export type BuiltinTintKeys:
    deciduousFoliage: string
    birchFoliage: string
    poplarFoliage: string
    drylandFoliage: string
    evergreenFoliage: string
    tallSpruceFoliage: string
    biomeGrass: string
    biomeGrassTop: string
    biomeWater: string
    kelpFoliage: string
    seagrassFoliage: string

/// 动态纹理的动画规则身份。
export type BuiltinAnimationKeys:
    magma: string

/// 各方块默认掉落表的逻辑身份。
export type BuiltinBlockLootKeys:
    basalt: string
    birchLeaves: string
    birchLog: string
    birchSapling: string
    blueFlower: string
    cactus: string
    clay: string
