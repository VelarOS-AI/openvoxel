/// BuiltinIdentities 是所有内容包共享的强类型身份视图。
/// 例如方块 YAML 中的 models.block.fluid 会逐层读取 identities.models.block.fluid，
/// 运行时代码也使用 builtinIdentities.models.block.fluid 访问同一位置。
/// 完整身份树以 Record<unknown> 原样进入生成产物，因此只被 YAML 数据引用的新身份
/// 不需要修改这里；只有新增 VelarScript 直接访问路径时才扩充这份核心类型契约。
/// 真正的 openvoxel:* 身份值始终只由 identities.yml 提供。

/// 所有基础方块家族的稳定身份，例如 blocks.water 和 blocks.stone。
export type BuiltinBlockKeys:
    podzol: string
    moss: string
    mud: string
    coarseDirt: string
    redSand: string
    terracotta: string
    ochreClay: string
    fern: string
    redMushroom: string
    brownMushroom: string
    air: string
    basalt: string
    birchLeaves: string
    birchLog: string
    birchSapling: string
    blueFlower: string
    cactus: string
    clay: string
    coalOre: string
    copperOre: string
    cotton: string
    deadwood: string
    diamondOre: string
    dirt: string
    dryBush: string
    fallenLeaves: string
    germaniumOre: string
    granite: string
    grass: string
    gravel: string
    ice: string
    ironOre: string
    kelp: string
    largeDryBush: string
    limestone: string
    marble: string
    magma: string
    mimosaLeaves: string
    mimosaLog: string
    mimosaSapling: string
    oakLeaves: string
    oakLog: string
    oakSapling: string
    poplarLeaves: string
    poplarLog: string
    poplarSapling: string
    pumpkin: string
    pumpkinStem: string
    purpleFlower: string
    redFlower: string
    rye: string
    rottenPumpkin: string
    saltpeterOre: string
    sand: string
    sandstone: string
    seaUrchin: string
    seagrass: string
    snow: string
    spruceLeaves: string
    tallSpruceLeaves: string
    spruceLog: string
    spruceSapling: string
    starfish: string
    stone: string
    sulphurOre: string
    tallGrass: string
    water: string
    whiteFlower: string
    vine: string
    wheat: string
    yellowFlower: string

/// 供玩法和生成系统查询的语义分类，不参与方块状态键计算。
export type BuiltinBlockTags:
    aquatic: string
    aquaticPlantSupport: string
    bottomDwellerSupport: string
    cactusSupport: string
    cropSupport: string
    damaging: string
    dryPlantSupport: string
    flammable: string
    fluid: string
    ice: string
    leaves: string
    magma: string
    naturalRock: string
    ore: string
    plant: string
    lushPlantSupport: string
    replaceable: string
    snow: string
    snowSupport: string
    soil: string
    terrain: string
    treeSupport: string
    vineSupport: string
    water: string
    wood: string

/// 世界生成算法身份；世界清单通过它选择确定性的生成器实现。
export type BuiltinWorldGenerators:
    survival: string

/// 世界生成材料调色板身份。它把生成算法中的语义槽位绑定到内容方块，
/// 但不属于方块定义，也不属于地形参数。
export type BuiltinWorldGeneratorPalettes:
    survival: string

/// 地形骨架类型只描述地貌，不夹带温度、湿度或植被含义。
export type BuiltinTerrainTypeKeys:
    deepOcean: string
    ocean: string
    coast: string
    plain: string
    hill: string
    mountain: string
    valley: string
    river: string

/// 群系身份描述最终气候结果；群系在地形骨架完成后选择。
export type BuiltinBiomeKeys:
    meadow: string
    birchForest: string
    taiga: string
    wetland: string
    savanna: string
    steppe: string
    badlands: string
    alpine: string
    ocean: string
    coast: string
    river: string
    plains: string
    forest: string
    desert: string
    tundra: string

/// 基础内容拥有的命名空间，编译器用它检查内建方块归属。
export type BuiltinNamespaces:
    base: string

/// 基础方块目录的语义版本身份。
export type BuiltinCatalogKeys:
    base: string

/// 自定义碰撞、选取和遮挡形状的逻辑身份。
export type BuiltinShapeKeys:
    pumpkin: string
    cactus: string
    cross: string
    fluid: string
    groundCover: string
    snowLayer: string

/// 方块逻辑模型身份；客户端负责把它们映射到具体网格实现。
export type BuiltinBlockModelKeys:
    cactus: string
    column: string
    cross: string
    cube: string
    fluid: string
    groundCover: string
    snowLayer: string
    submergedCross: string
    submergedSurface: string
    pumpkin: string
    starfish: string
    seaUrchin: string
    wallOverlay: string

export type BuiltinModelKeys:
    block: BuiltinBlockModelKeys

/// 渲染材质规则身份，描述不透明、叶片、流体等渲染策略。
export type BuiltinMaterialKeys:
    cross: string
    ice: string
    leaves: string
    magma: string
    metal: string
    model: string
    terrain: string
    water: string

