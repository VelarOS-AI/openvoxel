import {BuiltinBlockIdentities} from "@openvoxel/identities"
import {BlockShapeKind, BlockSourceFile, BlockTypeSource} from "../definition/block.vel"
import {BlockCatalogContribution, BlockCatalogManifest, BlockCatalogSource, BlockStateMapSource, BlockStateMapping} from "../definition/catalog.vel"
import {assembleBlockCatalog} from "./catalog-assembly.vel"
import {validateBuiltinBlockIdentities} from "./block-validation.vel"
import {enumerateBlockStates} from "./state-expansion.vel"

/// 按清单中的文件顺序合并分组方块；稳定 ID 分配仍使用规范状态键排序。
export def collectBlockTypes(files: List<BlockSourceFile>) -> List<BlockTypeSource>:
    return files.flatMap(file => file.blocks)

/// 编译 OpenVoxel 基础目录，并验证空气哨兵和内置身份约束。
export def compileBuiltinBlockCatalog(manifest: BlockCatalogManifest, identities: BuiltinBlockIdentities, sourceBlocks: List<BlockTypeSource>, stateMap: BlockStateMapSource) -> BlockCatalogSource:
    validateBuiltinBlockIdentities(identities, sourceBlocks)
    const catalog = assembleBlockCatalog(manifest.schemaVersion, manifest.catalogVersion, sourceBlocks, stateMap)
    const blocks = catalog.blocks
    const air = blocks.find(block => block.key == identities.blocks.air)
    assert air != null and air.defaultStateRuntimeId == 0 else f"Block state runtime id 0 must be the default {identities.blocks.air} state"
    assert air.properties.size == 0 else "Air cannot declare state properties"
    assert air.physics.collision.kind == BlockShapeKind.empty and air.physics.occlusion.kind == BlockShapeKind.empty else "Air cannot collide or occlude"
    assert air.render.model == null and air.light.emission == 0 and air.light.opacity == 0 else "Air cannot render, emit, or block light"
    return catalog

/// 编译一个 Mod 的独立方块目录。临时 runtimeId 会在安装到具体世界时重新绑定。
export def compileModBlockCatalog(owner: string, catalogVersion: string, sourceBlocks: List<BlockTypeSource>) -> BlockCatalogSource:
    assert Text.matches(owner, r"^[a-z][a-z0-9_.-]*$") else "Mod block catalog owner must be a lowercase namespace"
    assert not catalogVersion.isBlank() else "Mod block catalog version cannot be blank"
    assert sourceBlocks.size > 0 else "Mod block catalog cannot be empty"
    const stateKeys: Set<string> = Set()
    for block in sourceBlocks:
        assert block.key.startsWith(f"{owner}:") else f"Mod block {block.key} is outside contribution namespace {owner}"
        for state in enumerateBlockStates(block):
            assert not (state.stateKey in stateKeys) else f"Duplicate Mod block state {state.stateKey}"
            stateKeys.add(state.stateKey)
    const mappings: List<BlockStateMapping> = stateKeys.values()
        .sorted()
        .map((stateKey, runtimeId) => {runtimeId, stateKey})
    const stateMap: BlockStateMapSource = {
        formatVersion: 2,
        nextRuntimeId: mappings.size,
        reservedRuntimeIds: [],
        states: mappings,
    }
    return assembleBlockCatalog(3, catalogVersion, sourceBlocks, stateMap)

/// 生成世界内容目录可直接消费的 Mod contribution。
export def compileModBlockCatalogContribution(owner: string, catalogVersion: string, sourceBlocks: List<BlockTypeSource>) -> BlockCatalogContribution:
    return {
        owner,
        catalog: compileModBlockCatalog(owner, catalogVersion, sourceBlocks),
    }
