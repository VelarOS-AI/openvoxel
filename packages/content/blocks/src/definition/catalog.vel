import {BlockBehavior, BlockInteraction, BlockLight, BlockPhysics, BlockPropertyDefinition, BlockRender, BlockStateProperty} from "./block.vel"

/// data/catalog.yml 的强类型结构，只描述人工源如何组织。
/// catalogVersion 本身也是 identities 中的直接路径，生成时解析为稳定版本身份。
export type BlockCatalogManifest:
    /// 方块目录的数据结构版本；结构发生变化时递增。
    schemaVersion: number
    /// 当前基础内容目录的语义版本。
    catalogVersion: string
    /// 按确定顺序读取的分组方块文件列表。
    sources: List<string>

/// 规范状态键与数字 runtimeId 的一对一映射。
/// stateKey 负责跨版本表达“哪个状态”，runtimeId 负责世界热路径中的紧凑访问。
export type BlockStateMapping:
    runtimeId: number
    stateKey: string

/// 生成器内部使用的完整基础状态映射。
export type BlockStateMapSource:
    /// 状态映射格式版本，与方块目录 schema 分开演进。
    formatVersion: number
    /// 下一个可以分配的基础 runtimeId。
    nextRuntimeId: number
    /// 保留但当前不对应活动状态的 ID，注册表不得分配或解析这些值。
    reservedRuntimeIds: List<number>
    /// 当前所有活动基础状态的确定性映射。
    states: List<BlockStateMapping>

/// 编译后的方块家族，主要供类型级查询和默认放置使用。
/// properties 仍描述全部状态维度，physics 等组件则是默认状态的最终快照。
export type BlockDefinition:
    /// defaultState 对应的数字 runtimeId，可直接写入 Chunk。
    defaultStateRuntimeId: number
    key: string
    translationKey: string
    tags: List<string>
    properties: List<BlockPropertyDefinition>
    defaultState: List<BlockStateProperty>
    physics: BlockPhysics
    light: BlockLight
    render: BlockRender
    interaction: BlockInteraction
    behaviors: List<BlockBehavior>

/// 每个有限属性组合都对应一个独立运行时状态。
/// 这里保存最终组件快照，运行时查询状态时不需要再次匹配 variants。
export type BlockStateDefinition:
    /// 世界或基础目录中使用的 UInt32 状态身份。
    runtimeId: number
    /// 由 blockKey 和排序后的完整 properties 组成的稳定语义键。
    stateKey: string
    /// 该状态所属的方块家族身份。
    blockKey: string
    /// 当前状态的完整属性集合，不是局部差异。
    properties: List<BlockStateProperty>
    physics: BlockPhysics
    light: BlockLight
    render: BlockRender
    interaction: BlockInteraction
    behaviors: List<BlockBehavior>

/// 可以直接交给 BlockRegistry 建立索引的完整编译目录。
export type BlockCatalogSource:
    schemaVersion: number
    catalogVersion: string
    reservedRuntimeIds: List<number>
    blocks: List<BlockDefinition>
    states: List<BlockStateDefinition>

/// 多个状态共享的一组最终组件。生成产物把重复组件只保存一次，运行时再恢复为
/// BlockStateDefinition 的完整快照；profileId 只属于目录传输格式，不进入状态身份。
export type BlockComponentProfile:
    profileId: number
    physics: BlockPhysics
    light: BlockLight
    render: BlockRender
    interaction: BlockInteraction
    behaviors: List<BlockBehavior>

/// 压缩状态只保留身份、属性和组件档案引用。
export type PackedBlockStateDefinition:
    runtimeId: number
    stateKey: string
    blockKey: string
    properties: List<BlockStateProperty>
    componentProfileId: number

/// generated JSON 与网络目录共同使用的紧凑格式。
export type PackedBlockCatalogSource:
    schemaVersion: number
    catalogVersion: string
    reservedRuntimeIds: List<number>
    blocks: List<BlockDefinition>
    componentProfiles: List<BlockComponentProfile>
    states: List<PackedBlockStateDefinition>

/// generated/block-catalog.json 的顶层结构。
/// 唯一 JSON 产物同时携带身份树、编译目录和确定性哈希。
export type BlockCatalogArtifact:
    /// JSON 包装格式版本，用于在运行时拒绝不认识的产物结构。
    artifactVersion: number
    /// 覆盖身份树和完整目录内容；组件或资源变化都会改变它。
    contentHash: string
    /// 只覆盖 runtimeId 与 stateKey 的映射；用于判断世界状态编号是否一致。
    stateMapHash: string
    /// 已完成状态展开和语义验证、并对重复组件做过归并的紧凑目录。
    catalog: PackedBlockCatalogSource

/// Mod 以自己的命名空间贡献内容，世界注册表负责分配最终 runtimeId。
export type BlockCatalogContribution:
    /// Mod 拥有的命名空间，例如 farming；所有贡献 key 都必须属于它。
    owner: string
    /// Mod 编译后的类型和状态内容，其中临时 runtimeId 不会直接写入世界。
    catalog: BlockCatalogSource

/// 世界快照中的最小持久化单元，只保存数字 ID 与稳定状态键。
export type WorldBlockStateMapping:
    readonly runtimeId: number
    readonly stateKey: string

/// 世界快照持久化当前 Content Pack 集合的完整状态映射。
export type WorldBlockRegistrySnapshot:
    /// 世界注册表快照格式版本。
    readonly formatVersion: number
    /// 下一个可用于新 Mod 状态的 UInt32 ID。
    readonly nextModRuntimeId: number
    /// 基础状态与当前 Content Pack 中 Mod 状态的完整映射。
    readonly states: readonly List<readonly WorldBlockStateMapping>
