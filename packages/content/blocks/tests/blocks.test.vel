import {expect} from "velar/test"
import {builtinIdentities} from "@openvoxel/identities"
import {BlockBehaviorKind, BlockCatalogContribution, BlockDefinition, BlockPhysics, BlockPropertyKind, BlockRender, BlockRenderLayer, BlockShapeKind, BlockTypeSource, baseBlockCatalogSource, baseWorldBlockRegistry, blockCatalog, blockCatalogHash, blockCatalogSchemaVersion, blockCatalogVersion, blockStateCatalog, blockStateDefinition, blockStateMapHash, blockStateRuntimeId, blockTypeDefinition, collectBlockRenderResources, compileModBlockCatalogContribution, createWorldBlockRegistry, defaultBlockStateRuntimeId, findCropGrowthBehavior, firstModBlockStateRuntimeId, hasBlockBehavior, isFluidBlock, isNaturalRock, packedBlockCatalog, requireBlockState, resolveBlockShapeBoxes, withBlockStateProperty, worldBlockStateRuntimeId} from "../src/index.vel"

const airBlockState = defaultBlockStateRuntimeId(builtinIdentities.blocks.air)
const grassBlockState = defaultBlockStateRuntimeId(builtinIdentities.blocks.grass)
const stoneBlockState = defaultBlockStateRuntimeId(builtinIdentities.blocks.stone)
const waterBlockState = defaultBlockStateRuntimeId(builtinIdentities.blocks.water)

def contributionSource(blockKey: string) -> BlockTypeSource:
    const sourceBlock = BlockDefinition.parse(blockTypeDefinition(builtinIdentities.blocks.stone))
    return BlockTypeSource.from(sourceBlock, {
        key: blockKey,
        translationKey: f"block.{blockKey.replace(":", ".")}",
        tags: [],
        properties: [],
        defaultState: [],
        behaviors: sourceBlock.behaviors.copy(),
        variants: [],
    })

def contribution(owner: string, blockKey: string) -> BlockCatalogContribution:
    return compileModBlockCatalogContribution(owner, f"{blockKey}:v1", [contributionSource(blockKey)])

def fluidContributionSource(
    blockKey: string,
    canonicalBlock: string,
    maximumLevel: number = 15,
    defaultLevel: number = 0,
) -> BlockTypeSource:
    const source = contributionSource(blockKey)
    return BlockTypeSource.from(source, {
        properties: [
            {name: "falling", kind: BlockPropertyKind.boolean},
            {name: "level", kind: BlockPropertyKind.integer, minimum: 0, maximum: maximumLevel},
        ],
        defaultState: [{name: "falling", value: false}, {name: "level", value: defaultLevel}],
        behaviors: [{
            kind: BlockBehaviorKind.fluid,
            fluidKey: "farming:fluid/water",
            canonicalBlock,
            levelProperty: "level",
            fallingProperty: "falling",
            tickRate: 5,
            viscosity: 1,
        }],
    })

test "generated runtime catalog expands finite states with UInt32 identities":
    expect(blockCatalogSchemaVersion).toBe(6)
    expect(blockCatalogVersion).toBe(baseBlockCatalogSource.catalogVersion)
    expect(blockCatalogHash).toBe("2cf8d366a7ba492174c4eed35e0df46e9b072e473c91f9a8e1e339a343ed1116")
    expect(blockStateMapHash).toBe("ffbd052087d27f2c05ea32f5d1646a225b033c991db99a449d3e90e44bdb4a17")
    expect(blockCatalog().size).toBe(61)
    expect(blockStateCatalog().size).toBe(376)
    expect(packedBlockCatalog().componentProfiles.size).toBe(80)
    expect(packedBlockCatalog().states.size).toBe(376)
    expect(airBlockState).toBe(0)
    expect(stoneBlockState).toBe(147)
    expect(grassBlockState).toBe(28)
    expect(blockTypeDefinition(builtinIdentities.blocks.grass).render.layer).toBe(BlockRenderLayer.opaque)
    expect(blockTypeDefinition(builtinIdentities.blocks.water).render.model).toBe(builtinIdentities.models.block.fluid)
    expect(blockTypeDefinition(builtinIdentities.blocks.air).interaction.breakable).toBe(false)
    expect(isFluidBlock(waterBlockState)).toBe(true)
    expect(isNaturalRock(stoneBlockState)).toBe(true)

test "block shape geometry resolves fixed and state-scaled collision boxes":
    const cactus = blockStateDefinition(defaultBlockStateRuntimeId(builtinIdentities.blocks.cactus))
    const cactusBoxes = resolveBlockShapeBoxes(cactus.physics.collision, cactus.properties)
    expect(cactusBoxes.size).toBe(1)
    expect(cactusBoxes[0].minimumX).toBe(0.0625)
    expect(cactusBoxes[0].maximumX).toBe(0.9375)

    const snow = blockStateDefinition(blockStateRuntimeId(builtinIdentities.blocks.snow, [{name: "layers", value: 4}]))
    const snowBoxes = resolveBlockShapeBoxes(snow.physics.collision, snow.properties)
    expect(snowBoxes.size).toBe(1)
    expect(snowBoxes[0].minimumY).toBe(0)
    expect(snowBoxes[0].maximumY).toBe(0.5)

    const air = blockStateDefinition(airBlockState)
    expect(resolveBlockShapeBoxes(air.physics.collision, air.properties)).toEqual([])
    const stone = blockStateDefinition(stoneBlockState)
    expect(resolveBlockShapeBoxes(stone.physics.collision, stone.properties)[0].maximumY).toBe(1)

test "Mod collision shapes compile and preserve multiple declared boxes":
    const source = contributionSource("farming:trellis")
    const trellis = BlockTypeSource.from(source, {
        physics: BlockPhysics.from(source.physics, {collision: {
            kind: BlockShapeKind.custom,
            key: "farming:shape/trellis",
            boxes: [
                {minimumX: 0, minimumY: 0, minimumZ: 0, maximumX: 0.125, maximumY: 1, maximumZ: 1},
                {minimumX: 0.875, minimumY: 0, minimumZ: 0, maximumX: 1, maximumY: 1, maximumZ: 1},
            ],
        }}),
    })
    const compiled = compileModBlockCatalogContribution("farming", "farming:catalog-v1", [trellis])
    const state = compiled.catalog.states[0]
    const boxes = resolveBlockShapeBoxes(state.physics.collision, state.properties)
    expect(boxes.size).toBe(2)
    expect(boxes[0].maximumX).toBe(0.125)
    expect(boxes[1].minimumX).toBe(0.875)

test "Mod collision shapes reject missing geometry and invalid state scaling":
    const source = contributionSource("farming:invalid_shape")
    const missing = BlockTypeSource.from(source, {
        physics: BlockPhysics.from(source.physics, {collision: {kind: BlockShapeKind.custom, key: "farming:shape/missing"}}),
    })
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [missing])).toThrow()

    const scaled = BlockTypeSource.from(source, {
        physics: BlockPhysics.from(source.physics, {collision: {
            kind: BlockShapeKind.custom,
            key: "farming:shape/scaled",
            boxes: [{minimumX: 0, minimumY: 0, minimumZ: 0, maximumX: 1, maximumY: 1, maximumZ: 1, maximumYProperty: "missing", maximumYScale: 0.5}],
        }}),
    })
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [scaled])).toThrow()

test "state registry resolves properties through explicit runtime ids":
    const oakLog = defaultBlockStateRuntimeId(builtinIdentities.blocks.oakLog)
    const oakLogX = blockStateRuntimeId(builtinIdentities.blocks.oakLog, [{name: "axis", value: "x"}])
    expect(oakLog).toBe(98)
    expect(oakLogX).toBe(97)
    expect(withBlockStateProperty(oakLog, "axis", "x")).toBe(oakLogX)
    expect(blockStateDefinition(oakLogX).stateKey).toBe(f"{builtinIdentities.blocks.oakLog}[axis=x]")
    expect(hasBlockBehavior(oakLogX, BlockBehaviorKind.placement)).toBe(true)
    requireBlockState(oakLogX)
    expect(blockStateDefinition(oakLogX).runtimeId).toBe(oakLogX)
    expect(() => requireBlockState(0xffffffff)).toThrow()

test "tag and behavior indexes preserve unknown runtime id errors":
    expect(baseWorldBlockRegistry.registry.hasTag(stoneBlockState, builtinIdentities.tags.naturalRock)).toBe(true)
    expect(baseWorldBlockRegistry.registry.hasBehavior(waterBlockState, BlockBehaviorKind.fluid)).toBe(true)
    expect(() => baseWorldBlockRegistry.registry.hasTag(0xffffffff, builtinIdentities.tags.terrain)).toThrow()
    expect(() => baseWorldBlockRegistry.registry.hasBehavior(0xffffffff, BlockBehaviorKind.fluid)).toThrow()

test "Mod compiler expands finite source states before world id allocation":
    const crop = BlockTypeSource.from(contributionSource("farming:tomato_crop"), {
        properties: [{name: "age", kind: BlockPropertyKind.integer, minimum: 0, maximum: 3}],
        defaultState: [{name: "age", value: 0}],
    })
    const farming = compileModBlockCatalogContribution("farming", "farming:catalog-v1", [crop])
    expect(farming.catalog.blocks.size).toBe(1)
    expect(farming.catalog.states.size).toBe(4)
    expect(farming.catalog.states[0].stateKey).toBe("farming:tomato_crop[age=0]")
    expect(farming.catalog.states[3].stateKey).toBe("farming:tomato_crop[age=3]")

test "crop growth behavior owns its age property and cadence contract":
    const source = contributionSource("farming:tomato_crop")
    const crop = BlockTypeSource.from(source, {
        properties: [{name: "growth_stage", kind: BlockPropertyKind.integer, minimum: 2, maximum: 5}],
        defaultState: [{name: "growth_stage", value: 2}],
        behaviors: [{kind: BlockBehaviorKind.cropGrowth, ageProperty: "growth_stage", epochsPerStage: 6}],
    })
    const compiled = compileModBlockCatalogContribution("farming", "farming:catalog-v1", [crop])
    expect(compiled.catalog.states.size).toBe(4)
    for state in compiled.catalog.states:
        const growth = findCropGrowthBehavior(state.behaviors)
        assert growth != null else "Expected compiled crop growth behavior"
        expect(growth.ageProperty).toBe("growth_stage")
        expect(growth.epochsPerStage).toBe(6)

test "crop growth behavior rejects missing, non-integer, fixed, and invalid cadence contracts":
    const source = contributionSource("farming:invalid_crop")
    const missing = BlockTypeSource.from(source, {
        behaviors: [{kind: BlockBehaviorKind.cropGrowth, ageProperty: "growth_stage", epochsPerStage: 4}],
    })
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [missing])).toThrow()

    const booleanAge = BlockTypeSource.from(source, {
        properties: [{name: "growth_stage", kind: BlockPropertyKind.boolean}],
        defaultState: [{name: "growth_stage", value: false}],
        behaviors: [{kind: BlockBehaviorKind.cropGrowth, ageProperty: "growth_stage", epochsPerStage: 4}],
    })
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [booleanAge])).toThrow()

    const fixedAge = BlockTypeSource.from(source, {
        properties: [{name: "growth_stage", kind: BlockPropertyKind.integer, minimum: 0, maximum: 0}],
        defaultState: [{name: "growth_stage", value: 0}],
        behaviors: [{kind: BlockBehaviorKind.cropGrowth, ageProperty: "growth_stage", epochsPerStage: 4}],
    })
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [fixedAge])).toThrow()

    const zeroCadence = BlockTypeSource.from(source, {
        properties: [{name: "growth_stage", kind: BlockPropertyKind.integer, minimum: 0, maximum: 1}],
        defaultState: [{name: "growth_stage", value: 0}],
        behaviors: [{kind: BlockBehaviorKind.cropGrowth, ageProperty: "growth_stage", epochsPerStage: 0}],
    })
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [zeroCadence])).toThrow()

    const excessiveCadence = BlockTypeSource.from(zeroCadence, {
        behaviors: [{kind: BlockBehaviorKind.cropGrowth, ageProperty: "growth_stage", epochsPerStage: 121}],
    })
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [excessiveCadence])).toThrow()

    const baseCrop = BlockTypeSource.from(source, {
        properties: [{name: "growth_stage", kind: BlockPropertyKind.integer, minimum: 0, maximum: 1}],
        defaultState: [{name: "growth_stage", value: 0}],
        behaviors: [{kind: BlockBehaviorKind.cropGrowth, ageProperty: "growth_stage", epochsPerStage: 4}],
    })
    const missingVariantBehavior = BlockTypeSource.from(baseCrop, {
        variants: [{when: [{name: "growth_stage", value: 1}], behaviors: []}],
    })
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [missingVariantBehavior])).toThrow()

    const changedVariantBehavior = BlockTypeSource.from(baseCrop, {
        variants: [{when: [{name: "growth_stage", value: 1}], behaviors: [{kind: BlockBehaviorKind.cropGrowth, ageProperty: "growth_stage", epochsPerStage: 5}]}],
    })
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [changedVariantBehavior])).toThrow()

test "world registry assigns Mod states above the built-in range and requires exact content":
    const farming = contribution("farming", "farming:tomato_crop")
    const installed = createWorldBlockRegistry(baseBlockCatalogSource, [farming])
    const tomatoRuntimeId = worldBlockStateRuntimeId(installed.index, "farming:tomato_crop")
    expect(tomatoRuntimeId).toBe(firstModBlockStateRuntimeId)
    expect(tomatoRuntimeId > 0xffff).toBe(true)
    expect(installed.registry.requireStateByRuntimeId(tomatoRuntimeId).blockKey).toBe("farming:tomato_crop")

    expect(() => createWorldBlockRegistry(baseBlockCatalogSource, [], installed.snapshot)).toThrow()
    const restored = createWorldBlockRegistry(baseBlockCatalogSource, [farming], installed.snapshot)
    expect(worldBlockStateRuntimeId(restored.index, "farming:tomato_crop")).toBe(tomatoRuntimeId)

test "world registry rejects a renamed state against an existing snapshot":
    const original = contribution("farming", "farming:tomato_crop")
    const installed = createWorldBlockRegistry(baseBlockCatalogSource, [original])
    const renamed = contribution("farming", "farming:tomato_plant")
    expect(() => createWorldBlockRegistry(baseBlockCatalogSource, [renamed], installed.snapshot)).toThrow()

test "front textures validate and join the rendered resource set":
    const source = contributionSource("farming:pumpkin")
    const sideTexture = "farming:texture/block/pumpkin_side"
    const frontTexture = "farming:texture/block/pumpkin_front"
    const unoriented = BlockTypeSource.from(source, {
        render: BlockRender.from(source.render, {textures: {all: sideTexture, front: frontTexture}}),
    })
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [unoriented])).toThrow()
    const pumpkin = BlockTypeSource.from(source, {
        properties: [{name: "facing", kind: BlockPropertyKind.enumeration, values: ["north", "east", "south", "west"]}],
        defaultState: [{name: "facing", value: "north"}],
        render: BlockRender.from(source.render, {textures: {all: sideTexture, front: frontTexture}}),
    })
    const compiled = compileModBlockCatalogContribution("farming", "farming:catalog-v1", [pumpkin])
    const resources = collectBlockRenderResources(compiled.catalog.states)
    expect(compiled.catalog.states.size).toBe(4)
    expect(resources.textures).toEqual([frontTexture, sideTexture])

    const invalid = BlockTypeSource.from(pumpkin, {
        render: BlockRender.from(pumpkin.render, {textures: {all: sideTexture, front: "Pumpkin front"}}),
    })
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [invalid])).toThrow()

test "fluid composites resolve directly to a compatible self-canonical block":
    const water = fluidContributionSource("farming:water", "farming:water")
    const waterGrass = fluidContributionSource("farming:water_grass", "farming:water")
    const contribution = compileModBlockCatalogContribution("farming", "farming:catalog-v1", [water, waterGrass])
    const composite = contribution.catalog.blocks.find(block => block.key == "farming:water_grass")
    assert composite != null else "Expected compiled fluid composite"
    const behavior = composite.behaviors.find(candidate => candidate.kind == BlockBehaviorKind.fluid)
    assert behavior != null and behavior.kind == BlockBehaviorKind.fluid else "Expected fluid behavior"
    expect(behavior.canonicalBlock).toBe("farming:water")

test "fluid composites reject missing, chained, range-incompatible, and unmappable canonical blocks":
    const water = fluidContributionSource("farming:water", "farming:water")
    const missing = fluidContributionSource("farming:missing_fluid", "farming:absent")
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [water, missing])).toThrow()

    const chainedWater = fluidContributionSource("farming:water", "farming:water_grass")
    const chainedGrass = fluidContributionSource("farming:water_grass", "farming:water")
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [chainedWater, chainedGrass])).toThrow()

    const narrow = fluidContributionSource("farming:narrow_water_grass", "farming:water", 7)
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [water, narrow])).toThrow()

    const differentDefault = fluidContributionSource("farming:raised_water_grass", "farming:water", 15, 1)
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [water, differentDefault])).toThrow()

test "fluid state variants preserve volume ownership":
    const water = fluidContributionSource("farming:water", "farming:water")
    const dryVariant = BlockTypeSource.from(water, {
        variants: [{when: [{name: "level", value: 1}], behaviors: []}],
    })
    expect(() => compileModBlockCatalogContribution("farming", "farming:catalog-v1", [dryVariant])).toThrow()
