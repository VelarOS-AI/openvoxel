import {readText} from "velar/fs"
import {identityTree} from "@openvoxel/identities"
import {generateCatalogArtifacts} from "./catalog-artifact.vel"
import {readBlockCatalogInputs} from "./catalog-input.vel"

@main:
    const inputs = await readBlockCatalogInputs()
    const expected = generateCatalogArtifacts(inputs.manifestText, identityTree, inputs.sourceTexts)
    const actualCatalog = await readText("generated/block-catalog.json", 4 * 1024 * 1024)
    assert actualCatalog == expected.catalogText else "Generated block catalog is stale; run npm run generate"
