import {parseYaml} from "@velarscript-labs/yaml"
import {BuiltinBlockIdentities, IdentityResolution, resolveIdentityReferences} from "@openvoxel/identities"
import {sha256Text} from "velar/hash"
import {BlockSourceFile} from "../src/definition/block.vel"
import {BlockCatalogArtifact, BlockStateMapSource, BuiltinBlockCatalogManifest} from "../src/definition/catalog.vel"
import {collectBlockTypes, compileBuiltinBlockCatalog} from "../src/compiler/catalog-compiler.vel"
import {packBlockCatalog} from "../src/compiler/catalog-packing.vel"

type StateIdMapping:
    runtimeId: number
    stateKey: string

type ResolvedCatalogVersion:
    catalogVersion: string

export type GeneratedCatalogArtifacts:
    catalogText: string

def validateBuiltinStateMap(source: BlockStateMapSource) -> BlockStateMapSource:
    assert source.formatVersion == 2 else "Unsupported built-in block state map format version"
    assert source.nextRuntimeId.isInteger() and source.nextRuntimeId > 0 and source.nextRuntimeId <= 0x1000000 else "Built-in block state map nextRuntimeId is invalid"
    const allocated: Set<number> = Set()
    let previousRuntimeId = -1
    for mapping in source.states:
        assert mapping.runtimeId > previousRuntimeId else "Built-in block state mappings must be ordered by runtimeId"
        assert mapping.runtimeId < source.nextRuntimeId else f"Built-in block state runtime id {mapping.runtimeId} is not below nextRuntimeId"
        assert not (mapping.runtimeId in allocated) else f"Duplicate built-in block state runtime id {mapping.runtimeId}"
        allocated.add(mapping.runtimeId)
        previousRuntimeId = mapping.runtimeId
    let previousReservedRuntimeId = -1
    for runtimeId in source.reservedRuntimeIds:
        assert runtimeId > previousReservedRuntimeId else "Reserved built-in block state runtime ids must be ordered"
        assert runtimeId >= 0 and runtimeId < source.nextRuntimeId else f"Reserved built-in block state runtime id {runtimeId} is outside the allocated range"
        assert not (runtimeId in allocated) else f"Built-in block state runtime id {runtimeId} is both active and reserved"
        allocated.add(runtimeId)
        previousReservedRuntimeId = runtimeId
    assert allocated.size == source.nextRuntimeId else "Built-in block state map must account for every allocated runtime id"
    return source

export def generateCatalogArtifacts(manifestText: string, stateMapText: string, identityTree: readonly Record<unknown>, sourceTexts: List<string>) -> GeneratedCatalogArtifacts:
    // 身份树由独立 identities 包提供。方块编译器只消费其中属于方块定义的
    // 路径，不拥有世界生成器或其他内容域的身份配置。
    const manifestSource = BuiltinBlockCatalogManifest.parse(parseYaml(manifestText))
    const identities = BuiltinBlockIdentities.parse(identityTree)
    const stateMap = validateBuiltinStateMap(BlockStateMapSource.parse(parseYaml(stateMapText)))

    // 这两个身份由运行时代码直接使用，不会出现在方块 YAML 的引用遍历中，
    // 因此在这里显式登记。其余身份必须从配置中的打点路径被实际读取。
    const usedIdentityPaths: Set<string> = Set(["namespaces.base"])
    const manifestResolution = IdentityResolution.parse(resolveIdentityReferences({catalogVersion: manifestSource.catalogVersion}, identityTree))
    for path in manifestResolution.usedPaths: usedIdentityPaths.add(path)
    const resolvedCatalogVersion = ResolvedCatalogVersion.parse(manifestResolution.value)
    const manifest = BuiltinBlockCatalogManifest.from(manifestSource, {catalogVersion: resolvedCatalogVersion.catalogVersion})
    assert manifest.sources.size == sourceTexts.size else "Block catalog source count does not match its manifest"
    const sourceFiles: List<BlockSourceFile> = []
    for sourceText in sourceTexts:
        const resolution = IdentityResolution.parse(resolveIdentityReferences(parseYaml(sourceText), identityTree))
        for path in resolution.usedPaths: usedIdentityPaths.add(path)
        sourceFiles.append(BlockSourceFile.parse(resolution.value))
    const blocks = collectBlockTypes(sourceFiles)
    const catalog = compileBuiltinBlockCatalog(manifest, identities, blocks, stateMap)
    const packedCatalog = packBlockCatalog(catalog)

    // 哈希只基于稳定序列化后的运行时事实，不包含源文件路径或 YAML 排版。
    // contentHash 识别完整目录，stateMapHash 单独识别 runtimeId 到状态的映射。
    const contentHash = sha256Text(Json.stableStringify(catalog))
    const stateMappings: List<StateIdMapping> = catalog.states.map(state => ({runtimeId: state.runtimeId, stateKey: state.stateKey}))
    const stateMapHash = sha256Text(Json.stableStringify(stateMappings.sorted(by=mapping => mapping.runtimeId)))
    const artifact: BlockCatalogArtifact = {
        artifactVersion: 6,
        contentHash,
        stateMapHash,
        catalog: packedCatalog,
    }
    return {
        catalogText: f"{Json.stableStringify(artifact, 2)}\n",
    }
