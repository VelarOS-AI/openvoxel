/// 内容源路径必须留在 data/blocks 下。每一级只接受小写字母、数字与内部连字符，
/// 因而支持按职责继续分层，同时拒绝绝对路径、空段和任何目录回退。
export def isBlockCatalogSourcePath(source: string) -> bool:
    return Text.matches(source, r"^blocks/([a-z0-9]+(-[a-z0-9]+)*/)*[a-z0-9]+(-[a-z0-9]+)*[.]yml$")

export def requireBlockCatalogSourcePath(source: string):
    assert isBlockCatalogSourcePath(source) else f"Invalid block source path {source}"
