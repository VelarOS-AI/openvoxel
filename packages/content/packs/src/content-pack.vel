import {BlockCatalogContribution, blockCatalogHash} from "@openvoxel/blocks"
import {WorldContentIdentity, WorldContentPackReference, validateWorldContentIdentity} from "@openvoxel/world"
import {WorldGeneratorCatalogContribution, worldGeneratorCatalogHash} from "@openvoxel/world-generation"
import {sha256Text} from "velar/hash"

/// 一个 Mod 的统一运行时产物。方块和世界生成配置可以独立缺省，但至少需要贡献
/// 一个内容域。人工 YAML 由构建工具读取，运行时只解析这份已经验证的 JSON 结构。
export type ContentPackArtifact:
    artifactVersion: number
    owner: string
    contentHash: string
    blocks: BlockCatalogContribution?
    worldGeneration: WorldGeneratorCatalogContribution?

/// 世界运行时消费的完整内容集合。identity 是持久化事实，两个 contribution 列表
/// 是从已安装产物得到的运行时投影，不再另设可由调用方手写的 revision。
export type WorldContentSet:
    identity: WorldContentIdentity
    blockContributions: readonly List<readonly BlockCatalogContribution>
    generatorContributions: readonly List<readonly WorldGeneratorCatalogContribution>

export type ContentCatalog:
    defaultContent: () -> readonly WorldContentSet
    select: (owners: readonly List<string>) -> readonly WorldContentSet
    resolve: (identity: readonly WorldContentIdentity) -> readonly WorldContentSet
    requirePack: (owner: string) -> readonly ContentPackArtifact

def requireOwner(owner: string):
    assert Text.matches(owner, r"^[a-z][a-z0-9_.-]*$") else "Content pack owner must be a lowercase namespace"

def contentPackPayload(
    owner: string,
    blocks: readonly BlockCatalogContribution?,
    worldGeneration: readonly WorldGeneratorCatalogContribution?,
) -> Record<unknown>: return {owner, blocks, worldGeneration}

/// contribution 先由各自领域编译器验证；这里再验证它们属于同一个 Content Pack，
/// 并以稳定序列化结果计算唯一产物哈希。
export def createContentPackArtifact(
    owner: string,
    blocks: readonly BlockCatalogContribution? = null,
    worldGeneration: readonly WorldGeneratorCatalogContribution? = null,
) -> ContentPackArtifact:
    requireOwner(owner)
    assert blocks != null or worldGeneration != null else f"Content pack {owner} does not contribute any content"
    if blocks != null:
        assert blocks.owner == owner else f"Block contribution {blocks.owner} does not belong to content pack {owner}"
    if worldGeneration != null:
        assert worldGeneration.owner == owner else f"World generation contribution {worldGeneration.owner} does not belong to content pack {owner}"
    const contentHash = sha256Text(Json.stableStringify(contentPackPayload(owner, blocks, worldGeneration)))
    return {
        artifactVersion: 1,
        owner,
        contentHash,
        blocks: blocks == null ? null : BlockCatalogContribution.parse(blocks),
        worldGeneration: worldGeneration == null ? null : WorldGeneratorCatalogContribution.parse(worldGeneration),
    }

/// JSON 载入边界既做结构解析，也重新计算内容哈希；文件名、路径和外部清单都不能
/// 伪造同一产物身份。
export def validateContentPackArtifact(artifact: readonly ContentPackArtifact) -> readonly ContentPackArtifact:
    assert artifact.artifactVersion == 1 else "Unsupported content pack artifact version"
    const expected = createContentPackArtifact(artifact.owner, artifact.blocks, artifact.worldGeneration)
    assert artifact.contentHash == expected.contentHash else f"Content pack {artifact.owner} content hash does not match its payload"
    return artifact

def worldContentHash(packs: readonly List<readonly WorldContentPackReference>) -> string:
    return sha256Text(Json.stableStringify({blockCatalogHash, worldGeneratorCatalogHash, packs}))

/// 已安装内容目录只接受每个 owner 的一份确定构建。默认集合也是 owner 列表，最终
/// 身份和 contribution 顺序都由 owner 排序决定，不受服务器配置书写顺序影响。
export def createContentCatalog(
    artifacts: readonly List<readonly ContentPackArtifact> = [],
    defaultOwners: readonly List<string> = [],
) -> ContentCatalog:
    const installed: Map<string, readonly ContentPackArtifact> = Map()
    for candidate in artifacts:
        const artifact = validateContentPackArtifact(candidate)
        assert installed.get(artifact.owner) == null else f"Duplicate installed content pack {artifact.owner}"
        installed.set(artifact.owner, artifact)

    def requirePack(owner: string) -> readonly ContentPackArtifact:
        requireOwner(owner)
        const artifact = installed.get(owner)
        assert artifact != null else f"Required content pack {owner} is not installed"
        return artifact

    def select(owners: readonly List<string>) -> readonly WorldContentSet:
        const unique: Set<string> = Set()
        for owner in owners:
            requireOwner(owner)
            assert not (owner in unique) else f"Content selection repeats pack {owner}"
            unique.add(owner)
        const references: List<WorldContentPackReference> = []
        const blockContributions: List<readonly BlockCatalogContribution> = []
        const generatorContributions: List<readonly WorldGeneratorCatalogContribution> = []
        for owner in unique.values().sorted():
            const artifact = requirePack(owner)
            references.append({owner, contentHash: artifact.contentHash})
            if artifact.blocks != null: blockContributions.append(artifact.blocks)
            if artifact.worldGeneration != null: generatorContributions.append(artifact.worldGeneration)
        const identity: WorldContentIdentity = {
            contentHash: worldContentHash(references),
            packs: references,
        }
        validateWorldContentIdentity(identity)
        return {identity, blockContributions, generatorContributions}

    def resolve(identity: readonly WorldContentIdentity) -> readonly WorldContentSet:
        validateWorldContentIdentity(identity)
        const selected = select(identity.packs.map(pack => pack.owner))
        assert selected.identity.contentHash == identity.contentHash else "World content hash does not match the installed content set"
        for expected, index in identity.packs:
            const actual = selected.identity.packs[index]
            assert actual.owner == expected.owner and actual.contentHash == expected.contentHash else f"World requires a different build of content pack {expected.owner}"
        return selected

    const selectedDefaults = select(defaultOwners)

    def defaultContent() -> readonly WorldContentSet: return selectedDefaults

    return {defaultContent, select, resolve, requirePack}

export const baseContentCatalog = createContentCatalog()
export const baseWorldContent = baseContentCatalog.defaultContent()
